// Shared UI state for the laptop window. Rust sets these through
// `laptop.global::<Dash>()` etc.; pages read them directly.

import { AccountPrompt, PosterCardData, SessionRow } from "components.slint";
import { UiTheme } from "theme.slint";


// Which laptop page is showing.
export global Nav {
    // "home" | "library" | "browse" | "collection" | "show" | "settings" | "setup"
    in-out property <string> page: "home";
    // "dual" (laptop dashboard) | "tv" (everything on the TV, 10-foot)
    in property <string> layout: "dual";
    // Settings tab: "accounts" | "streaming" | "display" | "diagnostics"
    in-out property <string> settings-tab: "accounts";
    // A page was opened (the Library re-reads Plex).
    callback opened(string);
}

// The screensaver (laptop, two-screen layout).
export global Saver {
    in-out property <bool> on;
    in property <string> time;          // "9:04 PM" | "21:04"
    in property <string> day;           // "Thursday"
    in property <bool> has-weather;
    in property <string> temp;          // "51°"
    in property <string> condition;     // "partly sunny"
    in property <string> label;         // "ON THE TV · PLAYING · PLEX"
    in property <string> title;
    in property <string> line;
    in property <bool> show-progress;
    in property <float> progress;
    in property <string> at;            // "24:10 / 52:00"
    in property <string> ends;          // "Ends at 1:00 PM"
    in property <color> accent: #8FC1FF;
    // Burn-in: the text block moves a few pixels each minute.
    in property <length> drift-x;
    in property <length> drift-y;
}

// Colours for the On the TV card, taken from the poster's hue (set by Rust per theme).
export struct Tint {
    card: color,
    poster: color,
    accent: color,
    sec: color,
    track: color,
    btn: color,
    edge: color,
    on-accent: color,
}

// The On the TV card.
export struct TvCard {
    // "playing" (mpv) | "streaming" (browser) | "next" (idle, top Continue Watching item) | "idle"
    mode: string,
    label: string,      // "ON THE TV" | "UP NEXT"
    source: string,     // pill: "Plex" | "Browser" | ""
    title: string,
    subtitle: string,   // "S2 · E7 · Crossroads" (TV layout)
    episode-line: string, // "Season 2 · Episode 7 — Crossroads"; "" for movies
    facts: string,      // "2024 · TV-14 · 52 min · Drama"
    overview: string,   // description from Plex ("" = none)
    genres: string,     // shown with "No description on the server" when there's no overview
    note: string,       // line above the title ("Nothing on the TV. Pick up where you left off:")
    at-text: string,    // "24:10 / 52:00" | "Stopped at 31:40"
    left-text: string,  // "28 min left · ends 21:40"
    progress: float,
    paused: bool,
    poster: image,
    has-poster: bool,
    monogram: string,   // shown instead of a poster when there's no logo
    logo: image,        // the app's logo while it streams
    has-logo: bool,
}

// A Watch on TV tile (one of the ten fixed apps).
export struct SiteTileData {
    index: int,         // position in the app list
    name: string,
    logo: image,        // for the current theme
}

// Control dashboard (home page) + things shared with every page.
export global Dash {
    // Header
    in property <string> clock-hh: "--";
    in property <string> clock-mm: "--";
    in property <string> clock-ss: "--";
    in property <bool> show-seconds: false;
    in property <string> clock-suffix;  // "AM" / "PM" in 12-hour mode
    in property <string> weekday;
    in property <string> date-text;
    in property <bool> weather-on: false;
    in property <string> weather-temp: "—";
    in property <string> weather-detail;
    // Icon name (see icons.slint): "clear" | "partly" | "cloud" | "fog" | "rain" | "snow" | "storm"
    in property <string> weather-icon: "partly";
    // Last value is old (shown dimmed) / the last fetch failed (amber dot).
    in property <bool> weather-stale: false;
    in property <bool> weather-warn: false;
    // "Updated 25 min ago" or why it failed; replaces the detail line when set.
    in property <string> weather-note;

    // On the TV
    in property <TvCard> tv: { mode: "idle", label: "ON THE TV", title: "Nothing playing", subtitle: "The TV is showing the idle screen." };
    in property <Tint> tint: {
        card: #121F30, poster: #1C2E45, accent: #8FC1FF, sec: #AFC3DA,
        track: #1E3048, btn: #172840, edge: #24395A, on-accent: #0B0D10,
    };
    in property <[SessionRow]> sessions;
    // Servers whose sign-in expired (sessions can't be read).
    in property <[AccountPrompt]> tv-prompts;

    // Continue Watching: "loading" | "busy" | "code" | "prompts" | "empty" | "items"
    in property <string> cw-state: "loading";
    in property <string> cw-message;
    in property <string> signin-code;
    in property <string> signin-source;
    in property <[AccountPrompt]> prompts;
    // Everything in progress (TV layout, and the Up next item), and the dashboard's
    // two tabs of it.
    in property <[PosterCardData]> continue-watching;
    in property <[PosterCardData]> cw-tv;
    in property <[PosterCardData]> cw-movies;
    // "tv" | "movies"
    in-out property <string> cw-tab: "tv";

    in property <[SiteTileData]> streaming-sites;

    // The search panel over the right two boxes.
    in-out property <bool> search-open;

    // Shown in Settings
    in property <string> keyring-status: "Checking keyring…";
    in property <color> keyring-dot: #8A9099;

    // Transient message at the bottom of the window ("" = hidden).
    in property <string> toast;

    callback open-site(int);
    callback transport(string); // "back" | "play-pause" | "forward" | "stop"
    callback play-item(int);
    callback play-card(string, int); // (tab, index): a Continue Watching poster
    callback prompt-action(string, string); // (source, "sign-in" | "retry")
    callback cancel-sign-in(string);
    callback set-theme(UiTheme);
    callback quit();
}

export struct DetailData {
    title: string,
    subtitle: string,
    badge: string,
    meta: string,       // "Movie · 2024 · 1 h 52 min · Mystery"
    extra: string,      // "22 of 30 episodes watched"
    overview: string,
    action: string,     // "Resume on TV" | "Play on TV"
    poster: image,
    has-poster: bool,
    progress: float,
    can-resume: bool,   // offer "Play from the start" too
}

// A card in the Library's big box: a season to finish, or a movie to finish.
export struct ShelfItem {
    title: string,
    line: string,       // "Season 1 · 2 episodes left" | "22 min left"
    poster: image,
    has-poster: bool,
    card: color,
    art: color,         // behind the poster while it loads
    accent: color,
    sec: color,
    segments: int,      // one per episode; 0 = one continuous bar
    done: int,
    progress: float,
}

export struct GenreTile {
    name: string,
    count: string,
    bg: color,
    edge: color,
    sec: color,
}

// A card in the Library's Collections row.
export struct CollectionCard {
    title: string,
    line: string,       // "8 movies · 3 watched · smart" | "8 movies · all watched"
    poster: image,
    has-poster: bool,
    card: color,
    art: color,
    accent: color,
    sec: color,
    track: color,
    progress: float,    // watched / total
}

// A movie on a collection page.
export struct CollectionMovie {
    position: string,   // "#4" (collection order) or "1998"
    title: string,
    line: string,       // "1998 · watched" | "1998 · unwatched" | "1998 · 1 h 5 min left"
    poster: image,
    has-poster: bool,
    placeholder: color,
    accent: color,
    progress: float,
    watched: bool,
}

// Tonight's pick.
export struct PickData {
    title: string,
    meta: string,       // "Unwatched series · 8 episodes · Plex"
    why: string,
    action: string,     // "Start S1 · E1 on TV" | "Play on TV"
    poster: image,
    has-poster: bool,
}

export global Library {
    // The TV layout's Library screen (Continue Watching, Recently Added).
    in property <[PosterCardData]> continue-watching;
    in property <[PosterCardData]> recently-added;
    // section: "continue" | "recent"
    callback select(string, int);
    callback play-detail(bool); // true = from the start

    // Smart shelves (laptop). "tv" | "movies"
    in-out property <string> tab: "tv";
    // "loading" | "signin" | "ready"
    in property <string> state: "loading";
    in property <bool> has-pick;
    in property <PickData> pick;
    in property <Tint> pick-tint;
    in property <string> box-title;     // "FINISH A SEASON" | "CONTINUE WATCHING"
    in property <string> box-rule;
    in property <string> box-empty;
    in property <[ShelfItem]> box-items;
    in property <[PosterCardData]> added;
    in property <int> added-count;
    in property <string> added-rule;
    in property <[PosterCardData]> again;
    in property <int> again-count;
    in property <string> again-rule;
    in property <[GenreTile]> genres;
    // Movies: the Collections row instead of Genres.
    in property <[CollectionCard]> collections;
    in property <int> collection-count;
    // Order for the two shelves and Browse all: "added" | "az" | "za".
    in property <string> sort: "added";
    in-out property <bool> sort-open;

    callback set-tab(string);
    callback set-sort(string);
    callback open-collection(int);
    callback shuffle();
    callback play-pick();
    callback play-box(int);
    // A poster on a shelf: Browse that shelf with it selected. shelf: "added" | "again"
    callback open-item(string, int);
    // filter: "all" | "added" | "again" | "genre:<name>"
    callback browse(string);
}

// Browse all: the full grid and the detail panel.
export global Browse {
    in property <string> title;         // "All shows", "Drama · movies"
    in property <string> count-text;    // "86 titles"
    in-out property <bool> unwatched-only;
    in property <[PosterCardData]> cards;
    in-out property <int> selected: -1;
    in property <bool> detail-open;
    in property <DetailData> detail;
    // Genre filter chips ("" = all genres).
    in property <[string]> genres;
    in property <string> genre;

    callback select(int);
    callback play(bool);                // true = from the start
    callback set-unwatched(bool);
    callback set-genre(string);
}

// A season on a show page.
export struct SeasonTab {
    title: string,      // "Season 2" | "Specials"
    short: string,      // "S2" | "Sp"
    progress-text: string, // "Watched" | "2 of 10 watched" | "10 episodes"
    progress: float,
}

// An episode row on a show page.
export struct EpisodeRow {
    number: string,     // "03" | "S1" (specials)
    title: string,
    line: string,       // "45 min · 14 min left" | "45 min · watched"
    summary: string,
    still: image,
    has-still: bool,
    placeholder: color,
    accent: color,
    watched: bool,
    progress: float,
    current: bool,      // the up-next episode in progress: highlighted, filled Resume
}

// A show's page: seasons and episodes.
export global Show {
    // "loading" | "ready"
    in property <string> state: "loading";
    in property <string> crumb;         // "TV / Series › Harbor Lights"
    in property <string> title;
    in property <string> meta;          // "2024 · TV-14 · 3 seasons · Drama"
    in property <string> summary;
    in property <string> up-next;       // "Up next: S1 · E3 — The Breakwater · 14 min left"
    in property <string> action;        // "Resume S1 · E3 on TV" | "Play S1 · E3 on TV"
    in property <string> first;         // "Play from S1 · E1"
    in property <image> backdrop;
    in property <bool> has-backdrop;
    in property <Tint> tint;
    in property <[SeasonTab]> seasons;
    in property <int> season;           // selected, index into seasons
    // "tabs" (1–6 seasons) | "pills" (7–14) | "picker" (15+)
    in property <string> selector: "tabs";
    in-out property <bool> picker-open;
    in property <string> seasons-text;  // "20 seasons · 11 watched"
    in property <[EpisodeRow]> episodes;

    callback play-up-next();
    callback play-first();
    callback shuffle();
    callback select-season(int);
    callback play-episode(int);
}

// A collection's page.
export global Collection {
    in property <string> crumb;         // "Movies › Collections › Studio Ember"
    in property <string> title;
    in property <string> meta;          // "8 movies · 1998–2024 · 15 h 40 min in total"
    in property <float> progress;
    in property <string> watched-text;  // "3 of 8 watched"
    in property <string> summary;
    in property <string> up-next;       // "Up next: Paper Moon City"
    in property <string> action;        // "Resume Paper Moon City on TV" | "Play … on TV" | "Play from the start"
    in property <bool> can-shuffle;
    in property <image> backdrop;
    in property <bool> has-backdrop;
    in property <Tint> tint;
    // "collection" | "release" | "az"
    in property <string> order: "collection";
    in property <bool> hide-watched;
    in property <[CollectionMovie]> movies;
    // A long-pressed movie's details (the Browse panel's data).
    in-out property <bool> detail-open;

    callback play-up-next();
    callback shuffle();
    callback set-order(string);
    callback set-hide-watched(bool);
    callback play(int);
    callback details(int);
}

export struct AccountRow {
    id: string,         // "plex" | "tmdb"
    name: string,
    status: string,
    detail: string,
    state: string,      // "ok" | "warn" | "off" | "busy"
    primary: string,    // button labels; "" = no button
    primary-id: string, // "sign-in" | "sign-out" | "retry" | "cancel"
    secondary: string,
    secondary-id: string,
    input-hint: string, // placeholder when the row takes text (the TMDB token)
}

export struct SiteRow {
    index: int,         // position in the app list
    name: string,
    url: string,
    status: string,
    opened: bool,
    logo: image,
}

export global Accounts {
    in property <[AccountRow]> accounts;
    // Row whose text field is open ("" = none).
    in-out property <string> editing;
    in property <string> edit-error;
    callback submit(string, string); // (row id, value)
    in property <[SiteRow]> sites;
    in-out property <bool> confirm-clear;

    // (row id, button label)
    callback action(string, string);
    callback open-site(int);
    callback clear-profile();
    callback run-setup();
}

export global Setup {
    // 0 Plex · 1 Streaming
    in-out property <int> step: 0;
    // Per sign-in: "idle" | "busy" | "code" | "done" | "error"
    in property <string> plex-state: "idle";
    in property <string> plex-code;
    in property <string> plex-message;

    callback sign-in(string);       // "plex"
    callback cancel(string);
    callback finish();
}

// A search result in the panel.
export struct WatchCard {
    key: string,        // "movie:603" | "tv:1399"
    title: string,
    meta: string,       // "Movie · 1999 · included with Netflix"
    action: string,     // button label: "Resume on TV" | "Play on TV" | "Open on TV" | "" (none)
    show: bool,         // a show in your library: tapping the row opens its page
    primary: bool,      // filled button (library) vs outlined (apps)
    poster: image,
    has-poster: bool,
}

// Search (the panel): your library, then your apps, then the rest.
export global Watch {
    in-out property <string> query;
    in property <bool> searching;
    in property <string> message;   // error, "no results", or the TMDB token hint
    in property <[WatchCard]> library;
    in property <[WatchCard]> included;
    in property <[WatchCard]> extra;
    in property <[WatchCard]> none;
    in property <[WatchCard]> checking;

    callback edited(string);        // debounced search while typing
    callback action(string);        // the result's button (by key)
    callback open(string);          // a library show's row: its page
    callback close();
}

// Settings › Display.
export global Display {
    in-out property <bool> celsius: false;
    in-out property <bool> h12: false;
    in-out property <bool> seconds: false;
    callback changed();

    // Weather location.
    in property <string> location-name;     // "" = not set
    in-out property <string> place-query;
    in property <bool> place-searching;
    in property <string> place-message;     // "No place called …" / errors
    in property <[string]> places;          // matches to pick from
    callback set-layout(bool);  // true = TV only
    callback find-place(string);
    callback pick-place(int);
}

export struct HealthRow {
    name: string,
    state: string,      // "ok" | "warn" | "off"
    last-ok: string,    // "12:04 · 2 min ago · 6 in Continue Watching"
    last-error: string, // "11:58 · HTTP 500"
}

// Settings › Diagnostics.
export global Diagnostics {
    in property <[HealthRow]> rows;
    in property <[string]> paths;   // "Log file: /home/…/tvdash.log"
}

// TV-only layout ([display] layout = "tv"). Rust owns navigation (tv_nav.rs);
// these say what's showing and what has focus.
export global TvUi {
    // "home" | "search" | "library" | "services" | "settings"
    in-out property <string> screen: "home";
    in property <bool> rail-open;
    // What has focus: "rail" | "hero" | "prompts" | "continue" | "services" | "lib-continue"
    // | "lib-recent" | "grid" | "set-layout" | "set-theme" | "set-units" | "set-clock"
    // | "set-accounts" | "set-quit" | "" (nothing focusable)
    in property <string> focus;
    // Position inside the focused row (rail: 0 Home … 4 Settings, 5 theme).
    in property <int> col;
    // Full-bleed art + clock after a few idle minutes; any key returns.
    in property <bool> ambient;
    // Settings › Layout shows the saved choice.
    in property <bool> layout-tv: true;
    in property <int> focus-ticket;
    // In-window video: the current frame, whether a video plays in the window,
    // and whether it fills the screen (Back shows Home over it, still playing).
    in property <image> video;
    in property <bool> video-on;
    in property <bool> video-full;
    // A key press (Slint key text); returns true when handled.
    callback key(string) -> bool;
    // Show the playback overlay (title, progress, end time) on the video.
    callback overlay();
}
