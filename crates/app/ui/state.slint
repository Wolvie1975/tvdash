// Shared UI state for the laptop window. Rust sets these through
// `laptop.global::<Dash>()` etc.; pages read them directly.

import { AccountPrompt, PosterCardData, SessionRow } from "components.slint";
import { UiTheme } from "theme.slint";

// Which laptop page is showing.
export global Nav {
    // "home" | "library" | "watch" | "settings" | "setup"
    in-out property <string> page: "home";
    // "dual" (laptop dashboard) | "tv" (everything on the TV, 10-foot)
    in property <string> layout: "dual";
    // Settings tab: "accounts" | "streaming" | "display" | "server" | "diagnostics"
    in-out property <string> settings-tab: "accounts";
}

// Colours for the On the TV card, taken from the poster's hue (set by Rust per theme).
export struct Tint {
    card: color,
    poster: color,
    accent: color,
    sec: color,
    track: color,
    btn: color,
    edge: color,
    on-accent: color,
}

// The On the TV card.
export struct TvCard {
    // "playing" (mpv) | "streaming" (browser) | "next" (idle, top Continue Watching item) | "idle"
    mode: string,
    label: string,      // "ON THE TV" | "UP NEXT"
    source: string,     // pill: "Plex" | "Browser" | ""
    title: string,
    subtitle: string,
    note: string,       // line above the title ("Nothing on the TV. Pick up where you left off:")
    at-text: string,    // "24:10 / 52:00" | "Stopped at 31:40"
    left-text: string,  // "28 min left · ends 21:40"
    summary: string,
    progress: float,
    paused: bool,
    is-episode: bool,
    poster: image,
    has-poster: bool,
    monogram: string,   // shown instead of a poster (streaming site initial)
}

// A Watch on TV tile.
export struct SiteTileData {
    index: int,         // position in the config (hidden sites included)
    name: string,
    monogram: string,
    bg: color,
    fg: color,
    logo: image,
    has-logo: bool,
}

// Control dashboard (home page) + things shared with every page.
export global Dash {
    // Header
    in property <string> clock-hh: "--";
    in property <string> clock-mm: "--";
    in property <string> clock-ss: "--";
    in property <bool> show-seconds: false;
    in property <string> weekday;
    in property <string> date-text;
    in property <bool> weather-on: false;
    in property <string> weather-temp: "—";
    in property <string> weather-detail;
    in property <string> weather-condition;
    // Icon name (see icons.slint): "clear" | "partly" | "cloud" | "fog" | "rain" | "snow" | "storm"
    in property <string> weather-icon: "partly";
    // Last value is old (shown dimmed) / the last fetch failed (amber dot).
    in property <bool> weather-stale: false;
    in property <bool> weather-warn: false;
    // "Updated 25 min ago" or why it failed; replaces the detail line when set.
    in property <string> weather-note;

    // On the TV
    in property <bool> tv-connected: true;
    in property <TvCard> tv: { mode: "idle", label: "ON THE TV", title: "Nothing playing", subtitle: "The TV is showing the idle screen." };
    in property <Tint> tint: {
        card: #121F30, poster: #1C2E45, accent: #8FC1FF, sec: #AFC3DA,
        track: #1E3048, btn: #172840, edge: #24395A, on-accent: #0B0D10,
    };
    in property <[SessionRow]> sessions;
    // Servers whose sign-in expired (sessions can't be read).
    in property <[AccountPrompt]> tv-prompts;

    // Continue Watching: "loading" | "busy" | "code" | "prompts" | "empty" | "items"
    in property <string> cw-state: "loading";
    in property <string> cw-message;
    in-out property <string> cw-filter: "tv"; // "tv" | "movies"
    in-out property <bool> search-open: false;
    in-out property <bool> screensaver-open: false;
    in property <int> screensaver-dx: 0;
    in property <int> screensaver-dy: 0;
    in property <string> tv-ends-at;
    in property <string> signin-code;
    in property <string> signin-source;
    in property <[AccountPrompt]> prompts;
    in property <[PosterCardData]> continue-watching;

    in property <[SiteTileData]> streaming-sites;

    // Shown in Settings
    in property <string> keyring-status: "Checking keyring…";
    in property <color> keyring-dot: #8A9099;

    // Transient message at the bottom of the window ("" = hidden).
    in property <string> toast;
    in property <string> version;

    callback open-site(int);
    callback transport(string); // "back" | "forward" | "restart" | "play-pause" | "stop" | ...
    callback play-item(int);
    callback play-item-from-start(int);
    callback play-up-next();
    callback set-cw-filter(string);
    callback open-screensaver();
    callback close-screensaver();
    callback prompt-action(string, string); // (source, "sign-in" | "retry")
    callback cancel-sign-in(string);
    callback set-theme(UiTheme);
    callback quit();
}

export struct DetailData {
    title: string,
    subtitle: string,
    badge: string,
    meta: string,       // "Episode · 45 min · 30 min left"
    poster: image,
    has-poster: bool,
    progress: float,
    can-resume: bool,
    show-key: string,
}

export struct PopularCardData {
    rank: int,
    rating-key: string,
    title: string,
    plays: string,
}

export struct FinishSeasonRow {
    rating-key: string,
    title: string,
    season: string,
    watched: int,
    total: int,
}

export struct GenreTileData {
    key: string,
    title: string,
    count: int,
}

export struct CollectionCardData {
    rating-key: string,
    title: string,
    detail: string,
    progress: float,
    smart: bool,
}

export struct SeasonTabData {
    rating-key: string,
    index: int,
    title: string,
    progress: string,
    fraction: float,
}

export struct EpisodeRowData {
    rating-key: string,
    num: string,
    title: string,
    meta: string,
    summary: string,
    progress: float,
    watched: bool,
    can-resume: bool,
    has-thumb: bool,
    thumb: image,
}

export struct CollectionItemData {
    rating-key: string,
    num: string,
    title: string,
    status: string,
    watched: bool,
    can-resume: bool,
    has-poster: bool,
    poster: image,
}

export global Library {
    // "all" | "plex"
    in-out property <string> filter: "all";
    in-out property <string> media-tab: "tv"; // "tv" | "movies"
    in-out property <string> sort: "recent";  // "recent" | "title_asc" | "title_desc"
    in-out property <int> popular-days: 30;   // 7 | 30
    in-out property <bool> browse-all: false;
    in-out property <string> browse-letter: ""; // "" (all) | "#" | "A".."Z"
    in-out property <string> query;
    in property <bool> searching;
    // Non-empty while showing search results ("Results for “x”").
    in property <string> results-title;
    in property <[PosterCardData]> continue-watching;
    in property <[PosterCardData]> recently-added;
    in property <[PosterCardData]> results;
    in property <[FinishSeasonRow]> finish-season;
    in property <[PosterCardData]> added-week;
    in property <[PosterCardData]> watch-again;
    in property <[PosterCardData]> browse-items;
    in property <[PopularCardData]> popular;
    in property <[GenreTileData]> genres;
    in property <[CollectionCardData]> collections;
    in property <bool> detail-open;
    in-out property <bool> metadata-refreshing;
    in property <DetailData> detail;
    // Highlighted card (set by the page on click).
    in-out property <string> selected-section;
    in-out property <int> selected-index: -1;

    callback set-filter(string);
    callback set-media-tab(string);
    callback set-sort(string);
    callback set-popular-days(int);
    callback set-browse-letter(string);
    callback open-show(string);
    callback open-collection(string);
    callback play-key(string, bool);
    callback search(string);
    callback clear-search();
    // section: "continue" | "recent" | "results"
    callback select(string, int);
    callback play-detail(bool); // true = from the start
    callback close-detail();
}

export global ShowPageState {
    in-out property <bool> open: false;
    in property <bool> loading: false;
    in property <string> rating-key;
    in property <string> title;
    in property <string> meta;
    in property <string> summary;
    in property <string> up-next;
    in property <string> up-next-key;
    in property <bool> can-resume;
    in property <[SeasonTabData]> seasons;
    in-out property <string> selected-season;
    in property <[EpisodeRowData]> episodes;
    in property <Tint> tint: {
        card: #121F30, poster: #1C2E45, accent: #8FC1FF, sec: #AFC3DA,
        track: #1E3048, btn: #172840, edge: #24395A, on-accent: #0B0D10,
    };

    callback select-season(string);
    callback play-episode(string, bool);
    callback play-from-start();
    callback shuffle();
    callback close();
}

export global CollectionPageState {
    in-out property <bool> open: false;
    in property <bool> loading: false;
    in property <string> rating-key;
    in property <string> title;
    in property <string> meta;
    in property <string> progress-text;
    in property <string> summary;
    in property <string> up-next-key;
    in property <string> up-next-label: "Play next on TV";
    in-out property <string> order: "collection"; // "collection" | "release" | "alpha"
    in-out property <bool> hide-watched: false;
    in property <[CollectionItemData]> items;
    in property <Tint> tint: {
        card: #121F30, poster: #1C2E45, accent: #8FC1FF, sec: #AFC3DA,
        track: #1E3048, btn: #172840, edge: #24395A, on-accent: #0B0D10,
    };

    callback set-order(string);
    callback set-hide-watched(bool);
    callback play-item(string, bool);
    callback shuffle();
    callback close();
}

export struct ArtworkRow {
    key: string,
    provider: string,
    selected: bool,
    image: image,
    has-image: bool,
}

export global Artwork {
    in-out property <bool> open;
    in property <bool> backdrop;
    in property <bool> loading;
    in property <string> error;
    in property <[ArtworkRow]> choices;

    callback request(bool);
    callback set(string);
    callback refresh();
    callback close();
}

export struct AccountRow {
    id: string,         // "plex"
    name: string,
    status: string,
    detail: string,
    state: string,      // "ok" | "warn" | "off" | "busy"
    primary: string,    // button labels; "" = no button
    primary-id: string, // "sign-in" | "sign-out" | "retry" | "cancel"
    secondary: string,
    secondary-id: string,
    input-hint: string, // placeholder when the row takes text (the TMDB token)
}

export struct SiteRow {
    index: int,         // position in the config
    name: string,
    url: string,
    status: string,
    opened: bool,
    hidden: bool,
    monogram: string,
    bg: color,
    fg: color,
}

export global Accounts {
    in property <[AccountRow]> accounts;
    // Row whose text field is open ("" = none).
    in-out property <string> editing;
    in property <string> edit-error;
    callback submit(string, string); // (row id, value)
    in property <[SiteRow]> sites;
    in-out property <bool> confirm-clear;

    // (row id, button label)
    callback action(string, string);
    callback open-site(int);
    callback clear-profile();
    callback run-setup();
}

export global Setup {
    // 0 Plex · 1 Streaming
    in-out property <int> step: 0;
    // Per sign-in: "idle" | "busy" | "code" | "done" | "error"
    in property <string> plex-state: "idle";
    in property <string> plex-code;
    in property <string> plex-message;

    callback sign-in(string);       // "plex"
    callback cancel(string);
    callback finish();
}

export struct ServerActivityRow {
    uuid: string,
    title: string,
    subtitle: string,
    progress: float,
    cancellable: bool,
}

export struct ServerStreamRow {
    session-id: string,
    local: bool,
    title: string,
    device: string,
    detail: string,
}

export struct ServerLibraryRow {
    title: string,
    count: int,
    scanned: string,
    loading: bool,
}

export global Server {
    in property <int> streams: 0;
    in property <int> transcodes: 0;
    in property <int> bandwidth: 0;
    in property <int> cpu: 0;
    in property <int> ram: 0;
    in property <string> cpu-host-path;
    in property <string> cpu-process-path;
    in property <string> ram-host-path;
    in property <string> ram-process-path;
    in property <string> bandwidth-lan-path;
    in property <string> bandwidth-wan-path;
    in property <int> bandwidth-scale: 10;
    in property <string> status: "Waiting for Plex…";
    in property <string> name: "Plex server";
    in property <bool> plex-pass: false;
    in property <[ServerStreamRow]> streams-detail;
    in property <[ServerActivityRow]> activity;
    in property <[ServerLibraryRow]> libraries;
    in-out property <bool> confirm-stop: false;
    in-out property <string> stop-session-id;
    in-out property <string> stop-title;
    in-out property <string> stop-device;
    in-out property <string> stop-reason: "Stopped from tvdash";

    callback refresh();
    callback refresh-activities();
    callback open();
    callback scan-all();
    callback scan-section(int);
    callback cancel-activity(string);
    callback terminate(string, string);
}

// Add / edit a streaming site (a dialog over any page).
export global SiteEditor {
    in-out property <bool> open;
    // Config position being edited; -1 = adding a new site.
    in-out property <int> index: -1;
    in-out property <string> name;
    in-out property <string> url;
    in-out property <string> search;
    in-out property <string> providers; // "8, 1796"
    in property <string> error;
    in-out property <bool> confirm-remove;
    in-out property <bool> clear-cookies: true;
    // Result of Find (TMDB provider names that matched).
    in property <string> note;

    callback add();
    callback edit(int);
    callback save();
    callback test();
    callback remove();
    callback move(int, int);        // (from, to)
    callback set-hidden(int, bool);
    callback find();                // look up TMDB provider IDs for the name
}

// A Where to watch result.
export struct WatchCard {
    key: string,        // "movie:603" | "tv:1399"
    title: string,
    meta: string,       // "1999 · Movie"
    line: string,       // "On Netflix" | "In Plex" | "Rent · Apple TV" | "Not streaming in the US" | "Checking…"
    tier: string,       // "library" | "included" | "extra" | "none" | "checking"
    poster: image,
    has-poster: bool,
}

export struct WatchAction {
    label: string,
    kind: string,       // "play" | "library" | "open" | "tmdb"
    site: int,          // config index for "open"
    primary: bool,
}

export global Watch {
    in-out property <string> query;
    // Hide "Costs extra" and "Not streaming".
    in-out property <bool> only-now: false;
    in property <bool> searching;
    in property <string> message;   // prompt, error or "no results"
    in property <[WatchCard]> library;
    in property <[WatchCard]> included;
    in property <[WatchCard]> extra;
    in property <[WatchCard]> none;
    in property <[WatchCard]> checking;
    in property <bool> detail-open;
    in-out property <string> selected;
    in property <WatchCard> detail;
    in property <string> detail-overview;
    in property <[string]> detail-yours;
    in property <[string]> detail-elsewhere;
    in property <[WatchAction]> detail-actions;

    callback edited(string);        // debounced search while typing
    callback search(string);
    callback select(string);
    callback action(WatchAction);
    callback close-detail();
}

// Settings › Display.
export global Display {
    in-out property <bool> celsius: false;
    in-out property <bool> h12: false;
    in-out property <bool> seconds: false;
    in property <bool> follow-system: false;
    callback changed();
    callback set-follow-system();

    // Weather location.
    in property <string> location-name;     // "" = not set
    in-out property <string> place-query;
    in property <bool> place-searching;
    in property <string> place-message;     // "No place called …" / errors
    in property <[string]> places;          // matches to pick from
    in-out property <string> layout-setting: "auto"; // "auto" | "dual" | "tv"
    callback set-layout(bool);  // true = TV only
    callback set-layout-setting(string);
    callback find-place(string);
    callback pick-place(int);
}

export struct HealthRow {
    name: string,
    state: string,      // "ok" | "warn" | "off"
    last-ok: string,    // "12:04 · 2 min ago · 6 in Continue Watching"
    last-error: string, // "11:58 · HTTP 500"
}

// Settings › Diagnostics.
export global Diagnostics {
    in property <[HealthRow]> rows;
    in property <[string]> paths;   // "Log file: /home/…/tvdash.log"
}

// TV-only layout ([display] layout = "tv"). Rust owns navigation (tv_nav.rs);
// these say what's showing and what has focus.
export global TvUi {
    // "home" | "search" | "library" | "services" | "settings"
    in-out property <string> screen: "home";
    in property <bool> rail-open;
    // What has focus: "rail" | "hero" | "prompts" | "continue" | "services" | "lib-continue"
    // | "lib-recent" | "grid" | "set-layout" | "set-theme" | "set-units" | "set-clock"
    // | "set-accounts" | "set-quit" | "" (nothing focusable)
    in property <string> focus;
    // Position inside the focused row (rail: 0 Home … 4 Settings, 5 theme).
    in property <int> col;
    // Full-bleed art + clock after a few idle minutes; any key returns.
    in property <bool> ambient;
    // Settings › Layout shows the saved choice.
    in property <bool> layout-tv: true;
    in property <int> focus-ticket;
    // In-window video: the current frame, whether a video plays in the window,
    // and whether it fills the screen (Back shows Home over it, still playing).
    in property <image> video;
    in property <bool> video-on;
    in property <bool> video-full;
    // Home Continue Watching confirmation dialog (-1 = closed).
    in-out property <int> confirm-cw-index: -1;
    // A key press (Slint key text); returns true when handled.
    callback key(string) -> bool;
    // Mouse/touch click on a focusable item (row, col).
    callback click(string, int);
    // Show the playback overlay (title, progress, end time) on the video.
    callback overlay();
}
