import { Dash, TvUi } from "../state.slint";
import { OrbitTheme } from "theme.slint";
import { OrbitRing } from "ring.slint";

// Pill button (§1.4): primary = text fill / bg ink; secondary = 1px #FFFFFF38 outline.
// Hover = focus: focus ring drawn as a sibling behind the pill.
export component OrbitPill inherits Rectangle {
    in property <string> label;
    in property <string> badge;
    in property <bool> primary: false;
    in property <bool> focused: false;
    in property <bool> selected: false;
    in property <color> accent-color: OrbitTheme.accent;
    in property <length> pill-height: 46px * TvUi.u;
    in property <length> h-pad: 22px * TvUi.u;
    callback activated();
    callback hovered();

    property <bool> active-focus: focused || ta.has-hover;

    width: row.preferred-width + h-pad * 2;
    height: pill-height;

    if active-focus: Rectangle {
        x: -9px * TvUi.u;
        y: -9px * TvUi.u;
        width: parent.width + 18px * TvUi.u;
        height: parent.height + 18px * TvUi.u;
        border-radius: self.height / 2;
        border-width: 4px * TvUi.u;
        border-color: OrbitTheme.text;
        background: transparent;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        background: primary ? OrbitTheme.text
            : selected ? OrbitTheme.row-focus
            : active-focus ? OrbitTheme.row-focus
            : OrbitTheme.glass;
        border-width: primary ? 0px : 1px;
        border-color: selected ? accent-color : #FFFFFF38;
        animate background { duration: 120ms; }
    }

    row := HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: 8px * TvUi.u;
        alignment: center;

        Text {
            text: label;
            font-family: OrbitTheme.font;
            font-size: 18px * TvUi.u;
            font-weight: primary ? 600 : 500;
            color: primary ? OrbitTheme.bg : OrbitTheme.text;
            vertical-alignment: center;
        }
        if badge != "": Text {
            text: badge;
            font-family: OrbitTheme.font;
            font-size: 16px * TvUi.u;
            font-weight: 500;
            color: primary ? OrbitTheme.bg : OrbitTheme.text;
            opacity: 0.7;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}

// Round play button (§1.4): 104px, 9px ring = item/show progress, inner 86px text disc with bg ▶.
export component OrbitPlay inherits Rectangle {
    in property <string> lit-path;
    in property <string> unlit-path;
    in property <color> lit-color: OrbitTheme.accent;
    in property <bool> focused: false;
    in property <length> size: 104px * TvUi.u;
    callback activated();
    callback hovered();

    property <bool> active-focus: focused || ta.has-hover;

    width: size;
    height: size;

    if active-focus: Rectangle {
        x: -9px * TvUi.u;
        y: -9px * TvUi.u;
        width: parent.width + 18px * TvUi.u;
        height: parent.height + 18px * TvUi.u;
        border-radius: self.width / 2;
        border-width: 4px * TvUi.u;
        border-color: OrbitTheme.text;
        background: transparent;
    }

    OrbitRing {
        size: root.size;
        viewbox-size: 104;
        thickness: 9px * TvUi.u;
        lit-path: root.lit-path;
        unlit-path: root.unlit-path;
        lit-color: root.lit-color;
    }

    // The disc is a sibling of the ring, not ring @children: it is placed explicitly in the
    // ring's inner circle (inset thickness + 3 px) and centred, so it never depends on the
    // ring's clipped inner container (which left it off-centre with a dark crescent).
    Rectangle {
        x: (root.size - self.width) / 2;
        y: (root.size - self.height) / 2;
        width: root.size - (9px * TvUi.u + 3px) * 2;
        height: self.width;
        border-radius: self.width / 2;
        background: OrbitTheme.text;
        drop-shadow-blur: active-focus ? 30px : 0px;
        drop-shadow-offset-y: active-focus ? 10px : 0px;
        drop-shadow-color: #000000AA;

        Text {
            width: parent.width;
            height: parent.height;
            text: "▶";
            font-size: 28px * TvUi.u;
            color: OrbitTheme.bg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}

// 92 × 50 toggle (§1.4): on = accent, bg knob 40.
export component OrbitToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> focused: false;
    in property <color> accent-color: OrbitTheme.accent;
    callback toggled();
    callback hovered();

    property <bool> active-focus: focused || ta.has-hover;

    width: 92px * TvUi.u;
    height: 50px * TvUi.u;

    if active-focus: Rectangle {
        x: -9px * TvUi.u;
        y: -9px * TvUi.u;
        width: parent.width + 18px * TvUi.u;
        height: parent.height + 18px * TvUi.u;
        border-radius: self.height / 2;
        border-width: 4px * TvUi.u;
        border-color: OrbitTheme.text;
        background: transparent;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        background: checked ? accent-color : OrbitTheme.track;
        animate background { duration: 150ms; }

        Rectangle {
            x: checked ? parent.width - 45px * TvUi.u : 5px * TvUi.u;
            y: 5px * TvUi.u;
            width: 40px * TvUi.u;
            height: 40px * TvUi.u;
            border-radius: self.width / 2;
            background: checked ? OrbitTheme.bg : OrbitTheme.text;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}

// List row (§1.4): radius = ½ height, row / row-focus, hover = focus.
export component OrbitRow inherits Rectangle {
    in property <bool> focused: false;
    in property <bool> selected: false;
    in property <length> row-height: 72px * TvUi.u;
    callback activated();
    callback hovered();

    property <bool> active-focus: focused || ta.has-hover;

    height: row-height;

    if active-focus: Rectangle {
        x: -9px * TvUi.u;
        y: -9px * TvUi.u;
        width: parent.width + 18px * TvUi.u;
        height: parent.height + 18px * TvUi.u;
        border-radius: self.height / 2;
        border-width: 4px * TvUi.u;
        border-color: OrbitTheme.text;
        background: transparent;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        background: (active-focus || selected) ? OrbitTheme.row-focus : OrbitTheme.row;
        border-width: 1px;
        border-color: (active-focus || selected) ? OrbitTheme.row-focus-border : OrbitTheme.row-border;
        animate background { duration: 120ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }

    @children
}

// Filter / section bubble (§1.4): circle with count/icon + segmented ring + label to the right.
export component OrbitBubble inherits Rectangle {
    in property <string> count-text;
    in property <string> label;
    in property <string> meta;
    in property <bool> has-logo: false;
    in property <bool> logo-tall: false;
    in property <image> logo;
    in property <string> lit-path;
    in property <string> unlit-path;
    in property <color> lit-color: OrbitTheme.accent;
    in property <color> meta-color: OrbitTheme.sub;
    in property <length> circle-size: 96px * TvUi.u;
    in property <bool> selected: false;
    in property <bool> focused: false;
    callback activated();
    callback hovered();

    property <bool> active-focus: focused || ta.has-hover;

    height: circle-size + 12px * TvUi.u;

    if active-focus: Rectangle {
        x: -9px * TvUi.u;
        y: -3px * TvUi.u;
        width: parent.width + 18px * TvUi.u;
        height: parent.height + 6px * TvUi.u;
        border-radius: self.height / 2;
        border-width: 4px * TvUi.u;
        border-color: OrbitTheme.text;
        background: transparent;
    }

    if selected || active-focus: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        background: active-focus ? OrbitTheme.row-focus : #FFFFFF14;
    }

    OrbitRing {
        x: 6px * TvUi.u;
        y: 6px * TvUi.u;
        size: circle-size;
        thickness: 5px * TvUi.u;
        lit-path: root.lit-path;
        unlit-path: root.unlit-path;
        lit-color: root.lit-color;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: self.width / 2;
            background: selected ? OrbitTheme.text : active-focus ? #464C59 : #3A3F4B;

            if has-logo: Image {
                source: logo;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width * (logo-tall ? 0.78 : 0.66);
                height: parent.height * (logo-tall ? 0.78 : 0.66);
                image-fit: contain;
            }

            if !has-logo: Text {
                text: count-text;
                font-family: OrbitTheme.font;
                font-size: circle-size * 0.30;
                font-weight: 600;
                color: selected ? OrbitTheme.bg : #E6E8EC;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    VerticalLayout {
        x: circle-size + 24px * TvUi.u;
        y: 0;
        width: max(0px, parent.width - circle-size - 40px * TvUi.u);
        height: parent.height;
        alignment: center;
        spacing: 4px * TvUi.u;

        Text {
            text: label;
            font-family: OrbitTheme.font;
            font-size: 21px * TvUi.u;
            font-weight: selected ? 700 : 600;
            color: OrbitTheme.text;
            overflow: elide;
        }
        if meta != "": Text {
            text: meta;
            font-family: OrbitTheme.font;
            font-size: 15px * TvUi.u;
            color: meta-color;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}

export component ClockBadgeContent inherits VerticalLayout {
    width: 100%;
    height: 100%;
    alignment: center;
    spacing: 4px * TvUi.u;

    Text {
        text: Dash.clock-hh + ":" + Dash.clock-mm;
        font-family: OrbitTheme.font;
        font-size: 34px * TvUi.u;
        font-weight: 300;
        color: OrbitTheme.text;
        horizontal-alignment: center;
    }
    Text {
        text: (Dash.clock-ampm != "" ? Dash.clock-ampm + " · " : "") + Dash.weather-temp;
        font-family: OrbitTheme.font;
        font-size: 13px * TvUi.u;
        color: OrbitTheme.sub;
        horizontal-alignment: center;
    }
}

// Library shelf rail row (Concept 2C): 108 px count circle + 21 px label, pill when selected.
export component OrbitRailRow inherits Rectangle {
    in property <string> title;
    in property <int> count: 0;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> focused: false;
    callback activated();
    callback hovered();

    property <bool> active-focus: enabled && (focused || ta.has-hover);

    width: 380px * TvUi.u;
    height: 116px * TvUi.u;
    opacity: enabled ? 1.0 : 0.5;
    background: transparent;

    if selected: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: 58px * TvUi.u;
        background: OrbitTheme.glass;
        border-width: 1px;
        border-color: OrbitTheme.glass-border;
    }

    // 108 px count circle
    Rectangle {
        x: 4px * TvUi.u;
        y: 4px * TvUi.u;
        width: 108px * TvUi.u;
        height: 108px * TvUi.u;
        border-radius: 54px * TvUi.u;
        background: selected ? OrbitTheme.text : OrbitTheme.glass;
        border-width: selected ? 0px : 1px;
        border-color: OrbitTheme.glass-border;

        if active-focus: Rectangle {
            x: -8px * TvUi.u;
            y: -8px * TvUi.u;
            width: parent.width + 16px * TvUi.u;
            height: parent.height + 16px * TvUi.u;
            border-radius: self.width / 2;
            border-width: 3px * TvUi.u;
            border-color: OrbitTheme.accent;
            background: transparent;
        }

        Text {
            text: root.count;
            font-family: OrbitTheme.font;
            font-size: 38px * TvUi.u;
            font-weight: 700;
            color: selected ? OrbitTheme.bg : (enabled ? OrbitTheme.text : OrbitTheme.sub);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 131px * TvUi.u;
        y: 0;
        width: parent.width - 147px * TvUi.u;
        height: parent.height;
        text: root.title;
        font-family: OrbitTheme.font;
        font-size: 21px * TvUi.u;
        font-weight: selected ? 700 : 600;
        color: selected ? OrbitTheme.text : OrbitTheme.sub;
        vertical-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.activated(); } }
        pointer-event(ev) => {
            if root.enabled && ev.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}
