import { Browse, Library, LibraryLanding, TvUi } from "../state.slint";
import { OrbitTheme } from "theme.slint";
import { OrbitPill, OrbitPlay, OrbitRow } from "controls.slint";
import { OrbitBrowse } from "browse.slint";

// Orbit Library page (§5):
// Sub-tabs (TV Series · Movies · Browse all + Watching now),
// Hero (x 110, y 230), Right curve (4 round posters 108px),
// Bottom dial (cx 960, cy 1780, r 950, 6 posters at 10.5° steps).
export component OrbitLibrary inherits Rectangle {
    in-out property <int> dial-idx: 0;
    in-out property <int> shelf-pair: 0;      // 0 = shelf2 (Start watching), 1 = shelf3 (Added/Popular)
    in-out property <int> focused-area: 0;       // 0=play, 1=show-page, 2..5=curve, 6=dial
    in-out property <int> last-dial-hover: -1;

    property <bool> is-movies: Library.media-tab == "movies";
    property <bool> is-browse: Library.browse-all;
    property <int> dial-count: shelf-pair == 0 ? LibraryLanding.shelf2.length : LibraryLanding.shelf3.length;
    property <int> safe-dial: dial-count > 0 ? Math.clamp(dial-idx, 0, dial-count - 1) : 0;

    // ── Sub-tabs (y 130) ─────────────────────────────────────────────────────
    HorizontalLayout {
        x: 110px * TvUi.u;
        y: 130px * TvUi.u;
        height: 46px * TvUi.u;
        spacing: 12px * TvUi.u;

        if is-browse: OrbitPill {
            label: Browse.library == "movies" ? "‹ Movies" : "‹ TV Series";
            activated => {
                Library.set-browse-all(false);
            }
        }
        OrbitPill {
            label: "Movies";
            primary: is-browse && Browse.library == "movies";
            selected: !is-browse && is-movies;
            activated => {
                if is-browse {
                    Browse.set-library("movies");
                } else {
                    Library.set-media-tab("movies");
                }
            }
        }
        OrbitPill {
            label: "TV Series";
            primary: is-browse && Browse.library != "movies";
            selected: !is-browse && !is-movies;
            activated => {
                if is-browse {
                    Browse.set-library("tv");
                } else {
                    Library.set-media-tab("tv");
                }
            }
        }
        OrbitPill {
            label: "Browse all";
            selected: is-browse;
            activated => {
                Library.set-browse-all(!Library.browse-all);
            }
        }
        if !is-browse && LibraryLanding.watching-now-count > 0: OrbitPill {
            label: "Watching now";
            badge: LibraryLanding.watching-now-count;
            accent-color: #30D158;
            selected: LibraryLanding.watching-now-open;
            activated => { LibraryLanding.open-watching-now(); }
        }
        if is-browse: Rectangle {
            width: 1px;
            height: 28px * TvUi.u;
            y: 9px * TvUi.u;
            background: OrbitTheme.glass-border;
        }
        if is-browse: OrbitPill {
            label: "Sort · " + Browse.sort-label;
            activated => { Browse.cycle-sort(); }
        }
    }

    // ── Main Landing View (Hero + Curve + Dial) ──────────────────────────────
    if !is-browse: Rectangle {
        width: parent.width;
        height: parent.height;

        // Hero (x 110, y 230, w 880)
        VerticalLayout {
            x: 110px * TvUi.u;
            y: 230px * TvUi.u;
            width: 880px * TvUi.u;
            alignment: start;
            spacing: 14px * TvUi.u;

            Text {
                text: LibraryLanding.focus.kicker != "" ? LibraryLanding.focus.kicker : (is-movies ? "MOVIES" : "TV SERIES");
                font-family: OrbitTheme.font;
                font-size: 17px * TvUi.u;
                font-weight: 600;
                letter-spacing: 2.5px * TvUi.u;
                color: OrbitTheme.accent;
                overflow: elide;
            }

            Text {
                text: LibraryLanding.focus.title != "" ? LibraryLanding.focus.title : "Library";
                font-family: OrbitTheme.font;
                font-size: 80px * TvUi.u;
                font-weight: 700;
                letter-spacing: -2px * TvUi.u;
                color: OrbitTheme.text;
                wrap: word-wrap;
                overflow: elide;
            }

            if LibraryLanding.focus.summary != "": Text {
                text: LibraryLanding.focus.summary;
                font-family: OrbitTheme.font;
                font-size: 19px * TvUi.u;
                color: OrbitTheme.sub;
                wrap: word-wrap;
                max-height: 86px * TvUi.u;
                overflow: elide;
            }

            Rectangle { height: 10px * TvUi.u; }

            HorizontalLayout {
                height: 104px * TvUi.u;
                spacing: 20px * TvUi.u;
                alignment: start;

                OrbitPlay {
                    lit-path: LibraryLanding.focus.ring-lit;
                    unlit-path: LibraryLanding.focus.ring-unlit;
                    focused: root.focused-area == 0;
                    activated => {
                        if LibraryLanding.focus.rating-key != "" {
                            if Library.media-tab == "tv" {
                                Library.play-key(LibraryLanding.focus.rating-key, true);
                            } else {
                                Library.open-movie(LibraryLanding.focus.rating-key);
                            }
                        }
                    }
                    hovered => { root.focused-area = 0; }
                }

                VerticalLayout {
                    height: 104px * TvUi.u;
                    alignment: center;
                    spacing: 4px * TvUi.u;
                    Text {
                        text: LibraryLanding.focus.play-label != "" ? LibraryLanding.focus.play-label : "Play";
                        font-family: OrbitTheme.font;
                        font-size: 22px * TvUi.u;
                        font-weight: 600;
                        color: OrbitTheme.text;
                    }
                    if LibraryLanding.focus.meta != "": Text {
                        text: LibraryLanding.focus.meta;
                        font-family: OrbitTheme.font;
                        font-size: 16px * TvUi.u;
                        color: OrbitTheme.sub;
                    }
                }

                if !is-movies && LibraryLanding.focus.rating-key != "": VerticalLayout {
                    height: 104px * TvUi.u;
                    alignment: center;
                    OrbitPill {
                        label: "Show page";
                        focused: root.focused-area == 1;
                        activated => { Library.open-show(LibraryLanding.focus.rating-key); }
                        hovered => { root.focused-area = 1; }
                    }
                }
            }
        }

        // Right Curve (Finish the season / Continue watching)
        // Label in a glass pill (same as the hover labels) so the art behind it can't wash it
        // out. Text starts at x 1210 as before; the pill adds 16 px padding each side.
        Rectangle {
            x: 1210px * TvUi.u - 16px * TvUi.u;
            y: 180px * TvUi.u;
            width: shelf-label.preferred-width + 32px * TvUi.u;
            height: 36px * TvUi.u;
            border-radius: self.height / 2;
            background: OrbitTheme.glass;
            border-width: 1px;
            border-color: OrbitTheme.glass-border;

            shelf-label := Text {
                width: parent.width;
                height: parent.height;
                text: LibraryLanding.shelf1-title != "" ? LibraryLanding.shelf1-title : "FINISH THE SEASON";
                font-family: OrbitTheme.font;
                font-size: 15px * TvUi.u;
                font-weight: 700;
                letter-spacing: 2.5px * TvUi.u;
                // Accent, like the hero's time-remaining kicker.
                color: OrbitTheme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        for item[i] in LibraryLanding.shelf1: lib-curve := Rectangle {
            visible: i < 4;
            property <length> indent: (i == 0 ? 130px : i == 1 ? 70px : i == 2 ? 36px : 24px) * TvUi.u;
            property <bool> is-foc: (root.focused-area == 2 + i) || curve-ta.has-hover;

            x: 1180px * TvUi.u + self.indent;
            y: (230px + i * 124px) * TvUi.u;
            // Runs to x 1840 like Home's Up next rows.
            width: 1840px * TvUi.u - self.x;
            height: 112px * TvUi.u;

            if lib-curve.is-foc: Rectangle {
                x: -9px * TvUi.u;
                y: -7px * TvUi.u;
                width: parent.width + 18px * TvUi.u;
                height: parent.height + 14px * TvUi.u;
                border-radius: self.height / 2;
                border-width: 4px * TvUi.u;
                border-color: OrbitTheme.text;
            }

            // Glass pill behind every row (as on Home), darker when focused, so titles and
            // time left stay readable over the art.
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: self.height / 2;
                background: lib-curve.is-foc ? #1A202CD9 : OrbitTheme.glass;
            }

            Rectangle {
                x: 2px * TvUi.u;
                y: 2px * TvUi.u;
                width: 108px * TvUi.u;
                height: 108px * TvUi.u;
                border-radius: self.width / 2;
                border-width: 4px * TvUi.u;
                border-color: item.progress > 0.0 ? OrbitTheme.accent : OrbitTheme.track;
                clip: true;

                if item.has-art: Image {
                    source: item.art;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
            }

            VerticalLayout {
                x: 128px * TvUi.u;
                y: 0;
                width: parent.width - 144px * TvUi.u;
                height: parent.height;
                alignment: center;
                spacing: 4px * TvUi.u;

                Text {
                    text: item.title;
                    font-family: OrbitTheme.font;
                    font-size: 21px * TvUi.u;
                    font-weight: 600;
                    color: OrbitTheme.text;
                    overflow: elide;
                }
                Text {
                    text: item.right-label;
                    font-family: OrbitTheme.font;
                    font-size: 16px * TvUi.u;
                    color: OrbitTheme.sub;
                    overflow: elide;
                }
            }

            curve-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if is-movies {
                        Library.open-movie(item.rating-key);
                    } else {
                        Library.open-show(item.rating-key);
                    }
                }
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.move && root.focused-area != 2 + i {
                        root.focused-area = 2 + i;
                        root.last-dial-hover = -1;
                        LibraryLanding.focus-changed(4 + i);
                    }
                }
            }
        }

        // Bottom Dial (Start watching / Next shelf pair)
        Text {
            x: (parent.width - 700px * TvUi.u) / 2;
            y: 700px * TvUi.u;
            width: 700px * TvUi.u;
            text: shelf-pair == 0 ? LibraryLanding.shelf2-title : LibraryLanding.shelf3-title;
            font-family: OrbitTheme.font;
            font-size: 15px * TvUi.u;
            font-weight: 600;
            letter-spacing: 2.5px * TvUi.u;
            color: OrbitTheme.sub;
            horizontal-alignment: center;
        }

        for slot in [-2, -1, 0, 1, 2, 3]: lib-dial-node := Rectangle {
            visible: dial-count > 0;
            property <int> idx: dial-count > 0 ? Math.mod(safe-dial + slot + dial-count * 4, dial-count) : 0;
            property <bool> is-top: slot == 0;
            property <bool> is-foc: (self.is-top && root.focused-area == 6) || lib-dial-ta.has-hover;
            property <length> node-sz: (self.is-top ? 160px : self.is-foc ? 140px : 120px) * TvUi.u;
            property <angle> ang: slot * 10.5deg - 90deg;
            property <length> cx: parent.width / 2 + 950px * TvUi.u * Math.cos(self.ang);
            property <length> cy: 1780px * TvUi.u + 950px * TvUi.u * Math.sin(self.ang);

            x: self.cx - self.node-sz / 2;
            y: self.cy - self.node-sz / 2;
            width: self.node-sz;
            height: self.node-sz;
            animate width, height { duration: 150ms; easing: ease-out; }

            if lib-dial-node.is-foc: Rectangle {
                x: -9px * TvUi.u;
                y: -9px * TvUi.u;
                width: parent.width + 18px * TvUi.u;
                height: parent.height + 18px * TvUi.u;
                border-radius: self.width / 2;
                border-width: 4px * TvUi.u;
                border-color: OrbitTheme.text;
            }

            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: self.width / 2;
                background: OrbitTheme.glass;
                clip: true;

                if shelf-pair == 0 && LibraryLanding.shelf2[lib-dial-node.idx].has-poster: Image {
                    source: LibraryLanding.shelf2[lib-dial-node.idx].poster;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
                if shelf-pair == 1 && LibraryLanding.shelf3[lib-dial-node.idx].has-poster: Image {
                    source: LibraryLanding.shelf3[lib-dial-node.idx].poster;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
            }

            // Rank badge (40px accent circle)
            Rectangle {
                x: parent.width - 36px * TvUi.u;
                y: -4px * TvUi.u;
                width: 40px * TvUi.u;
                height: 40px * TvUi.u;
                border-radius: self.width / 2;
                background: OrbitTheme.accent;

                Text {
                    text: lib-dial-node.idx + 1;
                    font-family: OrbitTheme.font;
                    font-size: 16px * TvUi.u;
                    font-weight: 700;
                    color: OrbitTheme.bg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            lib-dial-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if is-movies {
                        Library.open-movie(shelf-pair == 0 ? LibraryLanding.shelf2[lib-dial-node.idx].rating-key : LibraryLanding.shelf3[lib-dial-node.idx].rating-key);
                    } else {
                        Library.open-show(shelf-pair == 0 ? LibraryLanding.shelf2[lib-dial-node.idx].rating-key : LibraryLanding.shelf3[lib-dial-node.idx].rating-key);
                    }
                }
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.move && (root.focused-area != 6 || root.last-dial-hover != lib-dial-node.idx) {
                        root.focused-area = 6;
                        root.last-dial-hover = lib-dial-node.idx;
                        LibraryLanding.focus-changed(
                            4 + LibraryLanding.shelf1.length + (shelf-pair == 0 ? lib-dial-node.idx : LibraryLanding.shelf2.length + lib-dial-node.idx)
                        );
                    }
                }
            }
        }
    }

    // ── Browse All (letter rail + 6-across OrbitRing grid) ──────────────────
    if is-browse: OrbitBrowse {
        width: parent.width;
        height: parent.height;
    }
}
