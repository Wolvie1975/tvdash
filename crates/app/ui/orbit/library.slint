import { Browse, Library, LibraryLanding, TvUi } from "../state.slint";
import { OrbitTheme } from "theme.slint";
import { OrbitPill, OrbitPlay, OrbitRailRow } from "controls.slint";
import { OrbitRing } from "ring.slint";
import { OrbitBrowse } from "browse.slint";

// Orbit Library page (Concept 2C):
// Sub-tabs (Movies · TV Series · Browse all + Watching now),
// Left Shelf rail (3 rows), Center 3x2 poster grid, Right detail card.
export component OrbitLibrary inherits Rectangle {
    property <bool> is-movies: Library.media-tab == "movies";
    property <bool> is-browse: Library.browse-all;

    // Count enabled rail shelves before a given shelf index (matches compacted tv_nav rects).
    function rail-rect-idx(i: int) -> int {
        return 4
            + (i > 0 && LibraryLanding.rail.length > 0 && LibraryLanding.rail[0].enabled ? 1 : 0)
            + (i > 1 && LibraryLanding.rail.length > 1 && LibraryLanding.rail[1].enabled ? 1 : 0);
    }

    property <int> enabled-rail-count:
        (LibraryLanding.rail.length > 0 && LibraryLanding.rail[0].enabled ? 1 : 0)
        + (LibraryLanding.rail.length > 1 && LibraryLanding.rail[1].enabled ? 1 : 0)
        + (LibraryLanding.rail.length > 2 && LibraryLanding.rail[2].enabled ? 1 : 0);
    property <int> grid-base-idx: 4 + enabled-rail-count;
    property <int> card-play-idx: grid-base-idx + LibraryLanding.grid.length;

    // ── Sub-tabs (y 130) ─────────────────────────────────────────────────────
    HorizontalLayout {
        x: 110px * TvUi.u;
        y: 130px * TvUi.u;
        height: 46px * TvUi.u;
        spacing: 12px * TvUi.u;

        if is-browse: OrbitPill {
            label: Browse.library == "movies" ? "‹ Movies" : "‹ TV Series";
            activated => {
                Library.set-browse-all(false);
            }
        }
        OrbitPill {
            label: "Movies";
            primary: is-browse && Browse.library == "movies";
            selected: !is-browse && is-movies;
            activated => {
                if is-browse {
                    Browse.set-library("movies");
                } else {
                    Library.set-media-tab("movies");
                }
            }
        }
        OrbitPill {
            label: "TV Series";
            primary: is-browse && Browse.library != "movies";
            selected: !is-browse && !is-movies;
            activated => {
                if is-browse {
                    Browse.set-library("tv");
                } else {
                    Library.set-media-tab("tv");
                }
            }
        }
        OrbitPill {
            label: "Browse all";
            selected: is-browse;
            activated => {
                Library.set-browse-all(!Library.browse-all);
            }
        }
        if !is-browse && LibraryLanding.watching-now-count > 0: OrbitPill {
            label: "Watching now";
            badge: LibraryLanding.watching-now-count;
            accent-color: #30D158;
            selected: LibraryLanding.watching-now-open;
            activated => { LibraryLanding.open-watching-now(); }
        }
        if is-browse: Rectangle {
            width: 1px;
            height: 28px * TvUi.u;
            y: 9px * TvUi.u;
            background: OrbitTheme.glass-border;
        }
        if is-browse: OrbitPill {
            label: "Sort · " + Browse.sort-label;
            activated => { Browse.cycle-sort(); }
        }
    }

    // ── Main Landing View (Shelf rail + 3x2 Grid + Detail card) ──────────────
    if !is-browse: Rectangle {
        width: parent.width;
        height: parent.height;

        // 1. Shelf rail (x 110, y 220, 3 rows of 116 px + 14 px gaps)
        for shelf[i] in LibraryLanding.rail: OrbitRailRow {
            x: 110px * TvUi.u;
            y: (220px + i * 130px) * TvUi.u;
            title: shelf.title;
            count: shelf.count;
            enabled: shelf.enabled;
            selected: LibraryLanding.rail-idx == i;
            focused: !TvUi.bar-focused && shelf.enabled && TvUi.focused-tile == root.rail-rect-idx(i);
            hovered => {
                if shelf.enabled {
                    LibraryLanding.rail-selected(i);
                }
            }
            activated => {
                if shelf.enabled {
                    LibraryLanding.rail-selected(i);
                }
            }
        }

        // 2. Grid header (x 520, y 192)
        Text {
            x: 520px * TvUi.u;
            y: 192px * TvUi.u;
            width: 760px * TvUi.u;
            text: LibraryLanding.grid-header;
            font-family: OrbitTheme.font;
            font-size: 16px * TvUi.u;
            font-weight: 600;
            letter-spacing: 3px * TvUi.u;
            color: OrbitTheme.accent;
            overflow: elide;
        }

        // Empty state when all shelves are empty
        if LibraryLanding.grid.length == 0: Text {
            x: 520px * TvUi.u;
            y: 260px * TvUi.u;
            text: "Nothing here yet";
            font-family: OrbitTheme.font;
            font-size: 24px * TvUi.u;
            font-weight: 500;
            color: OrbitTheme.sub;
        }

        // 3x2 poster grid (x 520, y 242, w 760, 260 col step, 296 row step)
        for item[i] in LibraryLanding.grid: Rectangle {
            property <int> grid-col: Math.mod(i, 3);
            property <int> grid-row: Math.floor(i / 3);
            property <bool> is-foc: (!TvUi.bar-focused && TvUi.focused-tile == root.grid-base-idx + i) || cell-ta.has-hover;
            property <length> ring-size: is-foc ? 210px * TvUi.u : 190px * TvUi.u;

            x: (520px + grid-col * 260px) * TvUi.u;
            y: (242px + grid-row * 296px) * TvUi.u;
            width: 240px * TvUi.u;
            height: 270px * TvUi.u;
            background: transparent;

            // Focus ring (4 px text + 5 px bg gap)
            if is-foc: Rectangle {
                x: (parent.width - (ring-size + 18px * TvUi.u)) / 2;
                y: -9px * TvUi.u - (ring-size - 190px * TvUi.u) / 2;
                width: ring-size + 18px * TvUi.u;
                height: ring-size + 18px * TvUi.u;
                border-radius: self.width / 2;
                border-width: 4px * TvUi.u;
                border-color: OrbitTheme.text;
                background: OrbitTheme.bg;
            }

            OrbitRing {
                x: (parent.width - ring-size) / 2;
                y: -(ring-size - 190px * TvUi.u) / 2;
                size: ring-size;
                viewbox-size: 104;
                thickness: 6px * TvUi.u;
                lit-path: item.ring-lit;
                unlit-path: item.ring-unlit;
                lit-color: OrbitTheme.accent;

                if item.has-poster: Image {
                    width: parent.width;
                    height: parent.height;
                    source: item.poster;
                    image-fit: cover;
                }

                if !item.has-poster: Text {
                    width: parent.width - 24px * TvUi.u;
                    height: parent.height;
                    x: 12px * TvUi.u;
                    text: item.title;
                    font-family: OrbitTheme.font;
                    font-size: 17px * TvUi.u;
                    font-weight: 600;
                    color: OrbitTheme.sub;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            // 1–6 rank badge for Start Watching
            if item.badge > 0: Rectangle {
                x: (parent.width - ring-size) / 2 + 4px * TvUi.u;
                y: -(ring-size - 190px * TvUi.u) / 2 + 4px * TvUi.u;
                width: 34px * TvUi.u;
                height: 34px * TvUi.u;
                border-radius: 17px * TvUi.u;
                background: OrbitTheme.accent;

                Text {
                    text: item.badge;
                    font-family: OrbitTheme.font;
                    font-size: 15px * TvUi.u;
                    font-weight: 700;
                    color: OrbitTheme.bg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                x: 5px * TvUi.u;
                y: 218px * TvUi.u;
                width: 230px * TvUi.u;
                text: item.title;
                font-family: OrbitTheme.font;
                font-size: 19px * TvUi.u;
                font-weight: 600;
                color: OrbitTheme.text;
                horizontal-alignment: center;
                overflow: elide;
            }

            Text {
                x: 5px * TvUi.u;
                y: 244px * TvUi.u;
                width: 230px * TvUi.u;
                text: item.meta;
                font-family: OrbitTheme.font;
                font-size: 15px * TvUi.u;
                color: OrbitTheme.sub;
                horizontal-alignment: center;
                overflow: elide;
            }

            cell-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { LibraryLanding.grid-activated(i); }
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.move && TvUi.focused-tile != root.grid-base-idx + i {
                        TvUi.tile-hovered(root.grid-base-idx + i);
                    }
                }
            }
        }

        // 3. Detail card (x 1340 -> right 70, y 200, h 760)
        Rectangle {
            x: 1340px * TvUi.u;
            y: 200px * TvUi.u;
            width: root.width - 1410px * TvUi.u;
            height: 760px * TvUi.u;
            border-radius: 44px * TvUi.u;
            background: OrbitTheme.glass;
            border-width: 1px;
            border-color: OrbitTheme.glass-border;

            // Round poster (180 px)
            OrbitRing {
                x: 36px * TvUi.u;
                y: 36px * TvUi.u;
                size: 180px * TvUi.u;
                thickness: 0px;

                if LibraryLanding.focus.has-poster: Image {
                    width: parent.width;
                    height: parent.height;
                    source: LibraryLanding.focus.poster;
                    image-fit: cover;
                }
            }

            VerticalLayout {
                x: 36px * TvUi.u;
                y: 232px * TvUi.u;
                width: parent.width - 72px * TvUi.u;
                spacing: 8px * TvUi.u;
                alignment: start;

                Text {
                    text: LibraryLanding.focus.kicker != "" ? LibraryLanding.focus.kicker : (is-movies ? "MOVIES" : "TV SERIES");
                    font-family: OrbitTheme.font;
                    font-size: 15px * TvUi.u;
                    font-weight: 600;
                    letter-spacing: 2px * TvUi.u;
                    color: OrbitTheme.accent;
                    overflow: elide;
                }

                Text {
                    text: LibraryLanding.focus.title != "" ? LibraryLanding.focus.title : "Library";
                    font-family: OrbitTheme.font;
                    font-size: 42px * TvUi.u;
                    font-weight: 700;
                    letter-spacing: -1px * TvUi.u;
                    color: OrbitTheme.text;
                    wrap: word-wrap;
                    max-height: 108px * TvUi.u;
                    overflow: elide;
                }

                Text {
                    text: LibraryLanding.focus.meta;
                    font-family: OrbitTheme.font;
                    font-size: 17px * TvUi.u;
                    color: OrbitTheme.sub;
                    overflow: elide;
                }

                // 5 lines reserved (130 px) so nothing jumps
                Text {
                    height: 130px * TvUi.u;
                    text: LibraryLanding.focus.summary;
                    font-family: OrbitTheme.font;
                    font-size: 17px * TvUi.u;
                    color: OrbitTheme.sub;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            // Pinned to bottom: OrbitPlay 84 px + play label + sub-line
            HorizontalLayout {
                x: 36px * TvUi.u;
                y: parent.height - 32px * TvUi.u - 84px * TvUi.u;
                width: parent.width - 72px * TvUi.u;
                height: 84px * TvUi.u;
                spacing: 18px * TvUi.u;
                alignment: start;

                OrbitPlay {
                    size: 84px * TvUi.u;
                    lit-path: LibraryLanding.focus.ring-lit;
                    unlit-path: LibraryLanding.focus.ring-unlit;
                    focused: !TvUi.bar-focused && LibraryLanding.grid.length > 0 && TvUi.focused-tile == root.card-play-idx;
                    activated => {
                        if LibraryLanding.focus.rating-key != "" {
                            if is-movies {
                                Library.play-key(LibraryLanding.focus.rating-key, true);
                            } else {
                                Library.play-key(LibraryLanding.focus.rating-key, false);
                            }
                        }
                    }
                    hovered => {
                        if LibraryLanding.grid.length > 0 {
                            TvUi.tile-hovered(root.card-play-idx);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px * TvUi.u;
                    horizontal-stretch: 1;

                    Text {
                        text: LibraryLanding.focus.play-label != "" ? LibraryLanding.focus.play-label : "Play";
                        font-family: OrbitTheme.font;
                        font-size: 20px * TvUi.u;
                        font-weight: 600;
                        color: OrbitTheme.text;
                        overflow: elide;
                    }

                    if LibraryLanding.focus.sub-line != "": Text {
                        text: LibraryLanding.focus.sub-line;
                        font-family: OrbitTheme.font;
                        font-size: 14px * TvUi.u;
                        color: OrbitTheme.sub;
                        overflow: elide;
                    }
                }
            }
        }

        // Bottom hint
        Text {
            x: 520px * TvUi.u;
            y: parent.height - 40px * TvUi.u - self.height;
            text: "↑ ↓ shelves · → into the grid · → again to the card · Browse all stays in the sub-tabs";
            font-family: OrbitTheme.font;
            font-size: 15px * TvUi.u;
            color: OrbitTheme.muted;
        }
    }

    // ── Browse All (letter rail + 6-across OrbitRing grid) ──────────────────
    if is-browse: OrbitBrowse {
        width: parent.width;
        height: parent.height;
    }
}
