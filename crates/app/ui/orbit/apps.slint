import { AppsPage, HomeState, TvUi } from "../state.slint";
import { OrbitTheme } from "theme.slint";
import { OrbitPill } from "controls.slint";

// Orbit Apps clock face (§4):
// Centre (960, 590), r 380, outer guide ring 760, inner disc 500 glass.
// Apps clockwise from 12 o'clock; 124px (96px if N > 16); focused 176px + focus ring.
export component OrbitApps inherits Rectangle {
    in-out property <int> focused-idx: 0;

    property <int> count: Math.max(1, AppsPage.apps.length);
    property <int> safe-idx: Math.clamp(focused-idx, 0, count - 1);
    property <bool> has-apps: AppsPage.apps.length > 0;
    property <length> node-base: AppsPage.apps.length > 16 ? 96px * TvUi.u : 124px * TvUi.u;
    property <angle> hand-angle: (safe-idx * 360deg / count) - 90deg;
    property <length> clock-cx: root.width / 2;
    property <length> clock-cy: (root.height + 80px * TvUi.u) / 2;

    // Neutral glow + faint glow in focused app's text-color
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @radial-gradient(circle, #2B2F3A 0%, #2B313D00 70%);
    }
    if has-apps: Rectangle {
        width: parent.width;
        height: parent.height;
        background: @radial-gradient(circle, AppsPage.apps[safe-idx].text-color 0%, #2B313D00 60%);
        opacity: 0.20;
    }

    // Left title + 2-line hint
    VerticalLayout {
        x: 110px * TvUi.u;
        y: 230px * TvUi.u;
        width: 340px * TvUi.u;
        alignment: start;
        spacing: 12px * TvUi.u;

        Text {
            text: "Apps";
            font-family: OrbitTheme.font;
            font-size: 56px * TvUi.u;
            font-weight: 700;
            color: OrbitTheme.text;
        }
        Text {
            text: "Turn the clock face with ← → or ↑ ↓.\nPress OK to launch full screen.";
            font-family: OrbitTheme.font;
            font-size: 18px * TvUi.u;
            color: OrbitTheme.sub;
            wrap: word-wrap;
        }
    }

    // Outer guide ring (760px)
    Rectangle {
        x: root.clock-cx - 380px * TvUi.u;
        y: root.clock-cy - 380px * TvUi.u;
        width: 760px * TvUi.u;
        height: 760px * TvUi.u;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: #FFFFFF24;
        background: transparent;
    }

    // Inner glass disc (500px)
    Rectangle {
        x: root.clock-cx - 250px * TvUi.u;
        y: root.clock-cy - 250px * TvUi.u;
        width: 500px * TvUi.u;
        height: 500px * TvUi.u;
        border-radius: self.width / 2;
        background: OrbitTheme.glass;
        border-width: 1px;
        border-color: OrbitTheme.glass-border;

        // Centre readout
        VerticalLayout {
            width: parent.width - 64px * TvUi.u;
            height: parent.height;
            x: 32px * TvUi.u;
            alignment: center;
            spacing: 10px * TvUi.u;

            Text {
                text: "APPS · " + AppsPage.apps.length;
                font-family: OrbitTheme.font;
                font-size: 16px * TvUi.u;
                font-weight: 600;
                letter-spacing: 2.5px * TvUi.u;
                color: OrbitTheme.muted;
                horizontal-alignment: center;
            }
            if has-apps: Text {
                text: AppsPage.apps[safe-idx].name;
                font-family: OrbitTheme.font;
                font-size: 56px * TvUi.u;
                font-weight: 700;
                color: OrbitTheme.text;
                horizontal-alignment: center;
                overflow: elide;
            }
            if has-apps: HorizontalLayout {
                alignment: center;
                padding-top: 8px * TvUi.u;
                OrbitPill {
                    label: "OK · Open";
                    primary: true;
                    activated => { HomeState.launch-app(AppsPage.apps[safe-idx].id); }
                }
            }
        }
    }

    // Clock hand: 8px accent dot/segment on r 287 (outer 50px: r 262 -> 312)
    if has-apps: Rectangle {
        property <length> hx: root.clock-cx + 287px * TvUi.u * Math.cos(hand-angle);
        property <length> hy: root.clock-cy + 287px * TvUi.u * Math.sin(hand-angle);
        x: self.hx - 10px * TvUi.u;
        y: self.hy - 10px * TvUi.u;
        width: 20px * TvUi.u;
        height: 20px * TvUi.u;
        border-radius: self.width / 2;
        background: OrbitTheme.accent;
        animate x, y { duration: 220ms; easing: ease-out; }
    }

    // App circles around the clock face
    for app[i] in AppsPage.apps: app-node := Rectangle {
        property <bool> is-foc: (root.safe-idx == i) || app-ta.has-hover;
        property <length> sz: self.is-foc ? 154px * TvUi.u : root.node-base;
        property <angle> ang: (i * 360deg / count) - 90deg;
        property <length> cx: root.clock-cx + 380px * TvUi.u * Math.cos(self.ang);
        property <length> cy: root.clock-cy + 380px * TvUi.u * Math.sin(self.ang);

        x: self.cx - self.sz / 2;
        y: self.cy - self.sz / 2;
        width: self.sz;
        height: self.sz;
        animate width, height { duration: 150ms; easing: ease-out; }

        if app-node.is-foc: Rectangle {
            x: -9px * TvUi.u;
            y: -9px * TvUi.u;
            width: parent.width + 18px * TvUi.u;
            height: parent.height + 18px * TvUi.u;
            border-radius: self.width / 2;
            border-width: 4px * TvUi.u;
            border-color: OrbitTheme.text;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: self.width / 2;
            background: app.color;
            clip: true;

            if app.has-logo: Image {
                source: app.logo;
                width: parent.width * 0.68;
                height: parent.height * 0.60;
                image-fit: contain;
            }
            if !app.has-logo: Text {
                text: app.name;
                font-family: OrbitTheme.font;
                font-size: (app-node.is-foc ? 22px : 16px) * TvUi.u;
                font-weight: 800;
                color: app.text-color;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        app-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { HomeState.launch-app(app.id); }
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.move {
                    root.focused-idx = i;
                }
            }
        }
    }
}
