import { OrbitTheme } from "theme.slint";
import { TvUi } from "../state.slint";
import { ClockBadgeContent } from "controls.slint";

export struct OrbitRingState {
    d: float,
    opacity: float,
}

export global OrbitIntro {
    in property <[OrbitRingState]> rings;
    in property <float> word-opacity;
    in property <float> word-scale: 1;
    in property <float> bg-opacity: 1;
    in property <float> trav-x;
    in property <float> trav-y;
    in property <float> trav-d;
    in property <float> trav-opacity;
    in property <float> land;
    in property <float> echo-d;
    in property <float> echo-opacity;
}

component Circle inherits Rectangle {
    in property <float> cx;
    in property <float> cy;
    in property <float> d;
    width: d * TvUi.u * 1px;
    height: self.width;
    x: cx * TvUi.u * 1px - self.width / 2;
    y: cy * TvUi.u * 1px - self.height / 2;
    border-radius: self.width / 2;
}

export component OrbitIntroLayer inherits Rectangle {
    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        background: OrbitTheme.bg;
        opacity: OrbitIntro.bg-opacity;
    }

    for r in OrbitIntro.rings: Circle {
        cx: 960;
        cy: 540;
        d: r.d;
        border-width: 3px * TvUi.u;
        border-color: OrbitTheme.accent;
        opacity: r.opacity;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        opacity: OrbitIntro.word-opacity;

        Text {
            text: "tvdash";
            horizontal-alignment: center;
            color: OrbitTheme.text;
            font-family: OrbitTheme.font;
            font-weight: 700;
            letter-spacing: -2px * TvUi.u;
            font-size: 104px * TvUi.u * OrbitIntro.word-scale;
        }
        Text {
            text: "ORBIT";
            horizontal-alignment: center;
            color: OrbitTheme.accent;
            font-family: OrbitTheme.font;
            font-weight: 600;
            letter-spacing: 6px * TvUi.u;
            font-size: 18px * TvUi.u * OrbitIntro.word-scale;
        }
    }

    // Traveller → clock badge. Two stacked borders instead of a colour mix.
    Circle {
        cx: OrbitIntro.trav-x;
        cy: OrbitIntro.trav-y;
        d: OrbitIntro.trav-d;
        opacity: OrbitIntro.trav-opacity;

        Rectangle {
            width: 100%;
            height: 100%;
            background: OrbitTheme.glass;
            border-radius: parent.width / 2;
            opacity: OrbitIntro.land;
        }
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.width / 2;
            border-width: 4px * TvUi.u;
            border-color: OrbitTheme.accent;
            opacity: 1 - OrbitIntro.land;
        }
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.width / 2;
            border-width: 1px * TvUi.u;
            border-color: #FFFFFF1A;
            opacity: OrbitIntro.land;
        }
        ClockBadgeContent {
            opacity: OrbitIntro.land;
        }
    }

    Circle {
        cx: 1768;
        cy: 102;
        d: OrbitIntro.echo-d;
        border-width: 3px * TvUi.u;
        border-color: OrbitTheme.accent;
        opacity: OrbitIntro.echo-opacity;
    }
}
