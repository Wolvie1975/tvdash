import { Theme } from "../theme.slint";

// Visual tokens for the Orbit Dashboard UI (§1.1).
export global OrbitTheme {
    out property <string> font: Theme.font;

    out property <color> bg: #07070A;
    out property <color> text: #EEF1F4;
    out property <color> sub: #B7BEC7;
    out property <color> muted: #8E95A0;
    out property <color> accent: Theme.accent;
    out property <color> collections-accent: #F2C66B;
    out property <color> search-accent: #7EE0B0;
    out property <color> live: #FF6B6B;

    out property <color> glass: #0B0A12B3;
    out property <color> glass-border: #FFFFFF1A;
    out property <color> row: #0D1017CC;
    out property <color> row-border: #FFFFFF14;
    out property <color> row-focus: #FFFFFF1F;
    out property <color> row-focus-border: #FFFFFF55;
    out property <color> track: #FFFFFF2E;
    out property <color> unwatched: #1A1624;

    out property <brush> fade: @linear-gradient(180deg, #07070A00 0%, #07070AFF 100%);
    out property <brush> scrim-left: @linear-gradient(90deg, #07070AF0 0%, #07070AA6 38%, #07070A00 66%);
    out property <brush> scrim-bottom: @linear-gradient(180deg, #07070A00 45%, #07070ACC 75%, #07070AFF 100%);
}
