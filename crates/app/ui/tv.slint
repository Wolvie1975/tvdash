import { Theme } from "theme.slint";
import { Clock } from "components.slint";
import { SleepWarning } from "shared/sleep.slint";
import { SportsAlertCard } from "shared/sports_alert.slint";
import { SportsAlertState, TvUi } from "state.slint";

// TV (HDMI) window. No input — everything is driven from the laptop.
export component TvWindow inherits Window {
    title: "tvdash — TV";
    background: Theme.bg-night;
    default-font-family: Theme.font;
    preferred-width: 1920px;
    preferred-height: 1080px;

    in property <string> clock-hh: "--";
    in property <string> clock-mm: "--";
    in property <string> clock-ss: "--";
    in property <bool> show-seconds: false;
    in property <string> date-text;
    // Replaces "Ready…" while something is starting ("Opening Netflix…").
    in property <string> message;
    in property <image> video;
    in property <bool> video-on: false;

    // Burn-in protection: the idle screen drifts a few pixels every few minutes.
    property <int> shift-step: 0;
    property <[{x: length, y: length}]> shifts: [
        { x: 0px, y: 0px }, { x: 6px, y: -4px }, { x: -5px, y: 5px }, { x: 4px, y: 7px },
        { x: -7px, y: -3px }, { x: 2px, y: -7px }, { x: -3px, y: 3px }, { x: 7px, y: 2px },
    ];
    Timer {
        interval: 180s;
        running: true;
        triggered => { root.shift-step = Math.mod(root.shift-step + 1, root.shifts.length); }
    }

    // ── Idle screen: dim, low-contrast, calm ─────────────────────
    VerticalLayout {
        x: root.shifts[root.shift-step].x;
        y: root.shifts[root.shift-step].y;
        width: root.width;
        height: root.height;
        animate x, y { duration: 2s; easing: ease-in-out; }
        alignment: center;
        spacing: 24px;

        HorizontalLayout {
            alignment: center;
            Clock {
                hh: root.clock-hh;
                mm: root.clock-mm;
                ss: root.clock-ss;
                show-seconds: root.show-seconds;
                font-px: Theme.tv-clock-size;
                tint: Theme.text-secondary.with-alpha(0.55);
                weight: 300;
            }
        }
        Text {
            text: root.date-text;
            horizontal-alignment: center;
            font-size: Theme.tv-body-size;
            color: Theme.text-muted.with-alpha(0.6);
        }
        Rectangle { height: 48px; }
        Text {
            text: root.message != "" ? root.message : "Ready — pick something on the laptop";
            animate color { duration: 400ms; }
            horizontal-alignment: center;
            font-size: Theme.tv-body-size;
            color: Theme.text-muted.with-alpha(0.5);
        }
    }

    // ── In-window video when playing in two-screen mode ──────────────
    if root.video-on: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;

        Image {
            source: root.video;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }
    }

    SleepWarning {
        x: parent.width - self.width - 48px;
        y: parent.height - self.height - 48px;
    }

    SportsAlertCard {
        x: parent.width - self.width - 96px - (SportsAlertState.visible ? 0px : -24px);
        y: parent.height - self.height - (TvUi.hud-open ? 250px : 120px);
        animate x { duration: 180ms; easing: ease-out; }
    }
}
