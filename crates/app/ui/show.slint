import { Theme } from "theme.slint";
import { ActionButton, Card, PageHeader, ProgressBar, SectionLabel } from "components.slint";
import { ShowPageState } from "state.slint";

export component ShowPage inherits Rectangle {
    background: Theme.bg;
    property <bool> season-picker-open: false;

    VerticalLayout {
        padding-left: 64px;
        padding-right: 64px;
        padding-top: 28px;
        padding-bottom: 40px;
        spacing: Theme.gap;

        PageHeader {
            title: "TV / Series › " + ShowPageState.title;
            back => { ShowPageState.close(); }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            // Left 4 cols: poster-tinted hero
            Rectangle {
                width: 440px;
                border-radius: Theme.radius;
                background: ShowPageState.tint.card;
                border-width: 1px;
                border-color: ShowPageState.tint.edge;
                VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    alignment: start;

                    Text {
                        text: "TV SERIES · PLEX";
                        font-size: 16px;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                        color: ShowPageState.tint.accent;
                    }
                    Text {
                        text: ShowPageState.title;
                        font-size: 44px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    if ShowPageState.meta != "": Text {
                        text: ShowPageState.meta;
                        font-size: 18px;
                        color: ShowPageState.tint.sec;
                        wrap: word-wrap;
                    }
                    if ShowPageState.summary != "": Text {
                        text: ShowPageState.summary;
                        font-size: Theme.body-size;
                        color: ShowPageState.tint.sec;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    if ShowPageState.up-next != "": Text {
                        text: "Up next: " + ShowPageState.up-next;
                        font-size: 18px;
                        font-weight: 600;
                        color: ShowPageState.tint.accent;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    if ShowPageState.up-next-key != "": ActionButton {
                        height: 72px;
                        text: ShowPageState.can-resume ? "Resume on TV" : "Play next on TV";
                        icon: "play";
                        primary: true;
                        fill: ShowPageState.tint.accent;
                        ink: ShowPageState.tint.on-accent;
                        clicked => { ShowPageState.play-episode(ShowPageState.up-next-key, ShowPageState.can-resume); }
                    }
                    ActionButton {
                        text: "Play from start";
                        clicked => { ShowPageState.play-from-start(); }
                    }
                    ActionButton {
                        text: "Shuffle episodes";
                        clicked => { ShowPageState.shuffle(); }
                    }
                }
            }

            // Right 8 cols: season selector + episodes
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    // 1–6 seasons: full tabs
                    if ShowPageState.seasons.length <= 6: HorizontalLayout {
                        spacing: 10px;
                        for s in ShowPageState.seasons: Rectangle {
                            min-height: 56px;
                            horizontal-stretch: 1;
                            border-radius: 12px;
                            background: s.rating-key == ShowPageState.selected-season ? Theme.text-primary : Theme.surface-raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: s.title;
                                    font-size: 18px;
                                    font-weight: 600;
                                    color: s.rating-key == ShowPageState.selected-season ? Theme.bg : Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: s.progress;
                                    font-size: 15px;
                                    color: s.rating-key == ShowPageState.selected-season ? Theme.bg : Theme.text-muted;
                                }
                                ProgressBar {
                                    value: s.fraction;
                                    fill: s.rating-key == ShowPageState.selected-season ? Theme.bg : ShowPageState.tint.accent;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { ShowPageState.select-season(s.rating-key); }
                            }
                        }
                    }

                    // 7–14 seasons: compact pills
                    if ShowPageState.seasons.length > 6 && ShowPageState.seasons.length <= 14: HorizontalLayout {
                        spacing: 8px;
                        for s in ShowPageState.seasons: Rectangle {
                            min-width: 56px;
                            min-height: 56px;
                            border-radius: 12px;
                            background: s.rating-key == ShowPageState.selected-season ? Theme.text-primary : Theme.surface-raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: s.index == 0 ? "Sp" : "S" + s.index;
                                    font-size: 18px;
                                    font-weight: 600;
                                    color: s.rating-key == ShowPageState.selected-season ? Theme.bg : Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                ProgressBar {
                                    value: s.fraction;
                                    fill: s.rating-key == ShowPageState.selected-season ? Theme.bg : ShowPageState.tint.accent;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { ShowPageState.select-season(s.rating-key); }
                            }
                        }
                    }

                    // 15+ seasons: dropdown button + 6-across grid
                    if ShowPageState.seasons.length > 14: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            ActionButton {
                                text: root.season-picker-open ? "Hide seasons ▴" : "Choose season ▾";
                                clicked => { root.season-picker-open = !root.season-picker-open; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.season-picker-open: Flickable {
                            height: 200px;
                            GridLayout {
                                spacing: 8px;
                                for s[idx] in ShowPageState.seasons: Rectangle {
                                    row: Math.floor(idx / 6);
                                    col: Math.mod(idx, 6);
                                    min-height: 56px;
                                    border-radius: 10px;
                                    background: s.rating-key == ShowPageState.selected-season ? Theme.text-primary : Theme.surface-raised;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 2px;
                                        alignment: center;
                                        Text {
                                            text: s.index == 0 ? "Specials" : "Season " + s.index;
                                            font-size: 16px;
                                            font-weight: 600;
                                            color: s.rating-key == ShowPageState.selected-season ? Theme.bg : Theme.text-primary;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: s.progress;
                                            font-size: 14px;
                                            color: s.rating-key == ShowPageState.selected-season ? Theme.bg : Theme.text-muted;
                                            horizontal-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.season-picker-open = false;
                                            ShowPageState.select-season(s.rating-key);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    SectionLabel { text: "EPISODES"; }

                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 12px;
                            for ep in ShowPageState.episodes: Rectangle {
                                min-height: 108px;
                                border-radius: 12px;
                                background: ep.can-resume ? Theme.surface-raised : transparent;
                                border-width: 1px;
                                border-color: ep.can-resume ? ShowPageState.tint.accent : Theme.border;
                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 16px;
                                    // 16:9 episode still (176 × 99)
                                    Rectangle {
                                        width: 176px;
                                        height: 99px;
                                        border-radius: 8px;
                                        background: ShowPageState.tint.poster;
                                        clip: true;
                                        if ep.has-thumb: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: ep.thumb;
                                            image-fit: cover;
                                        }
                                        if ep.watched: Rectangle {
                                            x: parent.width - 28px;
                                            y: 6px;
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: Theme.ok;
                                            Text {
                                                text: "✓";
                                                font-size: 14px;
                                                font-weight: 700;
                                                color: #0B0D10;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Text {
                                        text: ep.num;
                                        width: 44px;
                                        font-size: 24px;
                                        font-weight: 700;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: ep.title;
                                            font-size: 22px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: ep.meta;
                                            font-size: 16px;
                                            color: ep.watched ? Theme.ok : Theme.text-secondary;
                                        }
                                        if ep.summary != "": Text {
                                            text: ep.summary;
                                            font-size: 16px;
                                            color: Theme.text-muted;
                                            overflow: elide;
                                        }
                                        if ep.progress > 0: ProgressBar {
                                            value: ep.progress;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            text: ep.can-resume ? "Resume" : "Play";
                                            primary: ep.can-resume;
                                            clicked => { ShowPageState.play-episode(ep.rating-key, ep.can-resume); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
