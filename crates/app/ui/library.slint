import { Theme } from "theme.slint";
import { ActionButton, Card, PageHeader, PosterRow, ProgressBar, SectionLabel, TextField } from "components.slint";
import { Artwork, Dash, Library, Nav, Server } from "state.slint";

component DetailPanel inherits Card {
    width: 400px;
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: start;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 220px;
                height: 330px;
                border-radius: 12px;
                clip: true;
                background: Theme.surface-raised;
                if Library.detail.has-poster: Image {
                    width: parent.width;
                    height: parent.height;
                    source: Library.detail.poster;
                    image-fit: cover;
                }
                if !Library.detail.has-poster: Text {
                    text: Library.detail.title;
                    width: parent.width - 24px;
                    font-size: Theme.body-size;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        Text { text: Library.detail.badge; font-size: 16px; font-weight: 600; letter-spacing: 1.5px; color: Theme.text-secondary; }
        Text {
            text: Library.detail.title;
            font-size: 28px;
            font-weight: 600;
            color: Theme.text-primary;
            wrap: word-wrap;
        }
        if Library.detail.subtitle != "": Text {
            text: Library.detail.subtitle;
            font-size: Theme.body-size;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        Text { text: Library.detail.meta; font-size: 18px; color: Theme.text-muted; wrap: word-wrap; }
        if Library.detail.progress > 0: ProgressBar { value: Library.detail.progress; }
        Rectangle { height: 6px; }
        ActionButton {
            text: Library.detail.can-resume ? "Resume on TV" : "Play on TV";
            icon: "play";
            primary: true;
            clicked => { Library.play-detail(false); }
        }
        if Library.detail.can-resume: ActionButton {
            text: "Play from the start";
            clicked => { Library.play-detail(true); }
        }
        if Library.detail.badge == "PLEX": ActionButton {
            text: Library.metadata-refreshing ? "Refreshing…" : "Refresh metadata";
            enabled: !Library.metadata-refreshing;
            clicked => { Artwork.refresh(); }
        }
        if Library.detail.badge == "PLEX": ActionButton {
            text: "Change poster";
            clicked => { Artwork.request(false); }
        }
        if Library.detail.badge == "PLEX": ActionButton {
            text: "Change backdrop";
            clicked => { Artwork.request(true); }
        }
        ActionButton { text: "Close"; clicked => { Library.close-detail(); } }
    }
}

component ArtworkPicker inherits Rectangle {
    background: #000000AA;
    VerticalLayout {
        alignment: center;
        Card {
            width: parent.width - 80px;
            height: parent.height - 80px;
            VerticalLayout {
                padding: 28px;
                spacing: 16px;
                HorizontalLayout {
                    Text {
                        text: Artwork.backdrop ? "Change backdrop" : "Change poster";
                        font-size: 28px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                    }
                    ActionButton { text: "Close"; clicked => { Artwork.close(); } }
                }
                if Artwork.loading: Text { text: "Loading artwork…"; font-size: 20px; color: Theme.text-secondary; }
                if Artwork.error != "": Text { text: Artwork.error; font-size: 20px; color: Theme.warn; wrap: word-wrap; }
                if !Artwork.loading && Artwork.choices.length == 0 && Artwork.error == "": Text {
                    text: "No artwork choices were returned.";
                    font-size: 20px;
                    color: Theme.text-secondary;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: grid.preferred-height;
                    grid := GridLayout {
                        spacing: 16px;
                        for choice[index] in Artwork.choices: Rectangle {
                            row: index / 4;
                            col: Math.mod(index, 4);
                            width: 170px;
                            height: Artwork.backdrop ? 150px : 300px;
                            border-radius: 12px;
                            border-width: choice.selected ? 3px : 1px;
                            border-color: choice.selected ? Theme.accent : Theme.border;
                            background: Theme.surface-raised;
                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: Artwork.backdrop ? 104px : 240px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: Theme.surface;
                                    if choice.has-image: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: choice.image;
                                        image-fit: cover;
                                    }
                                    if choice.selected: Text {
                                        text: "✓";
                                        x: parent.width - 34px;
                                        y: 6px;
                                        font-size: 24px;
                                        color: Theme.text-primary;
                                    }
                                }
                                Text { text: choice.provider; font-size: 15px; color: Theme.text-secondary; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Artwork.set(choice.key); }
                            }
                        }
                    }
                }
            }
        }
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> id;
    in property <string> empty-text;
    in property <[PosterCardData]> cards;
    spacing: 14px;
    if root.title != "": SectionLabel { text: root.title; }
    if root.cards.length > 0: PosterRow {
        cards: root.cards;
        art-width: 150px;
        show-subtitle: true;
        selected: Library.selected-section == root.id ? Library.selected-index : -1;
        clicked(i) => {
            Library.selected-section = root.id;
            Library.selected-index = i;
            Library.select(root.id, i);
        }
    }
    if root.cards.length == 0: Text {
        text: root.empty-text;
        font-size: Theme.body-size;
        color: Theme.text-muted;
    }
}

import { PosterCardData } from "components.slint";

export component LibraryPage inherits VerticalLayout {
    padding: 40px;
    spacing: Theme.gap;

    HorizontalLayout {
        spacing: 16px;
        PageHeader {
            horizontal-stretch: 1;
            title: "Library";
            back => { Nav.page = "home"; }
        }
        ActionButton {
            text: "TV / Series";
            primary: Library.media-tab == "tv";
            clicked => { Library.set-media-tab("tv"); }
        }
        ActionButton {
            text: "Movies";
            primary: Library.media-tab == "movies";
            clicked => { Library.set-media-tab("movies"); }
        }
        ActionButton {
            text: Library.sort == "title_asc" ? "Sort: A–Z"
                : Library.sort == "title_desc" ? "Sort: Z–A"
                : "Sort: Recent";
            clicked => {
                Library.set-sort(
                    Library.sort == "recent" ? "title_asc"
                    : Library.sort == "title_asc" ? "title_desc"
                    : "recent"
                );
            }
        }
        ActionButton {
            text: Library.browse-all ? "Smart shelves" : "Browse all";
            primary: Library.browse-all;
            clicked => { Library.browse-all = !Library.browse-all; }
        }
        ActionButton {
            text: "Server ›";
            clicked => {
                Nav.settings-tab = "server";
                Nav.page = "settings";
                Server.open();
            }
        }
    }

    // Smart shelves (Library C) when not browsing all or searching
    if !Library.browse-all && Library.results-title == "": VerticalLayout {
        spacing: Theme.gap;

        // Row 1: Watching now (5 cols) | Big box (7 cols)
        HorizontalLayout {
            spacing: Theme.gap;

            Card {
                horizontal-stretch: 5;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    HorizontalLayout {
                        SectionLabel { text: "WATCHING NOW"; }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: Dash.sessions.length + " streams";
                            font-size: 16px;
                            color: Theme.text-muted;
                        }
                    }
                    if Dash.sessions.length == 0: Text {
                        text: "Nothing is streaming on the server.";
                        font-size: Theme.body-size;
                        color: Theme.text-muted;
                    }
                    for s in Dash.sessions: Rectangle {
                        min-height: 68px;
                        border-radius: 10px;
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text { text: s.title; font-size: 18px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
                            Text { text: s.detail; font-size: 15px; color: Theme.text-secondary; overflow: elide; }
                        }
                    }
                }
            }

            Card {
                horizontal-stretch: 7;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    SectionLabel { text: "CONTINUE WATCHING"; }

                    Section {
                        title: "";
                        id: "continue";
                        cards: Library.continue-watching;
                        empty-text: Library.media-tab == "tv" ? "No shows in progress." : "No movies in progress.";
                    }
                }
            }
        }

        // Row 2: Added this week (6 cols) | Watch again (6 cols)
        HorizontalLayout {
            spacing: Theme.gap;
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 24px;
                    Section {
                        title: "ADDED THIS WEEK";
                        id: "added-week";
                        cards: Library.added-week;
                        empty-text: "Nothing added since Monday.";
                    }
                }
            }
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 24px;
                    Section {
                        title: "WATCH AGAIN";
                        id: "watch-again";
                        cards: Library.watch-again;
                        empty-text: "Nothing rewatched yet.";
                    }
                }
            }
        }

        // Row 3: Popular on Republic City (hidden if Tautulli isn't set up / empty)
        if Library.popular.length > 0: Card {
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    SectionLabel { text: "POPULAR ON REPUBLIC CITY"; }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        text: "Last 7 days";
                        primary: Library.popular-days == 7;
                        clicked => { Library.set-popular-days(7); }
                    }
                    ActionButton {
                        text: "Last 30 days";
                        primary: Library.popular-days == 30;
                        clicked => { Library.set-popular-days(30); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    for p in Library.popular: Rectangle {
                        horizontal-stretch: 1;
                        min-height: 110px;
                        border-radius: 12px;
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text { text: "#" + p.rank; font-size: 16px; font-weight: 700; color: Theme.accent; }
                            Text { text: p.title; font-size: 17px; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; overflow: elide; }
                            Text { text: p.plays; font-size: 15px; color: Theme.text-muted; }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if Library.media-tab == "tv" {
                                    Library.open-show(p.rating-key);
                                } else {
                                    Library.play-key(p.rating-key, true);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Row 4: Genres (TV) or Collections (Movies)
        if Library.media-tab == "tv" && Library.genres.length > 0: Card {
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                SectionLabel { text: "GENRES"; }
                HorizontalLayout {
                    spacing: 12px;
                    for g in Library.genres: Rectangle {
                        horizontal-stretch: 1;
                        min-height: 76px;
                        border-radius: 12px;
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            Text { text: g.title; font-size: 18px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
                            Text { text: g.count + " shows"; font-size: 15px; color: Theme.text-muted; }
                        }
                    }
                }
            }
        }

        if Library.media-tab == "movies" && Library.collections.length > 0: Card {
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    SectionLabel { text: "COLLECTIONS"; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: Library.collections.length + " collections"; font-size: 16px; color: Theme.text-muted; }
                }
                HorizontalLayout {
                    spacing: 12px;
                    for c in Library.collections: Rectangle {
                        horizontal-stretch: 1;
                        min-height: 112px;
                        border-radius: 12px;
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;
                            Text { text: c.title; font-size: 20px; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                            Text { text: c.detail; font-size: 15px; color: Theme.text-secondary; }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Library.open-collection(c.rating-key); }
                        }
                    }
                }
            }
        }
    }

    // Filter + search (shown in Browse all or when searching)
    if Library.browse-all || Library.results-title != "": HorizontalLayout {
        spacing: 12px;
        ActionButton { text: "All"; primary: Library.filter == "all"; clicked => { Library.set-filter("all"); } }
        ActionButton { text: "Plex"; primary: Library.filter == "plex"; clicked => { Library.set-filter("plex"); } }
        Rectangle { width: 24px; }
        search := TextField {
            placeholder: "Search movies and shows";
            text <=> Library.query;
            accepted(q) => { Library.search(q); }
        }
        ActionButton { text: "Search"; clicked => { Library.search(Library.query); } }
        if Library.results-title != "": ActionButton {
            text: "Clear";
            clicked => {
                Library.query = "";
                Library.clear-search();
            }

            if Artwork.open: ArtworkPicker {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
        }
    }

    if Library.browse-all || Library.results-title != "": HorizontalLayout {
        spacing: Theme.gap;
        vertical-stretch: 1;

        VerticalLayout {
            spacing: Theme.gap;
            horizontal-stretch: 1;
            alignment: start;

            if Library.results-title != "": Section {
                title: Library.results-title;
                id: "results";
                cards: Library.results;
                empty-text: Library.searching ? "Searching…" : "No matches.";
            }
            if Library.results-title == "": Section {
                title: "CONTINUE WATCHING";
                id: "continue";
                cards: Library.continue-watching;
                empty-text: "Nothing in progress.";
            }
            if Library.results-title == "": Section {
                title: "RECENTLY ADDED";
                id: "recent";
                cards: Library.recently-added;
                empty-text: "Nothing new yet.";
            }
        }

        if Library.detail-open: DetailPanel { }
    }
}
