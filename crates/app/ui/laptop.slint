import { Theme } from "theme.slint";
import { ArtworkPicker } from "artwork_picker.slint";
import { Artwork, Dash, SiteEditor, TvUi } from "state.slint";
import { SiteEditorDialog } from "site_editor.slint";
import { TvShell } from "tv/shell.slint";

// The main window. Renders the unified TvShell dashboard in both one-screen
// (TV only) and two-screen (laptop + TV) modes.
export component LaptopWindow inherits Window {
    title: "tvdash";
    background: Theme.bg;
    default-font-family: Theme.font;
    preferred-width: 1600px;
    preferred-height: 1000px;
    // Small enough for a 1080p panel at 200% (960 × 540); TvShell scales via TvUi.u.
    min-width: 800px;
    min-height: 480px;

    TvShell { width: root.width; height: root.height; }

    if SiteEditor.open: SiteEditorDialog { width: root.width; height: root.height; }

    if Artwork.open: ArtworkPicker { width: root.width; height: root.height; }

    if Dash.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 110px * TvUi.u;
        width: min(toast-text.preferred-width + 48px * TvUi.u, parent.width - 80px);
        height: 84px * TvUi.u;
        border-radius: 12px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border;
        toast-text := Text {
            text: Dash.toast;
            font-size: 32px * TvUi.u;
            color: Theme.text-primary;
            overflow: elide;
        }
    }
}
