import { Theme } from "theme.slint";
import { HomePage } from "home.slint";
import { LibraryPage } from "library.slint";
import { BrowsePage } from "browse.slint";
import { SettingsPage } from "settings.slint";
import { SetupPage } from "setup.slint";
import { Dash, Nav } from "state.slint";
import { TvShell } from "tv/shell.slint";

// The main window. Two screens: the laptop dashboard pages. TV only
// (Nav.layout == "tv"): the 10-foot shell, full screen on the TV.
export component LaptopWindow inherits Window {
    title: "tvdash";
    background: Theme.bg;
    default-font-family: Theme.font;
    preferred-width: 1600px;
    preferred-height: 1000px;
    // Small enough for a 1080p panel at 200% (960 × 540); the page scrolls.
    min-width: 800px;
    min-height: 480px;

    // Scroll back to the top whenever the page changes.
    property <string> current-page: Nav.page;
    changed current-page => {
        scroller.content-y = 0;
        Nav.opened(self.current-page);
    }

    // Scrolls vertically if the panel is shorter than the content.
    scroller := Flickable {
        visible: Nav.layout == "dual";
        content-height: max(self.height, body.preferred-height);
        body := VerticalLayout {
            width: scroller.width;
            height: scroller.content-height;
            if Nav.page == "home": HomePage { }
            if Nav.page == "library": LibraryPage { }
            if Nav.page == "browse": BrowsePage { }
            if Nav.page == "settings": SettingsPage { }
            if Nav.page == "setup": SetupPage { }
        }
    }

    if Nav.layout == "tv": TvShell { width: root.width; height: root.height; }

    if Dash.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 110px;
        width: min(toast-text.preferred-width + 48px, parent.width - 80px);
        height: Nav.layout == "tv" ? 84px : 56px;
        border-radius: 12px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border;
        toast-text := Text {
            text: Dash.toast;
            font-size: Nav.layout == "tv" ? 32px : Theme.body-size;
            color: Theme.text-primary;
            overflow: elide;
        }
    }
}
