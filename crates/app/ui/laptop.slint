import { Theme } from "theme.slint";
import { ArtworkPicker } from "artwork_picker.slint";
import { Artwork, Dash, Display, SiteEditor, SleepState, SportsAlertState, TvUi } from "state.slint";
import { SiteEditorDialog } from "site_editor.slint";
import { SleepPicker, SleepWarning } from "shared/sleep.slint";
import { SportsAlertCard } from "shared/sports_alert.slint";
import { NextEpisodeCard } from "shared/up_next_card.slint";
// Resolved by build.rs: the real shell, or ui/stubs/* when its Cargo feature is off.
import { TvShell } from "@shell-classic";
import { V3Theme } from "v3/theme.slint";
import { V3Shell } from "@shell-blades";
import { PsTheme } from "ps5/theme.slint";
import { Ps5Shell } from "@shell-ps5";
import { OrbitTheme } from "orbit/theme.slint";
import { OrbitShell } from "@shell-orbit";

// The main window. Renders Classic (TvShell), Blades (V3Shell), PS5 (Ps5Shell), or Orbit (OrbitShell)
// based on Display.dashboard-ui ("classic" | "blades" | "ps5" | "orbit").
export component LaptopWindow inherits Window {
    title: "tvdash";
    background: Display.dashboard-ui == "orbit" ? OrbitTheme.bg
        : Display.dashboard-ui == "ps5" ? PsTheme.bg
        : Display.dashboard-ui == "blades" ? V3Theme.bg : Theme.bg;
    default-font-family: Display.dashboard-ui == "orbit" ? OrbitTheme.font
        : Display.dashboard-ui == "ps5" ? PsTheme.font
        : Display.dashboard-ui == "blades" ? V3Theme.font : Theme.font;
    preferred-width: 1600px;
    preferred-height: 1000px;
    // Small enough for a 1080p panel at 200% (960 × 540); shells scale via TvUi.u.
    min-width: 800px;
    min-height: 480px;

    if Display.dashboard-ui != "blades" && Display.dashboard-ui != "ps5" && Display.dashboard-ui != "orbit": TvShell { width: root.width; height: root.height; }
    if Display.dashboard-ui == "blades": V3Shell { width: root.width; height: root.height; }
    if Display.dashboard-ui == "ps5": Ps5Shell { width: root.width; height: root.height; }
    if Display.dashboard-ui == "orbit": OrbitShell { width: root.width; height: root.height; }

    if SiteEditor.open: SiteEditorDialog { width: root.width; height: root.height; }

    if Artwork.open: ArtworkPicker { width: root.width; height: root.height; }

    SleepPicker { width: root.width; height: root.height; }

    SleepWarning {
        x: parent.width - self.width - 48px;
        y: parent.height - self.height - 48px;
    }

    SportsAlertCard {
        x: parent.width - self.width - 96px * TvUi.u - (SportsAlertState.visible ? 0px : -24px * TvUi.u);
        y: parent.height - self.height - (TvUi.hud-open ? 250px : 120px) * TvUi.u;
        animate x { duration: 180ms; easing: ease-out; }
    }

    if Dash.next-ep-open: NextEpisodeCard {
        x: parent.width - self.width - 96px * TvUi.u;
        y: parent.height - self.height - 96px * TvUi.u;
    }

    if Dash.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 110px * TvUi.u;
        width: min(toast-text.preferred-width + 48px * TvUi.u, parent.width - 80px);
        height: 84px * TvUi.u;
        border-radius: 12px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border;
        toast-text := Text {
            text: Dash.toast;
            font-size: 32px * TvUi.u;
            color: Theme.text-primary;
            overflow: elide;
        }
    }
}
