import { Theme } from "theme.slint";
import {
    AccountPrompt, ActionButton, Card, Clock, PosterCard, PosterCardData, ProgressBar, PromptBanner,
    SectionLabel, SessionLine, SessionRow, SiteTile, StatusChip,
} from "components.slint";

// Control dashboard (home) on the laptop panel.
export component LaptopWindow inherits Window {
    title: "tvdash";
    background: Theme.bg;
    default-font-family: Theme.font;
    preferred-width: 1600px;
    preferred-height: 1000px;
    min-width: 960px;
    min-height: 640px;

    // Header
    in property <string> clock-hh: "--";
    in property <string> clock-mm: "--";
    in property <string> date-text;
    in property <string> weather-text: "—";
    in property <string> event-text: "—";
    in property <string> homelab-text: "—";
    in property <color> homelab-dot: transparent;

    // On the TV
    in property <string> now-playing-title: "Nothing playing";
    in property <string> now-playing-detail: "The TV is showing the idle screen.";
    in property <bool> transport-enabled: false;
    in property <bool> paused: false;
    in property <float> now-playing-progress: 0;
    // Playback on other devices, from both servers.
    in property <[SessionRow]> sessions;
    // Servers whose sign-in expired (sessions can't be read).
    in property <[AccountPrompt]> tv-prompts;

    // Continue Watching: "loading" | "busy" | "code" | "prompts" | "empty" | "items"
    in property <string> cw-state: "loading";
    // Instructions for "busy" / "code".
    in property <string> cw-message;
    in property <string> signin-code;
    // Which source the running sign-in belongs to ("jellyfin" | "plex").
    in property <string> signin-source;
    // Accounts needing attention (not set up, expired, unreachable, failed).
    in property <[AccountPrompt]> prompts;
    in property <[PosterCardData]> continue-watching;

    // Transient message at the bottom of the screen ("" = hidden).
    in property <string> toast;

    // Watch on TV
    in property <[string]> streaming-sites;

    // Footer
    in property <string> keyring-status: "Checking keyring…";
    in property <color> keyring-dot: Theme.text-muted;

    callback open-site(int);
    callback transport(string); // "back" | "play-pause" | "forward" | "stop"
    callback play-item(int);
    callback prompt-action(string, string); // (source, "sign-in" | "retry")
    callback cancel-sign-in(string);
    callback open-settings();
    callback quit();

    // Scrolls vertically if the panel is shorter than the content.
    page := Flickable {
        content-height: max(self.height, main.preferred-height);
        main := VerticalLayout {
            width: page.width;
            height: page.content-height;
            padding: 40px;
            spacing: Theme.gap;

            // ── Header ───────────────────────────────────────────
            HorizontalLayout {
                spacing: Theme.gap;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Clock {
                        hh: root.clock-hh;
                        mm: root.clock-mm;
                        font-px: Theme.laptop-clock-size;
                    }
                    Text {
                        text: root.date-text;
                        font-size: Theme.title-size;
                        color: Theme.text-secondary;
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: end;
                    height: 112px;
                    StatusChip { label: "WEATHER"; value: root.weather-text; }
                    StatusChip { label: "NEXT EVENT"; value: root.event-text; min-width: 300px; }
                    StatusChip { label: "HOMELAB"; value: root.homelab-text; dot: root.homelab-dot; }
                }
            }

            // ── On the TV ────────────────────────────────────────
            Card {
                VerticalLayout {
                    padding: 28px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: Theme.gap;

                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;
                            horizontal-stretch: 1;
                            SectionLabel { text: "ON THE TV"; }
                            Text {
                                text: root.now-playing-title;
                                font-size: 32px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            Text {
                                text: root.now-playing-detail;
                                font-size: Theme.body-size;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                            if root.transport-enabled: ProgressBar { value: root.now-playing-progress; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                ActionButton { text: "−10 s"; enabled: root.transport-enabled; clicked => { root.transport("back"); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    text: root.paused ? "Resume" : "Pause";
                                    primary: true;
                                    enabled: root.transport-enabled;
                                    clicked => { root.transport("play-pause"); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                ActionButton { text: "+30 s"; enabled: root.transport-enabled; clicked => { root.transport("forward"); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                ActionButton { text: "Stop"; enabled: root.transport-enabled; clicked => { root.transport("stop"); } }
                            }
                        }
                    }

                    if root.sessions.length > 0 || root.tv-prompts.length > 0: Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    if root.sessions.length > 0: SectionLabel { text: "ALSO PLAYING"; }
                    for session in root.sessions: SessionLine { data: session; }
                    for p in root.tv-prompts: PromptBanner {
                        data: p;
                        action => { root.prompt-action(p.source, p.action-id); }
                    }
                }
            }

            // ── Watch on TV ──────────────────────────────────────
            VerticalLayout {
                spacing: 14px;
                SectionLabel { text: "WATCH ON TV"; }
                HorizontalLayout {
                    spacing: 16px;
                    for site[i] in root.streaming-sites: SiteTile {
                        name: site;
                        clicked => { root.open-site(i); }
                    }
                }
            }

            // ── Continue Watching ────────────────────────────────
            VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;
                SectionLabel { text: "CONTINUE WATCHING"; }

                if root.cw-state == "items": VerticalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;
                    // One source missing: slim banner above the row.
                    for p in root.prompts: PromptBanner {
                        data: p;
                        action => { root.prompt-action(p.source, p.action-id); }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        min-height: 290px;
                        content-width: row.preferred-width;
                        row := HorizontalLayout {
                            spacing: 20px;
                            alignment: start;
                            for card[i] in root.continue-watching: PosterCard {
                                data: card;
                                clicked => { root.play-item(i); }
                            }
                        }
                    }
                }

                if root.cw-state != "items": Card {
                    vertical-stretch: 1;
                    min-height: 200px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 18px;
                        padding: 24px;

                        if root.cw-state == "code": Text {
                            text: root.signin-code;
                            font-size: 72px;
                            font-weight: 600;
                            letter-spacing: 12px;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                        }
                        if root.cw-state != "prompts": Text {
                            text: root.cw-state == "loading" ? "Loading…"
                                : root.cw-state == "empty" ? "Nothing in progress. Start something and it'll show up here."
                                : root.cw-message;
                            font-size: Theme.body-size;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        if root.cw-state == "code" || root.cw-state == "busy": HorizontalLayout {
                            alignment: center;
                            ActionButton {
                                text: "Cancel";
                                clicked => { root.cancel-sign-in(root.signin-source); }
                            }
                        }
                        if root.cw-state == "prompts": VerticalLayout {
                            spacing: 18px;
                            alignment: center;
                            for p in root.prompts: HorizontalLayout {
                                alignment: center;
                                spacing: 20px;
                                Text {
                                    text: p.message;
                                    font-size: Theme.body-size;
                                    color: p.warn ? Theme.warn : Theme.text-muted;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    text: p.action;
                                    primary: !p.warn;
                                    clicked => { root.prompt-action(p.source, p.action-id); }
                                }
                            }
                        }
                    }
                }
            }

            // ── Footer ───────────────────────────────────────────
            HorizontalLayout {
                spacing: 16px;
                HorizontalLayout {
                    spacing: 10px;
                    horizontal-stretch: 1;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        background: root.keyring-dot;
                    }
                    Text {
                        text: root.keyring-status;
                        font-size: Theme.label-size;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                ActionButton { text: "Settings"; clicked => { root.open-settings(); } }
                ActionButton { text: "Quit"; clicked => { root.quit(); } }
            }
        }
    }

    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 110px;
        width: min(toast-text.preferred-width + 48px, parent.width - 80px);
        height: 56px;
        border-radius: 12px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border;
        toast-text := Text {
            text: root.toast;
            font-size: Theme.body-size;
            color: Theme.text-primary;
            overflow: elide;
        }
    }
}
