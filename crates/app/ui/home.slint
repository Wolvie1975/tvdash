import { Theme, UiTheme } from "theme.slint";
import { Icon } from "icons.slint";
import { ActionButton, Clock, PosterCardData, PosterGrid, ProgressBar, PromptBanner, SectionLabel, TextField } from "components.slint";
import { Dash, Nav, Saver, SiteTileData, Watch, WatchCard } from "state.slint";

// Laptop dashboard: a header (search · time, date and weather · theme and
// Settings) over three equal, full-height boxes: On the TV, Watch on TV and
// Continue Watching. The search panel slides in over the right two boxes.
// Touch-first: every control is at least 56 px tall and nothing needs hover.

// ── Header ───────────────────────────────────────────────────────────

component ThemeChoice inherits Rectangle {
    in property <UiTheme> mode;
    in property <string> label;
    property <bool> on: Theme.mode == root.mode;
    min-height: Theme.hit-target;
    border-radius: 14px;
    background: root.on ? Theme.text-primary : touch.pressed ? Theme.surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.label + " theme";
    accessible-checked: root.on;
    accessible-action-default => { Dash.set-theme(root.mode); }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.mode == UiTheme.dark ? "moon" : "sun";
                tint: root.on ? Theme.bg : Theme.text-secondary;
                size: 22px;
            }
        }
        Text {
            text: root.label;
            font-size: 19px;
            font-weight: 500;
            color: root.on ? Theme.bg : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Dash.set-theme(root.mode); }
    }
}

component ThemeSwitch inherits Rectangle {
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius;
    width: row.preferred-width;
    height: row.preferred-height;

    row := HorizontalLayout {
        padding: 4px;
        ThemeChoice { mode: UiTheme.dark; label: "Dark"; }
        ThemeChoice { mode: UiTheme.stone; label: "Stone"; }
        ThemeChoice { mode: UiTheme.mist; label: "Mist"; }
    }
}

export component SquareButton inherits Rectangle {
    in property <string> icon;
    in property <string> label; // accessible name
    // Filled while what it opens is open (the search panel).
    in property <bool> on: false;
    callback clicked();
    width: 64px;
    height: 64px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.on ? Theme.text-primary : Theme.border;
    background: root.on ? Theme.text-primary : touch.pressed ? Theme.surface-raised : Theme.surface;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { name: root.icon; tint: root.on ? Theme.bg : Theme.text-secondary; size: 28px; line: 1.7px; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Time and date, a thin divider, then the weather; spread evenly.
component HeaderCentre inherits HorizontalLayout {
    alignment: space-around;

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        // The digits fill about 0.75 em; the row is sized to them, not the line.
        Rectangle {
            height: 96px;
            clock := Clock {
                x: (parent.width - self.preferred-width) / 2;
                y: (parent.height - self.preferred-height) / 2;
                hh: Dash.clock-hh;
                mm: Dash.clock-mm;
                ss: Dash.clock-ss;
                suffix: Dash.clock-suffix;
                show-seconds: Dash.show-seconds;
                font-px: 112px;
            }
        }
        Text {
            text: Dash.weekday + ", " + Dash.date-text;
            font-size: 24px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }

    VerticalLayout {
        alignment: center;
        Rectangle { width: 1px; height: 96px; background: Theme.border; }
    }

    weather := Rectangle {
        // No location yet: tapping goes to Settings › Display › Location.
        TouchArea {
            enabled: !Dash.weather-on;
            mouse-cursor: Dash.weather-on ? default : pointer;
            clicked => {
                Nav.settings-tab = "display";
                Nav.page = "settings";
            }
        }
        HorizontalLayout {
            spacing: 18px;
            opacity: Dash.weather-stale ? 0.55 : 1;
            animate opacity { duration: 400ms; }
            VerticalLayout {
                alignment: center;
                Icon { name: Dash.weather-on ? Dash.weather-icon : "partly"; tint: Theme.text-secondary; size: 52px; line: 1.4px; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: Dash.weather-on ? Dash.weather-temp : "Weather";
                        font-size: Dash.weather-on ? 48px : 28px;
                        font-weight: 300;
                        color: Theme.text-primary;
                    }
                    // Amber dot when the last fetch failed.
                    if Dash.weather-warn: VerticalLayout {
                        alignment: center;
                        Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.warn; }
                    }
                }
                Text {
                    text: !Dash.weather-on ? "Tap to set your location"
                        : Dash.weather-note != "" ? Dash.weather-note : Dash.weather-detail;
                    font-size: 22px;
                    color: Dash.weather-warn && Dash.weather-note != "" ? Theme.warn : Theme.text-secondary;
                    overflow: elide;
                    max-width: 380px;
                }
            }
        }
    }
}

// ── On the TV ────────────────────────────────────────────────────────

component TvBox inherits Rectangle {
    property <bool> playing: Dash.tv.mode == "playing";
    property <bool> streaming: Dash.tv.mode == "streaming";
    property <bool> next: Dash.tv.mode == "next";
    property <bool> idle: Dash.tv.mode == "idle";

    background: Dash.tint.card;
    border-radius: Theme.card-radius;
    clip: true;
    animate background { duration: 400ms; }

    // Crossfade (~400 ms) when the box switches to something else.
    property <string> showing: Dash.tv.mode + "|" + Dash.tv.title + "|" + Dash.tv.subtitle;
    property <bool> shown: true;
    changed showing => {
        root.shown = false;
        fade-in.running = true;
    }
    fade-in := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            root.shown = true;
            self.running = false;
        }
    }

    VerticalLayout {
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: root.shown ? 400ms : 100ms; }
        padding: 30px;
        spacing: 22px;

        // Label row: ON THE TV / UP NEXT, source badge.
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon { name: "tv"; tint: Dash.tint.accent; size: 22px; line: 1.75px; }
            }
            Text {
                text: Dash.tv.label;
                font-size: Theme.label-size;
                font-weight: 600;
                letter-spacing: 1.5px;
                color: Dash.tint.accent;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if Dash.tv.source != "": Rectangle {
                width: pill.preferred-width + 28px;
                height: 34px;
                border-radius: 17px;
                border-width: 1px;
                border-color: Dash.tint.edge;
                pill := Text { text: Dash.tv.source; font-size: 18px; color: Dash.tint.sec; }
            }
        }

        // Title, episode, facts.
        VerticalLayout {
            spacing: 8px;
            if Dash.tv.note != "": Text {
                text: Dash.tv.note;
                font-size: 20px;
                color: Dash.tint.sec;
                wrap: word-wrap;
            }
            Text {
                text: Dash.tv.title;
                font-size: 44px;
                font-weight: 500;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            if Dash.tv.episode-line != "": Text {
                text: Dash.tv.episode-line;
                font-size: 22px;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            if Dash.tv.facts != "": Text {
                text: Dash.tv.facts;
                font-size: 18px;
                color: Dash.tint.sec;
                overflow: elide;
            }
            if root.streaming || root.idle: Text {
                text: Dash.tv.subtitle;
                font-size: 20px;
                color: Dash.tint.sec;
                wrap: word-wrap;
            }
        }

        // Poster with the description beside it (clipped at the bottom of the box).
        if root.playing || root.next: HorizontalLayout {
            spacing: 20px;
            vertical-stretch: 1;
            min-height: 0;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 160px;
                    height: 240px;
                    border-radius: 14px;
                    clip: true;
                    background: Dash.tint.poster;
                    if Dash.tv.has-poster: Image {
                        width: parent.width;
                        height: parent.height;
                        source: Dash.tv.poster;
                        image-fit: cover;
                    }
                    if !Dash.tv.has-poster: Text {
                        text: Dash.tv.title;
                        width: parent.width - 24px;
                        font-size: 18px;
                        color: Dash.tint.accent;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                if Dash.tv.overview != "": Text {
                    y: 0;
                    width: parent.width;
                    text: Dash.tv.overview;
                    font-size: 18px;
                    color: Dash.tint.sec;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
                if Dash.tv.overview == "": VerticalLayout {
                    y: 0;
                    width: parent.width;
                    height: self.preferred-height;
                    spacing: 10px;
                    if Dash.tv.genres != "": Text { text: Dash.tv.genres; font-size: 18px; color: Dash.tint.sec; wrap: word-wrap; }
                    Text { text: "No description on the server"; font-size: 18px; color: Dash.tint.sec; wrap: word-wrap; }
                }
            }
        }

        // Streaming: the app's logo.
        if root.streaming: Rectangle {
            vertical-stretch: 1;
            min-height: 160px;
            border-radius: 20px;
            background: Dash.tint.btn;
            if Dash.tv.has-logo: Image {
                width: parent.width * 0.6;
                height: min(parent.height * 0.5, 120px);
                source: Dash.tv.logo;
                image-fit: contain;
            }
            if !Dash.tv.has-logo: Text { text: Dash.tv.monogram; font-size: 96px; font-weight: 600; color: Dash.tint.accent; }
        }

        if root.idle: Rectangle { vertical-stretch: 1; }

        if (root.playing || root.next) && Dash.tv.at-text != "": VerticalLayout {
            spacing: 10px;
            ProgressBar { height: 10px; value: Dash.tv.progress; fill: Dash.tint.accent; track: Dash.tint.track; }
            HorizontalLayout {
                Text { text: Dash.tv.at-text; font-size: 20px; color: Dash.tint.sec; horizontal-stretch: 1; }
                Text { text: Dash.tv.left-text; font-size: 20px; color: Dash.tint.sec; }
            }
        }

        // Servers whose sign-in expired.
        for p in Dash.tv-prompts: PromptBanner {
            data: p;
            fill: Dash.tint.btn;
            action => { Dash.prompt-action(p.source, p.action-id); }
        }

        if root.playing: HorizontalLayout {
            spacing: 14px;
            height: 76px;
            ActionButton {
                icon: "back";
                width: 76px;
                font-px: 26px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                accessible-label: "Back 10 seconds";
                clicked => { Dash.transport("back"); }
            }
            ActionButton {
                text: Dash.tv.paused ? "Resume" : "Pause";
                icon: Dash.tv.paused ? "play" : "pause";
                primary: true;
                font-px: 26px;
                horizontal-stretch: 1;
                fill: Dash.tint.accent;
                ink: Dash.tint.on-accent;
                clicked => { Dash.transport("play-pause"); }
            }
            ActionButton {
                icon: "forward";
                width: 76px;
                font-px: 26px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                accessible-label: "Forward 30 seconds";
                clicked => { Dash.transport("forward"); }
            }
            ActionButton {
                text: "Stop";
                font-px: 22px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                clicked => { Dash.transport("stop"); }
            }
        }
        if root.streaming: ActionButton {
            height: 76px;
            text: "Close browser";
            icon: "stop";
            primary: true;
            font-px: 26px;
            fill: Dash.tint.accent;
            ink: Dash.tint.on-accent;
            clicked => { Dash.transport("stop"); }
        }
        if root.next: ActionButton {
            height: 76px;
            text: "Resume on TV";
            icon: "play";
            primary: true;
            font-px: 26px;
            fill: Dash.tint.accent;
            ink: Dash.tint.on-accent;
            clicked => { Dash.play-item(0); }
        }
    }
}

// ── Watch on TV ──────────────────────────────────────────────────────

// One app: its logo only (the name is the accessible label). Tap opens it on the TV.
component SiteTile inherits Rectangle {
    in property <SiteTileData> site;
    callback clicked();
    border-radius: Theme.radius;
    border-width: touch.pressed ? 2px : 1px;
    border-color: touch.pressed ? Theme.accent : Theme.border;
    background: touch.pressed ? Theme.border : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.site.name;
    accessible-action-default => { root.clicked(); }

    Image {
        width: parent.width * 0.78;
        height: parent.height * 0.68;
        source: root.site.logo;
        image-fit: contain;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component AppsBox inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.card-radius;

    VerticalLayout {
        padding: 30px;
        spacing: 18px;
        HorizontalLayout {
            SectionLabel { text: "WATCH ON TV · " + Dash.streaming-sites.length + " APPS"; horizontal-stretch: 1; }
            Text { text: "Full screen on TV"; font-size: Theme.label-size; color: Theme.text-muted; }
        }
        // Two columns × five rows; tiles stretch to fill the box.
        grid := Rectangle {
            vertical-stretch: 1;
            property <int> columns: 2;
            property <int> rows: 5;
            property <length> gap: 14px;
            property <length> tile-w: (self.width - (self.columns - 1) * self.gap) / self.columns;
            property <length> tile-h: (self.height - (self.rows - 1) * self.gap) / self.rows;
            for site[i] in Dash.streaming-sites: SiteTile {
                x: Math.mod(i, grid.columns) * (grid.tile-w + grid.gap);
                y: Math.floor(i / grid.columns) * (grid.tile-h + grid.gap);
                width: grid.tile-w;
                height: grid.tile-h;
                site: site;
                clicked => { Dash.open-site(site.index); }
            }
        }
    }
}

// ── Continue Watching ────────────────────────────────────────────────

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    min-height: Theme.hit-target;
    border-radius: 12px;
    background: root.on ? Theme.text-primary : touch.pressed ? Theme.surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    Text {
        text: root.label;
        font-size: 20px;
        font-weight: 500;
        color: root.on ? Theme.bg : Theme.text-secondary;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CwBox inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.card-radius;
    clip: true;
    property <[PosterCardData]> cards: Dash.cw-tab == "movies" ? Dash.cw-movies : Dash.cw-tv;

    VerticalLayout {
        padding: 30px;
        spacing: 18px;

        HorizontalLayout {
            SectionLabel { text: "CONTINUE WATCHING"; horizontal-stretch: 1; vertical-alignment: center; }
            Rectangle {
                min-height: 48px;
                width: see-all.preferred-width + 8px;
                accessible-role: button;
                accessible-label: "See all in Library";
                accessible-action-default => { Nav.page = "library"; }
                see-all := HorizontalLayout {
                    spacing: 6px;
                    Text { text: "See all"; font-size: 20px; color: link.pressed ? Theme.text-primary : Theme.text-secondary; vertical-alignment: center; }
                    VerticalLayout { alignment: center; Icon { name: "chevron"; tint: Theme.text-secondary; size: 18px; } }
                }
                link := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Nav.page = "library"; }
                }
            }
        }

        if Dash.cw-state == "items": Rectangle {
            background: Theme.bg;
            border-radius: 16px;
            height: 64px;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                TabButton { label: "TV / Series"; on: Dash.cw-tab != "movies"; horizontal-stretch: 1; clicked => { Dash.cw-tab = "tv"; } }
                TabButton { label: "Movies"; on: Dash.cw-tab == "movies"; horizontal-stretch: 1; clicked => { Dash.cw-tab = "movies"; } }
            }
        }

        if Dash.cw-state == "items": VerticalLayout {
            spacing: 14px;
            vertical-stretch: 1;
            // One source missing: slim banner above the posters.
            for p in Dash.prompts: PromptBanner {
                data: p;
                action => { Dash.prompt-action(p.source, p.action-id); }
            }
            if root.cards.length > 0: PosterGrid {
                vertical-stretch: 1;
                cards: root.cards;
                clicked(i) => { Dash.play-card(Dash.cw-tab, i); }
            }
            if root.cards.length == 0: Text {
                vertical-stretch: 1;
                text: Dash.cw-tab == "movies" ? "No movies in progress." : "No shows in progress.";
                font-size: Theme.body-size;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        if Dash.cw-state != "items": VerticalLayout {
            alignment: center;
            spacing: 18px;
            vertical-stretch: 1;

            if Dash.cw-state == "code": Text {
                text: Dash.signin-code;
                font-size: 72px;
                font-weight: 600;
                letter-spacing: 12px;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            if Dash.cw-state != "prompts": Text {
                text: Dash.cw-state == "loading" ? "Loading…"
                    : Dash.cw-state == "empty" ? "Nothing in progress. Start something and it'll show up here."
                    : Dash.cw-message;
                font-size: Theme.body-size;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if Dash.cw-state == "code" || Dash.cw-state == "busy": HorizontalLayout {
                alignment: center;
                ActionButton { text: "Cancel"; clicked => { Dash.cancel-sign-in(Dash.signin-source); } }
            }
            if Dash.cw-state == "prompts": VerticalLayout {
                spacing: 18px;
                alignment: center;
                for p in Dash.prompts: VerticalLayout {
                    spacing: 14px;
                    Text {
                        text: p.message;
                        font-size: Theme.body-size;
                        color: p.warn ? Theme.warn : Theme.text-secondary;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        ActionButton {
                            text: p.action;
                            primary: !p.warn;
                            clicked => { Dash.prompt-action(p.source, p.action-id); }
                        }
                    }
                }
            }
        }
    }
}

// ── Search ───────────────────────────────────────────────────────────

component ResultRow inherits Rectangle {
    in property <WatchCard> card;
    border-radius: 16px;
    background: Theme.surface-raised;
    height: 82px;
    HorizontalLayout {
        padding: 8px;
        padding-right: 10px;
        spacing: 16px;
        Rectangle {
            width: 44px;
            height: 66px;
            border-radius: 8px;
            clip: true;
            background: Theme.border;
            if root.card.has-poster: Image { width: parent.width; height: parent.height; source: root.card.poster; image-fit: cover; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.card.title; font-size: 21px; font-weight: 500; color: Theme.text-primary; overflow: elide; }
            Text { text: root.card.meta; font-size: 17px; color: Theme.text-secondary; overflow: elide; }
        }
        if root.card.action != "": VerticalLayout {
            alignment: center;
            ActionButton {
                text: root.card.action;
                primary: root.card.primary;
                font-px: 19px;
                fill: root.card.primary ? Dash.tint.accent : transparent;
                ink: root.card.primary ? Dash.tint.on-accent : Theme.text-primary;
                clicked => { Watch.action(root.card.key); }
            }
        }
    }
}

component ResultGroup inherits VerticalLayout {
    in property <string> title;
    in property <[WatchCard]> cards;
    spacing: 8px;
    if root.cards.length > 0: Text {
        text: root.title;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 1.3px;
        color: Theme.text-muted;
    }
    for c in root.cards: ResultRow { card: c; }
}

component SearchPanel inherits Rectangle {
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.card-radius;
    drop-shadow-blur: 64px;
    drop-shadow-offset-y: 24px;
    drop-shadow-color: #00000059;
    clip: true;

    property <bool> open: Dash.search-open;
    changed open => {
        if self.open {
            field.focus-input();
        }
    }

    // Swallow taps so nothing under the panel reacts.
    TouchArea { }

    VerticalLayout {
        padding: 28px;
        spacing: 20px;

        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                height: 72px;
                horizontal-stretch: 1;
                border-radius: 20px;
                border-width: 2px;
                border-color: Theme.text-secondary;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 14px;
                    VerticalLayout { alignment: center; Icon { name: "search"; tint: Theme.text-secondary; size: 28px; } }
                    field := TextField {
                        placeholder: "Search movies and shows";
                        text <=> Watch.query;
                        font-px: 26px;
                        bare: true;
                        edited(q) => { Watch.edited(q); }
                        accessible-label: "Search your library and streaming apps";
                    }
                }
            }
            SquareButton {
                width: 72px;
                height: 72px;
                icon: "close";
                label: "Close search";
                clicked => { Watch.close(); }
            }
        }

        if Watch.query != "": VerticalLayout {
            vertical-stretch: 1;
            spacing: 14px;
            if Watch.message != "": Text { text: Watch.message; font-size: Theme.body-size; color: Theme.text-secondary; wrap: word-wrap; }
            if Watch.searching && Watch.message == "": Text { text: "Searching…"; font-size: Theme.body-size; color: Theme.text-muted; }
            Flickable {
                vertical-stretch: 1;
                content-height: results.preferred-height;
                results := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    spacing: 14px;
                    ResultGroup { title: "IN YOUR LIBRARY"; cards: Watch.library; }
                    ResultGroup { title: "ON YOUR APPS"; cards: Watch.included; }
                    ResultGroup { title: "COSTS EXTRA"; cards: Watch.extra; }
                    ResultGroup { title: "NOT STREAMING"; cards: Watch.none; }
                    ResultGroup { title: "CHECKING…"; cards: Watch.checking; }
                }
            }
            Text { text: "Streaming availability in the US from JustWatch, via TMDB"; font-size: 16px; color: Theme.text-muted; }
        }
    }
}

// ── Page ─────────────────────────────────────────────────────────────

export component HomePage inherits VerticalLayout {
    padding-top: 40px;
    padding-bottom: 40px;
    padding-left: 64px;
    padding-right: 64px;
    spacing: Theme.gap;

    // Header: three columns, 1fr 2fr 1fr.
    header := Rectangle {
        height: 140px;
        property <length> gap: 32px;
        property <length> unit: (self.width - 2 * self.gap) / 4;

        HorizontalLayout {
            x: 0;
            width: header.unit;
            alignment: start;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                SquareButton {
                    icon: "search";
                    label: "Search";
                    on: Dash.search-open;
                    clicked => {
                        if Dash.search-open {
                            Watch.close();
                        } else {
                            Dash.search-open = true;
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                SquareButton {
                    icon: "saver";
                    label: "Start screensaver";
                    clicked => {
                        if Dash.search-open {
                            Watch.close();
                        }
                        Saver.on = true;
                    }
                }
            }
        }
        HeaderCentre {
            x: header.unit + header.gap;
            width: header.unit * 2;
        }
        HorizontalLayout {
            x: header.unit * 3 + header.gap * 2;
            width: header.unit;
            alignment: end;
            spacing: 16px;
            VerticalLayout { alignment: center; ThemeSwitch { } }
            VerticalLayout {
                alignment: center;
                SquareButton { icon: "gear"; label: "Settings"; clicked => { Nav.page = "settings"; } }
            }
        }
    }

    // Main: three equal, full-height boxes (4 of 12 columns each). Placed by
    // hand so the thirds stay exact whatever the content.
    main := Rectangle {
        vertical-stretch: 1;
        min-height: 640px;
        property <length> box-w: (self.width - 2 * Theme.gap) / 3;

        TvBox { x: 0; width: main.box-w; height: main.height; }
        AppsBox { x: main.box-w + Theme.gap; width: main.box-w; height: main.height; }
        CwBox { x: (main.box-w + Theme.gap) * 2; width: main.box-w; height: main.height; }

        // Slides in over the right two boxes (opacity + 48 px, ~250 ms).
        SearchPanel {
            x: main.box-w + Theme.gap + (Dash.search-open ? 0 : 48px);
            width: main.width - self.x + (Dash.search-open ? 0 : 48px);
            height: main.height;
            opacity: Dash.search-open ? 1 : 0;
            visible: self.opacity > 0.01;
            animate x { duration: 260ms; easing: ease-out; }
            animate opacity { duration: 220ms; easing: ease-out; }
        }
    }
}
