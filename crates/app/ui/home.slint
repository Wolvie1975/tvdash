import { Theme, UiTheme } from "theme.slint";
import { Icon } from "icons.slint";
import { ActionButton, Clock, PosterCard, PosterCardData, ProgressBar, PromptBanner, SectionLabel, SessionLine } from "components.slint";
import { Dash, Library, Nav, SiteTileData, Watch } from "state.slint";
import { SearchPanel } from "watch.slint";

// Laptop dashboard, redesign "Option B":
// Header (140 px): [Search][Screensaver] | Clock + Weather | [Dark|Stone|Mist] [Settings]
// Main: three equal 4-column full-height boxes:
//   1. On the TV (tinted from poster)
//   2. Watch on TV (2×5 logo-only grid of 10 apps)
//   3. Continue Watching (TV / Series · Movies switch + 3×2 poster grid)
// Search panel slides in over boxes 2 & 3; On the TV stays visible.

component ThemeChoice inherits Rectangle {
    in property <UiTheme> mode;
    in property <string> label;
    property <bool> on: Theme.mode == root.mode;
    min-height: 48px;
    border-radius: 12px;
    background: root.on ? Theme.text-primary : touch.pressed ? Theme.surface-raised : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.mode == UiTheme.dark ? "moon" : "sun";
                tint: root.on ? Theme.bg : Theme.text-secondary;
                size: 20px;
            }
        }
        Text {
            text: root.label;
            font-size: 18px;
            font-weight: 500;
            color: root.on ? Theme.bg : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Dash.set-theme(root.mode); }
    }
}

component ThemeSwitch inherits Rectangle {
    height: Theme.hit-target;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: 4px;
        ThemeChoice { mode: UiTheme.dark; label: "Dark"; }
        ThemeChoice { mode: UiTheme.stone; label: "Stone"; }
        ThemeChoice { mode: UiTheme.mist; label: "Mist"; }
    }
}

component WeatherSummary inherits Rectangle {
    min-width: 240px;
    min-height: 96px;
    // No location yet: tapping goes to Settings › Display › Location.
    TouchArea {
        enabled: !Dash.weather-on;
        mouse-cursor: Dash.weather-on ? default : pointer;
        clicked => {
            Nav.settings-tab = "display";
            Nav.page = "settings";
        }
    }
    HorizontalLayout {
        opacity: Dash.weather-stale ? 0.55 : 1;
        animate opacity { duration: 400ms; }
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon { name: Dash.weather-on ? Dash.weather-icon : "partly"; tint: Theme.text-secondary; size: 40px; line: 1.6px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Dash.weather-on ? Dash.weather-temp : "Weather";
                    font-size: Dash.weather-on ? 48px : 24px;
                    font-weight: 300;
                    color: Theme.text-primary;
                }
                if Dash.weather-warn: VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.warn;
                    }
                }
            }
            Text {
                text: !Dash.weather-on ? "Tap to set location"
                    : Dash.weather-note != "" ? Dash.weather-note : Dash.weather-detail;
                font-size: 22px;
                color: Dash.weather-warn && Dash.weather-note != "" ? Theme.warn : Theme.text-secondary;
                overflow: elide;
                max-width: 320px;
            }
        }
    }
}

component SquareButton inherits Rectangle {
    in property <string> icon;
    in property <string> label; // accessible name
    in property <bool> active: false;
    callback clicked();
    width: 64px;
    height: 64px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.active ? Theme.text-primary : Theme.border;
    background: root.active ? Theme.text-primary : touch.pressed ? Theme.surface-raised : Theme.surface;
    accessible-role: button;
    accessible-label: root.label;
    Icon {
        name: root.icon;
        tint: root.active ? Theme.bg : Theme.text-secondary;
        size: 28px;
        line: 1.7px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── On the TV ────────────────────────────────────────────────────────

component TvCardView inherits Rectangle {
    property <bool> playing: Dash.tv.mode == "playing";
    property <bool> streaming: Dash.tv.mode == "streaming";
    property <bool> next: Dash.tv.mode == "next";

    background: Dash.tint.card;
    border-radius: Theme.card-radius;
    animate background { duration: 400ms; }
    clip: true;

    // Crossfade (~400 ms) when the card switches to something else.
    property <string> showing: Dash.tv.mode + "|" + Dash.tv.title + "|" + Dash.tv.subtitle;
    property <bool> shown: true;
    changed showing => {
        root.shown = false;
        fade-in.running = true;
    }
    fade-in := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            root.shown = true;
            self.running = false;
        }
    }

    VerticalLayout {
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: root.shown ? 400ms : 100ms; }
        padding: 32px;
        spacing: 16px;

        // 1. Label + Plex badge
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon { name: "tv"; tint: Dash.tint.accent; size: 22px; line: 1.75px; }
            }
            Text {
                text: Dash.tv.label;
                font-size: Theme.label-size;
                font-weight: 600;
                letter-spacing: 1.5px;
                color: Dash.tint.accent;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if Dash.tv.source != "": Rectangle {
                width: pill.preferred-width + 24px;
                height: 32px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Dash.tint.edge;
                pill := Text { text: Dash.tv.source; font-size: 16px; color: Dash.tint.sec; }
            }
        }

        // 2. Title + Episode line + Facts
        VerticalLayout {
            spacing: 6px;
            if Dash.tv.note != "": Text {
                text: Dash.tv.note;
                font-size: 18px;
                color: Dash.tint.sec;
                wrap: word-wrap;
            }
            Text {
                text: Dash.tv.title;
                font-size: 44px;
                font-weight: 500;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            if Dash.tv.subtitle != "": Text {
                text: Dash.tv.subtitle;
                font-size: 22px;
                color: Dash.tint.sec;
                wrap: word-wrap;
            }
            if root.playing && Dash.tv.paused: HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                Rectangle {
                    width: paused.preferred-width + 24px;
                    height: 30px;
                    border-radius: 15px;
                    background: Dash.tint.btn;
                    paused := Text { text: "Paused"; font-size: 16px; font-weight: 600; color: Dash.tint.accent; }
                }
            }
        }

        // 3. Poster (160×240) + Description
        if Dash.tv.mode != "idle": HorizontalLayout {
            spacing: 20px;
            vertical-stretch: 1;
            min-height: 0;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 140px;
                    height: 210px;
                    border-radius: 14px;
                    clip: true;
                    background: Dash.tint.poster;
                    if Dash.tv.has-poster: Image {
                        width: parent.width;
                        height: parent.height;
                        source: Dash.tv.poster;
                        image-fit: cover;
                    }
                    if !Dash.tv.has-poster: Text {
                        text: Dash.tv.monogram != "" ? Dash.tv.monogram : Dash.tv.title;
                        width: parent.width - 20px;
                        font-size: Dash.tv.monogram != "" ? 68px : 20px;
                        font-weight: Dash.tv.monogram != "" ? 600 : 400;
                        color: Dash.tint.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                Text {
                    text: !Dash.tv-connected && Dash.tv.mode == "idle"
                        ? "TV not connected"
                        : Dash.tv.summary != "" ? Dash.tv.summary : root.streaming ? "" : "No description on the server.";
                    font-size: 18px;
                    color: Dash.tint.sec;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        if Dash.tv.mode == "idle": Rectangle { vertical-stretch: 1; }

        // 4. Progress bar & times
        if (root.playing || root.next) && Dash.tv.at-text != "": VerticalLayout {
            spacing: 8px;
            ProgressBar { height: 10px; value: Dash.tv.progress; fill: Dash.tint.accent; track: Dash.tint.track; }
            HorizontalLayout {
                Text { text: Dash.tv.at-text; font-size: 18px; color: Dash.tint.sec; horizontal-stretch: 1; }
                Text { text: Dash.tv.left-text; font-size: 18px; color: Dash.tint.sec; }
            }
        }

        // 5. Actions
        if root.playing: HorizontalLayout {
            spacing: 12px;
            height: 64px;
            if Dash.tv.is-episode: ActionButton {
                text: "Prev";
                font-px: 18px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                accessible-label: "Previous episode";
                clicked => { Dash.transport("prev-ep"); }
            }
            ActionButton {
                text: "From start";
                icon: "back";
                font-px: 18px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                accessible-label: "Start from beginning";
                clicked => { Dash.transport("restart"); }
            }
            ActionButton {
                text: Dash.tv.paused ? "Resume" : "Pause";
                icon: Dash.tv.paused ? "play" : "pause";
                primary: true;
                font-px: 22px;
                horizontal-stretch: 1;
                fill: Dash.tint.accent;
                ink: Dash.tint.on-accent;
                clicked => { Dash.transport("play-pause"); }
            }
            if Dash.tv.is-episode: ActionButton {
                text: "Next";
                font-px: 18px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                accessible-label: "Next episode";
                clicked => { Dash.transport("next-ep"); }
            }
            ActionButton {
                text: "Stop";
                font-px: 20px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                clicked => { Dash.transport("stop"); }
            }
        }
        if root.streaming: ActionButton {
            height: 64px;
            text: "Close browser";
            icon: "stop";
            primary: true;
            font-px: 22px;
            fill: Dash.tint.accent;
            ink: Dash.tint.on-accent;
            clicked => { Dash.transport("stop"); }
        }
        if root.next: ActionButton {
            height: 64px;
            text: Dash.tv-connected ? "Resume on TV" : "TV not connected";
            icon: "play";
            primary: true;
            enabled: Dash.tv-connected;
            font-px: 22px;
            fill: Dash.tint.accent;
            ink: Dash.tint.on-accent;
            clicked => { Dash.play-up-next(); }
        }

        // Other devices & expired Plex sign-in.
        if Dash.sessions.length > 0 || Dash.tv-prompts.length > 0: Rectangle { height: 1px; background: Dash.tint.edge; }
        if Dash.sessions.length > 0: HorizontalLayout {
            Text {
                text: "ALSO PLAYING";
                font-size: 16px;
                font-weight: 600;
                letter-spacing: 1.5px;
                color: Dash.tint.sec;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "Server ›";
                font-size: 18px;
                color: Dash.tint.accent;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Nav.settings-tab = "server";
                        Nav.page = "settings";
                    }
                }
            }
        }
        for session in Dash.sessions: SessionLine { data: session; }
        for p in Dash.tv-prompts: PromptBanner {
            data: p;
            fill: Dash.tint.btn;
            action => { Dash.prompt-action(p.source, p.action-id); }
        }
    }
}

// ── Watch on TV (2×5 logo-only grid) ─────────────────────────────────

component SiteTile inherits Rectangle {
    in property <SiteTileData> site;
    in property <bool> enabled: true;
    callback clicked();
    opacity: root.enabled ? 1.0 : 0.45;
    border-radius: Theme.radius;
    border-width: touch.pressed ? 2px : 1px;
    border-color: touch.pressed ? Theme.accent : Theme.border;
    background: touch.pressed ? Theme.border : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.site.name;

    property <image> bundled-logo:
        root.site.name == "YouTube TV" ? @image-url("../../../assets/logos/youtube-tv.svg")
        : root.site.name == "YouTube" ? @image-url("../../../assets/logos/youtube.svg")
        : root.site.name == "Disney+" ? @image-url("../../../assets/logos/disney-plus.svg")
        : root.site.name == "Hulu" ? @image-url("../../../assets/logos/hulu.svg")
        : root.site.name == "Apple TV" || root.site.name == "Apple TV+" ? @image-url("../../../assets/logos/apple-tv.svg")
        : root.site.name == "Netflix" ? @image-url("../../../assets/logos/netflix.svg")
        : root.site.name == "Fandango at Home" ? @image-url("../../../assets/logos/fandango-at-home.svg")
        : root.site.name == "Prime Video" ? @image-url("../../../assets/logos/prime-video.svg")
        : root.site.name == "Crunchyroll" ? @image-url("../../../assets/logos/crunchyroll.svg")
        : root.site.name == "Tubi" ? @image-url("../../../assets/logos/tubi.svg")
        : @image-url("../../../assets/logos/netflix.svg");

    property <bool> has-bundled:
        root.site.name == "YouTube TV" || root.site.name == "YouTube" || root.site.name == "Disney+"
        || root.site.name == "Hulu" || root.site.name == "Apple TV" || root.site.name == "Apple TV+"
        || root.site.name == "Netflix" || root.site.name == "Fandango at Home"
        || root.site.name == "Prime Video" || root.site.name == "Crunchyroll" || root.site.name == "Tubi";

    if root.site.has-logo || root.has-bundled: Image {
        width: parent.width * 78%;
        height: parent.height * 68%;
        source: root.site.has-logo ? root.site.logo : root.bundled-logo;
        image-fit: contain;
    }
    if !root.site.has-logo && !root.has-bundled: Text {
        text: root.site.name;
        width: parent.width - 20px;
        font-size: 20px;
        font-weight: 600;
        color: Theme.text-primary;
        horizontal-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component WatchOnTvBox inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.card-radius;
    clip: true;

    VerticalLayout {
        padding: 28px;
        spacing: 16px;

        HorizontalLayout {
            SectionLabel {
                text: "WATCH ON TV · " + Dash.streaming-sites.length + " APPS";
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text {
                text: "Full screen on TV";
                font-size: Theme.label-size;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
        grid := Rectangle {
            vertical-stretch: 1;
            property <int> columns: 2;
            property <int> rows: max(1, Math.ceil(Dash.streaming-sites.length / grid.columns));
            property <length> gap: 12px;
            property <length> tile-w: (self.width - gap) / 2;
            property <length> tile-h: (self.height - (rows - 1) * gap) / rows;

            for site[i] in Dash.streaming-sites: SiteTile {
                x: Math.mod(i, grid.columns) * (grid.tile-w + grid.gap);
                y: Math.floor(i / grid.columns) * (grid.tile-h + grid.gap);
                width: grid.tile-w;
                height: grid.tile-h;
                site: site;
                enabled: Dash.tv-connected;
                clicked => { if Dash.tv-connected { Dash.open-site(site.index); } }
            }
        }
    }
}

// ── Continue Watching (TV / Series · Movies + 3×2 grid) ──────────────

component CwSwitchTab inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    horizontal-stretch: 1;
    height: 48px;
    border-radius: 12px;
    background: root.on ? Theme.text-primary : touch.pressed ? Theme.surface-raised : transparent;
    Text {
        text: root.label;
        font-size: 18px;
        font-weight: 500;
        color: root.on ? Theme.bg : Theme.text-secondary;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ContinueWatchingBox inherits Rectangle {
    callback pick(int);
    background: Theme.surface;
    border-radius: Theme.card-radius;
    clip: true;

    VerticalLayout {
        padding: 28px;
        spacing: 16px;

        HorizontalLayout {
            SectionLabel {
                text: "CONTINUE WATCHING";
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Rectangle {
                min-height: 48px;
                width: see-all.preferred-width + 8px;
                see-all := HorizontalLayout {
                    spacing: 6px;
                    Text { text: "See all"; font-size: 20px; color: link.pressed ? Theme.text-primary : Theme.text-secondary; vertical-alignment: center; }
                    VerticalLayout { alignment: center; Icon { name: "chevron"; tint: Theme.text-secondary; size: 18px; } }
                }
                link := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Library.set-media-tab(Library.media-tab);
                        Nav.page = "library";
                    }
                }
            }
        }

        // Full-width TV / Series · Movies switch (56 px)
        Rectangle {
            height: Theme.hit-target;
            border-radius: Theme.radius;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                CwSwitchTab {
                    label: "TV / Series";
                    on: Dash.cw-filter != "movies";
                    clicked => { Dash.set-cw-filter("tv"); }
                }
                CwSwitchTab {
                    label: "Movies";
                    on: Dash.cw-filter == "movies";
                    clicked => { Dash.set-cw-filter("movies"); }
                }
            }
        }

        if Dash.cw-state == "items": VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            min-height: 0;
            for p in Dash.prompts: PromptBanner {
                data: p;
                action => { Dash.prompt-action(p.source, p.action-id); }
            }
            Flickable {
                vertical-stretch: 1;
                min-height: 0;
                content-height: cw-grid.preferred-height;
                opacity: Dash.tv-connected ? 1.0 : 0.55;
                cw-grid := Rectangle {
                    property <length> gap: 14px;
                    property <length> card-w: (self.width - 2 * gap) / 3;
                    property <length> card-h: card-w * 1.5 + 34px;
                    property <int> rows: Math.ceil(Dash.continue-watching.length / 3);
                    height: max(0px, rows * card-h + max(0, rows - 1) * gap);

                    for c[i] in Dash.continue-watching: PosterCard {
                        x: Math.mod(i, 3) * (cw-grid.card-w + cw-grid.gap);
                        y: Math.floor(i / 3) * (cw-grid.card-h + cw-grid.gap);
                        width: cw-grid.card-w;
                        art-width: cw-grid.card-w;
                        data: c;
                        clicked => { if Dash.tv-connected { root.pick(i); } }
                    }
                }
            }
        }

        if Dash.cw-state != "items": VerticalLayout {
            alignment: center;
            spacing: 18px;
            vertical-stretch: 1;

            if Dash.cw-state == "code": Text {
                text: Dash.signin-code;
                font-size: 72px;
                font-weight: 600;
                letter-spacing: 12px;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            if Dash.cw-state != "prompts": Text {
                text: Dash.cw-state == "loading" ? "Loading…"
                    : Dash.cw-state == "empty" ? "Nothing in progress. Start something and it'll show up here."
                    : Dash.cw-message;
                font-size: Theme.body-size;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if Dash.cw-state == "code" || Dash.cw-state == "busy": HorizontalLayout {
                alignment: center;
                ActionButton { text: "Cancel"; clicked => { Dash.cancel-sign-in(Dash.signin-source); } }
            }
            if Dash.cw-state == "prompts": VerticalLayout {
                spacing: 18px;
                alignment: center;
                for p in Dash.prompts: HorizontalLayout {
                    alignment: center;
                    spacing: 20px;
                    Text {
                        text: p.message;
                        font-size: Theme.body-size;
                        color: p.warn ? Theme.warn : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    ActionButton {
                        text: p.action;
                        primary: !p.warn;
                        clicked => { Dash.prompt-action(p.source, p.action-id); }
                    }
                }
            }
        }
    }
}

export component HomePage inherits VerticalLayout {
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
    spacing: 20px;

    // ── Header ───────────────────────────────────────────────────
    header := HorizontalLayout {
        spacing: 16px;
        min-height: 112px;

        // Left
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                SquareButton {
                    icon: "search";
                    label: "Search";
                    active: Dash.search-open;
                    clicked => {
                        if Dash.search-open {
                            Dash.search-open = false;
                            Watch.query = "";
                            Watch.edited("");
                            Watch.close-detail();
                        } else {
                            Dash.search-open = true;
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                SquareButton {
                    icon: "screensaver";
                    label: "Screensaver";
                    clicked => {
                        Dash.search-open = false;
                        Dash.open-screensaver();
                    }
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Centre: clock + date · divider · weather
        HorizontalLayout {
            alignment: center;
            spacing: 28px;

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Clock {
                    hh: Dash.clock-hh;
                    mm: Dash.clock-mm;
                    ss: Dash.clock-ss;
                    show-seconds: Dash.show-seconds;
                    font-px: 88px;
                }
                Text {
                    text: Dash.weekday + ", " + Dash.date-text;
                    font-size: 20px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle { width: 1px; height: 76px; background: Theme.border; }
            }

            VerticalLayout {
                alignment: center;
                WeatherSummary { }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Right: Theme switch + Settings
        HorizontalLayout {
            spacing: 12px;
            alignment: end;
            VerticalLayout { alignment: center; ThemeSwitch { } }
            VerticalLayout {
                alignment: center;
                SquareButton { icon: "gear"; label: "Settings"; clicked => { Nav.page = "settings"; } }
            }
        }
    }

    // ── Main: three equal 4-column full-height boxes ─────────────
    main := Rectangle {
        vertical-stretch: 1;
        min-height: 0;

        property <length> box-w: (self.width - 2 * Theme.gap) / 3;
        property <int> confirm-index: -1;

        TvCardView {
            x: 0;
            y: 0;
            width: main.box-w;
            height: main.height;
        }

        WatchOnTvBox {
            x: main.box-w + Theme.gap;
            y: 0;
            width: main.box-w;
            height: main.height;
        }

        ContinueWatchingBox {
            x: (main.box-w + Theme.gap) * 2;
            y: 0;
            width: main.box-w;
            height: main.height;
            pick(i) => { main.confirm-index = i; }
        }

        // Slide-in Search panel over Watch on TV and Continue Watching.
        SearchPanel {
            x: main.box-w + Theme.gap + (Dash.search-open ? 0px : 48px);
            y: 0;
            width: main.width - (main.box-w + Theme.gap);
            height: main.height;
            opacity: Dash.search-open ? 1 : 0;
            visible: self.opacity > 0.01;
            animate x { duration: 250ms; easing: ease-out; }
            animate opacity { duration: 250ms; easing: ease-out; }
            close => {
                Dash.search-open = false;
                Watch.query = "";
                Watch.edited("");
                Watch.close-detail();
            }
        }

        if main.confirm-index >= 0 && main.confirm-index < Dash.continue-watching.length: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #0B0D10B3;
            property <PosterCardData> item: Dash.continue-watching[main.confirm-index];
            TouchArea { clicked => { main.confirm-index = -1; } }
            Rectangle {
                width: 580px;
                height: confirm-col.preferred-height + 56px;
                border-radius: Theme.card-radius;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                TouchArea { }
                confirm-col := VerticalLayout {
                    padding: 28px;
                    spacing: 20px;
                    HorizontalLayout {
                        spacing: 20px;
                        Rectangle {
                            width: 104px;
                            height: 156px;
                            border-radius: 12px;
                            clip: true;
                            background: item.placeholder;
                            if item.has-poster: Image { width: parent.width; height: parent.height; source: item.poster; image-fit: cover; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 8px;
                            Text { text: "CONFIRM PLAYBACK"; font-size: 14px; font-weight: 600; color: Theme.text-muted; letter-spacing: 0.8px; }
                            Text { text: item.title; font-size: 24px; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                            if item.subtitle != "": Text { text: item.subtitle; font-size: 18px; color: Theme.text-secondary; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        ActionButton {
                            text: item.progress > 0 ? "Resume on TV" : "Play on TV";
                            icon: "play";
                            primary: true;
                            horizontal-stretch: 1;
                            clicked => {
                                Dash.play-item(main.confirm-index);
                                main.confirm-index = -1;
                            }
                        }
                        if item.progress > 0: ActionButton {
                            text: "Play from start";
                            clicked => {
                                Dash.play-item-from-start(main.confirm-index);
                                main.confirm-index = -1;
                            }
                        }
                        ActionButton {
                            text: "Cancel";
                            clicked => { main.confirm-index = -1; }
                        }
                    }
                }
            }
        }
    }
}
