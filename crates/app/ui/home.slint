import { Theme, UiTheme } from "theme.slint";
import { Icon } from "icons.slint";
import { ActionButton, Clock, PosterRow, ProgressBar, PromptBanner, SectionLabel, SessionLine } from "components.slint";
import { Dash, Nav, SiteEditor, SiteTileData } from "state.slint";

// Laptop dashboard, redesign "Option B": a tall On the TV card tinted from the
// poster on the left; streaming tiles and Continue Watching on the right.
// Touch-first: every control is at least 56 px tall and nothing needs hover.

component ThemeChoice inherits Rectangle {
    in property <UiTheme> mode;
    in property <string> label;
    property <bool> on: Theme.mode == root.mode;
    min-height: Theme.hit-target;
    border-radius: 14px;
    background: root.on ? Theme.text-primary : touch.pressed ? Theme.surface-raised : transparent;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.mode == UiTheme.dark ? "moon" : "sun";
                tint: root.on ? Theme.bg : Theme.text-secondary;
                size: 22px;
            }
        }
        Text {
            text: root.label;
            font-size: 20px;
            font-weight: 500;
            color: root.on ? Theme.bg : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Dash.set-theme(root.mode); }
    }
}

component ThemeSwitch inherits Rectangle {
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: 4px;
        ThemeChoice { mode: UiTheme.dark; label: "Dark"; }
        ThemeChoice { mode: UiTheme.stone; label: "Stone"; }
        ThemeChoice { mode: UiTheme.mist; label: "Mist"; }
    }
}

component WeatherCard inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    min-width: 380px;
    min-height: 104px;
    // Amber dot when the last fetch failed.
    if Dash.weather-warn: Rectangle {
        x: parent.width - 26px;
        y: 14px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.warn;
    }
    HorizontalLayout {
        opacity: Dash.weather-stale ? 0.55 : 1;
        animate opacity { duration: 400ms; }
        padding-left: 28px;
        padding-right: 28px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Icon { name: Dash.weather-on ? Dash.weather-icon : "partly"; tint: Theme.text-secondary; size: 36px; line: 1.6px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: Dash.weather-on ? Dash.weather-temp : "No location";
                font-size: Dash.weather-on ? 34px : 24px;
                color: Theme.text-primary;
            }
            Text {
                text: !Dash.weather-on ? "Set latitude and longitude in config.toml"
                    : Dash.weather-note != "" ? Dash.weather-note : Dash.weather-detail;
                font-size: 18px;
                color: Dash.weather-warn && Dash.weather-note != "" ? Theme.warn : Theme.text-secondary;
                overflow: elide;
                max-width: 300px;
            }
        }
    }
}

component SquareButton inherits Rectangle {
    in property <string> icon;
    in property <string> label; // accessible name
    callback clicked();
    width: 64px;
    height: 64px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.surface-raised : Theme.surface;
    accessible-role: button;
    accessible-label: root.label;
    Icon { name: root.icon; tint: Theme.text-secondary; size: 28px; line: 1.7px; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── On the TV ────────────────────────────────────────────────────────

component TvCardView inherits Rectangle {
    property <bool> playing: Dash.tv.mode == "playing";
    property <bool> streaming: Dash.tv.mode == "streaming";
    property <bool> next: Dash.tv.mode == "next";

    background: Dash.tint.card;
    border-radius: Theme.card-radius;
    animate background { duration: 400ms; }

    // Crossfade (~400 ms) when the card switches to something else.
    property <string> showing: Dash.tv.mode + "|" + Dash.tv.title + "|" + Dash.tv.subtitle;
    property <bool> shown: true;
    changed showing => {
        root.shown = false;
        fade-in.running = true;
    }
    fade-in := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            root.shown = true;
            self.running = false;
        }
    }

    VerticalLayout {
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: root.shown ? 400ms : 100ms; }
        padding: 36px;
        spacing: 24px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon { name: "tv"; tint: Dash.tint.accent; size: 22px; line: 1.75px; }
            }
            Text {
                text: Dash.tv.label;
                font-size: Theme.label-size;
                font-weight: 600;
                letter-spacing: 1.5px;
                color: Dash.tint.accent;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if Dash.tv.source != "": Rectangle {
                width: pill.preferred-width + 28px;
                height: 34px;
                border-radius: 17px;
                border-width: 1px;
                border-color: Dash.tint.edge;
                pill := Text { text: Dash.tv.source; font-size: 18px; color: Dash.tint.sec; }
            }
        }

        HorizontalLayout {
            spacing: 28px;
            vertical-stretch: 1;

            if Dash.tv.mode != "idle": VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 230px;
                    height: 345px;
                    border-radius: 16px;
                    clip: true;
                    background: Dash.tint.poster;
                    if Dash.tv.has-poster: Image {
                        width: parent.width;
                        height: parent.height;
                        source: Dash.tv.poster;
                        image-fit: cover;
                    }
                    if !Dash.tv.has-poster: Text {
                        text: Dash.tv.monogram != "" ? Dash.tv.monogram : Dash.tv.title;
                        width: parent.width - 28px;
                        font-size: Dash.tv.monogram != "" ? 96px : 24px;
                        font-weight: Dash.tv.monogram != "" ? 600 : 400;
                        color: Dash.tint.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            VerticalLayout {
                spacing: 10px;
                alignment: start;
                horizontal-stretch: 1;
                if Dash.tv.note != "": Text {
                    text: Dash.tv.note;
                    font-size: Theme.body-size;
                    color: Dash.tint.sec;
                    wrap: word-wrap;
                }
                Text {
                    text: Dash.tv.title;
                    font-size: 46px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                if Dash.tv.subtitle != "": Text {
                    text: Dash.tv.subtitle;
                    font-size: 24px;
                    color: Dash.tint.sec;
                    wrap: word-wrap;
                }
                if root.playing && Dash.tv.paused: HorizontalLayout {
                    alignment: start;
                    padding-top: 8px;
                    Rectangle {
                        width: paused.preferred-width + 28px;
                        height: 34px;
                        border-radius: 17px;
                        background: Dash.tint.btn;
                        paused := Text { text: "Paused"; font-size: 18px; font-weight: 600; color: Dash.tint.accent; }
                    }
                }
            }
        }

        if (root.playing || root.next) && Dash.tv.at-text != "": VerticalLayout {
            spacing: 10px;
            ProgressBar { height: 10px; value: Dash.tv.progress; fill: Dash.tint.accent; track: Dash.tint.track; }
            HorizontalLayout {
                Text { text: Dash.tv.at-text; font-size: 20px; color: Dash.tint.sec; horizontal-stretch: 1; }
                Text { text: Dash.tv.left-text; font-size: 20px; color: Dash.tint.sec; }
            }
        }

        if root.playing: HorizontalLayout {
            spacing: 14px;
            height: 76px;
            ActionButton {
                icon: "back";
                width: 84px;
                font-px: 26px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                accessible-label: "Back 10 seconds";
                clicked => { Dash.transport("back"); }
            }
            ActionButton {
                text: Dash.tv.paused ? "Resume" : "Pause";
                icon: Dash.tv.paused ? "play" : "pause";
                primary: true;
                font-px: 26px;
                horizontal-stretch: 1;
                fill: Dash.tint.accent;
                ink: Dash.tint.on-accent;
                clicked => { Dash.transport("play-pause"); }
            }
            ActionButton {
                icon: "forward";
                width: 84px;
                font-px: 26px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                accessible-label: "Forward 30 seconds";
                clicked => { Dash.transport("forward"); }
            }
            ActionButton {
                text: "Stop";
                font-px: 24px;
                fill: Dash.tint.btn;
                edge: Dash.tint.edge;
                clicked => { Dash.transport("stop"); }
            }
        }
        if root.streaming: ActionButton {
            height: 76px;
            text: "Close browser";
            icon: "stop";
            primary: true;
            font-px: 26px;
            fill: Dash.tint.accent;
            ink: Dash.tint.on-accent;
            clicked => { Dash.transport("stop"); }
        }
        if root.next: ActionButton {
            height: 76px;
            text: "Resume on TV";
            icon: "play";
            primary: true;
            font-px: 26px;
            fill: Dash.tint.accent;
            ink: Dash.tint.on-accent;
            clicked => { Dash.play-item(0); }
        }

        // Other devices, and servers whose sign-in expired.
        if Dash.sessions.length > 0 || Dash.tv-prompts.length > 0: Rectangle { height: 1px; background: Dash.tint.edge; }
        if Dash.sessions.length > 0: Text {
            text: "ALSO PLAYING";
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 1.5px;
            color: Dash.tint.sec;
        }
        for session in Dash.sessions: SessionLine { data: session; }
        for p in Dash.tv-prompts: PromptBanner {
            data: p;
            fill: Dash.tint.btn;
            action => { Dash.prompt-action(p.source, p.action-id); }
        }
    }
}

// ── Watch on TV ──────────────────────────────────────────────────────

// Tap opens the site on the TV; hold (or right-click) edits it.
component SiteTile inherits Rectangle {
    in property <SiteTileData> site;
    callback clicked();
    callback held();
    property <bool> held-fired;
    border-radius: Theme.radius;
    border-width: touch.pressed ? 2px : 1px;
    border-color: touch.pressed ? Theme.accent : Theme.border;
    background: touch.pressed ? Theme.border : Theme.surface-raised;
    accessible-role: button;
    accessible-label: "Watch " + root.site.name + " on TV";

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 14px;
                clip: true;
                background: root.site.has-logo ? transparent : root.site.bg;
                if root.site.has-logo: Image { width: parent.width; height: parent.height; source: root.site.logo; image-fit: cover; }
                if !root.site.has-logo: Text {
                    text: root.site.monogram;
                    font-size: 26px;
                    font-weight: 600;
                    color: root.site.fg;
                }
            }
        }
        Text {
            text: root.site.name;
            font-size: 18px;
            font-weight: 500;
            color: Theme.text-primary;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.held-fired = e.button == PointerEventButton.right;
                if root.held-fired { root.held(); }
            }
        }
        clicked => {
            if !root.held-fired { root.clicked(); }
        }
    }
    Timer {
        interval: 600ms;
        running: touch.pressed && !root.held-fired;
        triggered => {
            root.held-fired = true;
            root.held();
        }
    }
}

component AddTile inherits Rectangle {
    callback clicked();
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.surface-raised : transparent;
    accessible-role: button;
    accessible-label: "Add service";
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        HorizontalLayout { alignment: center; Icon { name: "plus"; tint: Theme.text-secondary; size: 30px; } }
        Text { text: "Add service"; font-size: 18px; font-weight: 500; color: Theme.text-secondary; horizontal-alignment: center; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Wrapping grid of tiles, five per row, then the Add tile.
component SiteGrid inherits Rectangle {
    property <int> columns: 5;
    property <length> gap: 14px;
    property <length> tile-h: 104px;
    property <length> tile-w: (self.width - (root.columns - 1) * root.gap) / root.columns;
    property <int> count: Dash.streaming-sites.length + 1;
    property <int> rows: Math.ceil(root.count / root.columns);
    height: max(0, root.rows * (root.tile-h + root.gap) - root.gap);

    for site[i] in Dash.streaming-sites: SiteTile {
        x: Math.mod(i, root.columns) * (root.tile-w + root.gap);
        y: Math.floor(i / root.columns) * (root.tile-h + root.gap);
        width: root.tile-w;
        height: root.tile-h;
        site: site;
        clicked => { Dash.open-site(site.index); }
        held => { SiteEditor.edit(site.index); }
    }
    AddTile {
        x: Math.mod(Dash.streaming-sites.length, root.columns) * (root.tile-w + root.gap);
        y: Math.floor(Dash.streaming-sites.length / root.columns) * (root.tile-h + root.gap);
        width: root.tile-w;
        height: root.tile-h;
        clicked => { SiteEditor.add(); }
    }
}

// ── Continue Watching ────────────────────────────────────────────────

component ContinueWatching inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.card-radius;
    clip: true;

    VerticalLayout {
        padding-top: 24px;
        padding-bottom: 24px;
        padding-left: 28px;
        padding-right: 28px;
        spacing: 16px;

        HorizontalLayout {
            SectionLabel {
                text: Dash.cw-state == "items" ? "CONTINUE WATCHING · SWIPE FOR MORE" : "CONTINUE WATCHING";
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Rectangle {
                min-height: 48px;
                width: see-all.preferred-width + 8px;
                see-all := HorizontalLayout {
                    spacing: 6px;
                    Text { text: "See all in Library"; font-size: 20px; color: link.pressed ? Theme.text-primary : Theme.text-secondary; vertical-alignment: center; }
                    VerticalLayout { alignment: center; Icon { name: "chevron"; tint: Theme.text-secondary; size: 18px; } }
                }
                link := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Nav.page = "library"; }
                }
            }
        }

        if Dash.cw-state == "items": VerticalLayout {
            spacing: 14px;
            vertical-stretch: 1;
            // One source missing: slim banner above the row.
            for p in Dash.prompts: PromptBanner {
                data: p;
                action => { Dash.prompt-action(p.source, p.action-id); }
            }
            PosterRow {
                cards: Dash.continue-watching;
                clicked(i) => { Dash.play-item(i); }
            }
            Rectangle { vertical-stretch: 1; }
        }

        if Dash.cw-state != "items": VerticalLayout {
            alignment: center;
            spacing: 18px;
            vertical-stretch: 1;

            if Dash.cw-state == "code": Text {
                text: Dash.signin-code;
                font-size: 72px;
                font-weight: 600;
                letter-spacing: 12px;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            if Dash.cw-state != "prompts": Text {
                text: Dash.cw-state == "loading" ? "Loading…"
                    : Dash.cw-state == "empty" ? "Nothing in progress. Start something and it'll show up here."
                    : Dash.cw-message;
                font-size: Theme.body-size;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if Dash.cw-state == "code" || Dash.cw-state == "busy": HorizontalLayout {
                alignment: center;
                ActionButton { text: "Cancel"; clicked => { Dash.cancel-sign-in(Dash.signin-source); } }
            }
            if Dash.cw-state == "prompts": VerticalLayout {
                spacing: 18px;
                alignment: center;
                for p in Dash.prompts: HorizontalLayout {
                    alignment: center;
                    spacing: 20px;
                    Text {
                        text: p.message;
                        font-size: Theme.body-size;
                        color: p.warn ? Theme.warn : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    ActionButton {
                        text: p.action;
                        primary: !p.warn;
                        clicked => { Dash.prompt-action(p.source, p.action-id); }
                    }
                }
            }
        }
    }
}

export component HomePage inherits VerticalLayout {
    padding-top: 40px;
    padding-bottom: 40px;
    padding-left: 64px;
    padding-right: 64px;
    spacing: Theme.gap;

    // ── Header: clock, theme, weather, Settings ──────────────────
    HorizontalLayout {
        spacing: Theme.gap;
        min-height: 140px;

        HorizontalLayout {
            spacing: 28px;
            VerticalLayout {
                alignment: center;
                Clock {
                    hh: Dash.clock-hh;
                    mm: Dash.clock-mm;
                    ss: Dash.clock-ss;
                    show-seconds: Dash.show-seconds;
                    font-px: Theme.laptop-clock-size;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: Dash.weekday; font-size: 30px; color: Theme.text-primary; }
                Text { text: Dash.date-text; font-size: Theme.body-size; color: Theme.text-secondary; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout { alignment: center; horizontal-stretch: 0; ThemeSwitch { } }
        VerticalLayout { alignment: center; horizontal-stretch: 0; WeatherCard { } }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            SquareButton { icon: "search"; label: "Where to watch"; clicked => { Nav.page = "watch"; } }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            SquareButton { icon: "gear"; label: "Settings"; clicked => { Nav.page = "settings"; } }
        }
    }

    // ── Main: On the TV (5/12) · tiles + Continue Watching (7/12) ─
    // Placed by hand: a layout can't size one column from its own width.
    main := Rectangle {
        vertical-stretch: 1;
        min-height: 640px;

        tv-card := TvCardView {
            x: 0;
            y: 0;
            width: (main.width - Theme.gap) * 5 / 12;
            height: main.height;
        }

        VerticalLayout {
            x: tv-card.width + Theme.gap;
            y: 0;
            width: main.width - self.x;
            height: main.height;
            spacing: Theme.gap;

            Rectangle {
                background: Theme.surface;
                border-radius: Theme.card-radius;
                vertical-stretch: 0;
                VerticalLayout {
                    alignment: start;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 16px;
                    HorizontalLayout {
                        SectionLabel {
                            text: "WATCH ON TV · " + Dash.streaming-sites.length + (Dash.streaming-sites.length == 1 ? " SERVICE" : " SERVICES");
                            horizontal-stretch: 1;
                        }
                        Text { text: "Hold a tile to edit or remove it"; font-size: Theme.label-size; color: Theme.text-muted; }
                    }
                    SiteGrid { }
                }
            }

            ContinueWatching { vertical-stretch: 1; }
        }
    }
}
