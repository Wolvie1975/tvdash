// Blades UI (v3) — Apps page (§9).

import { AppsPage, Dash, HomeState, Nav, QuickSwitch, TvUi } from "../state.slint";
import { SleepChip } from "../shared/sleep.slint";
import { V3Theme } from "theme.slint";

export component V3Apps inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // Header: "Apps" + count on the left, status on the right
    HorizontalLayout {
        x: 40px * TvUi.u;
        y: 28px * TvUi.u;
        height: 52px * TvUi.u;
        spacing: 16px * TvUi.u;
        alignment: start;

        Text {
            text: "Apps";
            font-family: V3Theme.font;
            font-size: 42px * TvUi.u;
            font-weight: 900;
            color: V3Theme.text-primary;
            vertical-alignment: bottom;
        }

        Text {
            text: AppsPage.apps.length + (AppsPage.apps.length == 1 ? " app" : " apps");
            font-family: V3Theme.font;
            font-size: 22px * TvUi.u;
            font-weight: 700;
            color: V3Theme.text-secondary;
            vertical-alignment: bottom;
            y: -4px * TvUi.u;
        }
    }

    HorizontalLayout {
        x: parent.width - 40px * TvUi.u - self.preferred-width;
        y: 38px * TvUi.u;
        spacing: 20px * TvUi.u;
        alignment: end;

        SleepChip {
            ink: V3Theme.accent;
            clickable: Nav.layout == "dual";
            y: (parent.height - self.height) / 2;
        }

        if Dash.weather-on: Text {
            text: Dash.weather-temp;
            font-family: V3Theme.font;
            font-size: 20px * TvUi.u;
            font-weight: 600;
            color: V3Theme.text-primary;
        }

        Text {
            text: Dash.clock-hh + ":" + Dash.clock-mm + (Dash.clock-ampm != "" ? " " + Dash.clock-ampm : "");
            font-family: V3Theme.font;
            font-size: 20px * TvUi.u;
            font-weight: 600;
            color: V3Theme.text-primary;
        }
    }

    if AppsPage.apps.length == 0: Text {
        x: 40px * TvUi.u;
        y: 120px * TvUi.u;
        text: "No streaming apps configured.";
        font-family: V3Theme.font;
        font-size: 22px * TvUi.u;
        color: V3Theme.text-secondary;
    }

    // Compact top strip: Last played + Quick Switch
    if AppsPage.has-last-app: Rectangle {
        property <bool> is-foc: (!TvUi.bar-focused && TvUi.focused-tile == AppsPage.apps.length + 1) || last-ta.has-hover;
        x: 40px * TvUi.u;
        y: 94px * TvUi.u;
        width: 440px * TvUi.u;
        height: 82px * TvUi.u;
        border-radius: 16px * TvUi.u;
        background: V3Theme.surface;
        border-width: is-foc ? 4px : 1px;
        border-color: is-foc ? V3Theme.focus-ring : V3Theme.border;

        HorizontalLayout {
            padding-left: 14px * TvUi.u;
            padding-right: 16px * TvUi.u;
            spacing: 14px * TvUi.u;
            alignment: start;

            if AppsPage.last-app-has-logo: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 84px * TvUi.u;
                    height: 52px * TvUi.u;
                    border-radius: 10px * TvUi.u;
                    background: AppsPage.last-app-bg;
                    Image {
                        x: 10px * TvUi.u;
                        y: 8px * TvUi.u;
                        width: parent.width - 20px * TvUi.u;
                        height: parent.height - 16px * TvUi.u;
                        source: AppsPage.last-app-logo;
                        image-fit: contain;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px * TvUi.u;
                horizontal-stretch: 1;

                Text {
                    text: "LAST PLAYED · " + AppsPage.last-app-name;
                    font-family: V3Theme.font;
                    font-size: 16px * TvUi.u;
                    font-weight: 800;
                    color: V3Theme.text-primary;
                    overflow: elide;
                }

                Text {
                    text: AppsPage.last-app-ago != "" ? (AppsPage.last-app-ago + " · OK to open") : "OK to open";
                    font-family: V3Theme.font;
                    font-size: 14px * TvUi.u;
                    font-weight: 600;
                    color: V3Theme.text-secondary;
                    overflow: elide;
                }
            }
        }

        last-ta := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if self.has-hover {
                    TvUi.tile-hovered(AppsPage.apps.length + 1);
                }
            }
            clicked => { HomeState.launch-app(AppsPage.last-app-id); }
        }
    }

    if AppsPage.apps.length > 0: Rectangle {
        x: (AppsPage.has-last-app ? 496px : 40px) * TvUi.u;
        y: 94px * TvUi.u;
        width: (AppsPage.has-last-app ? 986px : 1442px) * TvUi.u;
        height: 82px * TvUi.u;
        border-radius: 16px * TvUi.u;
        background: V3Theme.surface;
        border-width: 1px;
        border-color: V3Theme.border;

        HorizontalLayout {
            padding-left: 18px * TvUi.u;
            padding-right: 14px * TvUi.u;
            spacing: 14px * TvUi.u;

            VerticalLayout {
                alignment: center;
                spacing: 2px * TvUi.u;
                Text {
                    text: "QUICK SWITCH";
                    font-family: V3Theme.font;
                    font-size: 13px * TvUi.u;
                    font-weight: 800;
                    letter-spacing: 1.2px;
                    color: V3Theme.text-secondary;
                }
                Text {
                    text: QuickSwitch.automatic ? "Automatic" : "Custom";
                    font-family: V3Theme.font;
                    font-size: 15px * TvUi.u;
                    font-weight: 800;
                    color: V3Theme.accent;
                }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                alignment: start;

                for choice in QuickSwitch.choices: Rectangle {
                    width: choice.slot > 0 ? 154px * TvUi.u : 0px;
                    height: 82px * TvUi.u;
                    clip: true;
                    background: transparent;

                    if choice.slot > 0: Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        height: 44px * TvUi.u;
                        width: 146px * TvUi.u;
                        border-radius: 22px * TvUi.u;
                        background: V3Theme.panel;
                        border-width: 1px;
                        border-color: V3Theme.border;
                        clip: true;

                        choice-row := HorizontalLayout {
                            padding-left: 8px * TvUi.u;
                            padding-right: 10px * TvUi.u;
                            spacing: 6px * TvUi.u;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px * TvUi.u;
                                    height: 22px * TvUi.u;
                                    border-radius: 11px * TvUi.u;
                                    background: #F5A524;
                                    Text {
                                        text: choice.slot;
                                        font-family: V3Theme.font;
                                        font-size: 12px * TvUi.u;
                                        font-weight: 800;
                                        color: #1A1200;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if choice.brand.has-logo: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px * TvUi.u;
                                    height: 22px * TvUi.u;
                                    border-radius: 4px;
                                    background: choice.brand.fill;
                                    Image {
                                        x: 3px * TvUi.u;
                                        y: 2px * TvUi.u;
                                        width: parent.width - 6px * TvUi.u;
                                        height: parent.height - 4px * TvUi.u;
                                        source: choice.brand.logo;
                                        image-fit: contain;
                                    }
                                }
                            }

                            Text {
                                text: choice.name;
                                font-family: V3Theme.font;
                                font-size: 14px * TvUi.u;
                                font-weight: 700;
                                color: V3Theme.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    property <bool> is-foc: (!TvUi.bar-focused && TvUi.focused-tile == AppsPage.apps.length) || qs-ta.has-hover;
                    width: 196px * TvUi.u;
                    height: 48px * TvUi.u;
                    border-radius: 12px * TvUi.u;
                    background: is-foc ? V3Theme.accent : V3Theme.panel;
                    border-width: is-foc ? 3px : 1px;
                    border-color: is-foc ? V3Theme.focus-ring : V3Theme.border;

                    Text {
                        text: "Adjust in Settings ›";
                        font-family: V3Theme.font;
                        font-size: 16px * TvUi.u;
                        font-weight: 800;
                        color: is-foc ? #FFFFFF : V3Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    qs-ta := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover {
                                TvUi.tile-hovered(AppsPage.apps.length);
                            }
                        }
                        clicked => { QuickSwitch.open-picker(); }
                    }
                }
            }
        }
    }

    if AppsPage.apps.length > 0: Rectangle {
        x: 0;
        y: 194px * TvUi.u;
        width: parent.width;
        height: parent.height - 194px * TvUi.u;
        clip: true;
        background: transparent;

        TouchArea {
            scroll-event(event) => {
                TvUi.scroll-panorama(event.delta-y);
                accept
            }
        }

        Rectangle {
            x: 0;
            y: -TvUi.lib-scroll * TvUi.u;
            width: parent.width;
            height: (Math.ceil(AppsPage.apps.length / 4) * 218px + 40px) * TvUi.u;
            background: transparent;
            animate y { duration: 150ms; easing: ease-out; }

            for app[i] in AppsPage.apps: Rectangle {
                property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == i;
                x: (40px + Math.mod(i, 4) * 366px) * TvUi.u;
                y: (6px + Math.floor(i / 4) * 218px) * TvUi.u;
                width: 344px * TvUi.u;
                height: 204px * TvUi.u;
                background: transparent;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 344px * TvUi.u;
                    height: 166px * TvUi.u;
                    border-radius: 20px * TvUi.u;
                    clip: true;
                    background: app.color;
                    border-width: (parent.is-foc || app-ta.has-hover) ? 4px : 1px;
                    border-color: (parent.is-foc || app-ta.has-hover) ? V3Theme.focus-ring : V3Theme.border;

                    if app.has-logo: Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: parent.width * (app.logo-wide ? 0.88 : 0.70);
                        height: parent.height * (app.logo-wide ? 0.62 : 0.50);
                        source: app.logo;
                        image-fit: contain;
                    }

                    if !app.has-logo: Text {
                        x: 16px * TvUi.u;
                        y: 0;
                        width: parent.width - 32px * TvUi.u;
                        height: parent.height;
                        text: app.name;
                        font-family: V3Theme.font;
                        font-size: 21px * TvUi.u;
                        font-weight: 900;
                        color: app.text-color;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                Text {
                    x: 4px * TvUi.u;
                    y: 174px * TvUi.u;
                    width: parent.width - 8px * TvUi.u;
                    text: app.name;
                    font-family: V3Theme.font;
                    font-size: 20px * TvUi.u;
                    font-weight: 800;
                    color: V3Theme.text-primary;
                    overflow: elide;
                }

                app-ta := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if self.has-hover {
                            TvUi.tile-hovered(i);
                        }
                    }
                    clicked => { HomeState.launch-app(app.id); }
                }
            }
        }

        // Bottom fade when more than 12 apps
        if AppsPage.apps.length > 12: Rectangle {
            x: 0;
            y: parent.height - 48px * TvUi.u;
            width: parent.width;
            height: 48px * TvUi.u;
            background: @linear-gradient(180deg, transparent 0%, V3Theme.panel 100%);
        }
    }
}
