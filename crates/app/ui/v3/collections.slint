// Blades UI (v3) — Collections panel.

import { Dash, Library, Nav, TvUi } from "../state.slint";
import { SleepChip } from "../shared/sleep.slint";
import { V3Theme } from "theme.slint";

export component V3Collections inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    Text {
        x: 40px * TvUi.u;
        y: 30px * TvUi.u;
        text: "Collections";
        font-family: V3Theme.font;
        font-size: 38px * TvUi.u;
        font-weight: 700;
        color: V3Theme.text-primary;
    }

    HorizontalLayout {
        x: parent.width - 40px * TvUi.u - self.preferred-width;
        y: 38px * TvUi.u;
        spacing: 20px * TvUi.u;
        alignment: end;

        SleepChip {
            ink: V3Theme.accent;
            clickable: Nav.layout == "dual";
            y: (parent.height - self.height) / 2;
        }

        if Dash.weather-on: Text {
            text: Dash.weather-temp;
            font-family: V3Theme.font;
            font-size: 20px * TvUi.u;
            font-weight: 600;
            color: V3Theme.text-primary;
        }
        Text {
            text: Dash.clock-hh + ":" + Dash.clock-mm + (Dash.clock-ampm != "" ? " " + Dash.clock-ampm : "");
            font-family: V3Theme.font;
            font-size: 20px * TvUi.u;
            font-weight: 600;
            color: V3Theme.text-primary;
        }
    }

    if Library.collections.length == 0: Text {
        x: 40px * TvUi.u;
        y: 120px * TvUi.u;
        text: "No movie collections found.";
        font-family: V3Theme.font;
        font-size: 22px * TvUi.u;
        color: V3Theme.text-secondary;
    }

    if Library.collections.length > 0: Rectangle {
        x: 0;
        y: 100px * TvUi.u;
        width: parent.width;
        height: parent.height - 100px * TvUi.u;
        clip: true;
        background: transparent;

        TouchArea {
            scroll-event(event) => {
                TvUi.scroll-panorama(event.delta-y);
                accept
            }
        }

        Rectangle {
            x: 0;
            y: -TvUi.lib-scroll * TvUi.u;
            width: parent.width;
            height: (Math.ceil(Library.collections.length / 7) * 356px + 40px) * TvUi.u;
            background: transparent;
            animate y { duration: 150ms; easing: ease-out; }

            // 7-column poster grid (190 x 280 + title/detail below, fits inside 1532 px panel)
            for col[i] in Library.collections: Rectangle {
                property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == i;
                x: (40px + Math.mod(i, 7) * 210px) * TvUi.u;
                y: (12px + Math.floor(i / 7) * 352px) * TvUi.u;
                width: 190px * TvUi.u;
                height: 336px * TvUi.u;
                background: transparent;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 190px * TvUi.u;
                    height: 280px * TvUi.u;
                    border-radius: 14px * TvUi.u;
                    clip: true;
                    background: V3Theme.surface;
                    border-width: parent.is-foc ? 4px : 1px;
                    border-color: parent.is-foc ? V3Theme.focus-ring : V3Theme.border;

                    if col.has-poster: Image {
                        source: col.poster;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }

                    if col.progress > 0: Rectangle {
                        x: 0;
                        y: parent.height - 5px * TvUi.u;
                        width: parent.width;
                        height: 5px * TvUi.u;
                        background: #FFFFFF30;
                        Rectangle {
                            width: parent.width * clamp(col.progress, 0.0, 1.0);
                            height: 100%;
                            background: V3Theme.accent;
                        }
                    }
                }

                Text {
                    x: 2px * TvUi.u;
                    y: 288px * TvUi.u;
                    width: parent.width - 4px * TvUi.u;
                    text: col.title;
                    font-family: V3Theme.font;
                    font-size: 16px * TvUi.u;
                    font-weight: 700;
                    color: V3Theme.text-primary;
                    overflow: elide;
                }

                if col.detail != "": Text {
                    x: 2px * TvUi.u;
                    y: 310px * TvUi.u;
                    width: parent.width - 4px * TvUi.u;
                    text: col.detail;
                    font-family: V3Theme.font;
                    font-size: 14px * TvUi.u;
                    color: V3Theme.text-secondary;
                    overflow: elide;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { TvUi.tile-activated(i); }
                    changed has-hover => { if self.has-hover { TvUi.tile-hovered(i); } }
                }
            }
        }
    }
}
