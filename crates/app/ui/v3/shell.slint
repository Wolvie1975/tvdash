// Blades UI (v3) shell. Design units: 1920 x 1080, scaled via TvUi.u.

import { Icon } from "../icons.slint";
import { Dash, Library, Nav, TvUi } from "../state.slint";
import { SleepChip } from "../shared/sleep.slint";
import { V3Theme } from "theme.slint";
import { BladeStrip } from "blades.slint";
import { V3Home } from "home.slint";
import { V3Apps } from "apps.slint";
import { V3Library } from "library.slint";
import { V3Collections } from "collections.slint";
import { V3Show } from "show.slint";
import { V3Collection } from "collection.slint";
import { V3Search } from "search.slint";
import { V3Sports } from "events.slint";
import { V3Settings } from "settings.slint";
import { V3PlayerHud } from "player_hud.slint";
import { TvDashboardPicker } from "../tv/dashboard_picker.slint";
import { QuickSwitchPicker } from "../shared/quick_switch_picker.slint";
import { Theme } from "../theme.slint";
import { V3Ambient } from "ambient.slint";
import { Intro, IntroStage } from "../shared/intro.slint";
import { BladesIntro } from "intro_blades.slint";

export component V3Shell inherits Rectangle {
    width: 100%;
    height: 100%;
    background: V3Theme.bg;

    property <float> scale: max(0.5, min(root.width / 1920px, root.height / 1080px));
    changed scale => { TvUi.u = self.scale; }
    init => { TvUi.u = self.scale; }

    property <int> focus-ticket: TvUi.focus-ticket;
    changed focus-ticket => { keys.focus(); }

    property <bool> is-subpage: TvUi.screen == "show" || TvUi.screen == "collection" || TvUi.screen == "search";
    property <int> parent-tab: TvUi.screen == "show" ? 2 : TvUi.screen == "collection" ? 3 : 0;
    property <int> eff-active: root.is-subpage ? root.parent-tab : TvUi.active-tab;
    property <int> left-count: root.is-subpage ? (root.eff-active + 1) : root.eff-active;
    property <length> panel-x: (24px + root.left-count * 68px) * TvUi.u;
    property <length> panel-w: (root.is-subpage ? 1464px : 1532px) * TvUi.u;
    property <float> widen: Intro.revealing ? 1.0 : 0.0;
    animate widen {
        duration: Intro.instant ? 0ms : 550ms;
        delay: Intro.instant ? 0ms : 900ms;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    property <length> panel-intro-dx: Intro.revealing ? 0px : 1920px * TvUi.u;
    property <float> panel-intro-op: Intro.revealing ? 1.0 : 0.0;
    animate panel-intro-dx, panel-intro-op {
        duration: Intro.instant ? 0ms : 550ms;
        delay: Intro.instant ? 0ms : 200ms;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    property <length> cur-panel-w: 60px * TvUi.u + (root.panel-w - 60px * TvUi.u) * root.widen;

    keys := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if TvUi.key(event.text) {
                accept
            } else {
                reject
            }
        }
    }

    // In-window full-screen video when playing on TV
    if TvUi.video-on && TvUi.video-full: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;

        Image {
            source: TvUi.video;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }

        TouchArea {
            clicked => {
                TvUi.hud-open = !TvUi.hud-open;
                if TvUi.hud-open {
                    TvUi.focused-tile = 1;
                }
                TvUi.overlay();
            }
            moved => {
                if !TvUi.hud-open {
                    TvUi.focused-tile = 1;
                    TvUi.hud-open = true;
                    TvUi.overlay();
                }
            }
        }

        if TvUi.hud-open: V3PlayerHud { }
    }

    // ── Blades Shell (hidden while full-screen video is active) ──────────────
    if !(TvUi.video-on && TvUi.video-full) && (TvUi.screen == "dashboard_picker" || TvUi.screen == "quick_switch_picker"): Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 1920px * TvUi.u;
        height: 1080px * TvUi.u;
        background: Theme.bg;

        if TvUi.screen == "dashboard_picker": TvDashboardPicker { width: 100%; height: 100%; }
        if TvUi.screen == "quick_switch_picker": QuickSwitchPicker { width: parent.width; height: parent.height; }

        Rectangle {
            x: 96px * TvUi.u;
            y: 52px * TvUi.u;
            width: v3-pick-back.preferred-width + 32px * TvUi.u;
            height: 46px * TvUi.u;
            border-radius: 23px * TvUi.u;
            background: v3-pick-ta.has-hover ? Theme.surface-raised : Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            v3-pick-back := Text {
                text: "← Back";
                font-size: 22px * TvUi.u;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            v3-pick-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { TvUi.back-clicked(); }
            }
        }
    }

    if !(TvUi.video-on && TvUi.video-full) && TvUi.screen != "dashboard_picker" && TvUi.screen != "quick_switch_picker": Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 1920px * TvUi.u;
        height: 1080px * TvUi.u;
        background: V3Theme.bg;

        // Left Blades
        for tab[i] in [
            { idx: 0, label: "home" },
            { idx: 1, label: "apps" },
            { idx: 2, label: "library" },
            { idx: 3, label: "collections" },
            { idx: 4, label: "sports" },
            { idx: 5, label: "settings" },
        ]: BladeStrip {
            visible: root.is-subpage ? (i <= root.eff-active) : (i < root.eff-active);
            x: (24px + i * 68px) * TvUi.u;
            y: 24px * TvUi.u;
            label: tab.label;
            is-left: true;
            near-active: i == root.left-count - 1;
            parent-tinted: root.is-subpage && i == root.eff-active;
            focused: TvUi.bar-focused && TvUi.active-tab == i;
            clicked => { TvUi.tab-clicked(i); }
        }

        // Active Rounded Panel
        active-panel := Rectangle {
            x: root.panel-x + root.panel-intro-dx;
            y: 24px * TvUi.u;
            width: root.cur-panel-w;
            height: 1032px * TvUi.u;
            opacity: root.panel-intro-op;
            border-radius: 18px * TvUi.u;
            clip: true;
            background: V3Theme.panel;
            border-width: 1px;
            border-color: V3Theme.border;

            if TvUi.screen == "home": V3Home { }
            if TvUi.screen == "apps": V3Apps { }
            if TvUi.screen == "collections": V3Collections { }
            if TvUi.screen == "library": V3Library { }
            if TvUi.screen == "show": V3Show { }
            if TvUi.screen == "collection": V3Collection { }
            if TvUi.screen == "search": V3Search { }
            if TvUi.screen == "sports": V3Sports { }
            if TvUi.screen == "settings": V3Settings { }

            // Sub-page top bar: < Back pill + breadcrumb + Weather/Clock
            if root.is-subpage: Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 84px * TvUi.u;
                background: transparent;

                Rectangle {
                    x: 40px * TvUi.u;
                    y: 26px * TvUi.u;
                    width: back-lbl.preferred-width + 32px * TvUi.u;
                    height: 38px * TvUi.u;
                    border-radius: 19px * TvUi.u;
                    background: back-ta.has-hover ? V3Theme.surface-raised : V3Theme.surface;
                    border-width: 1px;
                    border-color: V3Theme.border;

                    back-lbl := Text {
                        text: "‹  Back";
                        font-family: V3Theme.font;
                        font-size: 16px * TvUi.u;
                        font-weight: 700;
                        color: V3Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    back-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { TvUi.back-clicked(); }
                    }
                }

                Text {
                    x: 156px * TvUi.u;
                    y: 34px * TvUi.u;
                    text: TvUi.screen == "show"
                        ? ("Library › " + (Library.media-tab == "movies" ? "Movies" : "TV Series"))
                        : TvUi.screen == "collection"
                            ? "Collections"
                            : "Search";
                    font-family: V3Theme.font;
                    font-size: 16px * TvUi.u;
                    font-weight: 600;
                    color: V3Theme.text-secondary;
                }

                HorizontalLayout {
                    x: parent.width - 40px * TvUi.u - self.preferred-width;
                    y: 34px * TvUi.u;
                    spacing: 20px * TvUi.u;
                    alignment: end;

                    SleepChip {
                        ink: V3Theme.accent;
                        clickable: Nav.layout == "dual";
                        y: (parent.height - self.height) / 2;
                    }

                    if Dash.weather-on: Text {
                        text: Dash.weather-temp;
                        font-family: V3Theme.font;
                        font-size: 20px * TvUi.u;
                        font-weight: 600;
                        color: V3Theme.text-primary;
                    }
                    Text {
                        text: Dash.clock-hh + ":" + Dash.clock-mm + (Dash.clock-ampm != "" ? " " + Dash.clock-ampm : "");
                        font-family: V3Theme.font;
                        font-size: 20px * TvUi.u;
                        font-weight: 600;
                        color: V3Theme.text-primary;
                    }
                }
            }
        }

        // Right Blades
        for tab[i] in [
            { idx: 0, label: "home" },
            { idx: 1, label: "apps" },
            { idx: 2, label: "library" },
            { idx: 3, label: "collections" },
            { idx: 4, label: "sports" },
            { idx: 5, label: "settings" },
        ]: BladeStrip {
            visible: i > root.eff-active;
            x: active-panel.x + active-panel.width + 10px * TvUi.u + (i - root.eff-active - 1) * 68px * TvUi.u + self.intro-dx;
            y: 24px * TvUi.u;
            label: tab.label;
            is-left: false;
            near-active: i == root.eff-active + 1;
            focused: TvUi.bar-focused && TvUi.active-tab == i;
            intro-delay: 300ms + (i - 1) * 90ms;
            clicked => { TvUi.tab-clicked(i); }
        }
    }

    // Up Next prompt after an episode finishes
    if Dash.next-ep-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000B0;

        TouchArea {
            clicked => { Dash.dismiss-next-ep(); }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 780px * TvUi.u;
            height: 360px * TvUi.u;
            border-radius: 20px * TvUi.u;
            background: V3Theme.surface;
            border-width: 1px;
            border-color: V3Theme.border;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: #000000B0;

            TouchArea { }

            VerticalLayout {
                padding: 28px * TvUi.u;
                spacing: 20px * TvUi.u;

                Text {
                    text: "UP NEXT";
                    font-family: V3Theme.font;
                    font-size: 16px * TvUi.u;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    color: V3Theme.accent;
                }

                HorizontalLayout {
                    spacing: 22px * TvUi.u;
                    vertical-stretch: 1;

                    if Dash.next-ep-has-poster: Rectangle {
                        width: 128px * TvUi.u;
                        height: 180px * TvUi.u;
                        border-radius: 10px * TvUi.u;
                        clip: true;

                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: Dash.next-ep-poster;
                            image-fit: cover;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px * TvUi.u;
                        horizontal-stretch: 1;

                        Text {
                            text: Dash.next-ep-title;
                            font-family: V3Theme.font;
                            font-size: 28px * TvUi.u;
                            font-weight: 700;
                            color: V3Theme.text-primary;
                            wrap: word-wrap;
                        }

                        if Dash.next-ep-subtitle != "": Text {
                            text: Dash.next-ep-subtitle;
                            font-family: V3Theme.font;
                            font-size: 20px * TvUi.u;
                            color: V3Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px * TvUi.u;
                    alignment: end;

                    Rectangle {
                        width: 150px * TvUi.u;
                        height: 52px * TvUi.u;
                        border-radius: 12px * TvUi.u;
                        background: dis-ta.has-hover ? V3Theme.surface-raised : transparent;
                        border-width: 1px;
                        border-color: V3Theme.border;
                        Text {
                            text: "Dismiss";
                            font-family: V3Theme.font;
                            font-size: 18px * TvUi.u;
                            font-weight: 600;
                            color: V3Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        dis-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Dash.dismiss-next-ep(); }
                        }
                    }

                    Rectangle {
                        width: 210px * TvUi.u;
                        height: 52px * TvUi.u;
                        border-radius: 12px * TvUi.u;
                        background: V3Theme.accent;
                        Text {
                            text: "Play next episode";
                            font-family: V3Theme.font;
                            font-size: 18px * TvUi.u;
                            font-weight: 700;
                            color: V3Theme.on-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Dash.play-next-ep(); }
                        }
                    }
                }
            }
        }
    }

    // Ambient screensaver overlay
    if TvUi.ambient || Dash.screensaver-open: V3Ambient {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if Intro.stage != IntroStage.done: BladesIntro {
        width: 100%;
        height: 100%;
    }
}
