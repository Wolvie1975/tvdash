// Blades UI (v3) — Show detail panel.

import { Icon } from "../icons.slint";
import { ShowPageState, TvUi } from "../state.slint";
import { V3Theme } from "theme.slint";

export component V3Show inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    property <int> season-count: ShowPageState.seasons.length;
    property <int> grid-base: 2 + root.season-count;

    // Top-right backdrop with smooth horizontal & vertical fade into panel
    if ShowPageState.has-backdrop: Rectangle {
        x: parent.width - 960px * TvUi.u;
        y: 0;
        width: 960px * TvUi.u;
        height: 480px * TvUi.u;
        border-top-right-radius: 18px * TvUi.u;
        clip: true;

        Image {
            width: parent.width;
            height: parent.height;
            source: ShowPageState.backdrop;
            image-fit: cover;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(90deg, V3Theme.panel 0%, V3Theme.panel.with-alpha(0.55) 40%, transparent 100%);
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(180deg, transparent 50%, V3Theme.panel 100%);
        }
    }

    // Scrollable main content below top Back/Clock bar (y: 90px)
    Rectangle {
        x: 0;
        y: 90px * TvUi.u;
        width: parent.width;
        height: parent.height - 90px * TvUi.u;
        clip: true;
        background: transparent;

        TouchArea {
            scroll-event(event) => {
                TvUi.scroll-panorama(event.delta-y);
                accept
            }
        }

        // Scrollable Episode Grid (right column)
        Rectangle {
            x: 360px * TvUi.u;
            y: 356px * TvUi.u - TvUi.show-scroll * TvUi.u;
            width: parent.width - 400px * TvUi.u;
            height: (Math.ceil((ShowPageState.episodes.length + (ShowPageState.next-season-label != "" ? 1 : 0)) / 3) * 284px + 60px) * TvUi.u;
            background: transparent;
            animate y { duration: 150ms; easing: ease-out; }

            for ep[i] in ShowPageState.episodes: Rectangle {
                property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == root.grid-base + i;
                x: Math.mod(i, 3) * 384px * TvUi.u;
                y: Math.floor(i / 3) * 280px * TvUi.u;
                width: 366px * TvUi.u;
                height: 264px * TvUi.u;
                background: transparent;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 366px * TvUi.u;
                    height: 204px * TvUi.u;
                    border-radius: 14px * TvUi.u;
                    clip: true;
                    background: V3Theme.surface;
                    border-width: parent.is-foc ? 4px : 1px;
                    border-color: parent.is-foc ? V3Theme.focus-ring : V3Theme.border;

                    if ep.has-thumb: Image {
                        source: ep.thumb;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }

                    if ep.can-resume: Rectangle {
                        x: 10px * TvUi.u;
                        y: 10px * TvUi.u;
                        width: un-lbl.preferred-width + 16px * TvUi.u;
                        height: 24px * TvUi.u;
                        border-radius: 6px * TvUi.u;
                        background: V3Theme.accent;
                        un-lbl := Text {
                            text: "UP NEXT";
                            font-family: V3Theme.font;
                            font-size: 11px * TvUi.u;
                            font-weight: 700;
                            color: V3Theme.on-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if ep.watched: Rectangle {
                        x: parent.width - 34px * TvUi.u;
                        y: 10px * TvUi.u;
                        width: 24px * TvUi.u;
                        height: 24px * TvUi.u;
                        border-radius: 12px * TvUi.u;
                        background: #FFFFFFEE;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "check";
                            size: 14px * TvUi.u;
                            tint: #0B0D10;
                        }
                    }

                    if ep.progress > 0 && !ep.watched: Rectangle {
                        x: 0;
                        y: parent.height - 5px * TvUi.u;
                        width: parent.width;
                        height: 5px * TvUi.u;
                        background: #FFFFFF30;
                        Rectangle {
                            width: parent.width * clamp(ep.progress, 0.0, 1.0);
                            height: 100%;
                            background: V3Theme.accent;
                        }
                    }
                }

                Text {
                    x: 2px * TvUi.u;
                    y: 212px * TvUi.u;
                    width: parent.width - 4px * TvUi.u;
                    text: (ep.num != "" ? ep.num + " · " : "") + ep.title;
                    font-family: V3Theme.font;
                    font-size: 17px * TvUi.u;
                    font-weight: 700;
                    color: V3Theme.text-primary;
                    overflow: elide;
                }

                if ep.meta != "": Text {
                    x: 2px * TvUi.u;
                    y: 236px * TvUi.u;
                    width: parent.width - 4px * TvUi.u;
                    text: ep.meta;
                    font-family: V3Theme.font;
                    font-size: 14px * TvUi.u;
                    color: V3Theme.text-secondary;
                    overflow: elide;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { TvUi.tile-activated(root.grid-base + i); }
                    changed has-hover => { if self.has-hover { TvUi.tile-hovered(root.grid-base + i); } }
                }
            }

            if ShowPageState.next-season-label != "": Rectangle {
                property <int> idx: ShowPageState.episodes.length;
                property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == root.grid-base + idx;
                x: Math.mod(idx, 3) * 384px * TvUi.u;
                y: Math.floor(idx / 3) * 280px * TvUi.u;
                width: 366px * TvUi.u;
                height: 204px * TvUi.u;
                border-radius: 14px * TvUi.u;
                background: V3Theme.surface;
                border-width: self.is-foc ? 4px : 1px;
                border-color: self.is-foc ? V3Theme.focus-ring : V3Theme.border;

                Text {
                    text: "Continue to " + ShowPageState.next-season-label + " ›";
                    font-family: V3Theme.font;
                    font-size: 18px * TvUi.u;
                    font-weight: 700;
                    color: V3Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { TvUi.tile-activated(root.grid-base + idx); }
                }
            }
        }

        // Top Show Header (collapses slightly when scrolled)
        if !ShowPageState.scrolled: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 350px * TvUi.u;
            background: transparent;

            VerticalLayout {
                x: 40px * TvUi.u;
                y: 8px * TvUi.u;
                width: 820px * TvUi.u;
                spacing: 10px * TvUi.u;
                alignment: start;

                Text {
                    text: ShowPageState.title;
                    font-family: V3Theme.font;
                    font-size: 54px * TvUi.u;
                    font-weight: 700;
                    color: V3Theme.text-primary;
                    overflow: elide;
                }

                if ShowPageState.meta != "": Text {
                    text: ShowPageState.meta;
                    font-family: V3Theme.font;
                    font-size: 16px * TvUi.u;
                    font-weight: 600;
                    color: V3Theme.text-secondary;
                    overflow: elide;
                }

                if ShowPageState.summary != "": Text {
                    width: 680px * TvUi.u;
                    height: 68px * TvUi.u;
                    text: ShowPageState.summary;
                    font-family: V3Theme.font;
                    font-size: 17px * TvUi.u;
                    color: V3Theme.text-secondary;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            // 0: Resume / Play next
            Rectangle {
                property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == 0;
                x: 40px * TvUi.u;
                y: 214px * TvUi.u;
                width: res-row.preferred-width + 44px * TvUi.u;
                height: 52px * TvUi.u;
                border-radius: 26px * TvUi.u;
                background: V3Theme.accent;
                border-width: self.is-foc ? 4px : 0px;
                border-color: V3Theme.text-primary;

                res-row := HorizontalLayout {
                    x: 22px * TvUi.u;
                    height: parent.height;
                    spacing: 10px * TvUi.u;
                    Icon {
                        name: "play";
                        size: 18px * TvUi.u;
                        tint: V3Theme.on-accent;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: (ShowPageState.can-resume ? "Resume " : "Play ") + (ShowPageState.up-next != "" ? ShowPageState.up-next : "next");
                        font-family: V3Theme.font;
                        font-size: 18px * TvUi.u;
                        font-weight: 700;
                        color: V3Theme.on-accent;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { TvUi.tile-activated(0); }
                }
            }

            // 1: From S1 · E1
            Rectangle {
                property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == 1;
                x: 340px * TvUi.u;
                y: 214px * TvUi.u;
                width: 170px * TvUi.u;
                height: 52px * TvUi.u;
                border-radius: 26px * TvUi.u;
                background: V3Theme.surface;
                border-width: self.is-foc ? 4px : 1px;
                border-color: self.is-foc ? V3Theme.focus-ring : V3Theme.border;

                Text {
                    text: "From S1 · E1";
                    font-family: V3Theme.font;
                    font-size: 17px * TvUi.u;
                    font-weight: 700;
                    color: V3Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { TvUi.tile-activated(1); }
                }
            }

            // 2..2+season_n: Season pills
            HorizontalLayout {
                x: 40px * TvUi.u;
                y: 290px * TvUi.u;
                width: parent.width - 80px * TvUi.u;
                height: 44px * TvUi.u;
                spacing: 10px * TvUi.u;
                alignment: start;

                for tab[i] in ShowPageState.seasons: Rectangle {
                    property <bool> is-selected: tab.rating-key == ShowPageState.selected-season;
                    property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == 2 + i;
                    width: s-lbl.preferred-width + 32px * TvUi.u;
                    height: 42px * TvUi.u;
                    border-radius: 21px * TvUi.u;
                    background: self.is-selected ? V3Theme.accent : V3Theme.surface;
                    border-width: self.is-foc ? 3px : 1px;
                    border-color: self.is-foc ? V3Theme.focus-ring : (self.is-selected ? V3Theme.accent : V3Theme.border);

                    s-lbl := Text {
                        text: root.season-count <= 8 ? tab.title : (tab.index == 0 ? "Sp" : "S" + tab.index);
                        font-family: V3Theme.font;
                        font-size: 16px * TvUi.u;
                        font-weight: 700;
                        color: parent.is-selected ? V3Theme.on-accent : V3Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { TvUi.tile-activated(2 + i); }
                    }
                }
            }
        }

        // Left Season Poster + Metadata (sticky)
        Rectangle {
            x: 40px * TvUi.u;
            y: ShowPageState.scrolled ? 20px * TvUi.u : 356px * TvUi.u;
            width: 280px * TvUi.u;
            height: 540px * TvUi.u;
            background: transparent;

            Rectangle {
                width: 280px * TvUi.u;
                height: 420px * TvUi.u;
                border-radius: 16px * TvUi.u;
                clip: true;
                background: V3Theme.surface;
                border-width: 1px;
                border-color: V3Theme.border;

                if ShowPageState.season.has-poster: Image {
                    width: 100%;
                    height: 100%;
                    source: ShowPageState.season.poster;
                    image-fit: cover;
                }
            }

            Text {
                x: 0;
                y: 436px * TvUi.u;
                width: parent.width;
                text: ShowPageState.season.name;
                font-family: V3Theme.font;
                font-size: 22px * TvUi.u;
                font-weight: 700;
                color: V3Theme.text-primary;
                overflow: elide;
            }

            if ShowPageState.season.meta != "": Text {
                x: 0;
                y: 468px * TvUi.u;
                width: parent.width;
                text: ShowPageState.season.meta;
                font-family: V3Theme.font;
                font-size: 15px * TvUi.u;
                color: V3Theme.text-secondary;
                overflow: elide;
            }
        }
    }
}
