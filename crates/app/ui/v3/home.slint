// Blades UI (v3) — Home panel (1532 x 1032 design space, §2–§8).

import { Theme, UiTheme } from "../theme.slint";
import { Icon } from "../icons.slint";
import { Dash, GameState, HomeState, SleepState, TvUi } from "../state.slint";
import { IntroRise } from "../shared/intro.slint";
import { V3Theme } from "theme.slint";

export component V3Home inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    property <bool> has-up-next: HomeState.up-next.length > 0;
    property <bool> has-game: HomeState.next-game.visible;

    IntroRise {
        width: parent.width;
        height: parent.height;
        delay: 1300ms;

        // ── Header: "Home" left (no right status — Clock card shows it) ──────
        Text {
            x: 44px * TvUi.u;
            y: 28px * TvUi.u;
            text: "Home";
            font-family: V3Theme.font;
            font-size: 42px * TvUi.u;
            font-weight: 900;
            color: V3Theme.text-primary;
        }

        // ── Left column (x: 44, w: 848): What's On hero + Up next ────────────
        // 0: What's On hero (848 x 440, or taller centered when Up next is empty)
        Rectangle {
            property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == 0;
            x: 44px * TvUi.u;
            y: 96px * TvUi.u;
            width: 848px * TvUi.u;
            height: (root.has-up-next ? 440px : 477px) * TvUi.u;
            border-radius: 22px * TvUi.u;
            clip: true;
            background: HomeState.whats-on.is-app ? HomeState.whats-on.app-color : V3Theme.surface;
            border-width: self.is-foc ? 4px : 1px;
            border-color: self.is-foc ? V3Theme.focus-ring : V3Theme.border;

            if !HomeState.whats-on.is-app && HomeState.whats-on.has-art: Image {
                width: parent.width;
                height: parent.height;
                source: HomeState.whats-on.art;
                image-fit: cover;
            }

            if HomeState.whats-on.is-app && HomeState.whats-on.app-has-logo: Image {
                x: (parent.width - self.width) / 2;
                y: 48px * TvUi.u;
                width: parent.width * 0.45;
                height: parent.height * 0.35;
                source: HomeState.whats-on.app-logo;
                image-fit: contain;
            }

            // Scrim: transparent 0% → black 35% at 30% → black 88% at 100%
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: @linear-gradient(180deg, #00000000 0%, #00000059 30%, #000000E0 100%);
            }

            // Top-right decorative 84px play circle
            Rectangle {
                x: parent.width - 112px * TvUi.u;
                y: 28px * TvUi.u;
                width: 84px * TvUi.u;
                height: 84px * TvUi.u;
                border-radius: 42px * TvUi.u;
                background: V3Theme.accent;

                Icon {
                    x: (parent.width - self.width) / 2 + 2px * TvUi.u;
                    y: (parent.height - self.height) / 2;
                    name: "play";
                    size: 36px * TvUi.u;
                    tint: V3Theme.on-accent;
                }
            }

            // Bottom-left text block (36px inset)
            VerticalLayout {
                x: 36px * TvUi.u;
                y: 120px * TvUi.u;
                width: min(760px * TvUi.u, parent.width - 72px * TvUi.u);
                height: parent.height - 156px * TvUi.u;
                spacing: 8px * TvUi.u;
                alignment: end;

                HorizontalLayout {
                    spacing: 0;
                    alignment: start;

                    Text {
                        text: "WHAT'S ON";
                        font-family: V3Theme.font;
                        font-size: 17px * TvUi.u;
                        font-weight: 900;
                        letter-spacing: 2px;
                        color: #FFFFFFEB;
                    }

                    if HomeState.whats-on.source != "": Text {
                        text: " · " + HomeState.whats-on.source;
                        font-family: V3Theme.font;
                        font-size: 17px * TvUi.u;
                        font-weight: 900;
                        letter-spacing: 2px;
                        color: #FFFFFF9E;
                    }
                }

                Text {
                    text: HomeState.whats-on.has-item ? HomeState.whats-on.title : "Nothing on right now";
                    font-family: V3Theme.font;
                    font-size: 52px * TvUi.u;
                    font-weight: 900;
                    letter-spacing: -1px;
                    color: #FFFFFF;
                    overflow: elide;
                }

                if HomeState.whats-on.subtitle != "" || !HomeState.whats-on.has-item: Text {
                    text: HomeState.whats-on.has-item ? HomeState.whats-on.subtitle : "Search or open the Library";
                    font-family: V3Theme.font;
                    font-size: 22px * TvUi.u;
                    font-weight: 700;
                    color: #FFFFFFD9;
                    overflow: elide;
                }

                if HomeState.whats-on.plot != "": Text {
                    text: HomeState.whats-on.plot;
                    font-family: V3Theme.font;
                    font-size: 19px * TvUi.u;
                    font-weight: 400;
                    color: #FFFFFFD9;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 56px * TvUi.u;
                }

                if HomeState.whats-on.progress >= 0.0: Rectangle {
                    height: 6px * TvUi.u;
                    border-radius: 3px * TvUi.u;
                    background: #FFFFFF47;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * clamp(HomeState.whats-on.progress, 0.0, 1.0);
                        height: parent.height;
                        border-radius: 3px * TvUi.u;
                        background: #FFFFFF;
                    }
                }

                if HomeState.whats-on.status != "": Text {
                    text: HomeState.whats-on.status;
                    font-family: V3Theme.font;
                    font-size: 20px * TvUi.u;
                    font-weight: 800;
                    color: #FFFFFF;
                    overflow: elide;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { HomeState.activate-hero(); }
            }
        }

        // ── Up next row (1..=4) ──────────────────────────────────────────────
        if root.has-up-next: Text {
            x: 44px * TvUi.u;
            y: 556px * TvUi.u;
            text: "Up next";
            font-family: V3Theme.font;
            font-size: 22px * TvUi.u;
            font-weight: 900;
            color: V3Theme.text-primary;
        }

        for card[i] in HomeState.up-next: Rectangle {
            visible: i < 4;
            property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == 1 + i;
            property <length> cx: i == 0 ? 44px * TvUi.u : (326px + (i - 1) * 193px) * TvUi.u;
            property <length> cw: (i == 0 ? 268px : 179px) * TvUi.u;

            x: self.cx;
            y: 596px * TvUi.u;
            width: self.cw;
            height: 196px * TvUi.u;
            background: transparent;

            // Art box (124px tall)
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 124px * TvUi.u;
                border-radius: 14px * TvUi.u;
                clip: true;
                background: V3Theme.surface;
                border-width: parent.is-foc ? 4px : 1px;
                border-color: parent.is-foc ? V3Theme.focus-ring : V3Theme.border;

                if card.has-thumb: Image {
                    width: parent.width;
                    height: parent.height;
                    source: card.thumb;
                    image-fit: cover;
                }

                // Subtle bottom scrim for progress bar legibility
                if card.progress > 0.0: Rectangle {
                    x: 0;
                    y: parent.height - 32px * TvUi.u;
                    width: parent.width;
                    height: 32px * TvUi.u;
                    background: @linear-gradient(180deg, #00000000 0%, #000000B0 100%);
                }

                // UP NEXT badge on first card
                if card.up-next: Rectangle {
                    x: 10px * TvUi.u;
                    y: 10px * TvUi.u;
                    width: badge-txt.preferred-width + 18px * TvUi.u;
                    height: 24px * TvUi.u;
                    border-radius: 8px * TvUi.u;
                    background: V3Theme.accent;

                    badge-txt := Text {
                        text: "UP NEXT";
                        font-family: V3Theme.font;
                        font-size: 13px * TvUi.u;
                        font-weight: 900;
                        letter-spacing: 1.5px;
                        color: V3Theme.on-accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Progress bar (5px, 10px inset)
                if card.progress > 0.0: Rectangle {
                    x: 10px * TvUi.u;
                    y: parent.height - 15px * TvUi.u;
                    width: parent.width - 20px * TvUi.u;
                    height: 5px * TvUi.u;
                    border-radius: 3px * TvUi.u;
                    background: #FFFFFF4D;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * clamp(card.progress, 0.0, 1.0);
                        height: parent.height;
                        border-radius: 3px * TvUi.u;
                        background: #FFFFFF;
                    }
                }
            }

            Text {
                x: 2px * TvUi.u;
                y: 132px * TvUi.u;
                width: parent.width - 4px * TvUi.u;
                text: card.title;
                font-family: V3Theme.font;
                font-size: 19px * TvUi.u;
                font-weight: 900;
                color: V3Theme.text-primary;
                overflow: elide;
            }

            if card.meta != "": Text {
                x: 2px * TvUi.u;
                y: 158px * TvUi.u;
                width: parent.width - 4px * TvUi.u;
                text: card.meta;
                font-family: V3Theme.font;
                font-size: 15px * TvUi.u;
                font-weight: 700;
                color: V3Theme.text-secondary;
                overflow: elide;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { HomeState.activate-up-next(card.key); }
            }
        }

        // ── Right column (x: 920, w: 568): Clock + Next Game + Quick Actions ─
        // Clock card (not focusable)
        Rectangle {
            x: 920px * TvUi.u;
            y: 96px * TvUi.u;
            width: 568px * TvUi.u;
            height: 196px * TvUi.u;
            border-radius: 22px * TvUi.u;
            background: V3Theme.surface;
            border-width: 1px;
            border-color: V3Theme.border;

            VerticalLayout {
                padding-left: 26px * TvUi.u;
                padding-right: 26px * TvUi.u;
                padding-top: 18px * TvUi.u;
                padding-bottom: 18px * TvUi.u;
                spacing: 4px * TvUi.u;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px * TvUi.u;
                    alignment: start;

                    Text {
                        text: Dash.clock-hh + ":" + Dash.clock-mm;
                        font-family: V3Theme.font;
                        font-size: 76px * TvUi.u;
                        font-weight: 900;
                        color: V3Theme.text-primary;
                    }

                    if Dash.clock-ampm != "": Text {
                        text: Dash.clock-ampm;
                        font-family: V3Theme.font;
                        font-size: 28px * TvUi.u;
                        font-weight: 800;
                        color: V3Theme.text-secondary;
                        vertical-alignment: bottom;
                        y: -12px * TvUi.u;
                    }
                }

                Text {
                    text: Dash.clock-year != "" ? Dash.date-text + ", " + Dash.clock-year : Dash.date-text;
                    font-family: V3Theme.font;
                    font-size: 20px * TvUi.u;
                    font-weight: 700;
                    color: V3Theme.text-secondary;
                }

                HorizontalLayout {
                    spacing: 12px * TvUi.u;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px * TvUi.u;
                        Icon {
                            name: Dash.weather-icon;
                            size: 22px * TvUi.u;
                            tint: V3Theme.accent;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: Dash.weather-on
                                ? Dash.weather-temp + " · " + Dash.weather-condition
                                : "Set location in Settings";
                            font-family: V3Theme.font;
                            font-size: 20px * TvUi.u;
                            font-weight: 800;
                            color: V3Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    if Dash.weather-on && Dash.weather-detail != "": Text {
                        text: Dash.weather-detail;
                        font-family: V3Theme.font;
                        font-size: 19px * TvUi.u;
                        font-weight: 700;
                        color: V3Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 5: Next Game card (visible when HomeState.next-game.visible)
        if root.has-game: Rectangle {
            property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == 5;
            x: 920px * TvUi.u;
            y: 308px * TvUi.u;
            width: 568px * TvUi.u;
            height: 210px * TvUi.u;
            border-radius: 22px * TvUi.u;
            background: V3Theme.surface;
            border-width: self.is-foc ? 4px : 1px;
            border-color: self.is-foc ? V3Theme.focus-ring : V3Theme.border;

            VerticalLayout {
                padding-left: 22px * TvUi.u;
                padding-right: 22px * TvUi.u;
                padding-top: 16px * TvUi.u;
                padding-bottom: 14px * TvUi.u;
                spacing: 10px * TvUi.u;

                // Row 1: NEXT GAME · LEAGUE (left) + state (right)
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "NEXT GAME · " + HomeState.next-game.league;
                        font-family: V3Theme.font;
                        font-size: 15px * TvUi.u;
                        font-weight: 900;
                        letter-spacing: 2px;
                        color: V3Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px * TvUi.u;
                        alignment: end;

                        if HomeState.next-game.state == GameState.live: Rectangle {
                            width: 14px * TvUi.u;
                            height: 14px * TvUi.u;
                            border-radius: 7px * TvUi.u;
                            background: #E8000D40;
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                x: 2px * TvUi.u;
                                y: 2px * TvUi.u;
                                width: 10px * TvUi.u;
                                height: 10px * TvUi.u;
                                border-radius: 5px * TvUi.u;
                                background: #E8000D;
                            }
                        }

                        Text {
                            text: HomeState.next-game.state-text;
                            font-family: V3Theme.font;
                            font-size: 16px * TvUi.u;
                            font-weight: 900;
                            color: HomeState.next-game.state == GameState.live
                                ? #E8000D
                                : HomeState.next-game.state == GameState.upcoming
                                    ? V3Theme.accent
                                    : V3Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Team rows (away, home)
                for side in [HomeState.next-game.away, HomeState.next-game.home]: HorizontalLayout {
                    spacing: 10px * TvUi.u;
                    height: 36px * TvUi.u;

                    Text {
                        width: 34px * TvUi.u;
                        text: side.rank;
                        font-family: V3Theme.font;
                        font-size: 15px * TvUi.u;
                        font-weight: 900;
                        color: V3Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 32px * TvUi.u;
                        height: 32px * TvUi.u;
                        border-radius: 9px * TvUi.u;
                        background: side.has-logo ? V3Theme.surface-raised : side.color;
                        y: (parent.height - self.height) / 2;

                        if side.has-logo: Image {
                            x: 3px * TvUi.u;
                            y: 3px * TvUi.u;
                            width: parent.width - 6px * TvUi.u;
                            height: parent.height - 6px * TvUi.u;
                            source: side.logo;
                            image-fit: contain;
                        }

                        if !side.has-logo: Text {
                            text: side.init;
                            font-family: V3Theme.font;
                            font-size: 12px * TvUi.u;
                            font-weight: 900;
                            color: #FFFFFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: side.name;
                        font-family: V3Theme.font;
                        font-size: 22px * TvUi.u;
                        font-weight: side.lead ? 900 : 700;
                        color: side.lead ? V3Theme.text-primary : V3Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if side.score != "": Text {
                        text: side.score;
                        font-family: V3Theme.font;
                        font-size: 28px * TvUi.u;
                        font-weight: side.lead ? 900 : 700;
                        color: side.lead ? V3Theme.text-primary : V3Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                // Footer: Venue · Broadcasts
                if HomeState.next-game.meta != "": Rectangle {
                    height: 1px;
                    background: V3Theme.border;
                }
                if HomeState.next-game.meta != "": Text {
                    text: HomeState.next-game.meta;
                    font-family: V3Theme.font;
                    font-size: 16px * TvUi.u;
                    font-weight: 700;
                    color: V3Theme.text-secondary;
                    overflow: elide;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { HomeState.open-game(HomeState.next-game.event-id, HomeState.next-game.date); }
            }
        }

        // Quick Actions (4 equal rows: 6 Search, 7 Screensaver, 8 Sleep timer, 9 Theme)
        Rectangle {
            property <length> qa-y: root.has-game ? 534px * TvUi.u : 308px * TvUi.u;
            property <length> qa-h: root.has-game ? 262px * TvUi.u : 488px * TvUi.u;
            property <length> row-h: (self.qa-h - 20px * TvUi.u - 18px * TvUi.u) / 4;

            x: 920px * TvUi.u;
            y: self.qa-y;
            width: 568px * TvUi.u;
            height: self.qa-h;
            border-radius: 22px * TvUi.u;
            background: V3Theme.surface;
            border-width: 1px;
            border-color: V3Theme.border;

            for row[idx] in [
                { id: 6, icon: "search", label: "Search", right: "" },
                { id: 7, icon: "screensaver", label: "Screensaver", right: "" },
                { id: 8, icon: "moon", label: "Sleep timer", right: SleepState.active ? SleepState.label : "Off" },
                { id: 9, icon: "sun", label: "Theme", right: Theme.mode == UiTheme.dark ? "Espresso" : Theme.mode == UiTheme.aubergine ? "Aubergine" : Theme.mode == UiTheme.ku ? "Kansas Dark" : Theme.mode == UiTheme.ku-light ? "Kansas Light" : Theme.mode == UiTheme.stone ? "Stone" : "Mist" },
            ]: Rectangle {
                property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == row.id;
                x: 14px * TvUi.u;
                y: 10px * TvUi.u + idx * (parent.row-h + 6px * TvUi.u);
                width: parent.width - 28px * TvUi.u;
                height: parent.row-h;
                border-radius: 14px * TvUi.u;
                background: self.is-foc ? V3Theme.surface-raised : (r-ta.has-hover ? V3Theme.surface-raised : transparent);
                border-width: self.is-foc ? 3px : 0px;
                border-color: V3Theme.focus-ring;

                HorizontalLayout {
                    padding-left: 12px * TvUi.u;
                    padding-right: 12px * TvUi.u;
                    spacing: 14px * TvUi.u;

                    Rectangle {
                        width: 40px * TvUi.u;
                        height: 40px * TvUi.u;
                        border-radius: 12px * TvUi.u;
                        background: V3Theme.surface-raised;
                        y: (parent.height - self.height) / 2;

                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: row.icon;
                            size: 22px * TvUi.u;
                            tint: V3Theme.text-secondary;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: row.label;
                        font-family: V3Theme.font;
                        font-size: 22px * TvUi.u;
                        font-weight: 800;
                        color: V3Theme.text-primary;
                        vertical-alignment: center;
                    }

                    if row.right != "": Text {
                        text: row.right;
                        font-family: V3Theme.font;
                        font-size: 19px * TvUi.u;
                        font-weight: 700;
                        color: V3Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                r-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { TvUi.tile-activated(row.id); }
                }
            }
        }

        // ── Bottom Apps bar (7 recent-first + All apps ›) ────────────────────
        Text {
            x: 44px * TvUi.u;
            y: 816px * TvUi.u;
            text: "Apps";
            font-family: V3Theme.font;
            font-size: 22px * TvUi.u;
            font-weight: 900;
            color: V3Theme.text-primary;
        }

        for app[i] in HomeState.apps-bar: Rectangle {
            visible: i < 7;
            property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == 10 + i;

            x: (44px + i * 182px) * TvUi.u;
            y: 850px * TvUi.u;
            width: 170px * TvUi.u;
            height: 88px * TvUi.u;
            border-radius: 16px * TvUi.u;
            clip: true;
            background: app.color;
            border-width: (self.is-foc || app-bar-ta.has-hover) ? 4px : 1px;
            border-color: (self.is-foc || app-bar-ta.has-hover) ? V3Theme.focus-ring : #FFFFFF20;

            if app.has-logo: Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width * (app.logo-wide ? 0.88 : 0.70);
                height: parent.height * (app.logo-wide ? 0.66 : 0.54);
                source: app.logo;
                image-fit: contain;
            }

            if !app.has-logo: Text {
                x: 10px * TvUi.u;
                width: parent.width - 20px * TvUi.u;
                height: parent.height;
                text: app.name;
                font-family: V3Theme.font;
                font-size: 21px * TvUi.u;
                font-weight: 900;
                color: app.text-color;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            app-bar-ta := TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if self.has-hover {
                        TvUi.tile-hovered(10 + i);
                    }
                }
                clicked => { HomeState.launch-app(app.id); }
            }
        }

        // Tile 17: All apps ›
        Rectangle {
            property <bool> is-foc: !TvUi.bar-focused && TvUi.focused-tile == 17;
            x: (44px + 7 * 182px) * TvUi.u;
            y: 850px * TvUi.u;
            width: 170px * TvUi.u;
            height: 88px * TvUi.u;
            border-radius: 16px * TvUi.u;
            background: V3Theme.surface-raised;
            border-width: (self.is-foc || all-apps-ta.has-hover) ? 4px : 2px;
            border-color: (self.is-foc || all-apps-ta.has-hover) ? V3Theme.focus-ring : V3Theme.border;

            Text {
                text: "All apps ›";
                font-family: V3Theme.font;
                font-size: 21px * TvUi.u;
                font-weight: 900;
                color: V3Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            all-apps-ta := TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if self.has-hover {
                        TvUi.tile-hovered(17);
                    }
                }
                clicked => { HomeState.open-apps-page(); }
            }
        }
    } // end IntroRise
}
