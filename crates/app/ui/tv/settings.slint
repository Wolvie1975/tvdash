import { Theme, UiTheme } from "../theme.slint";
import { Accounts, Dash, Display, Server, TvUi } from "../state.slint";
import { SubTabs } from "tabs.slint";
import { Tile, ValueTile } from "tile.slint";

component ServerGraphTile inherits Rectangle {
    in property <string> label;
    in property <string> line-a;
    in property <string> line-b;
    in property <string> scale;

    border-radius: 6px;
    background: Theme.surface;

    Text {
        x: 20px * TvUi.u;
        y: 16px * TvUi.u;
        width: parent.width - 40px * TvUi.u;
        text: root.label + (root.scale != "" ? " · " + root.scale : "");
        font-size: 20px * TvUi.u;
        font-weight: 400;
        color: Theme.text-secondary;
        overflow: elide;
    }

    Path {
        x: 16px * TvUi.u;
        y: 52px * TvUi.u;
        width: parent.width - 32px * TvUi.u;
        height: parent.height - 68px * TvUi.u;
        viewbox-width: 300;
        viewbox-height: 100;
        commands: root.line-a;
        stroke: Theme.accent;
        stroke-width: 3px * TvUi.u;
    }

    Path {
        x: 16px * TvUi.u;
        y: 52px * TvUi.u;
        width: parent.width - 32px * TvUi.u;
        height: parent.height - 68px * TvUi.u;
        viewbox-width: 300;
        viewbox-height: 100;
        commands: root.line-b;
        stroke: Theme.text-secondary;
        stroke-width: 3px * TvUi.u;
    }
}

export component TvSettings inherits Rectangle {
    width: 1920px * TvUi.u;
    height: 1080px * TvUi.u;
    background: transparent;

    property <int> tab-idx: TvUi.settings-tab == "accounts" ? 1
        : TvUi.settings-tab == "server" ? 2
        : TvUi.settings-tab == "changelog" ? 3 : 0;

    Timer {
        interval: 5s;
        running: root.tab-idx == 2;
        triggered => { Server.refresh(); }
    }

    Timer {
        interval: 2s;
        running: root.tab-idx == 2;
        triggered => { Server.refresh-activities(); }
    }

    SubTabs {
        x: 96px * TvUi.u;
        y: 122px * TvUi.u;
        labels: ["Display", "Accounts", "Server", "What's new"];
        active: root.tab-idx;
        focused: !TvUi.bar-focused && TvUi.focused-tile >= 0 && TvUi.focused-tile < 4;
        focused-index: (!TvUi.bar-focused && TvUi.focused-tile >= 0 && TvUi.focused-tile < 4)
            ? TvUi.focused-tile : -1;
        selected(i) => { TvUi.tile-activated(i); }
    }

    // ── Tab 0: Display ───────────────────────────────────────────────────────
    if root.tab-idx == 0: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        // 4: Layout
        ValueTile {
            x: 96px * TvUi.u;
            y: 184px * TvUi.u;
            base-width: 416px * TvUi.u;
            base-height: 220px * TvUi.u;
            fill: Theme.surface;
            label: "Display layout";
            value: Display.layout-setting == "tv" ? "TV only" : Display.layout-setting == "dual" ? "Two screens" : "Auto";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 4;
            activated => { TvUi.tile-activated(4); }
            hovered => { TvUi.tile-hovered(4); }
        }

        // 5: Theme
        ValueTile {
            x: 528px * TvUi.u;
            y: 184px * TvUi.u;
            base-width: 416px * TvUi.u;
            base-height: 220px * TvUi.u;
            fill: Theme.surface;
            label: "Theme";
            value: Theme.mode == UiTheme.dark ? "Dark" : Theme.mode == UiTheme.stone ? "Stone" : "Mist";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 5;
            activated => { TvUi.tile-activated(5); }
            hovered => { TvUi.tile-hovered(5); }
        }

        // 6: Temperature units
        ValueTile {
            x: 960px * TvUi.u;
            y: 184px * TvUi.u;
            base-width: 416px * TvUi.u;
            base-height: 220px * TvUi.u;
            fill: Theme.surface;
            label: "Temperature";
            value: Display.celsius ? "Celsius (°C)" : "Fahrenheit (°F)";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 6;
            activated => { TvUi.tile-activated(6); }
            hovered => { TvUi.tile-hovered(6); }
        }

        // 7: Clock format
        ValueTile {
            x: 1392px * TvUi.u;
            y: 184px * TvUi.u;
            base-width: 416px * TvUi.u;
            base-height: 220px * TvUi.u;
            fill: Theme.surface;
            label: "Clock";
            value: Display.h12 ? "12-hour" : "24-hour";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 7;
            activated => { TvUi.tile-activated(7); }
            hovered => { TvUi.tile-hovered(7); }
        }

        // 8: Recent services
        ValueTile {
            x: 96px * TvUi.u;
            y: 420px * TvUi.u;
            base-width: 416px * TvUi.u;
            base-height: 220px * TvUi.u;
            fill: Theme.surface;
            label: "Recent services";
            value: "Clear list";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 8;
            activated => { TvUi.tile-activated(8); }
            hovered => { TvUi.tile-hovered(8); }
        }

        // 9: Quit
        ValueTile {
            x: 528px * TvUi.u;
            y: 420px * TvUi.u;
            base-width: 416px * TvUi.u;
            base-height: 220px * TvUi.u;
            fill: TvUi.confirm-quit ? #5C1E1E : Theme.surface;
            label: "Application";
            value: TvUi.confirm-quit ? "Confirm quit?" : "Quit tvdash";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 9;
            activated => { TvUi.tile-activated(9); }
            hovered => { TvUi.tile-hovered(9); }
        }

        // Phone Remote QR card
        if Dash.remote-url != "": Rectangle {
            x: 960px * TvUi.u;
            y: 420px * TvUi.u;
            width: 848px * TvUi.u;
            height: 220px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;

            if Dash.remote-has-qr: Rectangle {
                x: 22px * TvUi.u;
                y: 22px * TvUi.u;
                width: 176px * TvUi.u;
                height: 176px * TvUi.u;
                border-radius: 10px * TvUi.u;
                background: #FFFFFF;

                Image {
                    x: 8px * TvUi.u;
                    y: 8px * TvUi.u;
                    width: parent.width - 16px * TvUi.u;
                    height: parent.height - 16px * TvUi.u;
                    source: Dash.remote-qr;
                    image-rendering: pixelated;
                }
            }

            VerticalLayout {
                x: (Dash.remote-has-qr ? 222px : 24px) * TvUi.u;
                y: 24px * TvUi.u;
                width: parent.width - (Dash.remote-has-qr ? 246px : 48px) * TvUi.u;
                height: parent.height - 48px * TvUi.u;
                alignment: center;
                spacing: 8px * TvUi.u;

                Text {
                    text: "PHONE REMOTE";
                    font-size: 18px * TvUi.u;
                    font-weight: 500;
                    letter-spacing: 1.2px;
                    color: Theme.text-secondary;
                }

                Text {
                    text: Dash.remote-url;
                    font-size: 28px * TvUi.u;
                    font-weight: 400;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                Text {
                    text: "Scan with your phone camera on the same Wi-Fi to open the remote.";
                    font-size: 20px * TvUi.u;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }

        // Weather location lookup card
        Rectangle {
            x: 96px * TvUi.u;
            y: 656px * TvUi.u;
            width: 848px * TvUi.u;
            height: 248px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;

            VerticalLayout {
                padding: 22px * TvUi.u;
                spacing: 12px * TvUi.u;

                Text {
                    text: "WEATHER LOCATION";
                    font-size: 18px * TvUi.u;
                    font-weight: 500;
                    letter-spacing: 1.2px;
                    color: Theme.text-secondary;
                }

                Text {
                    text: Display.location-name != "" ? Display.location-name : "Not set — search for a city to enable weather & time zone";
                    font-size: 24px * TvUi.u;
                    font-weight: 400;
                    color: Display.location-name != "" ? Theme.text-primary : Theme.text-muted;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 12px * TvUi.u;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 52px * TvUi.u;
                        border-radius: 6px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: place-input.has-focus ? Theme.accent : Theme.border;

                        if place-input.text == "": Text {
                            x: 16px * TvUi.u;
                            y: 0;
                            width: parent.width - 32px * TvUi.u;
                            height: parent.height;
                            text: "Search for a city…";
                            font-size: 22px * TvUi.u;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }

                        place-input := TextInput {
                            x: 16px * TvUi.u;
                            y: 0;
                            width: parent.width - 32px * TvUi.u;
                            height: parent.height;
                            text <=> Display.place-query;
                            font-size: 22px * TvUi.u;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            accepted => { Display.find-place(self.text); }
                        }
                    }

                    Rectangle {
                        width: 132px * TvUi.u;
                        height: 52px * TvUi.u;
                        border-radius: 6px;
                        background: search-ta.has-hover ? Theme.accent : Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: "Search";
                            font-size: 22px * TvUi.u;
                            font-weight: 500;
                            color: search-ta.has-hover ? #0B0D10 : Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        search-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Display.find-place(place-input.text); }
                        }
                    }
                }

                if Display.place-searching: Text {
                    text: "Looking it up…";
                    font-size: 18px * TvUi.u;
                    color: Theme.accent;
                }

                if !Display.place-searching && Display.place-message != "": Text {
                    text: Display.place-message;
                    font-size: 18px * TvUi.u;
                    color: Theme.warn;
                    overflow: elide;
                }
            }
        }

        // Location search results (up to 4)
        for p[i] in Display.places: Tile {
            visible: i < 4;
            x: 960px * TvUi.u;
            y: (656px + i * 64px) * TvUi.u;
            base-width: 848px * TvUi.u;
            base-height: 54px * TvUi.u;
            fill: Theme.surface;
            focused: !TvUi.bar-focused && TvUi.focused-tile == 10 + i;
            activated => { TvUi.tile-activated(10 + i); }
            hovered => { TvUi.tile-hovered(10 + i); }

            Text {
                x: 20px * TvUi.u;
                y: 0;
                width: parent.width - 40px * TvUi.u;
                height: parent.height;
                text: p;
                font-size: 22px * TvUi.u;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Text {
            x: 96px * TvUi.u;
            y: 940px * TvUi.u;
            text: "tvdash " + Dash.version;
            font-size: 22px * TvUi.u;
            color: Theme.text-muted;
        }
    }

    // ── Tab 1: Accounts ──────────────────────────────────────────────────────
    if root.tab-idx == 1: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        if Dash.cw-state == "code": Rectangle {
            x: 96px * TvUi.u;
            y: 184px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 112px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface-raised;
            border-width: 2px;
            border-color: Theme.accent;

            HorizontalLayout {
                padding-left: 28px * TvUi.u;
                padding-right: 28px * TvUi.u;
                spacing: 32px * TvUi.u;

                Text {
                    text: Dash.signin-code;
                    font-size: 56px * TvUi.u;
                    font-weight: 600;
                    letter-spacing: 12px;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }

                Text {
                    text: Dash.cw-message;
                    font-size: 24px * TvUi.u;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        if Dash.cw-state == "busy": Text {
            x: 96px * TvUi.u;
            y: 184px * TvUi.u;
            text: "Connecting…";
            font-size: 22px * TvUi.u;
            color: Theme.accent;
        }

        for a[i] in Accounts.accounts: Tile {
            x: (96px + Math.mod(i, 2) * 872px) * TvUi.u;
            y: (Dash.cw-state == "code" ? 316px : 184px) * TvUi.u + Math.floor(i / 2) * 152px * TvUi.u;
            base-width: 856px * TvUi.u;
            base-height: 136px * TvUi.u;
            fill: Theme.surface;
            focused: !TvUi.bar-focused && TvUi.focused-tile == 4 + i;
            activated => { TvUi.tile-activated(4 + i); }
            hovered => { TvUi.tile-hovered(4 + i); }

            HorizontalLayout {
                padding-left: 24px * TvUi.u;
                padding-right: 24px * TvUi.u;
                spacing: 18px * TvUi.u;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 14px * TvUi.u;
                        height: 14px * TvUi.u;
                        border-radius: 7px * TvUi.u;
                        background: a.state == "ok" ? Theme.ok
                            : a.state == "warn" ? Theme.warn
                            : a.state == "busy" ? Theme.accent
                            : Theme.text-muted;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px * TvUi.u;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: 12px * TvUi.u;
                        Text {
                            text: a.name;
                            font-size: 26px * TvUi.u;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: a.status;
                            font-size: 22px * TvUi.u;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    if a.detail != "": Text {
                        text: a.detail;
                        font-size: 18px * TvUi.u;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }

                if (a.primary != "" || a.secondary != ""): VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: act-lbl.preferred-width + 28px * TvUi.u;
                        height: 44px * TvUi.u;
                        border-radius: 6px;
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border;

                        act-lbl := Text {
                            text: a.primary != "" ? a.primary : a.secondary;
                            font-size: 20px * TvUi.u;
                            font-weight: 500;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if Accounts.editing != "": Rectangle {
            x: 96px * TvUi.u;
            y: 780px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 132px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.accent;

            VerticalLayout {
                padding: 18px * TvUi.u;
                spacing: 10px * TvUi.u;

                HorizontalLayout {
                    spacing: 14px * TvUi.u;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 52px * TvUi.u;
                        border-radius: 6px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;

                        token-input := TextInput {
                            x: 16px * TvUi.u;
                            y: 0;
                            width: parent.width - 32px * TvUi.u;
                            height: parent.height;
                            font-size: 22px * TvUi.u;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            accepted => { Accounts.submit(Accounts.editing, self.text); }
                        }
                    }

                    Rectangle {
                        width: 120px * TvUi.u;
                        height: 52px * TvUi.u;
                        border-radius: 6px;
                        background: Theme.accent;

                        Text {
                            text: "Save";
                            font-size: 22px * TvUi.u;
                            font-weight: 500;
                            color: #0B0D10;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Accounts.submit(Accounts.editing, token-input.text); }
                        }
                    }

                    Rectangle {
                        width: 130px * TvUi.u;
                        height: 52px * TvUi.u;
                        border-radius: 6px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: "Cancel";
                            font-size: 22px * TvUi.u;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Accounts.editing = ""; }
                        }
                    }
                }

                if Accounts.edit-error != "": Text {
                    text: Accounts.edit-error;
                    font-size: 18px * TvUi.u;
                    color: Theme.warn;
                    overflow: elide;
                }
            }
        }

        Text {
            x: 96px * TvUi.u;
            y: 940px * TvUi.u;
            text: "Streaming sites and diagnostics are available on the two-screen layout.";
            font-size: 20px * TvUi.u;
            color: Theme.text-muted;
        }
    }

    // ── Tab 2: Server ────────────────────────────────────────────────────────
    if root.tab-idx == 2: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        Text {
            x: 96px * TvUi.u;
            y: 188px * TvUi.u;
            width: 1460px * TvUi.u;
            text: Server.name + " · " + Server.status;
            font-size: 28px * TvUi.u;
            font-weight: 400;
            color: Theme.text-primary;
            overflow: elide;
        }

        // 4: Scan all tile
        Tile {
            x: 1604px * TvUi.u;
            y: 180px * TvUi.u;
            base-width: 220px * TvUi.u;
            base-height: 52px * TvUi.u;
            fill: Theme.surface;
            focused: !TvUi.bar-focused && TvUi.focused-tile == 4;
            activated => { TvUi.tile-activated(4); }
            hovered => { TvUi.tile-hovered(4); }

            Text {
                text: "Scan all";
                font-size: 22px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 5 metric cards
        ValueTile {
            x: 96px * TvUi.u;
            y: 256px * TvUi.u;
            base-width: 332px * TvUi.u;
            base-height: 148px * TvUi.u;
            fill: Theme.surface;
            label: "Streams";
            value: Server.streams;
        }

        ValueTile {
            x: 444px * TvUi.u;
            y: 256px * TvUi.u;
            base-width: 332px * TvUi.u;
            base-height: 148px * TvUi.u;
            fill: Theme.surface;
            label: "Transcodes";
            value: Server.transcodes;
        }

        ValueTile {
            x: 792px * TvUi.u;
            y: 256px * TvUi.u;
            base-width: 332px * TvUi.u;
            base-height: 148px * TvUi.u;
            fill: Theme.surface;
            label: "Bandwidth";
            value: Server.bandwidth + " Mb/s";
        }

        ValueTile {
            x: 1140px * TvUi.u;
            y: 256px * TvUi.u;
            base-width: 332px * TvUi.u;
            base-height: 148px * TvUi.u;
            fill: Theme.surface;
            label: "CPU";
            value: Server.cpu + "%";
        }

        ValueTile {
            x: 1488px * TvUi.u;
            y: 256px * TvUi.u;
            base-width: 336px * TvUi.u;
            base-height: 148px * TvUi.u;
            fill: Theme.surface;
            label: "RAM";
            value: Server.ram + "%";
        }

        if Server.plex-pass: ServerGraphTile {
            x: 96px * TvUi.u;
            y: 420px * TvUi.u;
            width: 565px * TvUi.u;
            height: 210px * TvUi.u;
            label: "CPU · Host / Plex";
            line-a: Server.cpu-host-path;
            line-b: Server.cpu-process-path;
        }

        if Server.plex-pass: ServerGraphTile {
            x: 677px * TvUi.u;
            y: 420px * TvUi.u;
            width: 565px * TvUi.u;
            height: 210px * TvUi.u;
            label: "RAM · Host / Plex";
            line-a: Server.ram-host-path;
            line-b: Server.ram-process-path;
        }

        if Server.plex-pass: ServerGraphTile {
            x: 1258px * TvUi.u;
            y: 420px * TvUi.u;
            width: 566px * TvUi.u;
            height: 210px * TvUi.u;
            label: "Bandwidth · LAN / WAN";
            line-a: Server.bandwidth-lan-path;
            line-b: Server.bandwidth-wan-path;
            scale: Server.bandwidth-scale + " Mb/s";
        }

        Text {
            x: 96px * TvUi.u;
            y: (Server.plex-pass ? 656px : 432px) * TvUi.u;
            text: "ACTIVITY";
            font-size: 20px * TvUi.u;
            font-weight: 500;
            letter-spacing: 1.2px;
            color: Theme.text-secondary;
        }

        if Server.activity.length == 0: Text {
            x: 96px * TvUi.u;
            y: (Server.plex-pass ? 696px : 472px) * TvUi.u;
            text: "Nothing running on the server.";
            font-size: 24px * TvUi.u;
            color: Theme.text-muted;
        }

        for act[i] in Server.activity: Rectangle {
            visible: i < 3;
            x: 96px * TvUi.u;
            y: ((Server.plex-pass ? 696px : 472px) + i * 72px) * TvUi.u;
            width: 1728px * TvUi.u;
            height: 60px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 20px * TvUi.u;
                padding-right: 20px * TvUi.u;
                spacing: 16px * TvUi.u;

                Text {
                    text: act.title + " · " + act.subtitle;
                    font-size: 22px * TvUi.u;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: Math.round(act.progress) + "%";
                    font-size: 22px * TvUi.u;
                    font-weight: 500;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ── Tab 3: What's new ────────────────────────────────────────────────────
    if root.tab-idx == 3: Flickable {
        x: 96px * TvUi.u;
        y: 184px * TvUi.u;
        width: 1728px * TvUi.u;
        height: 800px * TvUi.u;
        interactive: true;
        content-height: cl-col.preferred-height + 24px * TvUi.u;

        cl-col := VerticalLayout {
            width: 1728px * TvUi.u;
            spacing: 16px * TvUi.u;

            for entry in Dash.changelog: Rectangle {
                border-radius: 6px;
                background: Theme.surface;
                height: entry-col.preferred-height + 36px * TvUi.u;

                entry-col := VerticalLayout {
                    x: 24px * TvUi.u;
                    y: 18px * TvUi.u;
                    width: parent.width - 48px * TvUi.u;
                    spacing: 10px * TvUi.u;

                    HorizontalLayout {
                        spacing: 14px * TvUi.u;

                        Text {
                            text: entry.version;
                            font-size: 26px * TvUi.u;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if entry.date != "": Text {
                            text: entry.date;
                            font-size: 20px * TvUi.u;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: entry.notes;
                        font-size: 20px * TvUi.u;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
