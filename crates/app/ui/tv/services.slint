import { Theme } from "../theme.slint";
import { TvUi } from "../state.slint";
import { ServiceTile } from "tile.slint";

export component TvServices inherits Rectangle {
    width: 1920px;
    height: 1080px;
    background: transparent;

    Text {
        x: 96px;
        y: 136px;
        text: "STREAMING SERVICES";
        font-size: 22px;
        font-weight: 500;
        letter-spacing: 1.2px;
        color: Theme.text-secondary;
    }

    // 5 x 2 grid of 332 x 360 ServiceTiles with 16 px gaps
    for svc[i] in TvUi.services: ServiceTile {
        x: 96px + Math.mod(i, 5) * 348px;
        y: 180px + Math.floor(i / 5) * 376px;
        base-width: 332px;
        base-height: 360px;
        brand: svc.brand;
        is-recent: svc.is-recent;
        focused: !TvUi.bar-focused && TvUi.focused-tile == i;
        activated => { TvUi.tile-activated(i); }
        hovered => { TvUi.tile-hovered(i); }
    }

    Text {
        x: 96px;
        y: 944px;
        text: "Coming back: press F12 or move the mouse for the Back to tvdash pill.";
        font-size: 24px;
        font-weight: 400;
        color: Theme.text-muted;
    }
}
