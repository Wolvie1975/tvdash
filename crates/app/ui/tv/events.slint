import { Theme } from "../theme.slint";
import { Scoreboard, Sports, TvUi } from "../state.slint";
import { SubTabs } from "tabs.slint";

component TeamBadge inherits HorizontalLayout {
    in property <string> name;
    in property <string> side-label;
    in property <bool> has-logo;
    in property <image> logo;
    in property <string> initials;

    spacing: 12px * TvUi.u;
    alignment: start;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 40px * TvUi.u;
            height: 40px * TvUi.u;
            border-radius: 6px;
            background: root.has-logo ? transparent : Theme.surface-raised;
            border-width: root.has-logo ? 0px : 1px;
            border-color: Theme.border;
            clip: true;

            if root.has-logo: Image {
                width: 40px * TvUi.u;
                height: 40px * TvUi.u;
                source: root.logo;
                image-fit: contain;
            }

            if !root.has-logo: Text {
                text: root.initials;
                font-size: 14px * TvUi.u;
                font-weight: 600;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 1px * TvUi.u;
        horizontal-stretch: 1;

        Text {
            text: root.name;
            font-size: 20px * TvUi.u;
            font-weight: 500;
            color: Theme.text-primary;
            overflow: elide;
        }

        if root.side-label != "": Text {
            text: root.side-label;
            font-size: 14px * TvUi.u;
            color: Theme.text-muted;
        }
    }
}

component LinkPill inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: lbl.preferred-width + 24px * TvUi.u;
    height: 36px * TvUi.u;
    border-radius: 6px;
    background: ta.has-hover ? Theme.accent : Theme.surface-raised;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent : Theme.border;

    lbl := Text {
        text: root.label;
        font-size: 16px * TvUi.u;
        font-weight: 500;
        color: ta.has-hover ? #FFFFFF : Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TvSports inherits Rectangle {
    width: 1920px * TvUi.u;
    height: 1080px * TvUi.u;
    background: transparent;

    property <int> tab-idx: TvUi.sports-tab == "scoreboard" ? 1 : 0;
    property <bool> filter-open: false;
    property <bool> sb-filter-open: false;

    // Auto-refresh Scoreboard every 5 minutes while visible
    Timer {
        interval: 300s;
        running: root.tab-idx == 1 && TvUi.screen == "sports";
        triggered => { Scoreboard.load(Scoreboard.day, Scoreboard.show, Scoreboard.final-only); }
    }

    SubTabs {
        x: 96px * TvUi.u;
        y: 122px * TvUi.u;
        labels: ["Competitions", "Scoreboard"];
        active: root.tab-idx;
        focused: !TvUi.bar-focused && TvUi.focused-tile >= 0 && TvUi.focused-tile < 2;
        focused-index: (!TvUi.bar-focused && TvUi.focused-tile >= 0 && TvUi.focused-tile < 2)
            ? TvUi.focused-tile : -1;
        selected(i) => { TvUi.tile-activated(i); }
    }

    // ── Tab 0: Competitions ──────────────────────────────────────────────────
    if root.tab-idx == 0: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        // Schedule dropdown button
        Rectangle {
            x: 96px * TvUi.u;
            y: 184px * TvUi.u;
            width: 340px * TvUi.u;
            height: 48px * TvUi.u;
            border-radius: 8px;
            background: filter-ta.has-hover ? Theme.surface-raised : Theme.surface;
            border-width: 1px;
            border-color: root.filter-open ? Theme.accent : Theme.border;

            HorizontalLayout {
                padding-left: 16px * TvUi.u;
                padding-right: 16px * TvUi.u;
                spacing: 8px * TvUi.u;

                Text {
                    text: Sports.schedule-label;
                    font-size: 20px * TvUi.u;
                    font-weight: 500;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: root.filter-open ? "▴" : "▾";
                    font-size: 18px * TvUi.u;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            filter-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.filter-open = !root.filter-open; }
            }
        }

        // Refresh button
        Rectangle {
            x: 452px * TvUi.u;
            y: 184px * TvUi.u;
            width: 128px * TvUi.u;
            height: 48px * TvUi.u;
            border-radius: 8px;
            background: ref-ta.has-hover ? Theme.surface-raised : Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                text: Sports.loading ? "Loading…" : "Refresh";
                font-size: 20px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            ref-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Sports.load(Sports.schedule, Sports.page); }
            }
        }

        // Event count & last updated
        Text {
            x: 604px * TvUi.u;
            y: 194px * TvUi.u;
            width: 1220px * TvUi.u;
            text: (Sports.total-count == 1 ? "1 event" : Sports.total-count + " events")
                + (Sports.last-updated != "" ? " · Schedule last updated " + Sports.last-updated : "");
            font-size: 19px * TvUi.u;
            color: Theme.text-secondary;
            overflow: elide;
        }

        // Error banner
        if Sports.error != "": Rectangle {
            x: 96px * TvUi.u;
            y: 252px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 84px * TvUi.u;
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.warn;

            Text {
                x: 24px * TvUi.u;
                width: parent.width - 48px * TvUi.u;
                height: parent.height;
                text: Sports.error;
                font-size: 20px * TvUi.u;
                color: Theme.warn;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        // Empty state
        if !Sports.loading && Sports.error == "" && Sports.rows.length == 0: Rectangle {
            x: 96px * TvUi.u;
            y: 276px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 180px * TvUi.u;
            border-radius: 8px;
            background: Theme.surface;

            VerticalLayout {
                alignment: center;
                spacing: 16px * TvUi.u;

                Text {
                    text: Sports.schedule != ""
                        ? "No events match in the next three days."
                        : "No games scheduled from today through the next three days. Check back soon.";
                    font-size: 24px * TvUi.u;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }

                if Sports.schedule != "": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 180px * TvUi.u;
                        height: 44px * TvUi.u;
                        border-radius: 8px;
                        background: clr-ta.has-hover ? Theme.surface-raised : Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "Clear filters";
                            font-size: 20px * TvUi.u;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        clr-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Sports.load("", 0); }
                        }
                    }
                }
            }
        }

        // Main scrollable list of days, leagues, and games
        Flickable {
            x: 96px * TvUi.u;
            y: 248px * TvUi.u;
            width: 1728px * TvUi.u;
            height: Sports.total-pages > 1 ? 696px * TvUi.u : 756px * TvUi.u;
            visible: Sports.rows.length > 0;
            interactive: true;
            content-height: list-col.preferred-height + 24px * TvUi.u;

            list-col := VerticalLayout {
                width: 1728px * TvUi.u;
                spacing: 8px * TvUi.u;

                for row in Sports.rows: Rectangle {
                    width: 1728px * TvUi.u;
                    height: row.kind == "day" ? 56px * TvUi.u
                        : row.kind == "league" ? 42px * TvUi.u
                        : 108px * TvUi.u;
                    background: row.kind == "game" ? Theme.surface : transparent;
                    border-radius: row.kind == "game" ? 8px : 0px;

                    if row.kind == "day": Text {
                        x: 0px;
                        y: 16px * TvUi.u;
                        text: row.header-text;
                        font-size: 28px * TvUi.u;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    if row.kind == "league": Text {
                        x: 4px * TvUi.u;
                        y: 8px * TvUi.u;
                        text: row.header-text;
                        font-size: 20px * TvUi.u;
                        font-weight: 600;
                        letter-spacing: 0.4px;
                        color: Theme.accent;
                    }

                    if row.kind == "game": HorizontalLayout {
                        x: 18px * TvUi.u;
                        y: 0px;
                        width: parent.width - 36px * TvUi.u;
                        height: parent.height;
                        spacing: 16px * TvUi.u;

                        // Sport + Neutral site tag
                        VerticalLayout {
                            width: 190px * TvUi.u;
                            alignment: center;
                            spacing: 4px * TvUi.u;

                            Text {
                                text: row.sport;
                                font-size: 18px * TvUi.u;
                                font-weight: 500;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }

                            if row.is-neutral: Text {
                                text: "Neutral site";
                                font-size: 14px * TvUi.u;
                                color: Theme.accent;
                            }
                        }

                        // Away team
                        TeamBadge {
                            width: 320px * TvUi.u;
                            name: row.away-name;
                            side-label: row.away-label;
                            has-logo: row.away-has-logo;
                            logo: row.away-logo;
                            initials: row.away-initials;
                        }

                        // Home team
                        TeamBadge {
                            width: 320px * TvUi.u;
                            name: row.home-name;
                            side-label: row.home-label;
                            has-logo: row.home-has-logo;
                            logo: row.home-logo;
                            initials: row.home-initials;
                        }

                        // Time
                        VerticalLayout {
                            width: 185px * TvUi.u;
                            alignment: center;
                            Text {
                                text: row.time-text;
                                font-size: 18px * TvUi.u;
                                font-weight: row.is-tbd ? 400 : 500;
                                color: row.is-tbd ? Theme.text-muted : Theme.text-primary;
                                wrap: word-wrap;
                            }
                        }

                        // Location (city / venue)
                        VerticalLayout {
                            width: 240px * TvUi.u;
                            alignment: center;
                            spacing: 2px * TvUi.u;

                            if row.city != "": Text {
                                text: row.city;
                                font-size: 17px * TvUi.u;
                                color: Theme.text-primary;
                                overflow: elide;
                            }

                            if row.venue != "": Text {
                                text: row.venue;
                                font-size: 15px * TvUi.u;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }

                        // TV / Radio + Link buttons
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 6px * TvUi.u;

                            if row.tv != "" || row.radio != "": Text {
                                text: (row.tv != "" ? "TV: " + row.tv : "")
                                    + (row.tv != "" && row.radio != "" ? " · " : "")
                                    + (row.radio != "" ? "Radio: " + row.radio : "");
                                font-size: 15px * TvUi.u;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 8px * TvUi.u;
                                alignment: start;

                                if row.stats-url != "": LinkPill {
                                    label: "Stats";
                                    clicked => { Sports.open-url("Stats", row.stats-url); }
                                }
                                if row.stream-url != "": LinkPill {
                                    label: "Video";
                                    clicked => { Sports.open-url("Video", row.stream-url); }
                                }
                                if row.audio-url != "": LinkPill {
                                    label: "Audio";
                                    clicked => { Sports.open-url("Audio", row.audio-url); }
                                }
                                if row.details-url != "": LinkPill {
                                    label: "Details";
                                    clicked => { Sports.open-url("Details", row.details-url); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Paging footer
        if Sports.total-pages > 1: HorizontalLayout {
            x: 96px * TvUi.u;
            y: 956px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 48px * TvUi.u;
            spacing: 20px * TvUi.u;
            alignment: center;

            Rectangle {
                width: 150px * TvUi.u;
                height: 44px * TvUi.u;
                border-radius: 8px;
                background: prev-ta.has-hover && Sports.page > 0 ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                opacity: Sports.page > 0 ? 1.0 : 0.4;
                Text {
                    text: "← Earlier";
                    font-size: 20px * TvUi.u;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                prev-ta := TouchArea {
                    mouse-cursor: Sports.page > 0 ? pointer : default;
                    clicked => { if Sports.page > 0 { Sports.load(Sports.schedule, Sports.page - 1); } }
                }
            }

            Text {
                text: "Page " + (Sports.page + 1) + " of " + Sports.total-pages;
                font-size: 20px * TvUi.u;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            Rectangle {
                width: 150px * TvUi.u;
                height: 44px * TvUi.u;
                border-radius: 8px;
                background: next-ta.has-hover && Sports.page + 1 < Sports.total-pages ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                opacity: Sports.page + 1 < Sports.total-pages ? 1.0 : 0.4;
                Text {
                    text: "Later →";
                    font-size: 20px * TvUi.u;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                next-ta := TouchArea {
                    mouse-cursor: Sports.page + 1 < Sports.total-pages ? pointer : default;
                    clicked => { if Sports.page + 1 < Sports.total-pages { Sports.load(Sports.schedule, Sports.page + 1); } }
                }
            }
        }

        // Schedule dropdown menu overlay
        if root.filter-open: Rectangle {
            width: 100%;
            height: 100%;
            background: #00000040;

            TouchArea {
                clicked => { root.filter-open = false; }
            }

            Rectangle {
                x: 96px * TvUi.u;
                y: 238px * TvUi.u;
                width: 400px * TvUi.u;
                height: min(choices-col.preferred-height + 16px * TvUi.u, 620px * TvUi.u);
                border-radius: 8px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                Flickable {
                    x: 0px;
                    y: 8px * TvUi.u;
                    width: parent.width;
                    height: parent.height - 16px * TvUi.u;
                    interactive: true;
                    content-height: choices-col.preferred-height;

                    choices-col := VerticalLayout {
                        width: parent.width;
                        spacing: 2px * TvUi.u;

                        for ch in Sports.choices: Rectangle {
                            width: parent.width;
                            height: 44px * TvUi.u;
                            background: ch.value == Sports.schedule ? Theme.accent
                                : ch-ta.has-hover ? Theme.surface-raised : transparent;

                            Text {
                                x: 16px * TvUi.u;
                                width: parent.width - 32px * TvUi.u;
                                height: parent.height;
                                text: ch.label;
                                font-size: 19px * TvUi.u;
                                font-weight: ch.value == Sports.schedule ? 600 : 400;
                                color: ch.value == Sports.schedule ? #FFFFFF : Theme.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            ch-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.filter-open = false;
                                    Sports.load(ch.value, 0);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Tab 1: Scoreboard ────────────────────────────────────────────────────
    if root.tab-idx == 1: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        // Toolbar: Date stepper + Today + Show dropdown + Final filter + Refresh
        HorizontalLayout {
            x: 96px * TvUi.u;
            y: 184px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 48px * TvUi.u;
            spacing: 12px * TvUi.u;
            alignment: start;

            // Prev day
            if Scoreboard.prev-day != "": Rectangle {
                width: 48px * TvUi.u;
                height: 48px * TvUi.u;
                border-radius: 8px;
                background: prev-d-ta.has-hover ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: "←";
                    font-size: 22px * TvUi.u;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                prev-d-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Scoreboard.load(Scoreboard.prev-day, Scoreboard.show, Scoreboard.final-only); }
                }
            }

            // Day label
            Rectangle {
                width: 320px * TvUi.u;
                height: 48px * TvUi.u;
                border-radius: 8px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: Scoreboard.day-label;
                    font-size: 19px * TvUi.u;
                    font-weight: 500;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Next day
            if Scoreboard.next-day != "": Rectangle {
                width: 48px * TvUi.u;
                height: 48px * TvUi.u;
                border-radius: 8px;
                background: next-d-ta.has-hover ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: "→";
                    font-size: 22px * TvUi.u;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                next-d-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Scoreboard.load(Scoreboard.next-day, Scoreboard.show, Scoreboard.final-only); }
                }
            }

            // Today shortcut
            if !Scoreboard.is-today: Rectangle {
                width: 100px * TvUi.u;
                height: 48px * TvUi.u;
                border-radius: 8px;
                background: today-ta.has-hover ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: "Today";
                    font-size: 19px * TvUi.u;
                    font-weight: 500;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                today-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Scoreboard.load("", Scoreboard.show, Scoreboard.final-only); }
                }
            }

            // Show dropdown button
            Rectangle {
                width: 320px * TvUi.u;
                height: 48px * TvUi.u;
                border-radius: 8px;
                background: sb-f-ta.has-hover ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: root.sb-filter-open ? Theme.accent : Theme.border;

                HorizontalLayout {
                    padding-left: 16px * TvUi.u;
                    padding-right: 16px * TvUi.u;
                    spacing: 8px * TvUi.u;
                    Text {
                        text: Scoreboard.show-label;
                        font-size: 19px * TvUi.u;
                        font-weight: 500;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: root.sb-filter-open ? "▴" : "▾";
                        font-size: 18px * TvUi.u;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
                sb-f-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.sb-filter-open = !root.sb-filter-open; }
                }
            }

            // Final scores toggle
            Rectangle {
                width: 170px * TvUi.u;
                height: 48px * TvUi.u;
                border-radius: 8px;
                background: Scoreboard.final-only ? Theme.accent
                    : fin-ta.has-hover ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: Scoreboard.final-only ? Theme.accent : Theme.border;
                Text {
                    text: Scoreboard.final-only ? "Final scores" : "All statuses";
                    font-size: 19px * TvUi.u;
                    font-weight: 500;
                    color: Scoreboard.final-only ? #FFFFFF : Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                fin-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Scoreboard.load(Scoreboard.day, Scoreboard.show, !Scoreboard.final-only); }
                }
            }

            // Refresh
            Rectangle {
                width: 128px * TvUi.u;
                height: 48px * TvUi.u;
                border-radius: 8px;
                background: sb-ref-ta.has-hover ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: Scoreboard.loading ? "Loading…" : "Refresh";
                    font-size: 19px * TvUi.u;
                    font-weight: 500;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                sb-ref-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Scoreboard.load(Scoreboard.day, Scoreboard.show, Scoreboard.final-only); }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "Updates ~10m";
                font-size: 16px * TvUi.u;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }

        // Coverage warning or error banner
        if Scoreboard.error != "" || Scoreboard.coverage-warning != "": Rectangle {
            x: 96px * TvUi.u;
            y: 244px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 44px * TvUi.u;
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.warn;
            Text {
                x: 16px * TvUi.u;
                width: parent.width - 32px * TvUi.u;
                height: parent.height;
                text: Scoreboard.error != "" ? Scoreboard.error : Scoreboard.coverage-warning;
                font-size: 18px * TvUi.u;
                color: Theme.warn;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Empty state
        if !Scoreboard.loading && Scoreboard.rows.length == 0 && Scoreboard.empty-message != "": Rectangle {
            x: 96px * TvUi.u;
            y: 268px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 160px * TvUi.u;
            border-radius: 8px;
            background: Theme.surface;
            Text {
                text: Scoreboard.empty-message;
                font-size: 22px * TvUi.u;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Scrollable Scoreboard groups and cards
        Flickable {
            x: 96px * TvUi.u;
            y: (Scoreboard.error != "" || Scoreboard.coverage-warning != "") ? 300px * TvUi.u : 248px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 1004px * TvUi.u - self.y;
            visible: Scoreboard.rows.length > 0;
            interactive: true;
            content-height: sb-col.preferred-height + 24px * TvUi.u;

            sb-col := VerticalLayout {
                width: 1728px * TvUi.u;
                spacing: 8px * TvUi.u;

                for row in Scoreboard.rows: Rectangle {
                    width: 1728px * TvUi.u;
                    height: row.kind == "group" ? 54px * TvUi.u
                        : (row.warning-text != "" ? 142px * TvUi.u : 122px * TvUi.u);
                    background: row.kind == "game" ? Theme.surface : transparent;
                    border-radius: row.kind == "game" ? 8px : 0px;

                    if row.kind == "group": HorizontalLayout {
                        x: 0;
                        y: 12px * TvUi.u;
                        spacing: 12px * TvUi.u;
                        alignment: start;

                        if row.is-live: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 12px * TvUi.u;
                                height: 12px * TvUi.u;
                                border-radius: 6px * TvUi.u;
                                background: #E53935;
                            }
                        }
                        Text {
                            text: row.group-title;
                            font-size: 26px * TvUi.u;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: row.group-subtitle;
                            font-size: 18px * TvUi.u;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }

                    if row.kind == "game": HorizontalLayout {
                        x: 18px * TvUi.u;
                        y: 0px;
                        width: parent.width - 36px * TvUi.u;
                        height: parent.height;
                        spacing: 16px * TvUi.u;

                        // League + Status / Clock
                        VerticalLayout {
                            width: 240px * TvUi.u;
                            alignment: center;
                            spacing: 4px * TvUi.u;

                            Text {
                                text: row.league-label;
                                font-size: 16px * TvUi.u;
                                font-weight: 600;
                                color: Theme.accent;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 8px * TvUi.u;
                                alignment: start;
                                if row.status == "live" || row.status == "delayed" || row.status == "suspended": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 10px * TvUi.u;
                                        height: 10px * TvUi.u;
                                        border-radius: 5px * TvUi.u;
                                        background: row.status == "live" ? #E53935 : Theme.warn;
                                    }
                                }
                                Text {
                                    text: row.header-text;
                                    font-size: 17px * TvUi.u;
                                    font-weight: 500;
                                    color: row.status == "live" ? #FF6B6B : Theme.text-primary;
                                    overflow: elide;
                                }
                            }
                        }

                        // Away (top) + Home (bottom) matchup with scores
                        VerticalLayout {
                            width: 440px * TvUi.u;
                            alignment: center;
                            spacing: 6px * TvUi.u;

                            HorizontalLayout {
                                spacing: 12px * TvUi.u;
                                TeamBadge {
                                    horizontal-stretch: 1;
                                    name: row.away-name;
                                    side-label: row.away-winner ? "Winner" : row.away-leading ? "Leading" : "";
                                    has-logo: row.away-has-logo;
                                    logo: row.away-logo;
                                    initials: row.away-initials;
                                }
                                Text {
                                    width: 56px * TvUi.u;
                                    text: row.away-score;
                                    font-size: 26px * TvUi.u;
                                    font-weight: row.away-winner || row.away-leading ? 700 : 400;
                                    color: row.away-winner || row.away-leading ? Theme.text-primary : Theme.text-secondary;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px * TvUi.u;
                                TeamBadge {
                                    horizontal-stretch: 1;
                                    name: row.home-name;
                                    side-label: row.home-winner ? "Winner" : row.home-leading ? "Leading" : "";
                                    has-logo: row.home-has-logo;
                                    logo: row.home-logo;
                                    initials: row.home-initials;
                                }
                                Text {
                                    width: 56px * TvUi.u;
                                    text: row.home-score;
                                    font-size: 26px * TvUi.u;
                                    font-weight: row.home-winner || row.home-leading ? 700 : 400;
                                    color: row.home-winner || row.home-leading ? Theme.text-primary : Theme.text-secondary;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Details + Warning + Recap / Game link
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px * TvUi.u;

                            if row.details-text != "": Text {
                                text: row.details-text;
                                font-size: 15px * TvUi.u;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                            if row.warning-text != "": Text {
                                text: row.warning-text;
                                font-size: 14px * TvUi.u;
                                color: Theme.warn;
                                overflow: elide;
                            }
                            if row.source-url != "": HorizontalLayout {
                                alignment: start;
                                LinkPill {
                                    label: row.status == "final" ? "Recap ↗" : "Game ↗";
                                    clicked => { Scoreboard.open-url(row.away-name + " vs " + row.home-name, row.source-url); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Show filter dropdown overlay
        if root.sb-filter-open: Rectangle {
            width: 100%;
            height: 100%;
            background: #00000040;

            TouchArea {
                clicked => { root.sb-filter-open = false; }
            }

            Rectangle {
                x: 452px * TvUi.u;
                y: 238px * TvUi.u;
                width: 440px * TvUi.u;
                height: min(sb-choices-col.preferred-height + 16px * TvUi.u, 620px * TvUi.u);
                border-radius: 8px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                Flickable {
                    x: 0px;
                    y: 8px * TvUi.u;
                    width: parent.width;
                    height: parent.height - 16px * TvUi.u;
                    interactive: true;
                    content-height: sb-choices-col.preferred-height;

                    sb-choices-col := VerticalLayout {
                        width: parent.width;
                        spacing: 2px * TvUi.u;

                        for ch in Scoreboard.choices: Rectangle {
                            width: parent.width;
                            height: 44px * TvUi.u;
                            background: ch.value == Scoreboard.show ? Theme.accent
                                : sb-ch-ta.has-hover ? Theme.surface-raised : transparent;

                            HorizontalLayout {
                                x: 16px * TvUi.u;
                                width: parent.width - 32px * TvUi.u;
                                height: parent.height;
                                spacing: 8px * TvUi.u;

                                Text {
                                    text: ch.label;
                                    font-size: 18px * TvUi.u;
                                    font-weight: ch.value == Scoreboard.show ? 600 : 400;
                                    color: ch.value == Scoreboard.show ? #FFFFFF : Theme.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }

                                if ch.group != "": Text {
                                    text: ch.group;
                                    font-size: 14px * TvUi.u;
                                    color: ch.value == Scoreboard.show ? #FFFFFFCC : Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            sb-ch-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.sb-filter-open = false;
                                    Scoreboard.load(Scoreboard.day, ch.value, Scoreboard.final-only);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
