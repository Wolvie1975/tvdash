// Classic UI — Scoreboard panel (§6).

import { Theme } from "../theme.slint";
import { Scoreboard, ScoreCard, ScoreEmphasis, ScoreSide, ScoreTone, TvUi } from "../state.slint";

component TvScoreSideRow inherits HorizontalLayout {
    in property <ScoreSide> side;
    in property <bool> is-upcoming: false;
    in property <bool> is-postponed: false;

    spacing: 10px * TvUi.u;
    height: 38px * TvUi.u;

    Text {
        width: 40px * TvUi.u;
        text: root.side.rank;
        font-size: 16px * TvUi.u;
        font-weight: 700;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }

    Rectangle {
        width: 34px * TvUi.u;
        height: 34px * TvUi.u;
        border-radius: 6px;
        y: (parent.height - self.height) / 2;
        background: root.side.has-logo ? transparent : Theme.surface-raised;
        border-width: root.side.has-logo ? 0px : 1px;
        border-color: Theme.border;
        clip: true;

        if root.side.has-logo: Image {
            width: 100%;
            height: 100%;
            source: root.side.logo;
            image-fit: contain;
        }

        if !root.side.has-logo: Text {
            text: root.side.initials;
            font-size: 13px * TvUi.u;
            font-weight: 700;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        horizontal-stretch: 1;
        text: root.side.full;
        font-size: 22px * TvUi.u;
        font-weight: root.side.emphasis == ScoreEmphasis.lead ? 700
            : root.side.emphasis == ScoreEmphasis.trail ? 400 : 600;
        color: root.side.emphasis == ScoreEmphasis.trail ? Theme.text-secondary : Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }

    for p in root.side.periods: Text {
        width: 34px * TvUi.u;
        text: p;
        font-size: 18px * TvUi.u;
        font-weight: 500;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if !root.is-postponed: Text {
        width: 48px * TvUi.u;
        text: root.side.total;
        font-size: root.is-upcoming ? 16px * TvUi.u : 30px * TvUi.u;
        font-weight: root.is-upcoming ? 500
            : root.side.emphasis == ScoreEmphasis.lead ? 700 : 500;
        color: (root.is-upcoming || root.side.emphasis == ScoreEmphasis.trail)
            ? Theme.text-secondary : Theme.text-primary;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component TvScoreCardRow inherits Rectangle {
    in property <ScoreCard> card;
    in property <bool> is-postponed: false;

    property <bool> star-foc: !TvUi.bar-focused && root.card.star-focus-id >= 0 && TvUi.focused-tile == root.card.star-focus-id;
    property <bool> game-foc: !TvUi.bar-focused && root.card.game-focus-id >= 0 && TvUi.focused-tile == root.card.game-focus-id;
    property <bool> card-foc: root.star-foc || root.game-foc;

    border-radius: 6px;
    background: Theme.surface;
    border-width: root.card-foc ? 4px : 1px;
    border-color: root.card-foc ? Theme.accent : Theme.border;

    HorizontalLayout {
        padding-left: 20px * TvUi.u;
        padding-right: 20px * TvUi.u;
        padding-top: 16px * TvUi.u;
        padding-bottom: 16px * TvUi.u;
        spacing: 20px * TvUi.u;

        // Left (160px): League + Status
        VerticalLayout {
            width: 160px * TvUi.u;
            alignment: center;
            spacing: 6px * TvUi.u;

            Text {
                text: root.card.league;
                font-size: 14px * TvUi.u;
                font-weight: 700;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 6px * TvUi.u;
                alignment: start;

                if root.card.tone == ScoreTone.live: Rectangle {
                    width: 10px * TvUi.u;
                    height: 10px * TvUi.u;
                    border-radius: 5px * TvUi.u;
                    background: #E8000D;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.card.status;
                    font-size: 18px * TvUi.u;
                    font-weight: 700;
                    color: root.card.tone == ScoreTone.live ? #E8000D
                        : root.card.tone == ScoreTone.upcoming ? Theme.accent
                        : Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }

        // Middle (1fr): Box score + Venue
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px * TvUi.u;

            if !root.is-postponed && root.card.period-labels.length > 0: HorizontalLayout {
                spacing: 10px * TvUi.u;
                height: 20px * TvUi.u;

                Rectangle { horizontal-stretch: 1; }

                for lbl in root.card.period-labels: Text {
                    width: 34px * TvUi.u;
                    text: lbl;
                    font-size: 14px * TvUi.u;
                    font-weight: 700;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    width: 48px * TvUi.u;
                    text: "T";
                    font-size: 14px * TvUi.u;
                    font-weight: 700;
                    color: Theme.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            TvScoreSideRow {
                side: root.card.away;
                is-upcoming: root.card.tone == ScoreTone.upcoming;
                is-postponed: root.is-postponed;
            }

            TvScoreSideRow {
                side: root.card.home;
                is-upcoming: root.card.tone == ScoreTone.upcoming;
                is-postponed: root.is-postponed;
            }

            if root.card.meta != "": Text {
                text: root.card.meta;
                font-size: 15px * TvUi.u;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }

        // Right (112px): Star + Game ↗ stacked
        VerticalLayout {
            width: 112px * TvUi.u;
            alignment: center;
            spacing: 8px * TvUi.u;

            if root.card.following: Rectangle {
                height: 42px * TvUi.u;
                border-radius: 6px;
                background: Theme.accent.with-alpha(0.18);
                Text {
                    text: "★ Following";
                    font-size: 15px * TvUi.u;
                    font-weight: 700;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if !root.card.following && root.card.event-id != "": Rectangle {
                height: 42px * TvUi.u;
                border-radius: 6px;
                background: root.card.starred ? Theme.accent : (c-st-ta.has-hover ? Theme.surface-raised : Theme.bg);
                border-width: root.star-foc ? 3px : 1px;
                border-color: root.star-foc ? Theme.accent : (root.card.starred ? Theme.accent : Theme.border);

                Text {
                    text: root.card.starred ? "★ Starred" : "☆ Star";
                    font-size: 15px * TvUi.u;
                    font-weight: 700;
                    color: root.card.starred ? #FFFFFF : Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                c-st-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Scoreboard.toggle-star(root.card.event-id); }
                }
            }

            if root.card.game-url != "": Rectangle {
                height: 42px * TvUi.u;
                border-radius: 6px;
                background: c-gm-ta.has-hover ? Theme.surface-raised : Theme.bg;
                border-width: root.game-foc ? 3px : 1px;
                border-color: root.game-foc ? Theme.accent : Theme.border;

                Text {
                    text: "Game ↗";
                    font-size: 15px * TvUi.u;
                    font-weight: 700;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                c-gm-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Scoreboard.open-url(root.card.away.full + " vs " + root.card.home.full, root.card.game-url);
                    }
                }
            }
        }
    }
}

export component TvScoreboardPanel inherits Rectangle {
    background: transparent;
    property <bool> sb-filter-open: false;

    Timer {
        interval: (Scoreboard.groups.length > 0 && Scoreboard.groups[0].is-live) ? 120s : 600s;
        running: Scoreboard.is-today && !Scoreboard.loading;
        triggered => { Scoreboard.refresh(); }
    }

    // Controls row (§6)
    HorizontalLayout {
        x: 96px * TvUi.u;
        y: 184px * TvUi.u;
        width: 1728px * TvUi.u;
        height: 50px * TvUi.u;
        spacing: 12px * TvUi.u;
        alignment: start;

        Rectangle {
            width: 50px * TvUi.u;
            height: 50px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;
            border-width: (!TvUi.bar-focused && TvUi.focused-tile == 2) ? 3px : 1px;
            border-color: (!TvUi.bar-focused && TvUi.focused-tile == 2) ? Theme.accent : Theme.border;
            opacity: Scoreboard.prev-day != "" ? 1.0 : 0.35;
            Text { text: "‹"; font-size: 24px * TvUi.u; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea {
                mouse-cursor: Scoreboard.prev-day != "" ? pointer : default;
                clicked => { Scoreboard.prev-day-clicked(); }
            }
        }

        Rectangle {
            width: 320px * TvUi.u;
            height: 50px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            Text {
                text: Scoreboard.day-label;
                font-size: 19px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            width: 50px * TvUi.u;
            height: 50px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;
            border-width: (!TvUi.bar-focused && TvUi.focused-tile == 3) ? 3px : 1px;
            border-color: (!TvUi.bar-focused && TvUi.focused-tile == 3) ? Theme.accent : Theme.border;
            opacity: Scoreboard.next-day != "" ? 1.0 : 0.35;
            Text { text: "›"; font-size: 24px * TvUi.u; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea {
                mouse-cursor: Scoreboard.next-day != "" ? pointer : default;
                clicked => { Scoreboard.next-day-clicked(); }
            }
        }

        if !Scoreboard.is-today: Rectangle {
            width: 100px * TvUi.u;
            height: 50px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;
            border-width: (!TvUi.bar-focused && TvUi.focused-tile == 4) ? 3px : 1px;
            border-color: (!TvUi.bar-focused && TvUi.focused-tile == 4) ? Theme.accent : Theme.border;
            Text {
                text: "Today";
                font-size: 19px * TvUi.u;
                font-weight: 600;
                color: Theme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Scoreboard.today-clicked(); }
            }
        }

        Rectangle {
            width: 300px * TvUi.u;
            height: 50px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;
            border-width: (!TvUi.bar-focused && TvUi.focused-tile == 5) || root.sb-filter-open ? 3px : 1px;
            border-color: (!TvUi.bar-focused && TvUi.focused-tile == 5) || root.sb-filter-open ? Theme.accent : Theme.border;

            HorizontalLayout {
                padding-left: 16px * TvUi.u;
                padding-right: 16px * TvUi.u;
                spacing: 8px * TvUi.u;
                Text {
                    text: Scoreboard.show-label;
                    font-size: 19px * TvUi.u;
                    font-weight: 500;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: root.sb-filter-open ? "▴" : "▾";
                    font-size: 18px * TvUi.u;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.sb-filter-open = !root.sb-filter-open; }
            }
        }

        Rectangle {
            width: 128px * TvUi.u;
            height: 50px * TvUi.u;
            border-radius: 6px;
            background: Theme.surface;
            border-width: (!TvUi.bar-focused && TvUi.focused-tile == 6) ? 3px : 1px;
            border-color: (!TvUi.bar-focused && TvUi.focused-tile == 6) ? Theme.accent : Theme.border;
            Text {
                text: Scoreboard.loading ? "Loading…" : "Refresh";
                font-size: 19px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Scoreboard.refresh(); }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if Scoreboard.fresh != "": Text {
            text: Scoreboard.fresh;
            font-size: 17px * TvUi.u;
            color: Scoreboard.stale ? Theme.warn : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    if !Scoreboard.loading && Scoreboard.groups.length == 0: Text {
        x: 96px * TvUi.u;
        y: 268px * TvUi.u;
        text: Scoreboard.error != "" ? Scoreboard.error : ("No games on " + Scoreboard.day-label);
        font-size: 24px * TvUi.u;
        color: Scoreboard.error != "" ? Theme.warn : Theme.text-secondary;
    }

    if Scoreboard.groups.length > 0: Flickable {
        x: 96px * TvUi.u;
        y: 252px * TvUi.u;
        width: 1728px * TvUi.u;
        height: 752px * TvUi.u;
        interactive: true;
        content-height: sb-col.preferred-height + 24px * TvUi.u;

        sb-col := VerticalLayout {
            width: 1728px * TvUi.u;
            spacing: 14px * TvUi.u;

            for grp in Scoreboard.groups: VerticalLayout {
                width: 1728px * TvUi.u;
                spacing: 12px * TvUi.u;

                HorizontalLayout {
                    spacing: 10px * TvUi.u;
                    alignment: start;

                    if grp.is-live: Rectangle {
                        width: 13px * TvUi.u;
                        height: 13px * TvUi.u;
                        border-radius: 7px * TvUi.u;
                        background: #E8000D;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: grp.title;
                        font-size: 30px * TvUi.u;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: grp.count;
                        font-size: 20px * TvUi.u;
                        font-weight: 400;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                // 2-column rows
                for row_idx in Math.ceil(grp.cards.length / 2): HorizontalLayout {
                    spacing: 17px * TvUi.u;

                    for col_idx in [0, 1]: Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        if (row_idx * 2 + col_idx) < grp.cards.length: TvScoreCardRow {
                            width: 100%;
                            card: grp.cards[row_idx * 2 + col_idx];
                            is-postponed: grp.is-postponed;
                        }
                    }
                }
            }
        }
    }

    if root.sb-filter-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        TouchArea {
            clicked => { root.sb-filter-open = false; }
        }

        Rectangle {
            x: 452px * TvUi.u;
            y: 238px * TvUi.u;
            width: 440px * TvUi.u;
            height: min(sb-choices-col.preferred-height + 16px * TvUi.u, 620px * TvUi.u);
            border-radius: 6px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            Flickable {
                x: 0px;
                y: 8px * TvUi.u;
                width: parent.width;
                height: parent.height - 16px * TvUi.u;
                interactive: true;
                content-height: sb-choices-col.preferred-height;

                sb-choices-col := VerticalLayout {
                    width: parent.width;
                    spacing: 2px * TvUi.u;

                    for ch in Scoreboard.choices: Rectangle {
                        width: parent.width;
                        height: 44px * TvUi.u;
                        background: ch.value == Scoreboard.show ? Theme.accent : transparent;

                        Text {
                            x: 16px * TvUi.u;
                            text: ch.label;
                            font-size: 18px * TvUi.u;
                            font-weight: ch.value == Scoreboard.show ? 600 : 400;
                            color: ch.value == Scoreboard.show ? #FFFFFF : Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.sb-filter-open = false;
                                Scoreboard.set-filter(ch.value);
                            }
                        }
                    }
                }
            }
        }
    }
}
