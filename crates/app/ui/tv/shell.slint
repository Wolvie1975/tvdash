// TV-only shell (Tile hub, v2). Design units: 1920 x 1080, safe area 96 / 54 px.

import { Theme } from "../theme.slint";
import { Icon } from "../icons.slint";
import { Dash, TvUi } from "../state.slint";
import { TabBar } from "tabs.slint";
import { TvHome } from "home.slint";
import { TvApps } from "apps.slint";
import { TvCollections } from "collections.slint";
import { TvLibrary } from "library.slint";
import { TvShow } from "show.slint";
import { TvCollection } from "collection.slint";
import { TvSearch } from "search.slint";
import { TvSettings } from "settings.slint";
import { TvDashboardPicker } from "dashboard_picker.slint";
import { QuickSwitchPicker } from "../shared/quick_switch_picker.slint";
import { TvSports } from "events.slint";
import { TvPlayerHud } from "player_hud.slint";
import { TvAmbient } from "ambient.slint";
import { Intro, IntroStage } from "../shared/intro.slint";
import { TilesIntro } from "intro_tiles.slint";

component MiniTransportBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();

    width: 40px * TvUi.u;
    height: 40px * TvUi.u;
    border-radius: 6px;
    background: ta.has-hover ? Theme.surface-raised : Theme.bg;
    border-width: 1px;
    border-color: Theme.border;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        size: 20px * TvUi.u;
        tint: Theme.text-primary;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TvShell inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    property <float> scale: max(0.5, min(root.width / 1920px, root.height / 1080px));
    changed scale => { TvUi.u = self.scale; }
    init => { TvUi.u = self.scale; }

    property <int> focus-ticket: TvUi.focus-ticket;
    changed focus-ticket => { keys.focus(); }

    keys := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if TvUi.key(event.text) {
                accept
            } else {
                reject
            }
        }
    }

    // In-window full-screen video when playing on TV.
    if TvUi.video-on && TvUi.video-full: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;

        Image {
            source: TvUi.video;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }

        TouchArea {
            clicked => {
                TvUi.hud-open = !TvUi.hud-open;
                if TvUi.hud-open {
                    TvUi.focused-tile = 1;
                }
                TvUi.overlay();
            }
            moved => {
                if !TvUi.hud-open {
                    TvUi.focused-tile = 1;
                    TvUi.hud-open = true;
                    TvUi.overlay();
                }
            }
        }

        if TvUi.hud-open: TvPlayerHud { }
    }

    // ── Tile Hub UI (hidden while full-screen video is active) ───────────────
    if !(TvUi.video-on && TvUi.video-full): Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 1920px * TvUi.u;
        height: 1080px * TvUi.u;
        background: Theme.bg;
        opacity: Intro.revealing ? 1.0 : 0.0;
        animate opacity {
            duration: Intro.instant ? 0ms : 400ms;
            delay: Intro.instant ? 0ms : 300ms;
            easing: cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        // Pages (rendered before top chrome so backdrops never cover TabBar / Back pill)
        if TvUi.screen == "home": TvHome { }
        if TvUi.screen == "apps": TvApps { }
        if TvUi.screen == "collections": TvCollections { }
        if TvUi.screen == "library": TvLibrary { }
        if TvUi.screen == "show": TvShow { }
        if TvUi.screen == "collection": TvCollection { }
        if TvUi.screen == "search": TvSearch { }
        if TvUi.screen == "sports": TvSports { }
        if TvUi.screen == "settings": TvSettings { }
        if TvUi.screen == "dashboard_picker": TvDashboardPicker { }
        if TvUi.screen == "quick_switch_picker": QuickSwitchPicker { width: parent.width; height: parent.height; }

        // Top chrome: optional Back pill + TabBar left, compact clock + weather top-right
        if TvUi.screen == "show" || TvUi.screen == "collection" || TvUi.screen == "search" || TvUi.screen == "dashboard_picker" || TvUi.screen == "quick_switch_picker": Rectangle {
            x: 96px * TvUi.u;
            y: 52px * TvUi.u;
            width: back-lbl.preferred-width + 32px * TvUi.u;
            height: 46px * TvUi.u;
            border-radius: 23px * TvUi.u;
            background: back-ta.has-hover ? Theme.surface-raised : Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            back-lbl := Text {
                text: "← Back";
                font-size: 22px * TvUi.u;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            back-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { TvUi.back-clicked(); }
            }
        }

        TabBar {
            x: ((TvUi.screen == "show" || TvUi.screen == "collection" || TvUi.screen == "search" || TvUi.screen == "dashboard_picker") ? 240px : 96px) * TvUi.u;
            y: 44px * TvUi.u;
            active: TvUi.active-tab;
            bar-focused: TvUi.bar-focused;
            tab-clicked(i) => { TvUi.tab-clicked(i); }
        }

        HorizontalLayout {
            x: 1920px * TvUi.u - 96px * TvUi.u - self.preferred-width;
            y: 54px * TvUi.u;
            spacing: 20px * TvUi.u;
            alignment: end;

            if Dash.weather-on: HorizontalLayout {
                spacing: 8px * TvUi.u;
                Icon {
                    name: Dash.weather-icon;
                    size: 28px * TvUi.u;
                    tint: Theme.text-secondary;
                }
                Text {
                    text: Dash.weather-temp;
                    font-size: 28px * TvUi.u;
                    font-weight: 300;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            Text {
                text: Dash.clock-hh + ":" + Dash.clock-mm;
                font-size: 28px * TvUi.u;
                font-weight: 400;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // Bottom-left toast
        if Dash.toast != "": Rectangle {
            x: 96px * TvUi.u;
            y: 1080px * TvUi.u - 44px * TvUi.u - self.height;
            width: toast-lbl.preferred-width + 40px * TvUi.u;
            height: 48px * TvUi.u;
            border-radius: 24px * TvUi.u;
            background: #0B0D10E6;
            border-width: 1px;
            border-color: Theme.border;

            toast-lbl := Text {
                text: Dash.toast;
                font-size: 22px * TvUi.u;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Now-playing transport bar (two-screen mode, or when video is minimized in one-screen mode)
        if (Dash.tv.mode == "playing" || Dash.tv.mode == "paused") && !(TvUi.video-on && TvUi.video-full): Rectangle {
            x: 96px * TvUi.u;
            y: 1022px * TvUi.u;
            width: 1728px * TvUi.u;
            height: 52px * TvUi.u;
            border-radius: 8px;
            background: #0B0D10EB;
            border-width: 1px;
            border-color: Theme.border;

            // Progress bar along top edge
            Rectangle {
                x: 10px * TvUi.u;
                y: 0px;
                width: parent.width - 20px * TvUi.u;
                height: 3px * TvUi.u;
                border-radius: 2px;
                background: #FFFFFF22;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * clamp(Dash.tv.progress, 0.0, 1.0);
                    height: 100%;
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }

            HorizontalLayout {
                x: 16px * TvUi.u;
                y: 0px;
                width: parent.width - 32px * TvUi.u;
                height: parent.height;
                spacing: 8px * TvUi.u;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    spacing: 1px * TvUi.u;
                    horizontal-stretch: 1;

                    Text {
                        text: Dash.tv.title;
                        font-size: 18px * TvUi.u;
                        font-weight: 500;
                        color: Theme.text-primary;
                        overflow: elide;
                    }

                    Text {
                        text: Dash.tv.subtitle + (Dash.tv-ends-at != "" ? " · Ends at " + Dash.tv-ends-at : "");
                        font-size: 14px * TvUi.u;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }
                }

                MiniTransportBtn { icon: "back"; label: "-10s"; clicked => { Dash.transport("back"); } }
                MiniTransportBtn {
                    icon: Dash.tv.mode == "paused" ? "play" : "pause";
                    label: Dash.tv.mode == "paused" ? "Play" : "Pause";
                    clicked => { Dash.transport("play-pause"); }
                }
                MiniTransportBtn { icon: "forward"; label: "+30s"; clicked => { Dash.transport("forward"); } }
                MiniTransportBtn { icon: "stop"; label: "Stop"; clicked => { Dash.transport("stop"); } }
                MiniTransportBtn { icon: "sub"; label: "Subtitles"; clicked => { Dash.transport("sub"); } }
                MiniTransportBtn { icon: "audio"; label: "Audio"; clicked => { Dash.transport("audio"); } }
            }
        }

    }

    // ── Up Next modal when a TV episode finishes ─────────────────────────────
    if Dash.next-ep-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000B0;

        TouchArea {
            clicked => { Dash.dismiss-next-ep(); }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 780px * TvUi.u;
            height: 360px * TvUi.u;
            border-radius: 10px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: #000000B0;

            TouchArea { }

            VerticalLayout {
                padding: 28px * TvUi.u;
                spacing: 20px * TvUi.u;

                Text {
                    text: "UP NEXT";
                    font-size: 18px * TvUi.u;
                    font-weight: 500;
                    letter-spacing: 1.2px;
                    color: Theme.text-secondary;
                }

                HorizontalLayout {
                    spacing: 22px * TvUi.u;
                    vertical-stretch: 1;

                    if Dash.next-ep-has-poster: Rectangle {
                        width: 128px * TvUi.u;
                        height: 180px * TvUi.u;
                        border-radius: 6px;
                        clip: true;

                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: Dash.next-ep-poster;
                            image-fit: cover;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px * TvUi.u;
                        horizontal-stretch: 1;

                        Text {
                            text: Dash.next-ep-title;
                            font-size: 30px * TvUi.u;
                            font-weight: 500;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }

                        if Dash.next-ep-subtitle != "": Text {
                            text: Dash.next-ep-subtitle;
                            font-size: 22px * TvUi.u;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px * TvUi.u;
                    alignment: end;

                    Rectangle {
                        width: play-next-lbl.preferred-width + 44px * TvUi.u;
                        height: 56px * TvUi.u;
                        border-radius: 6px;
                        background: Theme.accent;
                        border-width: TvUi.focused-tile != 1 ? 3px : 0px;
                        border-color: Theme.text-primary;

                        play-next-lbl := Text {
                            text: "Play Next";
                            font-size: 22px * TvUi.u;
                            font-weight: 600;
                            color: #0B0D10;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Dash.play-next-ep(); }
                        }
                    }

                    Rectangle {
                        width: back-dash-lbl.preferred-width + 44px * TvUi.u;
                        height: 56px * TvUi.u;
                        border-radius: 6px;
                        background: Theme.surface-raised;
                        border-width: TvUi.focused-tile == 1 ? 3px : 1px;
                        border-color: TvUi.focused-tile == 1 ? Theme.text-primary : Theme.border;

                        back-dash-lbl := Text {
                            text: "Back to Dashboard";
                            font-size: 22px * TvUi.u;
                            font-weight: 500;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Dash.dismiss-next-ep(); }
                        }
                    }
                }
            }
        }
    }

    // ── Ambient idle overlay ─────────────────────────────────────────────────
    if TvUi.ambient: TvAmbient { }

    if Intro.stage != IntroStage.done: TilesIntro {
        width: 100%;
        height: 100%;
    }
}
