// Classic UI — Home (§14.2), bound to the same HomeState as Blades.

import { Theme, UiTheme } from "../theme.slint";
import { Icon } from "../icons.slint";
import { Dash, GameState, HomeState, SleepState, TvUi } from "../state.slint";
import { IconTile, Tile, ValueTile } from "tile.slint";
import { IntroRise } from "../shared/intro.slint";

export component TvHome inherits Rectangle {
    width: 1920px * TvUi.u;
    height: 1080px * TvUi.u;
    background: transparent;

    // ── Group 1: What's On info column + Hero art (450 ms) ───────────────────
    IntroRise {
        width: parent.width;
        height: parent.height;
        delay: 450ms;

        // Left: What's On info column (230 x 590, non-focusable)
        Tile {
            x: 96px * TvUi.u;
            y: 136px * TvUi.u;
            base-width: 230px * TvUi.u;
            base-height: 590px * TvUi.u;
            fill: Dash.tint.card;
            focused: false;

            VerticalLayout {
                padding: 18px * TvUi.u;
                spacing: 8px * TvUi.u;
                alignment: start;

                Text {
                    text: HomeState.whats-on.source != ""
                        ? "WHAT'S ON · " + HomeState.whats-on.source
                        : "WHAT'S ON";
                    font-size: 13px * TvUi.u;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    color: #FFFFFF;
                    wrap: word-wrap;
                }

                Text {
                    text: HomeState.whats-on.has-item
                        ? HomeState.whats-on.title
                        : "Nothing on right now";
                    font-size: 22px * TvUi.u;
                    font-weight: 700;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                if HomeState.whats-on.subtitle != "" || !HomeState.whats-on.has-item: Text {
                    text: HomeState.whats-on.has-item
                        ? HomeState.whats-on.subtitle
                        : "Search or open the Library";
                    font-size: 16px * TvUi.u;
                    font-weight: 600;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                if HomeState.whats-on.progress >= 0.0: Rectangle {
                    height: 5px * TvUi.u;
                    border-radius: 3px * TvUi.u;
                    background: #FFFFFF38;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * clamp(HomeState.whats-on.progress, 0.0, 1.0);
                        height: parent.height;
                        border-radius: 3px * TvUi.u;
                        background: #FFFFFF;
                    }
                }

                if HomeState.whats-on.status != "": Text {
                    text: HomeState.whats-on.status;
                    font-size: 15px * TvUi.u;
                    font-weight: 600;
                    color: Dash.tint.sec;
                    overflow: elide;
                }

                if HomeState.whats-on.plot != "": Rectangle {
                    height: 1px;
                    background: Dash.tint.sec.with-alpha(0.25);
                }

                if HomeState.whats-on.plot != "": Text {
                    text: HomeState.whats-on.plot;
                    font-size: 15px * TvUi.u;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-stretch: 1;
                }
            }
        }

        // 0: Hero art only (708 x 590; no badge or title overlay)
        Tile {
            x: 342px * TvUi.u;
            y: 136px * TvUi.u;
            base-width: 708px * TvUi.u;
            base-height: 590px * TvUi.u;
            fill: HomeState.whats-on.is-app ? HomeState.whats-on.app-color : Dash.tint.poster;
            focused: !TvUi.bar-focused && TvUi.focused-tile == 0;
            activated => { HomeState.activate-hero(); }
            hovered => { TvUi.tile-hovered(0); }

            if !HomeState.whats-on.is-app && HomeState.whats-on.has-art: Image {
                width: parent.width;
                height: parent.height;
                source: HomeState.whats-on.art;
                image-fit: cover;
            }

            if HomeState.whats-on.is-app && HomeState.whats-on.app-has-logo: Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width * 0.55;
                height: parent.height * 0.45;
                source: HomeState.whats-on.app-logo;
                image-fit: contain;
            }

            if !HomeState.whats-on.has-item && !HomeState.whats-on.is-app: VerticalLayout {
                alignment: center;
                spacing: 14px * TvUi.u;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: 84px * TvUi.u;
                    height: 84px * TvUi.u;
                    border-radius: 42px * TvUi.u;
                    background: #FFFFFF14;

                    Icon {
                        x: (parent.width - self.width) / 2 + 2px * TvUi.u;
                        y: (parent.height - self.height) / 2;
                        size: 36px * TvUi.u;
                        name: "search";
                        tint: Theme.text-secondary;
                    }
                }

                Text {
                    text: "Nothing on right now";
                    font-size: 26px * TvUi.u;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Press OK to search or browse Library";
                    font-size: 18px * TvUi.u;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }

            if TvUi.video-on: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 88px * TvUi.u;
                height: 88px * TvUi.u;
                border-radius: 44px * TvUi.u;
                background: #0B0D10B8;
                border-width: 2px;
                border-color: #FFFFFF55;

                Icon {
                    x: (parent.width - self.width) / 2 + 3px * TvUi.u;
                    y: (parent.height - self.height) / 2;
                    size: 40px * TvUi.u;
                    name: "play";
                    tint: #FFFFFF;
                }
            }
        }
    } // end Group 1

    // ── Group 2: Quick tiles column (Search, Screensaver, Sleep, Theme) (530 ms)
    IntroRise {
        width: parent.width;
        height: parent.height;
        delay: 530ms;

        // 6: Search
        IconTile {
            x: 1066px * TvUi.u;
            y: 136px * TvUi.u;
            base-width: 240px * TvUi.u;
            base-height: 135px * TvUi.u;
            fill: Dash.tint.poster;
            icon: "search";
            label: "Search";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 6;
            activated => { TvUi.tile-activated(6); }
            hovered => { TvUi.tile-hovered(6); }
        }

        // 7: Screensaver
        IconTile {
            x: 1066px * TvUi.u;
            y: 287px * TvUi.u;
            base-width: 240px * TvUi.u;
            base-height: 135px * TvUi.u;
            fill: Dash.tint.poster;
            icon: "screensaver";
            label: "Screensaver";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 7;
            activated => { TvUi.tile-activated(7); }
            hovered => { TvUi.tile-hovered(7); }
        }

        // 8: Sleep
        IconTile {
            x: 1066px * TvUi.u;
            y: 438px * TvUi.u;
            base-width: 240px * TvUi.u;
            base-height: 135px * TvUi.u;
            fill: Dash.tint.card;
            icon: "moon";
            label: SleepState.active ? "Sleep · " + SleepState.label : "Sleep · Off";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 8;
            activated => { TvUi.tile-activated(8); }
            hovered => { TvUi.tile-hovered(8); }
        }

        // 9: Theme
        ValueTile {
            x: 1066px * TvUi.u;
            y: 589px * TvUi.u;
            base-width: 240px * TvUi.u;
            base-height: 137px * TvUi.u;
            fill: Dash.tint.poster;
            label: "Theme";
            value: Theme.mode == UiTheme.dark ? "Espresso" : Theme.mode == UiTheme.aubergine ? "Aubergine" : Theme.mode == UiTheme.ku ? "Kansas Dark" : Theme.mode == UiTheme.ku-light ? "Kansas Light" : Theme.mode == UiTheme.stone ? "Stone" : "Mist";
            focused: !TvUi.bar-focused && TvUi.focused-tile == 9;
            activated => { TvUi.tile-activated(9); }
            hovered => { TvUi.tile-hovered(9); }
        }
    } // end Group 2

    // ── Group 3: Bottom row (Clock + Up next 4 cards) (610 ms) ───────────────
    IntroRise {
        width: parent.width;
        height: parent.height;
        delay: 610ms;

        // Clock card (230 x 230, non-focusable)
        Tile {
            x: 96px * TvUi.u;
            y: 742px * TvUi.u;
            base-width: 230px * TvUi.u;
            base-height: 230px * TvUi.u;
            fill: Dash.tint.card;
            focused: false;

            VerticalLayout {
                padding: 16px * TvUi.u;
                spacing: 6px * TvUi.u;

                HorizontalLayout {
                    spacing: 4px * TvUi.u;
                    alignment: start;

                    Text {
                        text: Dash.clock-hh + ":" + Dash.clock-mm;
                        font-size: 32px * TvUi.u;
                        font-weight: 300;
                        color: Theme.text-primary;
                    }

                    if Dash.clock-ampm != "": Text {
                        text: Dash.clock-ampm;
                        font-size: 15px * TvUi.u;
                        font-weight: 400;
                        color: Dash.tint.sec;
                        vertical-alignment: bottom;
                    }
                }

                Text {
                    text: Dash.clock-year != "" ? Dash.date-text + ", " + Dash.clock-year : Dash.date-text;
                    font-size: 14px * TvUi.u;
                    color: Dash.tint.sec;
                    overflow: elide;
                }

                Rectangle {
                    height: 1px;
                    background: Dash.tint.sec.with-alpha(0.25);
                }

                HorizontalLayout {
                    spacing: 8px * TvUi.u;
                    alignment: start;

                    Icon {
                        name: Dash.weather-icon;
                        size: 24px * TvUi.u;
                        tint: Dash.tint.accent;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: Dash.weather-on
                            ? Dash.weather-temp + " · " + Dash.weather-condition
                            : "Weather";
                        font-size: 18px * TvUi.u;
                        font-weight: 500;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: Dash.weather-on
                        ? (Dash.weather-note != "" ? Dash.weather-note : Dash.weather-detail)
                        : "Set location in Settings";
                    font-size: 15px * TvUi.u;
                    color: Dash.tint.sec;
                    overflow: elide;
                }
            }
        }

        // 1..=4: Up next row (4 cards across x: 342..1306, y: 742, h: 230)
        for card[i] in HomeState.up-next: Tile {
            visible: i < 4;
            x: (i == 0 ? 342px : (668px + (i - 1) * 218px)) * TvUi.u;
            y: 742px * TvUi.u;
            base-width: (i == 0 ? 310px : 202px) * TvUi.u;
            base-height: 230px * TvUi.u;
            fill: Dash.tint.card;
            focused: !TvUi.bar-focused && TvUi.focused-tile == 1 + i;
            activated => { HomeState.activate-up-next(card.key); }
            hovered => { TvUi.tile-hovered(1 + i); }

            // Art box (156px tall)
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 156px * TvUi.u;
                clip: true;
                background: Dash.tint.poster;

                if card.has-thumb: Image {
                    width: parent.width;
                    height: parent.height;
                    source: card.thumb;
                    image-fit: cover;
                }

                if card.up-next: Rectangle {
                    x: 10px * TvUi.u;
                    y: 10px * TvUi.u;
                    width: cu-badge.preferred-width + 16px * TvUi.u;
                    height: 24px * TvUi.u;
                    border-radius: 6px * TvUi.u;
                    background: Theme.accent;

                    cu-badge := Text {
                        text: "UP NEXT";
                        font-size: 12px * TvUi.u;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                        color: #0B0D10;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if card.progress > 0.0: Rectangle {
                    x: 10px * TvUi.u;
                    y: parent.height - 14px * TvUi.u;
                    width: parent.width - 20px * TvUi.u;
                    height: 5px * TvUi.u;
                    border-radius: 3px * TvUi.u;
                    background: #FFFFFF4D;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * clamp(card.progress, 0.0, 1.0);
                        height: parent.height;
                        border-radius: 3px * TvUi.u;
                        background: #FFFFFF;
                    }
                }
            }

            Text {
                x: 12px * TvUi.u;
                y: 164px * TvUi.u;
                width: parent.width - 24px * TvUi.u;
                text: card.title;
                font-size: 18px * TvUi.u;
                font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }

            if card.meta != "": Text {
                x: 12px * TvUi.u;
                y: 192px * TvUi.u;
                width: parent.width - 24px * TvUi.u;
                text: card.meta;
                font-size: 14px * TvUi.u;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
    } // end Group 3

    // ── Group 4: Right column — APPS (2x4) + Next Game card (690 ms) ─────────
    IntroRise {
        width: parent.width;
        height: parent.height;
        delay: 690ms;

        Text {
            x: 1338px * TvUi.u;
            y: 136px * TvUi.u;
            text: "APPS";
            font-size: 22px * TvUi.u;
            font-weight: 500;
            letter-spacing: 1.2px;
            color: Theme.text-secondary;
        }

        // 10..=16: 7 recent-first apps in 2x4 grid
        for app[i] in HomeState.apps-bar: Tile {
            visible: i < 7;
            x: (1338px + Math.mod(i, 2) * 251px) * TvUi.u;
            y: (176px + Math.floor(i / 2) * 126px) * TvUi.u;
            base-width: 235px * TvUi.u;
            base-height: 112px * TvUi.u;
            fill: app.color;
            focused: !TvUi.bar-focused && TvUi.focused-tile == 10 + i;
            activated => { HomeState.launch-app(app.id); }
            hovered => { TvUi.tile-hovered(10 + i); }

            if app.has-logo: Image {
                x: (parent.width - self.width) / 2;
                y: 12px * TvUi.u;
                width: parent.width * 0.65;
                height: parent.height - 42px * TvUi.u;
                source: app.logo;
                image-fit: contain;
            }

            Text {
                x: 12px * TvUi.u;
                y: parent.height - self.height - 8px * TvUi.u;
                width: parent.width - 24px * TvUi.u;
                text: app.name;
                font-size: 15px * TvUi.u;
                font-weight: 700;
                color: app.text-color;
                overflow: elide;
            }
        }

        // 17: All apps › (slot 7 in 2x4)
        Tile {
            x: (1338px + 251px) * TvUi.u;
            y: (176px + 3 * 126px) * TvUi.u;
            base-width: 235px * TvUi.u;
            base-height: 112px * TvUi.u;
            fill: Theme.surface-raised;
            focused: !TvUi.bar-focused && TvUi.focused-tile == 17;
            activated => { HomeState.open-apps-page(); }
            hovered => { TvUi.tile-hovered(17); }

            Text {
                text: "All apps ›";
                font-size: 20px * TvUi.u;
                font-weight: 700;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 5: Next Game card (under Apps grid, x: 1338, y: 682, 486 x 290)
        if HomeState.next-game.visible: Tile {
            x: 1338px * TvUi.u;
            y: 682px * TvUi.u;
            base-width: 486px * TvUi.u;
            base-height: 290px * TvUi.u;
            fill: Dash.tint.card;
            focused: !TvUi.bar-focused && TvUi.focused-tile == 5;
            activated => { HomeState.open-game(HomeState.next-game.event-id, HomeState.next-game.date); }
            hovered => { TvUi.tile-hovered(5); }

            VerticalLayout {
                padding: 18px * TvUi.u;
                spacing: 12px * TvUi.u;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "NEXT GAME · " + HomeState.next-game.league;
                        font-size: 14px * TvUi.u;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: HomeState.next-game.state-text;
                        font-size: 15px * TvUi.u;
                        font-weight: 700;
                        color: HomeState.next-game.state == GameState.live
                            ? #E8000D
                            : HomeState.next-game.state == GameState.upcoming
                                ? Theme.accent
                                : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                for side in [HomeState.next-game.away, HomeState.next-game.home]: HorizontalLayout {
                    spacing: 10px * TvUi.u;
                    height: 38px * TvUi.u;

                    Text {
                        width: 34px * TvUi.u;
                        text: side.rank;
                        font-size: 15px * TvUi.u;
                        font-weight: 700;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 32px * TvUi.u;
                        height: 32px * TvUi.u;
                        border-radius: 8px * TvUi.u;
                        background: side.has-logo ? Theme.surface-raised : side.color;
                        y: (parent.height - self.height) / 2;

                        if side.has-logo: Image {
                            x: 3px * TvUi.u;
                            y: 3px * TvUi.u;
                            width: parent.width - 6px * TvUi.u;
                            height: parent.height - 6px * TvUi.u;
                            source: side.logo;
                            image-fit: contain;
                        }

                        if !side.has-logo: Text {
                            text: side.init;
                            font-size: 12px * TvUi.u;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: side.name;
                        font-size: 20px * TvUi.u;
                        font-weight: side.lead ? 700 : 500;
                        color: side.lead ? Theme.text-primary : Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if side.score != "": Text {
                        text: side.score;
                        font-size: 26px * TvUi.u;
                        font-weight: side.lead ? 700 : 500;
                        color: side.lead ? Theme.text-primary : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                if HomeState.next-game.meta != "": Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                if HomeState.next-game.meta != "": Text {
                    text: HomeState.next-game.meta;
                    font-size: 15px * TvUi.u;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }
        }
    } // end Group 4
}
