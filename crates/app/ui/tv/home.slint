import { Theme } from "../theme.slint";
import { Icon } from "../icons.slint";
import { Dash, TvUi } from "../state.slint";
import { IconTile, MediaTile, ServiceTile, Tile } from "tile.slint";

export component TvHome inherits Rectangle {
    width: 1920px * TvUi.u;
    height: 1080px * TvUi.u;
    background: transparent;

    // ── Left/center hub (x: 96..1306, y: 136..972) ─────────────────────────
    // 0: Tall Clock + Plex Up Next info tile (210 x 590)
    Tile {
        x: 96px * TvUi.u;
        y: 136px * TvUi.u;
        base-width: 210px * TvUi.u;
        base-height: 590px * TvUi.u;
        fill: Dash.tint.card;
        focused: !TvUi.bar-focused && TvUi.focused-tile == 0;
        activated => { TvUi.tile-activated(0); }
        hovered => { TvUi.tile-hovered(0); }

        VerticalLayout {
            padding: 18px * TvUi.u;
            spacing: 8px * TvUi.u;
            alignment: start;

            Text {
                text: Dash.clock-hh + ":" + Dash.clock-mm;
                font-size: 46px * TvUi.u;
                font-weight: 300;
                color: Theme.text-primary;
            }

            Text {
                text: Dash.date-text;
                font-size: 18px * TvUi.u;
                color: Dash.tint.sec;
                wrap: word-wrap;
            }

            Rectangle {
                height: 1px;
                background: Dash.tint.sec.with-alpha(0.25);
            }

            Text {
                text: Dash.tv.source != "" ? Dash.tv.source + " · " + Dash.tv.label : Dash.tv.label;
                font-size: 16px * TvUi.u;
                font-weight: 600;
                letter-spacing: 0.8px;
                color: Dash.tint.accent;
                overflow: elide;
            }

            if Dash.tv.subtitle != "": Text {
                text: Dash.tv.subtitle;
                font-size: 18px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            if Dash.tv.at-text != "": Text {
                text: Dash.tv.at-text;
                font-size: 16px * TvUi.u;
                color: Dash.tint.sec;
                wrap: word-wrap;
            }

            if Dash.tv.left-text != "": Text {
                text: Dash.tv.left-text;
                font-size: 16px * TvUi.u;
                color: Dash.tint.sec;
                wrap: word-wrap;
            }

            if Dash.tv.summary != "": Text {
                text: Dash.tv.summary;
                font-size: 15px * TvUi.u;
                color: Theme.text-secondary;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }

    // 1: Big On-the-TV Hero tile (728 x 590, top progress bar; shows live video when playing)
    MediaTile {
        x: 322px * TvUi.u;
        y: 136px * TvUi.u;
        base-width: 728px * TvUi.u;
        base-height: 590px * TvUi.u;
        art: TvUi.video-on ? TvUi.video : Dash.tv.poster;
        has-art: TvUi.video-on || Dash.tv.has-poster;
        title: Dash.tv.title;
        subtitle: TvUi.video-on ? "Click or press OK for full screen" : Dash.tv.subtitle;
        progress: Dash.tv.progress;
        progress-top: true;
        badge: Dash.tv.label;
        focused: !TvUi.bar-focused && TvUi.focused-tile == 1;
        activated => { TvUi.tile-activated(1); }
        hovered => { TvUi.tile-hovered(1); }
    }

    // 2..4: Utility column (Search, Library, Screensaver)
    IconTile {
        x: 1066px * TvUi.u;
        y: 136px * TvUi.u;
        base-width: 240px * TvUi.u;
        base-height: 186px * TvUi.u;
        fill: Dash.tint.poster;
        icon: "search";
        label: "Search";
        focused: !TvUi.bar-focused && TvUi.focused-tile == 2;
        activated => { TvUi.tile-activated(2); }
        hovered => { TvUi.tile-hovered(2); }
    }

    IconTile {
        x: 1066px * TvUi.u;
        y: 338px * TvUi.u;
        base-width: 240px * TvUi.u;
        base-height: 186px * TvUi.u;
        fill: Dash.tint.poster;
        icon: "library";
        label: "Library";
        focused: !TvUi.bar-focused && TvUi.focused-tile == 3;
        activated => { TvUi.tile-activated(3); }
        hovered => { TvUi.tile-hovered(3); }
    }

    IconTile {
        x: 1066px * TvUi.u;
        y: 540px * TvUi.u;
        base-width: 240px * TvUi.u;
        base-height: 186px * TvUi.u;
        fill: Dash.tint.poster;
        icon: "moon";
        label: "Screensaver";
        focused: !TvUi.bar-focused && TvUi.focused-tile == 4;
        activated => { TvUi.tile-activated(4); }
        hovered => { TvUi.tile-hovered(4); }
    }

    // 5..7: 3 recent services + 8: All 10 services
    for svc[i] in TvUi.home-services: ServiceTile {
        x: (96px + i * 242px) * TvUi.u;
        y: 742px * TvUi.u;
        base-width: 226px * TvUi.u;
        base-height: 230px * TvUi.u;
        brand: svc.brand;
        is-recent: svc.is-recent;
        focused: !TvUi.bar-focused && TvUi.focused-tile == 5 + i;
        activated => { TvUi.tile-activated(5 + i); }
        hovered => { TvUi.tile-hovered(5 + i); }
    }

    IconTile {
        x: 822px * TvUi.u;
        y: 742px * TvUi.u;
        base-width: 228px * TvUi.u;
        base-height: 230px * TvUi.u;
        fill: Dash.tint.poster;
        icon: "tv";
        label: "View all services";
        focused: !TvUi.bar-focused && TvUi.focused-tile == 8;
        activated => { TvUi.tile-activated(8); }
        hovered => { TvUi.tile-hovered(8); }
    }

    // 9: Dedicated Weather tile (below Screensaver)
    Tile {
        x: 1066px * TvUi.u;
        y: 742px * TvUi.u;
        base-width: 240px * TvUi.u;
        base-height: 230px * TvUi.u;
        fill: Dash.tint.card;
        focused: !TvUi.bar-focused && TvUi.focused-tile == 9;
        activated => { TvUi.tile-activated(9); }
        hovered => { TvUi.tile-hovered(9); }

        VerticalLayout {
            padding: 18px * TvUi.u;
            spacing: 8px * TvUi.u;

            HorizontalLayout {
                spacing: 12px * TvUi.u;
                alignment: start;

                Icon {
                    name: Dash.weather-icon;
                    size: 40px * TvUi.u;
                    tint: Dash.tint.accent;
                }

                Text {
                    text: Dash.weather-on ? Dash.weather-temp : "—";
                    font-size: 40px * TvUi.u;
                    font-weight: 300;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }

            Rectangle { vertical-stretch: 1; }

            Text {
                text: Dash.weather-on ? Dash.weather-condition : "Weather";
                font-size: 20px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: Dash.weather-on ? (Dash.weather-note != "" ? Dash.weather-note : Dash.weather-detail) : "Set location in Settings";
                font-size: 16px * TvUi.u;
                color: Dash.tint.sec;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }

    // ── Continue watching 2x3 grid (no scrolling, all 6 items visible) ──────
    Text {
        x: 1338px * TvUi.u;
        y: 136px * TvUi.u;
        text: "CONTINUE WATCHING";
        font-size: 22px * TvUi.u;
        font-weight: 500;
        letter-spacing: 1.2px;
        color: Theme.text-secondary;
    }

    for item[i] in Dash.continue-watching: MediaTile {
        visible: i < 6;
        x: (1338px + Math.mod(i, 2) * 296px) * TvUi.u;
        y: (176px + Math.floor(i / 2) * 270px) * TvUi.u;
        base-width: 280px * TvUi.u;
        base-height: 254px * TvUi.u;
        art: item.poster;
        has-art: item.has-poster;
        title: item.title;
        subtitle: item.subtitle;
        progress: item.progress;
        progress-top: false;
        focused: !TvUi.bar-focused && TvUi.focused-tile == 10 + i;
        activated => { TvUi.tile-activated(10 + i); }
        hovered => { TvUi.tile-hovered(10 + i); }
    }
}
