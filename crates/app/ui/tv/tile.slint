import { Theme, UiTheme } from "../theme.slint";
import { Brand } from "../shared/brand.slint";
import { Icon } from "../icons.slint";
import { TvUi } from "../state.slint";

// Base tile with 6 px corners, 1.04x focus scale, deep shadow, and 4 px focus outline.
export component Tile inherits Rectangle {
    in property <bool> focused: false;
    in property <brush> fill: Theme.surface;
    in property <length> base-width: 240px;
    in property <length> base-height: 240px;
    callback activated();
    callback hovered();

    width: root.base-width;
    height: root.base-height;
    background: transparent;

    body := Rectangle {
        // Cap focus expansion so large tiles (e.g. Hero) stay inside the 16 px gap and never overlap neighbors.
        property <length> grow-w: root.focused ? min(root.base-width * 0.04, 10px * TvUi.u) : 0px;
        property <length> grow-h: root.focused ? min(root.base-height * 0.04, 10px * TvUi.u) : 0px;

        x: -self.grow-w / 2;
        y: -self.grow-h / 2;
        width: root.base-width + self.grow-w;
        height: root.base-height + self.grow-h;
        border-radius: 6px;
        background: root.fill;
        clip: true;
        drop-shadow-blur: root.focused ? 60px : 0px;
        drop-shadow-offset-y: root.focused ? 20px : 0px;
        drop-shadow-color: #00000099;

        animate width, height, x, y, drop-shadow-blur, drop-shadow-offset-y {
            duration: 120ms;
            easing: ease-out;
        }

        @children
    }

    // 4 px focus outline, drawn just outside the scaled tile.
    Rectangle {
        x: body.x - 4px;
        y: body.y - 4px;
        width: body.width + 8px;
        height: body.height + 8px;
        border-radius: 9px;
        border-width: root.focused ? 4px : 0px;
        border-color: Theme.mode == UiTheme.ku ? Theme.accent : Theme.text-primary;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        changed has-hover => {
            if self.has-hover {
                root.hovered();
            }
        }
    }
}

export component MediaTile inherits Rectangle {
    in property <length> base-width;
    in property <length> base-height;
    in property <bool> focused: false;
    in property <image> art;
    in property <bool> has-art: false;
    in property <string> title;
    in property <string> subtitle;
    in property <float> progress: 0.0;
    in property <bool> progress-top: false;
    in property <string> badge;

    callback activated();
    callback hovered();

    width: root.base-width;
    height: root.base-height;
    background: transparent;

    poster-tile := Tile {
        x: 0;
        y: 0;
        base-width: root.base-width;
        base-height: max(60px * TvUi.u, root.base-height - 54px * TvUi.u);
        fill: Theme.surface;
        focused: root.focused;
        activated => { root.activated(); }
        hovered => { root.hovered(); }

        if root.has-art: Image {
            source: root.art;
            width: 100%;
            height: 100%;
            image-fit: cover;
        }

        // Optional progress bar (top for Home hero, bottom for posters/episodes).
        if root.progress > 0.0: Rectangle {
            x: 0;
            y: root.progress-top ? 0 : parent.height - 5px * TvUi.u;
            width: 100%;
            height: 5px * TvUi.u;
            background: #FFFFFF33;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * clamp(root.progress, 0.0, 1.0);
                height: 100%;
                background: #E8EAED;
            }
        }

        if root.badge != "": Rectangle {
            x: parent.width - self.width - 12px * TvUi.u;
            y: 12px * TvUi.u;
            width: badge-txt.preferred-width + 16px * TvUi.u;
            height: 28px * TvUi.u;
            border-radius: 4px;
            background: Theme.scrim;

            badge-txt := Text {
                text: root.badge;
                font-size: 15px * TvUi.u;
                font-weight: 600;
                color: #E8EAED;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Text {
        x: 4px * TvUi.u;
        y: poster-tile.height + 8px * TvUi.u;
        width: parent.width - 8px * TvUi.u;
        text: root.title;
        font-size: 16px * TvUi.u;
        font-weight: 700;
        color: Theme.text-primary;
        overflow: elide;
    }

    if root.subtitle != "": Text {
        x: 4px * TvUi.u;
        y: poster-tile.height + 30px * TvUi.u;
        width: parent.width - 8px * TvUi.u;
        text: root.subtitle;
        font-size: 14px * TvUi.u;
        color: Theme.text-secondary;
        overflow: elide;
    }
}

export component ServiceTile inherits Tile {
    in property <Brand> brand;
    in property <bool> is-recent: false;

    fill: @linear-gradient(135deg, root.brand.fill 0%, root.brand.fill-end 100%);

    // Scaled SVG logo when available, falling back to bold typographic wordmark.
    if root.brand.has-logo: Image {
        source: root.brand.logo;
        width: parent.width * 0.72;
        height: parent.height * 0.52;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 8px * TvUi.u;
        image-fit: contain;
    }

    if !root.brand.has-logo: HorizontalLayout {
        x: 16px * TvUi.u;
        y: (parent.height - self.preferred-height) / 2 - 8px * TvUi.u;
        width: parent.width - 32px * TvUi.u;
        alignment: center;
        spacing: 8px * TvUi.u;

        Text {
            text: root.brand.wordmark;
            font-size: 32px * TvUi.u;
            font-weight: 800;
            color: root.brand.ink;
        }

        if root.brand.sub != "": Text {
            text: root.brand.sub;
            font-size: 24px * TvUi.u;
            font-weight: 600;
            color: root.brand.sub-ink;
            vertical-alignment: center;
        }
    }

    if root.is-recent: Rectangle {
        x: parent.width - self.width - 10px * TvUi.u;
        y: 10px * TvUi.u;
        width: recent-txt.preferred-width + 14px * TvUi.u;
        height: 22px * TvUi.u;
        border-radius: 4px;
        background: #0B0D10B0;

        recent-txt := Text {
            text: "RECENT";
            font-size: 11px * TvUi.u;
            font-weight: 600;
            letter-spacing: 1px;
            color: #E8EAED;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 14px * TvUi.u;
        y: parent.height - self.preferred-height - 10px * TvUi.u;
        width: parent.width - 28px * TvUi.u;
        text: root.brand.name;
        font-size: 16px * TvUi.u;
        font-weight: 500;
        color: root.brand.ink;
        overflow: elide;
    }
}

export component ValueTile inherits Tile {
    in property <string> label;
    in property <string> value;
    in property <length> value-size: 40px * TvUi.u;

    Text {
        x: 20px * TvUi.u;
        y: 18px * TvUi.u;
        width: parent.width - 40px * TvUi.u;
        text: root.label;
        font-size: 20px * TvUi.u;
        font-weight: 400;
        color: Theme.text-secondary;
        overflow: elide;
    }

    Text {
        x: 20px * TvUi.u;
        y: parent.height - self.preferred-height - 18px * TvUi.u;
        width: parent.width - 40px * TvUi.u;
        text: root.value;
        font-size: root.value-size;
        font-weight: 300;
        color: Theme.text-primary;
        overflow: elide;
    }
}

export component IconTile inherits Tile {
    in property <string> icon;
    in property <string> label;
    in property <color> ink: Theme.text-primary;

    Icon {
        x: 20px;
        y: 20px;
        size: 48px;
        name: root.icon;
        tint: root.ink;
    }

    Text {
        x: 20px;
        y: parent.height - self.preferred-height - 18px;
        width: parent.width - 40px;
        text: root.label;
        font-size: 22px;
        font-weight: 400;
        color: root.ink;
        overflow: elide;
    }
}
