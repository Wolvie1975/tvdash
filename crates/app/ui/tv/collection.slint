import { Theme } from "../theme.slint";
import { CollectionPageState, TvUi } from "../state.slint";
import { IconTile, MediaTile, Tile } from "tile.slint";

export component TvCollection inherits Rectangle {
    width: 1920px * TvUi.u;
    height: 1080px * TvUi.u;
    background: transparent;

    // Collection hero info block
    Rectangle {
        x: 96px * TvUi.u;
        y: 136px * TvUi.u;
        width: 520px * TvUi.u;
        height: 320px * TvUi.u;
        border-radius: 6px;
        background: CollectionPageState.tint.card;

        VerticalLayout {
            padding: 24px * TvUi.u;
            spacing: 12px * TvUi.u;

            Text {
                text: CollectionPageState.title;
                font-size: 38px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            Text {
                text: CollectionPageState.meta + " · " + CollectionPageState.progress-text;
                font-size: 20px * TvUi.u;
                color: CollectionPageState.tint.sec;
                overflow: elide;
            }

            Text {
                text: CollectionPageState.summary;
                font-size: 18px * TvUi.u;
                color: Theme.text-secondary;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }

    // 0: Play next
    Tile {
        x: 96px * TvUi.u;
        y: 472px * TvUi.u;
        base-width: 520px * TvUi.u;
        base-height: 140px * TvUi.u;
        fill: CollectionPageState.tint.poster;
        focused: !TvUi.bar-focused && TvUi.focused-tile == 0;
        activated => { TvUi.tile-activated(0); }
        hovered => { TvUi.tile-hovered(0); }

        VerticalLayout {
            padding: 20px * TvUi.u;
            spacing: 6px * TvUi.u;
            alignment: center;

            Text {
                text: CollectionPageState.up-next-label;
                font-size: 28px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
            }
        }
    }

    // 3-column vertical-scrolling movie grid (372 x 236)
    Rectangle {
        x: 660px * TvUi.u;
        y: 180px * TvUi.u;
        width: 1180px * TvUi.u;
        height: 824px * TvUi.u;
        clip: true;
        background: transparent;

        TouchArea {
            scroll-event(event) => {
                TvUi.scroll-panorama(event.delta-y);
                accept
            }
        }

        Rectangle {
            x: 0px;
            y: -TvUi.col-scroll * TvUi.u;
            width: parent.width;
            height: (Math.ceil(CollectionPageState.items.length / 3) * 252px + 40px) * TvUi.u;
            background: transparent;
            animate y { duration: 180ms; easing: ease-out; }

            for item[i] in CollectionPageState.items: MediaTile {
                x: Math.mod(i, 3) * 388px * TvUi.u;
                y: (8px + Math.floor(i / 3) * 252px) * TvUi.u;
                base-width: 372px * TvUi.u;
                base-height: 236px * TvUi.u;
                art: item.poster;
                has-art: item.has-poster;
                title: item.title;
                subtitle: item.status;
                badge: item.num != "" ? item.num : "#" + (i + 1);
                focused: !TvUi.bar-focused && TvUi.focused-tile == 1 + i;
                activated => { TvUi.tile-activated(1 + i); }
                hovered => { TvUi.tile-hovered(1 + i); }
            }
        }
    }
}
