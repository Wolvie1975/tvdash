import { Theme } from "../theme.slint";
import { CollectionPageState, TvUi } from "../state.slint";
import { IconTile, MediaTile, Tile } from "tile.slint";

export component TvCollection inherits Rectangle {
    width: 1920px;
    height: 1080px;
    background: transparent;

    // Collection hero info block
    Rectangle {
        x: 96px;
        y: 136px;
        width: 520px;
        height: 320px;
        border-radius: 6px;
        background: CollectionPageState.tint.card;

        VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Text {
                text: CollectionPageState.title;
                font-size: 38px;
                font-weight: 500;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            Text {
                text: CollectionPageState.meta + " · " + CollectionPageState.progress-text;
                font-size: 20px;
                color: CollectionPageState.tint.sec;
                overflow: elide;
            }

            Text {
                text: CollectionPageState.summary;
                font-size: 18px;
                color: Theme.text-secondary;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }

    // 0: Play next
    Tile {
        x: 96px;
        y: 472px;
        base-width: 520px;
        base-height: 140px;
        fill: CollectionPageState.tint.poster;
        focused: !TvUi.bar-focused && TvUi.focused-tile == 0;
        activated => { TvUi.tile-activated(0); }
        hovered => { TvUi.tile-hovered(0); }

        VerticalLayout {
            padding: 20px;
            spacing: 6px;
            alignment: center;

            Text {
                text: CollectionPageState.up-next-label;
                font-size: 28px;
                font-weight: 500;
                color: Theme.text-primary;
            }
        }
    }

    // 1: Shuffle
    IconTile {
        x: 96px;
        y: 628px;
        base-width: 520px;
        base-height: 140px;
        fill: CollectionPageState.tint.card;
        icon: "forward";
        label: "Shuffle";
        focused: !TvUi.bar-focused && TvUi.focused-tile == 1;
        activated => { TvUi.tile-activated(1); }
        hovered => { TvUi.tile-hovered(1); }
    }

    // 3-row movie panorama (384 x 240)
    Rectangle {
        x: 660px;
        y: 180px;
        width: 1260px;
        height: 760px;
        clip: true;
        background: transparent;

        Rectangle {
            x: -TvUi.col-scroll;
            y: 0px;
            width: 5000px;
            height: parent.height;
            background: transparent;
            animate x { duration: 200ms; easing: ease-out; }

            for item[i] in CollectionPageState.items: MediaTile {
                x: Math.floor(i / 3) * 400px;
                y: Math.mod(i, 3) * 256px;
                base-width: 384px;
                base-height: 240px;
                art: item.poster;
                has-art: item.has-poster;
                title: item.title;
                subtitle: item.status;
                badge: item.num != "" ? item.num : "#" + (i + 1);
                focused: !TvUi.bar-focused && TvUi.focused-tile == 2 + i;
                activated => { TvUi.tile-activated(2 + i); }
                hovered => { TvUi.tile-hovered(2 + i); }
            }
        }
    }
}
