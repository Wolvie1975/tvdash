import { Theme } from "../theme.slint";
import { TvUi } from "../state.slint";

export component FocusBackdrop inherits Rectangle {
    in property <image> image-a;
    in property <image> image-b;
    in property <bool> show-b: false;
    in property <bool> has-image: false;
    in property <color> tint-poster: Theme.surface-raised;
    in property <color> tint-card: Theme.surface;

    clip: true;
    background: @linear-gradient(135deg, root.tint-poster 0%, root.tint-card 100%);

    if root.has-image: Image {
        source: root.image-a;
        width: 100%;
        height: 100%;
        image-fit: cover;
        opacity: root.show-b ? 0 : 1;
        animate opacity { duration: 250ms; easing: ease-in-out; }
    }

    if root.has-image: Image {
        source: root.image-b;
        width: 100%;
        height: 100%;
        image-fit: cover;
        opacity: root.show-b ? 1 : 0;
        animate opacity { duration: 250ms; easing: ease-in-out; }
    }

    // Left scrim
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(90deg, Theme.bg 0%, Theme.bg.with-alpha(0.8) 22%, transparent 60%);
    }

    // Soft top fade into the header bar
    Rectangle {
        width: 100%;
        height: 72px * TvUi.u;
        background: @linear-gradient(180deg, Theme.bg 0%, transparent 100%);
    }

    // Bottom scrim
    Rectangle {
        y: parent.height * 0.45;
        width: 100%;
        height: parent.height * 0.55;
        background: @linear-gradient(0deg, Theme.bg 0%, transparent 100%);
    }
}
