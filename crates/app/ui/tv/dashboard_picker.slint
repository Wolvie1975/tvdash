// Classic: Choose a dashboard (UI picker) sub-page under Settings › Display.

import { Theme } from "../theme.slint";
import { Display, TvUi } from "../state.slint";

export component TvDashboardPicker inherits Rectangle {
    property <int> count: Display.dashboard-choices.length;
    property <length> row-w: count * 420px * TvUi.u + Math.max(0, count - 1) * 16px * TvUi.u;

    width: 100%;
    height: 100%;
    background: Theme.bg;

    // Breadcrumb & Title (x 96, y 210)
    Text {
        x: 96px * TvUi.u;
        y: 210px * TvUi.u;
        text: "SETTINGS › DISPLAY › DASHBOARD UI";
        font-size: 22px * TvUi.u;
        font-weight: 600;
        letter-spacing: 1.2px * TvUi.u;
        color: Theme.text-secondary;
    }

    Text {
        x: 96px * TvUi.u;
        y: 244px * TvUi.u;
        text: "Choose a dashboard";
        font-size: 54px * TvUi.u;
        font-weight: 300;
        color: Theme.text-primary;
    }

    // 4-across 420 x 600 tiles at y 330 (centred when fewer than 4)
    for choice[i] in Display.dashboard-choices: Rectangle {
        property <bool> is-foc: (!TvUi.bar-focused && TvUi.focused-tile == i) || tile-ta.has-hover;
        property <length> base-x: (count < 4 ? (parent.width - row-w) / 2 : 96px * TvUi.u) + i * 436px * TvUi.u;

        x: base-x - (is-foc ? 8px * TvUi.u : 0px);
        y: 330px * TvUi.u - (is-foc ? 12px * TvUi.u : 0px);
        width: (is-foc ? 436px : 420px) * TvUi.u;
        height: (is-foc ? 624px : 600px) * TvUi.u;
        animate x, y, width, height { duration: 120ms; easing: ease-out; }

        // Focus outline at 0 offset (radius 9)
        if is-foc: Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 9px * TvUi.u;
            border-width: 4px * TvUi.u;
            border-color: Theme.text-primary;
            drop-shadow-blur: 60px;
            drop-shadow-offset-y: 20px;
            drop-shadow-color: #00000099;
        }

        // Card surface
        Rectangle {
            x: is-foc ? 4px * TvUi.u : 0;
            y: is-foc ? 4px * TvUi.u : 0;
            width: parent.width - (is-foc ? 8px * TvUi.u : 0);
            height: parent.height - (is-foc ? 8px * TvUi.u : 0);
            border-radius: 6px * TvUi.u;
            background: Theme.surface;
            border-width: is-foc ? 0px : 1px;
            border-color: Theme.border;
            clip: true;

            // Top 420 x 300 shape preview per UI
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 300px * TvUi.u;
                background: choice.id == "orbit" ? #2B313D
                    : choice.id == "ps5" ? #111622
                    : choice.id == "blades" ? #12161E
                    : #10141B;
                clip: true;

                // Classic preview: top tabs + hero + 2x3 tiles
                if choice.id == "classic": Rectangle {
                    width: parent.width;
                    height: parent.height;
                    Rectangle { x: 24px * TvUi.u; y: 20px * TvUi.u; width: 220px * TvUi.u; height: 18px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF22; }
                    Rectangle { x: 24px * TvUi.u; y: 54px * TvUi.u; width: 170px * TvUi.u; height: 140px * TvUi.u; border-radius: 6px * TvUi.u; background: Theme.accent; opacity: 0.75; }
                    Rectangle { x: 208px * TvUi.u; y: 54px * TvUi.u; width: 90px * TvUi.u; height: 64px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF1C; }
                    Rectangle { x: 308px * TvUi.u; y: 54px * TvUi.u; width: 90px * TvUi.u; height: 64px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF1C; }
                    Rectangle { x: 208px * TvUi.u; y: 130px * TvUi.u; width: 90px * TvUi.u; height: 64px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF1C; }
                    Rectangle { x: 308px * TvUi.u; y: 130px * TvUi.u; width: 90px * TvUi.u; height: 64px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF1C; }
                    Rectangle { x: 24px * TvUi.u; y: 210px * TvUi.u; width: 120px * TvUi.u; height: 64px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF16; }
                    Rectangle { x: 154px * TvUi.u; y: 210px * TvUi.u; width: 120px * TvUi.u; height: 64px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF16; }
                    Rectangle { x: 284px * TvUi.u; y: 210px * TvUi.u; width: 114px * TvUi.u; height: 64px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF16; }
                }

                // Blades preview: side blade strips + wide center panel
                if choice.id == "blades": Rectangle {
                    width: parent.width;
                    height: parent.height;
                    Rectangle { x: 0; y: 0; width: 42px * TvUi.u; height: parent.height; background: Theme.accent; opacity: 0.7; }
                    Rectangle { x: 48px * TvUi.u; y: 0; width: 22px * TvUi.u; height: parent.height; background: #FFFFFF18; }
                    Rectangle { x: 86px * TvUi.u; y: 28px * TvUi.u; width: 248px * TvUi.u; height: 150px * TvUi.u; border-radius: 6px * TvUi.u; background: #FFFFFF1A; }
                    Rectangle { x: 86px * TvUi.u; y: 194px * TvUi.u; width: 76px * TvUi.u; height: 80px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF14; }
                    Rectangle { x: 172px * TvUi.u; y: 194px * TvUi.u; width: 76px * TvUi.u; height: 80px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF14; }
                    Rectangle { x: 258px * TvUi.u; y: 194px * TvUi.u; width: 76px * TvUi.u; height: 80px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFF14; }
                    Rectangle { x: 350px * TvUi.u; y: 0; width: 22px * TvUi.u; height: parent.height; background: #FFFFFF18; }
                    Rectangle { x: 378px * TvUi.u; y: 0; width: 42px * TvUi.u; height: parent.height; background: #FFFFFF12; }
                }

                // PS5 preview: full-bleed art + top-left app row + bottom cards
                if choice.id == "ps5": Rectangle {
                    width: parent.width;
                    height: parent.height;
                    Rectangle { x: 24px * TvUi.u; y: 24px * TvUi.u; width: 42px * TvUi.u; height: 42px * TvUi.u; border-radius: 10px * TvUi.u; background: Theme.accent; }
                    Rectangle { x: 76px * TvUi.u; y: 24px * TvUi.u; width: 42px * TvUi.u; height: 42px * TvUi.u; border-radius: 10px * TvUi.u; background: #FFFFFF22; }
                    Rectangle { x: 128px * TvUi.u; y: 24px * TvUi.u; width: 42px * TvUi.u; height: 42px * TvUi.u; border-radius: 10px * TvUi.u; background: #FFFFFF22; }
                    Rectangle { x: 180px * TvUi.u; y: 24px * TvUi.u; width: 42px * TvUi.u; height: 42px * TvUi.u; border-radius: 10px * TvUi.u; background: #FFFFFF22; }
                    Rectangle { x: 24px * TvUi.u; y: 112px * TvUi.u; width: 180px * TvUi.u; height: 28px * TvUi.u; border-radius: 4px * TvUi.u; background: #FFFFFFCC; }
                    Rectangle { x: 24px * TvUi.u; y: 150px * TvUi.u; width: 120px * TvUi.u; height: 14px * TvUi.u; border-radius: 3px * TvUi.u; background: #FFFFFF44; }
                    Rectangle { x: 24px * TvUi.u; y: 204px * TvUi.u; width: 112px * TvUi.u; height: 68px * TvUi.u; border-radius: 6px * TvUi.u; background: #FFFFFF24; }
                    Rectangle { x: 148px * TvUi.u; y: 204px * TvUi.u; width: 112px * TvUi.u; height: 68px * TvUi.u; border-radius: 6px * TvUi.u; background: #FFFFFF18; }
                    Rectangle { x: 272px * TvUi.u; y: 204px * TvUi.u; width: 112px * TvUi.u; height: 68px * TvUi.u; border-radius: 6px * TvUi.u; background: #FFFFFF18; }
                }

                // Orbit preview: pill nav + play ring + curved rows + bottom dial
                if choice.id == "orbit": Rectangle {
                    width: parent.width;
                    height: parent.height;
                    Rectangle { x: 110px * TvUi.u; y: 18px * TvUi.u; width: 200px * TvUi.u; height: 24px * TvUi.u; border-radius: 12px * TvUi.u; background: #0B0A12B3; }
                    Rectangle { x: 114px * TvUi.u; y: 21px * TvUi.u; width: 46px * TvUi.u; height: 18px * TvUi.u; border-radius: 9px * TvUi.u; background: #EEF1F4; }
                    Rectangle { x: 28px * TvUi.u; y: 92px * TvUi.u; width: 130px * TvUi.u; height: 22px * TvUi.u; border-radius: 4px * TvUi.u; background: #EEF1F4; }
                    Rectangle { x: 28px * TvUi.u; y: 126px * TvUi.u; width: 42px * TvUi.u; height: 42px * TvUi.u; border-radius: 21px * TvUi.u; border-width: 4px * TvUi.u; border-color: #8FC1FF; background: #EEF1F4; }
                    Rectangle { x: 266px * TvUi.u; y: 80px * TvUi.u; width: 128px * TvUi.u; height: 34px * TvUi.u; border-radius: 17px * TvUi.u; background: #0B0A12B3; }
                    Rectangle { x: 248px * TvUi.u; y: 124px * TvUi.u; width: 146px * TvUi.u; height: 34px * TvUi.u; border-radius: 17px * TvUi.u; background: #0B0A12B3; }
                    Rectangle { x: 185px * TvUi.u; y: 224px * TvUi.u; width: 50px * TvUi.u; height: 50px * TvUi.u; border-radius: 25px * TvUi.u; background: #8FC1FF; }
                    Rectangle { x: 128px * TvUi.u; y: 238px * TvUi.u; width: 38px * TvUi.u; height: 38px * TvUi.u; border-radius: 19px * TvUi.u; background: #FFFFFF30; }
                    Rectangle { x: 254px * TvUi.u; y: 238px * TvUi.u; width: 38px * TvUi.u; height: 38px * TvUi.u; border-radius: 19px * TvUi.u; background: #FFFFFF30; }
                }
            }

            // Name
            Text {
                x: 24px * TvUi.u;
                y: 324px * TvUi.u;
                width: parent.width - 48px * TvUi.u;
                text: choice.name;
                font-size: 40px * TvUi.u;
                font-weight: 400;
                color: Theme.text-primary;
                overflow: elide;
            }

            // Description (max 3 lines)
            Text {
                x: 24px * TvUi.u;
                y: 382px * TvUi.u;
                width: parent.width - 48px * TvUi.u;
                height: 110px * TvUi.u;
                text: choice.description;
                font-size: 20px * TvUi.u;
                color: Theme.text-secondary;
                wrap: word-wrap;
                overflow: elide;
            }

            // Bottom-left status/action chip
            if choice.current: Rectangle {
                x: 24px * TvUi.u;
                y: parent.height - 64px * TvUi.u;
                width: cur-lbl.preferred-width + 32px * TvUi.u;
                height: 40px * TvUi.u;
                border-radius: 20px * TvUi.u;
                background: Theme.accent;

                cur-lbl := Text {
                    text: "✓ Current";
                    font-size: 18px * TvUi.u;
                    font-weight: 600;
                    color: Theme.on-accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if !choice.current && is-foc: Rectangle {
                x: 24px * TvUi.u;
                y: parent.height - 64px * TvUi.u;
                width: sw-lbl.preferred-width + 32px * TvUi.u;
                height: 40px * TvUi.u;
                border-radius: 20px * TvUi.u;
                background: Theme.text-primary;

                sw-lbl := Text {
                    text: "OK · Switch to " + choice.name;
                    font-size: 18px * TvUi.u;
                    font-weight: 600;
                    color: Theme.bg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        tile-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Display.choose-dashboard(choice.id); }
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.move {
                    TvUi.tile-hovered(i);
                }
            }
        }
    }
}
