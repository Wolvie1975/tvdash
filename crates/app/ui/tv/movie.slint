import { Theme } from "../theme.slint";
import { MoviePageState, TvUi } from "../state.slint";
import { Tile } from "tile.slint";

export component TvMovie inherits Rectangle {
    width: 1920px * TvUi.u;
    height: 1080px * TvUi.u;
    background: transparent;
    clip: true;

    property <bool> scrolled: TvUi.show-scroll > 40px;
    property <length> content-top: (700px - TvUi.show-scroll) * TvUi.u;
    property <length> left-col-y: root.scrolled ? 244px * TvUi.u : root.content-top;

    property <int> idx-from-start: 1;
    property <int> idx-trailer: 1 + (MoviePageState.show-from-start ? 1 : 0);
    property <int> idx-col: idx-trailer + (MoviePageState.has-trailer ? 1 : 0);
    property <int> idx-tab-cast: idx-col + (MoviePageState.in-collection ? 1 : 0);
    property <int> idx-tab-extras: idx-tab-cast + 1;
    property <bool> has-extras: MoviePageState.extras.length > 0;
    property <int> content-base: idx-tab-cast + 1 + (has-extras ? 1 : 0);
    property <int> crew-n: MoviePageState.crew.length;
    property <int> cast-base: content-base + crew-n;
    property <int> focused-extra-i: (MoviePageState.tab == "extras" && TvUi.focused-tile >= content-base)
        ? Math.clamp(TvUi.focused-tile - content-base, 0, Math.max(0, MoviePageState.extras.length - 1)) : 0;

    TouchArea {
        scroll-event(event) => {
            TvUi.scroll-panorama(event.delta-y);
            accept
        }
    }

    // Backdrop (fades out when scrolled). On the light themes it stays dark (spec §8.9):
    // a dark base under the art, and a shorter left scrim that only covers the text block.
    Rectangle {
        x: 560px * TvUi.u;
        y: 0px;
        width: 1360px * TvUi.u;
        height: 720px * TvUi.u;
        clip: true;
        background: Theme.light ? #0B0D10 : transparent;
        opacity: root.scrolled ? 0.0 : 1.0;
        animate opacity { duration: 250ms; easing: ease-out; }

        if MoviePageState.has-backdrop: Image {
            source: MoviePageState.backdrop;
            width: 100%;
            height: 100%;
            image-fit: cover;
        }
        if !MoviePageState.has-backdrop: Rectangle {
            width: 100%;
            height: 100%;
            background: @radial-gradient(circle, MoviePageState.tint.with-alpha(0.28) 0%, (Theme.light ? #0B0D10 : Theme.bg) 72%);
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.light
                ? @linear-gradient(90deg, Theme.bg 0%, Theme.bg.with-alpha(0.82) 24%, transparent 40%)
                : @linear-gradient(90deg, Theme.bg 0%, Theme.bg.with-alpha(0.82) 25%, transparent 62%);
        }
        Rectangle {
            x: 0;
            y: 380px * TvUi.u;
            width: 100%;
            height: 340px * TvUi.u;
            background: @linear-gradient(180deg, transparent 0%, Theme.bg 100%);
        }
        // Light themes: keep the (dark-text) tab bar and clock readable over the dark art.
        if Theme.light: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 170px * TvUi.u;
            background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg.with-alpha(0.7) 55%, transparent 100%);
        }
    }

    // Top hero block (fades out when scrolled)
    Rectangle {
        x: 96px * TvUi.u;
        y: 176px * TvUi.u;
        width: 1728px * TvUi.u;
        height: 410px * TvUi.u;
        opacity: root.scrolled ? 0.0 : 1.0;
        animate opacity { duration: 220ms; easing: ease-out; }

        Text {
            x: 0;
            y: 0;
            text: "MOVIE · PLEX";
            font-size: 20px * TvUi.u;
            font-weight: 500;
            letter-spacing: 1.2px * TvUi.u;
            color: MoviePageState.tint;
        }

        if !MoviePageState.loading: Text {
            x: 0;
            y: 34px * TvUi.u;
            width: 1100px * TvUi.u;
            text: MoviePageState.title;
            font-size: 88px * TvUi.u;
            font-weight: 400;
            letter-spacing: -1.5px * TvUi.u;
            color: Theme.text-primary;
            overflow: elide;
        }
        if MoviePageState.loading: Rectangle {
            x: 0;
            y: 44px * TvUi.u;
            width: 560px * TvUi.u;
            height: 76px * TvUi.u;
            border-radius: 8px;
            background: Theme.surface;
        }

        if !MoviePageState.loading: Text {
            x: 0;
            y: 138px * TvUi.u;
            width: 1100px * TvUi.u;
            text: MoviePageState.meta-line;
            font-size: 24px * TvUi.u;
            color: Theme.text-secondary;
            overflow: elide;
        }

        if !MoviePageState.loading: Text {
            x: 0;
            y: 178px * TvUi.u;
            width: 780px * TvUi.u;
            height: 96px * TvUi.u;
            text: MoviePageState.summary;
            font-size: 22px * TvUi.u;
            color: Theme.text-secondary;
            wrap: word-wrap;
            overflow: elide;
        }
    }

    // Action row (y 452, h 120, gap 16)
    HorizontalLayout {
        x: 96px * TvUi.u;
        y: 452px * TvUi.u;
        width: 1728px * TvUi.u;
        height: 120px * TvUi.u;
        spacing: 16px * TvUi.u;
        opacity: root.scrolled ? 0.0 : 1.0;
        animate opacity { duration: 220ms; }

        // 0: Resume / Play
        Tile {
            base-width: 440px * TvUi.u;
            base-height: 120px * TvUi.u;
            focused: TvUi.focused-tile == 0;
            fill: MoviePageState.tint;
            activated => { MoviePageState.play(); }

            VerticalLayout {
                padding-left: 26px * TvUi.u;
                padding-right: 26px * TvUi.u;
                alignment: center;
                spacing: 4px * TvUi.u;
                Text {
                    text: "▶  " + (MoviePageState.play-label != "" ? MoviePageState.play-label : "Play");
                    font-size: 30px * TvUi.u;
                    font-weight: 500;
                    color: MoviePageState.on-tint;
                    overflow: elide;
                }
                if MoviePageState.play-meta != "": Text {
                    text: MoviePageState.play-meta;
                    font-size: 19px * TvUi.u;
                    color: MoviePageState.on-tint.with-alpha(0.72);
                    overflow: elide;
                }
            }

            if MoviePageState.progress > 0.0: Rectangle {
                x: 0;
                y: parent.height - 5px * TvUi.u;
                width: parent.width;
                height: 5px * TvUi.u;
                background: MoviePageState.on-tint.with-alpha(0.22);
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * Math.clamp(MoviePageState.progress, 0.0, 1.0);
                    height: 100%;
                    background: MoviePageState.on-tint.with-alpha(0.72);
                }
            }
        }

        // From start
        if MoviePageState.show-from-start: Tile {
            base-width: 260px * TvUi.u;
            base-height: 120px * TvUi.u;
            focused: TvUi.focused-tile == root.idx-from-start;
            fill: Theme.surface;
            activated => { MoviePageState.play-from-start(); }
            Text {
                text: "From start";
                font-size: 24px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Trailer
        if MoviePageState.has-trailer: Tile {
            base-width: 220px * TvUi.u;
            base-height: 120px * TvUi.u;
            focused: TvUi.focused-tile == root.idx-trailer;
            fill: Theme.surface;
            activated => { MoviePageState.play-trailer(); }
            Text {
                text: "▶  Trailer";
                font-size: 24px * TvUi.u;
                font-weight: 500;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Collection tile
        // Takes the rest of the 1728 row (760 at full width).
        if MoviePageState.in-collection: Tile {
            base-width: (1728px - 440px - 16px
                - (MoviePageState.show-from-start ? 276px : 0px)
                - (MoviePageState.has-trailer ? 236px : 0px)) * TvUi.u;
            base-height: 120px * TvUi.u;
            focused: TvUi.focused-tile == root.idx-col;
            fill: Theme.surface;
            activated => { MoviePageState.open-collection(); }

            HorizontalLayout {
                padding: 15px * TvUi.u;
                spacing: 18px * TvUi.u;
                alignment: start;

                Rectangle {
                    width: 60px * TvUi.u;
                    height: 90px * TvUi.u;
                    border-radius: 4px;
                    clip: true;
                    background: Theme.bg;
                    Image {
                        source: MoviePageState.collection-poster;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 6px * TvUi.u;
                    horizontal-stretch: 1;
                    Text {
                        text: "PART OF A COLLECTION";
                        font-size: 17px * TvUi.u;
                        letter-spacing: 1.2px * TvUi.u;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: MoviePageState.collection-title + " · " + MoviePageState.collection-position;
                        font-size: 26px * TvUi.u;
                        color: Theme.text-primary;
                        overflow: elide;
                    }
                    // Progress bar (continuous if >24, segmented if <=24)
                    if MoviePageState.collection-total > 24: Rectangle {
                        height: 5px * TvUi.u;
                        border-radius: 2.5px * TvUi.u;
                        background: Theme.border;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * (MoviePageState.collection-watched / Math.max(1, MoviePageState.collection-total));
                            height: 100%;
                            border-radius: 2.5px * TvUi.u;
                            background: MoviePageState.tint;
                        }
                    }
                    if MoviePageState.collection-total <= 24: HorizontalLayout {
                        height: 5px * TvUi.u;
                        spacing: 4px * TvUi.u;
                        for seg in MoviePageState.collection-total: Rectangle {
                            horizontal-stretch: 1;
                            height: 5px * TvUi.u;
                            border-radius: 2.5px * TvUi.u;
                            background: seg < MoviePageState.collection-watched ? MoviePageState.tint : Theme.border;
                        }
                    }
                }

                Text {
                    text: MoviePageState.collection-watched + " of " + MoviePageState.collection-total + " watched  ›";
                    font-size: 18px * TvUi.u;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Tabs row (y 612)
    if !root.scrolled: Rectangle {
        x: 96px * TvUi.u;
        y: 612px * TvUi.u;
        width: 1728px * TvUi.u;
        height: 52px * TvUi.u;

        Rectangle {
            x: 0;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            height: parent.height;
            spacing: 36px * TvUi.u;
            alignment: start;

            Rectangle {
                width: 168px * TvUi.u;
                height: parent.height;
                border-width: TvUi.focused-tile == root.idx-tab-cast ? 2px : 0px;
                border-color: Theme.text-primary;
                border-radius: 4px;
                Text {
                    text: "Cast & crew";
                    font-size: 26px * TvUi.u;
                    font-weight: MoviePageState.tab == "cast" ? 400 : 300;
                    color: MoviePageState.tab == "cast" ? Theme.text-primary : #5E646D;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                if MoviePageState.tab == "cast": Rectangle {
                    x: 0;
                    y: parent.height - 3px * TvUi.u;
                    width: parent.width;
                    height: 3px * TvUi.u;
                    background: MoviePageState.tint;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { MoviePageState.set-tab("cast"); }
                }
            }

            if root.has-extras: Rectangle {
                width: 110px * TvUi.u;
                height: parent.height;
                border-width: TvUi.focused-tile == root.idx-tab-extras ? 2px : 0px;
                border-color: Theme.text-primary;
                border-radius: 4px;
                Text {
                    text: "Extras";
                    font-size: 26px * TvUi.u;
                    font-weight: MoviePageState.tab == "extras" ? 400 : 300;
                    color: MoviePageState.tab == "extras" ? Theme.text-primary : #5E646D;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                if MoviePageState.tab == "extras": Rectangle {
                    x: 0;
                    y: parent.height - 3px * TvUi.u;
                    width: parent.width;
                    height: 3px * TvUi.u;
                    background: MoviePageState.tint;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { MoviePageState.set-tab("extras"); }
                }
            }
        }

        Text {
            x: parent.width - self.preferred-width;
            y: 0;
            height: parent.height;
            text: MoviePageState.tab == "extras"
                ? (MoviePageState.extras.length + " extras · trailers first")
                : (MoviePageState.crew.length + " crew · " + MoviePageState.cast.length + " cast");
            font-size: 20px * TvUi.u;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }

    // Content area (clipped below y 680 when not scrolled, or below sticky bar y 220 when scrolled)
    Rectangle {
        x: 0;
        y: root.scrolled ? 220px * TvUi.u : 684px * TvUi.u;
        width: parent.width;
        height: parent.height - self.y;
        clip: true;

        // Left column (x 96, w 260)
        VerticalLayout {
            x: 96px * TvUi.u;
            y: root.scrolled ? 24px * TvUi.u : 16px * TvUi.u;
            width: 260px * TvUi.u;
            spacing: 12px * TvUi.u;
            alignment: start;

            if MoviePageState.tab == "cast" && MoviePageState.crew.length > 0: Text {
                text: "CREW";
                font-size: 20px * TvUi.u;
                letter-spacing: 1.2px * TvUi.u;
                color: Theme.text-muted;
            }
            if MoviePageState.tab == "cast": VerticalLayout {
                spacing: 12px * TvUi.u;
                for p[i] in MoviePageState.crew: Tile {
                base-width: 260px * TvUi.u;
                base-height: 84px * TvUi.u;
                focused: TvUi.focused-tile == root.content-base + i;
                fill: Theme.surface;
                activated => { MoviePageState.search-person(p.name); }

                HorizontalLayout {
                    padding: 12px * TvUi.u;
                    spacing: 12px * TvUi.u;
                    alignment: start;
                    Rectangle {
                        width: 56px * TvUi.u;
                        height: 56px * TvUi.u;
                        border-radius: 28px * TvUi.u;
                        clip: true;
                        background: p.tint;
                        if p.has-photo: Image { source: p.photo; width: 100%; height: 100%; image-fit: cover; }
                        if !p.has-photo: Text {
                            text: p.initials;
                            font-size: 18px * TvUi.u;
                            font-weight: 500;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px * TvUi.u;
                        horizontal-stretch: 1;
                        Text { text: p.name; font-size: 20px * TvUi.u; color: Theme.text-primary; overflow: elide; }
                        Text { text: p.role; font-size: 16px * TvUi.u; color: Theme.text-muted; overflow: elide; }
                    }
                }
            }
            }

            if MoviePageState.tab == "extras" && MoviePageState.extras.length > 0: VerticalLayout {
                spacing: 12px * TvUi.u;
                Rectangle {
                    width: 260px * TvUi.u;
                    height: 146px * TvUi.u;
                    border-radius: 6px;
                    clip: true;
                    background: Theme.surface;
                    Image {
                        source: MoviePageState.extras[root.focused-extra-i].thumb;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
                Text {
                    text: MoviePageState.extras[root.focused-extra-i].kind;
                    font-size: 18px * TvUi.u;
                    color: MoviePageState.tint;
                }
                Text {
                    text: MoviePageState.extras[root.focused-extra-i].title;
                    font-size: 26px * TvUi.u;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                Text {
                    text: (MoviePageState.extras[root.focused-extra-i].duration != "" ? MoviePageState.extras[root.focused-extra-i].duration + " · " : "") + "plays in mpv";
                    font-size: 18px * TvUi.u;
                    color: Theme.text-secondary;
                }
                Text {
                    text: "Back returns to this page.";
                    font-size: 18px * TvUi.u;
                    color: Theme.text-muted;
                }
            }
        }

        // Right grid (x 388, w 1436)
        Rectangle {
            x: 388px * TvUi.u;
            y: (root.scrolled ? 24px * TvUi.u : 16px * TvUi.u) - TvUi.show-scroll * TvUi.u;
            width: 1436px * TvUi.u;
            height: 2400px * TvUi.u;
            animate y { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

            if MoviePageState.tab == "cast" && MoviePageState.crew.length == 0 && MoviePageState.cast.length == 0 && !MoviePageState.loading: Text {
                x: 0;
                y: 8px * TvUi.u;
                text: "No cast or crew listed";
                font-size: 22px * TvUi.u;
                color: Theme.text-secondary;
            }

            if MoviePageState.tab == "cast": Rectangle {
                width: parent.width;
                height: parent.height;
                for p[i] in MoviePageState.cast: Rectangle {
                property <int> grid-col: Math.mod(i, 6);
                property <int> grid-row: Math.floor(i / 6);
                x: grid-col * 242px * TvUi.u;
                y: grid-row * 388px * TvUi.u;
                width: 226px * TvUi.u;
                height: 356px * TvUi.u;

                Tile {
                    x: 0;
                    y: 0;
                    base-width: 226px * TvUi.u;
                    base-height: 300px * TvUi.u;
                    focused: TvUi.focused-tile == root.cast-base + i;
                    fill: p.has-photo ? Theme.surface : p.tint;
                    activated => { MoviePageState.search-person(p.name); }

                    if p.has-photo: Image { source: p.photo; width: 100%; height: 100%; image-fit: cover; }
                    if !p.has-photo: Text {
                        width: 100%;
                        height: 100%;
                        text: p.initials;
                        font-size: 44px * TvUi.u;
                        font-weight: 300;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    x: 0;
                    y: 308px * TvUi.u;
                    width: 226px * TvUi.u;
                    text: p.name;
                    font-size: 22px * TvUi.u;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    x: 0;
                    y: 334px * TvUi.u;
                    width: 226px * TvUi.u;
                    text: p.role;
                    font-size: 17px * TvUi.u;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
            }

            if MoviePageState.tab == "extras": Rectangle {
                    x: 0;
                    y: parent.height - 3px * TvUi.u;
                    width: parent.width;
                    height: 3px * TvUi.u;
                    background: MoviePageState.tint;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { MoviePageState.set-tab("extras"); }
                }
            }
        }

        Text {
            x: parent.width - self.preferred-width;
            y: 0;
            height: parent.height;
            text: MoviePageState.tab == "extras"
                ? (MoviePageState.extras.length + " extras · trailers first")
                : (MoviePageState.crew.length + " crew · " + MoviePageState.cast.length + " cast");
            font-size: 20px * TvUi.u;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }

    // Content area (clipped below y 680 when not scrolled, or below sticky bar y 220 when scrolled)
    Rectangle {
        x: 0;
        y: root.scrolled ? 220px * TvUi.u : 684px * TvUi.u;
        width: parent.width;
        height: parent.height - self.y;
        clip: true;

        // Left column (x 96, w 260)
        VerticalLayout {
            x: 96px * TvUi.u;
            y: root.scrolled ? 24px * TvUi.u : 16px * TvUi.u;
            width: 260px * TvUi.u;
            spacing: 12px * TvUi.u;
            alignment: start;

            if MoviePageState.tab == "cast" && MoviePageState.crew.length > 0: Text {
                text: "CREW";
                font-size: 20px * TvUi.u;
                letter-spacing: 1.2px * TvUi.u;
                color: Theme.text-muted;
            }
            if MoviePageState.tab == "cast": VerticalLayout {
                spacing: 12px * TvUi.u;
                for p[i] in MoviePageState.crew: Tile {
                base-width: 260px * TvUi.u;
                base-height: 84px * TvUi.u;
                focused: TvUi.focused-tile == root.content-base + i;
                fill: Theme.surface;
                activated => { MoviePageState.search-person(p.name); }

                HorizontalLayout {
                    padding: 12px * TvUi.u;
                    spacing: 12px * TvUi.u;
                    alignment: start;
                    Rectangle {
                        width: 56px * TvUi.u;
                        height: 56px * TvUi.u;
                        border-radius: 28px * TvUi.u;
                        clip: true;
                        background: p.tint;
                        if p.has-photo: Image { source: p.photo; width: 100%; height: 100%; image-fit: cover; }
                        if !p.has-photo: Text {
                            text: p.initials;
                            font-size: 18px * TvUi.u;
                            font-weight: 500;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px * TvUi.u;
                        horizontal-stretch: 1;
                        Text { text: p.name; font-size: 20px * TvUi.u; color: Theme.text-primary; overflow: elide; }
                        Text { text: p.role; font-size: 16px * TvUi.u; color: Theme.text-muted; overflow: elide; }
                    }
                }
            }
            }

            if MoviePageState.tab == "extras" && MoviePageState.extras.length > 0: VerticalLayout {
                spacing: 12px * TvUi.u;
                Rectangle {
                    width: 260px * TvUi.u;
                    height: 146px * TvUi.u;
                    border-radius: 6px;
                    clip: true;
                    background: Theme.surface;
                    Image {
                        source: MoviePageState.extras[root.focused-extra-i].thumb;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
                Text {
                    text: MoviePageState.extras[root.focused-extra-i].kind;
                    font-size: 18px * TvUi.u;
                    color: MoviePageState.tint;
                }
                Text {
                    text: MoviePageState.extras[root.focused-extra-i].title;
                    font-size: 26px * TvUi.u;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                Text {
                    text: (MoviePageState.extras[root.focused-extra-i].duration != "" ? MoviePageState.extras[root.focused-extra-i].duration + " · " : "") + "plays in mpv";
                    font-size: 18px * TvUi.u;
                    color: Theme.text-secondary;
                }
                Text {
                    text: "Back returns to this page.";
                    font-size: 18px * TvUi.u;
                    color: Theme.text-muted;
                }
            }
        }

        // Right grid (x 388, w 1436)
        Rectangle {
            x: 388px * TvUi.u;
            y: (root.scrolled ? 24px * TvUi.u : 16px * TvUi.u) - TvUi.show-scroll * TvUi.u;
            width: 1436px * TvUi.u;
            height: 2400px * TvUi.u;
            animate y { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

            if MoviePageState.tab == "cast" && MoviePageState.crew.length == 0 && MoviePageState.cast.length == 0 && !MoviePageState.loading: Text {
                x: 0;
                y: 8px * TvUi.u;
                text: "No cast or crew listed";
                font-size: 22px * TvUi.u;
                color: Theme.text-secondary;
            }

            if MoviePageState.tab == "cast": Rectangle {
                width: parent.width;
                height: parent.height;
                for p[i] in MoviePageState.cast: Tile {
                property <int> grid-col: Math.mod(i, 6);
                property <int> grid-row: Math.floor(i / 6);
                x: grid-col * 242px * TvUi.u;
                y: grid-row * 388px * TvUi.u;
                width: 226px * TvUi.u;
                height: 356px * TvUi.u;
                focused: TvUi.focused-tile == root.cast-base + i;
                fill: transparent;
                activated => { MoviePageState.search-person(p.name); }

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 226px * TvUi.u;
                    height: 300px * TvUi.u;
                    border-radius: 6px;
                    clip: true;
                    background: p.has-photo ? Theme.surface : p.tint;
                    if p.has-photo: Image { source: p.photo; width: 100%; height: 100%; image-fit: cover; }
                    if !p.has-photo: Text {
                        text: p.initials;
                        font-size: 44px * TvUi.u;
                        font-weight: 300;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    x: 0;
                    y: 308px * TvUi.u;
                    width: 226px * TvUi.u;
                    text: p.name;
                    font-size: 22px * TvUi.u;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    x: 0;
                    y: 334px * TvUi.u;
                    width: 226px * TvUi.u;
                    text: p.role;
                    font-size: 17px * TvUi.u;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
            }

            if MoviePageState.tab == "extras": Rectangle {
                width: parent.width;
                height: parent.height;
                for ex[i] in MoviePageState.extras: Rectangle {
                property <int> grid-col: Math.mod(i, 3);
                property <int> grid-row: Math.floor(i / 3);
                x: grid-col * 484px * TvUi.u;
                y: grid-row * 356px * TvUi.u;
                width: 468px * TvUi.u;
                height: 316px * TvUi.u;

                Tile {
                    x: 0;
                    y: 0;
                    base-width: 468px * TvUi.u;
                    base-height: 263px * TvUi.u;
                    focused: TvUi.focused-tile == root.content-base + i;
                    fill: Theme.surface;
                    activated => { MoviePageState.play-extra(ex.key); }
                    Image { source: ex.thumb; width: 100%; height: 100%; image-fit: cover; }

                    Rectangle {
                        x: 12px * TvUi.u;
                        y: 12px * TvUi.u;
                        width: kind-lbl.preferred-width + 18px * TvUi.u;
                        height: 28px * TvUi.u;
                        border-radius: 4px;
                        background: ex.is-trailer ? MoviePageState.tint : #0B0D10CC;
                        kind-lbl := Text {
                            text: ex.is-trailer ? "TRAILER" : ex.kind;
                            font-size: 14px * TvUi.u;
                            font-weight: 600;
                            color: ex.is-trailer ? MoviePageState.on-tint : #E8EAED;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if ex.duration != "": Rectangle {
                        x: parent.width - self.width - 12px * TvUi.u;
                        y: parent.height - self.height - 12px * TvUi.u;
                        width: dur-lbl.preferred-width + 16px * TvUi.u;
                        height: 26px * TvUi.u;
                        border-radius: 4px;
                        background: #0B0D10CC;
                        dur-lbl := Text {
                            text: ex.duration;
                            font-size: 15px * TvUi.u;
                            color: #E8EAED;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    x: 0;
                    y: 272px * TvUi.u;
                    width: 468px * TvUi.u;
                    text: ex.title;
                    font-size: 24px * TvUi.u;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    x: 0;
                    y: 300px * TvUi.u;
                    width: 468px * TvUi.u;
                    text: ex.kind;
                    font-size: 18px * TvUi.u;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
            }
        }
    }

    // Sticky bar when scrolled (y 132)
    if root.scrolled: Rectangle {
        x: 96px * TvUi.u;
        y: 132px * TvUi.u;
        width: 1728px * TvUi.u;
        height: 76px * TvUi.u;
        border-radius: 8px;
        background: Theme.surface.with-alpha(0.95);
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding-left: 24px * TvUi.u;
            padding-right: 16px * TvUi.u;
            spacing: 24px * TvUi.u;
            alignment: start;

            Text {
                text: MoviePageState.title;
                font-size: 28px * TvUi.u;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { width: 1px; height: 28px * TvUi.u; background: Theme.border; }
            Text {
                text: "Cast & crew";
                font-size: 22px * TvUi.u;
                font-weight: MoviePageState.tab == "cast" ? 500 : 300;
                color: MoviePageState.tab == "cast" ? Theme.text-primary : Theme.text-muted;
                vertical-alignment: center;
                TouchArea { mouse-cursor: pointer; clicked => { MoviePageState.set-tab("cast"); } }
            }
            if root.has-extras: Text {
                text: "Extras";
                font-size: 22px * TvUi.u;
                font-weight: MoviePageState.tab == "extras" ? 500 : 300;
                color: MoviePageState.tab == "extras" ? Theme.text-primary : Theme.text-muted;
                vertical-alignment: center;
                TouchArea { mouse-cursor: pointer; clicked => { MoviePageState.set-tab("extras"); } }
            }
            Rectangle { horizontal-stretch: 1; }
            Tile {
                base-width: 240px * TvUi.u;
                base-height: 52px * TvUi.u;
                fill: MoviePageState.tint;
                activated => { MoviePageState.play(); }
                Text {
                    text: "▶  " + (MoviePageState.play-label != "" ? MoviePageState.play-label : "Play");
                    font-size: 20px * TvUi.u;
                    font-weight: 500;
                    color: MoviePageState.on-tint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
