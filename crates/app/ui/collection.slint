import { Theme } from "theme.slint";
import { ActionButton, Card, PageHeader, SectionLabel } from "components.slint";
import { CollectionPageState } from "state.slint";

export component CollectionPage inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        padding-left: 64px;
        padding-right: 64px;
        padding-top: 28px;
        padding-bottom: 40px;
        spacing: Theme.gap;

        PageHeader {
            title: "Movies › Collections › " + CollectionPageState.title;
            back => { CollectionPageState.close(); }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            // Left 4 cols: collection hero
            Rectangle {
                width: 440px;
                border-radius: Theme.radius;
                background: CollectionPageState.tint.card;
                border-width: 1px;
                border-color: CollectionPageState.tint.edge;
                VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    alignment: start;

                    Text {
                        text: "COLLECTION · PLEX";
                        font-size: 16px;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                        color: CollectionPageState.tint.accent;
                    }
                    Text {
                        text: CollectionPageState.title;
                        font-size: 44px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: CollectionPageState.meta + " · " + CollectionPageState.progress-text;
                        font-size: 18px;
                        color: CollectionPageState.tint.sec;
                        wrap: word-wrap;
                    }
                    if CollectionPageState.summary != "": Text {
                        text: CollectionPageState.summary;
                        font-size: Theme.body-size;
                        color: CollectionPageState.tint.sec;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    if CollectionPageState.up-next-key != "": ActionButton {
                        height: 72px;
                        text: CollectionPageState.up-next-label;
                        icon: "play";
                        primary: true;
                        fill: CollectionPageState.tint.accent;
                        ink: CollectionPageState.tint.on-accent;
                        clicked => { CollectionPageState.play-item(CollectionPageState.up-next-key, true); }
                    }
                    ActionButton {
                        text: "Shuffle an unwatched one";
                        clicked => { CollectionPageState.shuffle(); }
                    }
                }
            }

            // Right 8 cols: order controls + movie list/grid
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 10px;
                        ActionButton {
                            text: "Collection order";
                            primary: CollectionPageState.order == "collection";
                            clicked => { CollectionPageState.set-order("collection"); }
                        }
                        ActionButton {
                            text: "Release date";
                            primary: CollectionPageState.order == "release";
                            clicked => { CollectionPageState.set-order("release"); }
                        }
                        ActionButton {
                            text: "A–Z";
                            primary: CollectionPageState.order == "alpha";
                            clicked => { CollectionPageState.set-order("alpha"); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            text: CollectionPageState.hide-watched ? "Showing unwatched" : "Hide watched";
                            primary: CollectionPageState.hide-watched;
                            clicked => { CollectionPageState.set-hide-watched(!CollectionPageState.hide-watched); }
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        GridLayout {
                            spacing: 12px;
                            for item[idx] in CollectionPageState.items: Rectangle {
                                row: Math.floor(idx / 4);
                                col: Math.mod(idx, 4);
                                min-height: 180px;
                                border-radius: 12px;
                                background: Theme.surface-raised;
                                border-width: 1px;
                                border-color: item.can-resume ? CollectionPageState.tint.accent : Theme.border;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 120px;
                                            height: 180px;
                                            border-radius: 8px;
                                            background: CollectionPageState.tint.poster;
                                            clip: true;
                                            if item.has-poster: Image {
                                                width: 100%;
                                                height: 100%;
                                                source: item.poster;
                                                image-fit: cover;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        Text {
                                            text: item.num;
                                            font-size: 16px;
                                            font-weight: 700;
                                            color: Theme.text-muted;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        if item.status != "": Text {
                                            text: item.status;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: item.watched ? Theme.ok : CollectionPageState.tint.accent;
                                        }
                                    }
                                    Text {
                                        text: item.title;
                                        font-size: 20px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        wrap: word-wrap;
                                        overflow: elide;
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                    ActionButton {
                                        text: item.can-resume ? "Resume" : "Play";
                                        primary: item.can-resume;
                                        clicked => { CollectionPageState.play-item(item.rating-key, item.can-resume); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
