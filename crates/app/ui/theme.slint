// Visual tokens (plan §8, future plan §4). The laptop switches between Dark,
// Stone and Mist; the TV window never changes its mode, so it stays dark.

import "../../../assets/fonts/Inter-Light.ttf";
import "../../../assets/fonts/Inter-Regular.ttf";
import "../../../assets/fonts/Inter-Medium.ttf";
import "../../../assets/fonts/Inter-SemiBold.ttf";

export enum UiTheme { dark, aubergine, stone, mist }

export global Theme {
    in-out property <UiTheme> mode: UiTheme.dark;
    out property <bool> light: mode == UiTheme.stone || mode == UiTheme.mist;

    out property <string> font: "Inter";

    out property <color> bg: mode == UiTheme.dark ? #0E1526 : mode == UiTheme.aubergine ? #1A1024 : mode == UiTheme.stone ? #CBC5BA : #C3CBD3;
    out property <color> bg-night: #050608;
    out property <color> surface: mode == UiTheme.dark ? #162038 : mode == UiTheme.aubergine ? #241733 : mode == UiTheme.stone ? #DAD5CC : #D3DAE1;
    out property <color> surface-raised: mode == UiTheme.dark ? #1E2B4A : mode == UiTheme.aubergine ? #2F1F42 : mode == UiTheme.stone ? #E3DFD7 : #DEE3E8;
    out property <color> border: mode == UiTheme.dark ? #2B3B61 : mode == UiTheme.aubergine ? #412C59 : mode == UiTheme.stone ? #B9B2A6 : #AEB7C1;
    out property <color> text-primary: !light ? #E8EAED : mode == UiTheme.stone ? #1F1D1A : #1A1E23;
    out property <color> text-secondary: !light ? #A0A6AF : mode == UiTheme.stone ? #47433D : #3F464F;
    out property <color> text-muted: !light ? #8A9099 : mode == UiTheme.stone ? #4E4943 : #47505A;
    // Primary buttons and focus; darker on the light themes so white labels pass.
    out property <color> accent: light ? #194D9F : #5B9DFF;
    out property <color> on-accent: light ? #FFFFFF : #0B0D10;
    out property <color> ok: light ? #1E6B45 : #4CC38A;
    out property <color> warn: light ? #7A4E00 : #E5A84B;
    out property <color> alert: light ? #9E2622 : #F0605D;
    // Text drawn on poster art (badges) sits on a dark scrim in every theme.
    out property <color> scrim: #0B0D10C0;
    out property <color> on-scrim: #E8EAED;

    // Laptop sizes (touch-first: every control at least 56 px tall)
    out property <length> label-size: 18px;
    out property <length> body-size: 22px;
    out property <length> title-size: 28px;
    out property <length> laptop-clock-size: 132px;
    out property <length> hit-target: 56px;
    out property <length> radius: 18px;
    out property <length> card-radius: 28px;
    out property <length> gap: 24px;

    // TV sizes
    out property <length> tv-body-size: 36px;
    out property <length> tv-clock-size: 160px;
}
