    // | "search" | "library" | "expand" | weather: "clear" | "partly" | "cloud" | "fog" | "rain" | "snow" | "storm"
    in property <string> name;
    in property <color> tint: white;
    in property <length> size: 24px;
    in property <length> line: 1.8px;

