import { Theme } from "theme.slint";

// Small caps section label, e.g. "ON THE TV".
export component SectionLabel inherits Text {
    font-size: Theme.label-size;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: Theme.text-muted;
}

// HH:MM in fixed-width cells so the layout never jitters as digits change
// (Slint can't switch on Inter's tabular numerals).
export component Clock {
    in property <string> hh: "--";
    in property <string> mm: "--";
    in property <length> font-px: Theme.laptop-clock-size;
    in property <color> tint: Theme.text-primary;
    in property <int> weight: 300;

    HorizontalLayout {
        Text {
            text: root.hh;
            width: root.font-px * 1.24;
            horizontal-alignment: right;
            font-size: root.font-px;
            font-weight: root.weight;
            color: root.tint;
        }
        Text {
            text: ":";
            width: root.font-px * 0.34;
            horizontal-alignment: center;
            font-size: root.font-px;
            font-weight: root.weight;
            color: root.tint;
        }
        Text {
            text: root.mm;
            width: root.font-px * 1.24;
            horizontal-alignment: left;
            font-size: root.font-px;
            font-weight: root.weight;
            color: root.tint;
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    min-height: Theme.hit-target;
    min-width: max(Theme.hit-target, label.preferred-width + 32px);
    border-radius: 10px;
    border-width: root.primary ? 0 : 1px;
    border-color: Theme.border;
    background: !root.enabled ? Theme.surface-raised
        : root.primary ? (touch.pressed ? Theme.accent.darker(20%) : touch.has-hover ? Theme.accent.brighter(10%) : Theme.accent)
        : (touch.pressed ? Theme.border : touch.has-hover ? Theme.surface-raised.brighter(20%) : Theme.surface-raised);
    opacity: root.enabled ? 1.0 : 0.45;

    label := Text {
        text: root.text;
        font-size: Theme.body-size;
        font-weight: 500;
        color: root.primary && root.enabled ? #0B0D10 : Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Header status chip (weather, next event, homelab).
export component StatusChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <color> dot: transparent;
    // Non-empty shows a button instead of the detail line (e.g. "Reconnect").
    in property <string> action;
    callback action-clicked();

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: root.action != "" ? 1px : 0;
    border-color: Theme.warn.with-alpha(0.4);
    min-width: 220px;

    VerticalLayout {
        padding: 18px;
        spacing: 6px;
        SectionLabel { text: root.label; }
        HorizontalLayout {
            spacing: 10px;
            if root.dot != transparent: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.dot;
                }
            }
            Text {
                text: root.value;
                font-size: Theme.body-size;
                color: Theme.text-primary;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        if root.action == "" && root.detail != "": Text {
            text: root.detail;
            font-size: 18px;
            color: Theme.text-secondary;
            overflow: elide;
        }
        if root.action != "": HorizontalLayout {
            alignment: start;
            ActionButton {
                text: root.action;
                clicked => { root.action-clicked(); }
            }
        }
    }
}

// "Watch on TV" streaming tile.
export component SiteTile inherits Rectangle {
    in property <string> name;
    callback clicked();

    min-height: 84px;
    min-width: 120px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    background: touch.pressed ? Theme.border : Theme.surface-raised;

    Text {
        text: root.name;
        font-size: Theme.body-size;
        font-weight: 600;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export struct PosterCardData {
    title: string,
    subtitle: string,
    badge: string,
    progress: float,
    poster: image,
    has-poster: bool,
}

// Continue Watching card: 2:3 poster, source badge, progress, title.
export component PosterCard inherits Rectangle {
    in property <PosterCardData> data;
    in property <string> hover-text: "▶  Resume on TV";
    in property <bool> selected: false;
    callback clicked();

    width: 150px;
    height: 290px;

    VerticalLayout {
        spacing: 10px;

        art := Rectangle {
            height: 225px;
            border-radius: 10px;
            clip: true;
            background: Theme.surface-raised;
            border-width: touch.has-hover || root.selected ? 2px : 0;
            border-color: Theme.accent;

            if !root.data.has-poster: Text {
                text: root.data.title;
                width: parent.width - 24px;
                font-size: Theme.body-size;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.data.has-poster: Image {
                width: parent.width;
                height: parent.height;
                source: root.data.poster;
                image-fit: cover;
            }

            // Source badge
            Rectangle {
                x: 8px;
                y: 8px;
                width: badge-text.preferred-width + 16px;
                height: 26px;
                border-radius: 6px;
                background: #000000b0;
                badge-text := Text {
                    text: root.data.badge;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text-primary;
                }
            }

            // Hover affordance
            if touch.has-hover: Rectangle {
                background: #00000080;
                Text {
                    text: root.hover-text;
                    font-size: Theme.body-size;
                    font-weight: 600;
                    color: Theme.text-primary;
                }
            }

            // Progress
            if root.data.progress > 0: Rectangle {
                y: parent.height - 6px;
                height: 6px;
                background: #00000099;
                Rectangle {
                    x: 0;
                    width: parent.width * root.data.progress;
                    background: Theme.accent;
                }
            }
        }

        Text {
            text: root.data.title;
            font-size: 18px;
            font-weight: 600;
            color: Theme.text-primary;
            overflow: elide;
        }
        Text {
            text: root.data.subtitle;
            font-size: 16px;
            color: Theme.text-secondary;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Theme.border;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: Theme.accent;
    }
}

// An account that needs attention.
export struct AccountPrompt {
    source: string,     // "jellyfin" | "plex"
    message: string,
    action: string,     // button label
    action-id: string,  // "sign-in" | "retry"
    warn: bool,         // expired / failed / unreachable (vs. simply not set up)
}

// Slim one-line version, above a populated row or on the On the TV card.
export component PromptBanner inherits Rectangle {
    in property <AccountPrompt> data;
    callback action();

    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.data.warn ? Theme.warn.with-alpha(0.4) : Theme.border;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.data.warn ? Theme.warn : Theme.text-muted;
            }
        }
        Text {
            text: root.data.message;
            font-size: 18px;
            color: Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        ActionButton {
            text: root.data.action;
            clicked => { root.action(); }
        }
    }
}

export struct SessionRow {
    badge: string,
    title: string,
    detail: string,
}

// "Also playing" line: badge · title · device and position.
export component SessionLine inherits HorizontalLayout {
    in property <SessionRow> data;
    spacing: 14px;

    Rectangle {
        width: badge.preferred-width + 16px;
        height: 26px;
        y: (parent.height - self.height) / 2;
        border-radius: 6px;
        background: Theme.surface-raised;
        badge := Text {
            text: root.data.badge;
            font-size: 14px;
            font-weight: 600;
            color: Theme.text-secondary;
        }
    }
    Text {
        text: root.data.title;
        font-size: 20px;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    Text {
        text: root.data.detail;
        font-size: 18px;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
}

// Horizontally scrolling row of poster cards.
export component PosterRow inherits Flickable {
    in property <[PosterCardData]> cards;
    in property <string> hover-text: "▶  Resume on TV";
    in property <int> selected: -1;
    callback clicked(int);

    min-height: 290px;
    content-width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 20px;
        alignment: start;
        for c[i] in root.cards: PosterCard {
            data: c;
            hover-text: root.hover-text;
            selected: i == root.selected;
            clicked => { root.clicked(i); }
        }
    }
}

// Single-line text entry in the dashboard style.
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <bool> password: false;
    callback accepted(string);

    min-height: Theme.hit-target;
    min-width: 200px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Rectangle {
            if input.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                font-size: Theme.body-size;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                font-size: Theme.body-size;
                color: Theme.text-primary;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                accepted => { root.accepted(self.text); }
            }
        }
    }
}

// Title row for secondary pages, with a Back button.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    callback back();
    spacing: 20px;
    alignment: start;
    ActionButton { text: "‹  Back"; clicked => { root.back(); } }
    Text {
        text: root.title;
        font-size: 36px;
        font-weight: 600;
        color: Theme.text-primary;
        vertical-alignment: center;
    }
}
