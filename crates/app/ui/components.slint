import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

// Small caps section label, e.g. "ON THE TV".
export component SectionLabel inherits Text {
    font-size: Theme.label-size;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: Theme.text-muted;
}

// HH:MM in fixed-width cells so the layout never jitters as digits change
// (Slint can't switch on Inter's tabular numerals).
export component Clock {
    in property <string> hh: "--";
    in property <string> mm: "--";
    in property <string> ss: "--";
    in property <bool> show-seconds: false;
    in property <length> font-px: Theme.laptop-clock-size;
    in property <color> tint: Theme.text-primary;
    in property <int> weight: 300;

    HorizontalLayout {
        Text {
            text: root.hh;
            width: root.font-px * 1.24;
            horizontal-alignment: right;
            font-size: root.font-px;
            font-weight: root.weight;
            color: root.tint;
        }
        Text {
            text: ":";
            width: root.font-px * 0.34;
            horizontal-alignment: center;
            font-size: root.font-px;
            font-weight: root.weight;
            color: root.tint;
        }
        Text {
            text: root.mm;
            width: root.font-px * 1.24;
            horizontal-alignment: left;
            font-size: root.font-px;
            font-weight: root.weight;
            color: root.tint;
        }
        if root.show-seconds: Text {
            text: root.ss;
            width: root.font-px * 0.7;
            horizontal-alignment: left;
            vertical-alignment: bottom;
            font-size: root.font-px * 0.45;
            font-weight: root.weight;
            color: root.tint.transparentize(0.35);
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.card-radius;
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    // Overrides for tinted surfaces (the On the TV card).
    in property <color> fill: root.primary ? Theme.accent : Theme.surface-raised;
    in property <color> ink: root.primary ? Theme.on-accent : Theme.text-primary;
    in property <color> edge: Theme.border;
    in property <length> font-px: Theme.body-size;
    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    min-height: Theme.hit-target;
    min-width: max(Theme.hit-target, row.preferred-width + 40px);
    horizontal-stretch: 0;
    border-radius: 14px;
    border-width: root.primary ? 0 : 1px;
    border-color: root.edge;
    background: touch.pressed ? root.fill.mix(root.ink, 0.8) : touch.has-hover ? root.fill.mix(root.ink, 0.92) : root.fill;
    opacity: root.enabled ? 1.0 : 0.45;

    row := HorizontalLayout {
        alignment: center;
        spacing: 10px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; tint: root.ink; size: root.font-px * 1.2; }
        }
        if root.text != "": Text {
            text: root.text;
            font-size: root.font-px;
            font-weight: root.primary ? 600 : 500;
            color: root.ink;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export struct PosterCardData {
    title: string,
    subtitle: string,
    badge: string,
    progress: float,
    poster: image,
    has-poster: bool,
    // Progress colour and the no-art background, from the poster's hue.
    accent: color,
    placeholder: color,
}

// Poster card: 2:3 art, source badge, progress, title (and optionally a subtitle).
export component PosterCard inherits Rectangle {
    in property <PosterCardData> data;
    in property <bool> selected: false;
    in property <length> art-width: 140px;
    in property <bool> show-subtitle: false;
    callback clicked();

    width: root.art-width;
    height: col.preferred-height;

    col := VerticalLayout {
        spacing: 8px;

        art := Rectangle {
            height: root.art-width * 1.5;
            border-radius: 12px;
            clip: true;
            background: root.data.placeholder;
            border-width: touch.pressed || root.selected ? 3px : touch.has-hover ? 2px : 0;
            border-color: Theme.accent;

            if !root.data.has-poster: Text {
                text: root.data.title;
                width: parent.width - 20px;
                font-size: 18px;
                color: Theme.on-scrim;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.data.has-poster: Image {
                width: parent.width;
                height: parent.height;
                source: root.data.poster;
                image-fit: cover;
            }

            // Source badge
            Rectangle {
                x: 8px;
                y: 8px;
                width: badge-text.preferred-width + 16px;
                height: 24px;
                border-radius: 6px;
                background: Theme.scrim;
                badge-text := Text {
                    text: root.data.badge;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.on-scrim;
                }
            }

            // Progress
            if root.data.progress > 0: Rectangle {
                y: parent.height - 6px;
                height: 6px;
                background: #0B0D1099;
                Rectangle {
                    x: 0;
                    width: parent.width * root.data.progress;
                    background: root.data.accent;
                }
            }
        }

        Text {
            text: root.data.title;
            font-size: 17px;
            font-weight: 500;
            color: Theme.text-primary;
            overflow: elide;
        }
        if root.show-subtitle: Text {
            text: root.data.subtitle;
            font-size: 15px;
            color: Theme.text-secondary;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.accent;
    in property <color> track: Theme.border;
    height: 6px;
    border-radius: self.height / 2;
    background: root.track;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        background: root.fill;
    }
}

// An account that needs attention.
export struct AccountPrompt {
    source: string,     // "plex"
    message: string,
    action: string,     // button label
    action-id: string,  // "sign-in" | "retry"
    warn: bool,         // expired / failed / unreachable (vs. simply not set up)
}

// Slim one-line version, above a populated row or on the On the TV card.
export component PromptBanner inherits Rectangle {
    in property <AccountPrompt> data;
    in property <color> fill: Theme.surface-raised;
    callback action();

    border-radius: 14px;
    background: root.fill;
    border-width: 1px;
    border-color: root.data.warn ? Theme.warn.with-alpha(0.4) : Theme.border;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.data.warn ? Theme.warn : Theme.text-muted;
            }
        }
        Text {
            text: root.data.message;
            font-size: 18px;
            color: Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        ActionButton {
            text: root.data.action;
            clicked => { root.action(); }
        }
    }
}

export struct SessionRow {
    badge: string,
    title: string,
    detail: string,
}

// "Also playing" line: badge · title · device and position.
export component SessionLine inherits HorizontalLayout {
    in property <SessionRow> data;
    spacing: 14px;

    Rectangle {
        width: badge.preferred-width + 16px;
        height: 26px;
        y: (parent.height - self.height) / 2;
        border-radius: 6px;
        background: Theme.scrim;
        badge := Text {
            text: root.data.badge;
            font-size: 14px;
            font-weight: 600;
            color: Theme.on-scrim;
        }
    }
    Text {
        text: root.data.title;
        font-size: 20px;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    Text {
        text: root.data.detail;
        font-size: 18px;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

// Horizontally scrolling row of poster cards (swipe or drag to scroll).
export component PosterRow inherits Flickable {
    in property <[PosterCardData]> cards;
    in property <int> selected: -1;
    in property <length> art-width: 140px;
    in property <bool> show-subtitle: false;
    callback clicked(int);

    min-height: row.preferred-height;
    content-width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 16px;
        alignment: start;
        for c[i] in root.cards: PosterCard {
            data: c;
            art-width: root.art-width;
            show-subtitle: root.show-subtitle;
            selected: i == root.selected;
            clicked => { root.clicked(i); }
        }
    }
}

// Single-line text entry in the dashboard style.
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <bool> password: false;
    callback accepted(string);
    callback edited(string);

    min-height: Theme.hit-target;
    min-width: 200px;
    horizontal-stretch: 1;
    border-radius: 14px;
    background: Theme.surface-raised;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Rectangle {
            if input.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                font-size: Theme.body-size;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                font-size: Theme.body-size;
                color: Theme.text-primary;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }
    }
}

// Title row for secondary pages, with a Back button.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    callback back();
    spacing: 20px;
    alignment: start;
    ActionButton { text: "Back"; icon: "back-arrow"; clicked => { root.back(); } }
    Text {
        text: root.title;
        font-size: 36px;
        font-weight: 600;
        color: Theme.text-primary;
        vertical-alignment: center;
    }
}

// Touch-sized checkbox with a label.
export component CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    min-height: Theme.hit-target;
    horizontal-stretch: 0;
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.text;
    HorizontalLayout {
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                border-width: root.checked ? 0 : 2px;
                border-color: Theme.text-secondary;
                background: root.checked ? Theme.accent : transparent;
                if root.checked: Icon { name: "check"; tint: Theme.on-accent; size: 22px; line: 2.4px; }
            }
        }
        Text { text: root.text; font-size: 20px; color: Theme.text-primary; vertical-alignment: center; wrap: word-wrap; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Label above a text field, with an optional hint below.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> placeholder;
    in-out property <string> text;
    spacing: 8px;
    Text { text: root.label; font-size: 18px; font-weight: 600; color: Theme.text-secondary; }
    TextField { placeholder: root.placeholder; text <=> root.text; }
    if root.hint != "": Text { text: root.hint; font-size: 16px; color: Theme.text-muted; wrap: word-wrap; }
}
