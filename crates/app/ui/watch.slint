import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { ActionButton, Card, CheckBox, PageHeader, SectionLabel, TextField } from "components.slint";
import { Nav, Watch, WatchAction, WatchCard } from "state.slint";

// Where to watch: TMDB search, grouped by what you can watch right now.

component WatchTile inherits Rectangle {
    in property <WatchCard> card;
    callback clicked();
    width: 150px;
    height: col.preferred-height;
    property <bool> selected: Watch.selected == root.card.key && Watch.detail-open;

    col := VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 225px;
            border-radius: 12px;
            clip: true;
            background: Theme.surface-raised;
            border-width: root.selected || touch.pressed ? 3px : 0;
            border-color: Theme.accent;
            if root.card.has-poster: Image { width: parent.width; height: parent.height; source: root.card.poster; image-fit: cover; }
            if !root.card.has-poster: Text {
                text: root.card.title;
                width: parent.width - 20px;
                font-size: 18px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        Text { text: root.card.title; font-size: 17px; font-weight: 500; color: Theme.text-primary; overflow: elide; }
        Text { text: root.card.meta; font-size: 15px; color: Theme.text-muted; overflow: elide; }
        Text {
            text: root.card.line;
            font-size: 15px;
            font-weight: root.card.tier == "included" || root.card.tier == "library" ? 600 : 400;
            color: root.card.tier == "included" || root.card.tier == "library" ? Theme.ok : Theme.text-secondary;
            wrap: word-wrap;
            max-height: 40px;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Group inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <[WatchCard]> cards;
    spacing: 14px;
    if root.cards.length > 0: HorizontalLayout {
        spacing: 14px;
        SectionLabel { text: root.title + " · " + root.cards.length; vertical-alignment: center; }
        Text { text: root.hint; font-size: 16px; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; }
    }
    if root.cards.length > 0: Flickable {
        min-height: row.preferred-height;
        content-width: row.preferred-width;
        row := HorizontalLayout {
            spacing: 16px;
            alignment: start;
            for c in root.cards: WatchTile {
                card: c;
                clicked => {
                    Watch.selected = c.key;
                    Watch.select(c.key);
                }
            }
        }
    }
}

component WatchDetail inherits Card {
    width: 440px;
    Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: parent.width;
            padding: 24px;
            spacing: 14px;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 200px;
                    height: 300px;
                    border-radius: 12px;
                    clip: true;
                    background: Theme.surface-raised;
                    if Watch.detail.has-poster: Image { width: parent.width; height: parent.height; source: Watch.detail.poster; image-fit: cover; }
                }
            }
            Text { text: Watch.detail.title; font-size: 28px; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
            Text { text: Watch.detail.meta; font-size: 18px; color: Theme.text-secondary; }
            for a in Watch.detail-actions: ActionButton {
                text: a.label;
                icon: a.kind == "play" || a.kind == "open" ? "play" : a.kind == "tmdb" ? "tv" : a.kind == "library" ? "library" : "";
                primary: a.primary;
                clicked => { Watch.action(a); }
            }
            if Watch.detail-yours.length > 0: SectionLabel { text: "ON YOUR SERVICES"; }
            for y in Watch.detail-yours: Text { text: y; font-size: 20px; color: Theme.ok; }
            if Watch.detail-elsewhere.length > 0: SectionLabel { text: "ELSEWHERE"; }
            for e in Watch.detail-elsewhere: Text { text: e; font-size: 18px; color: Theme.text-secondary; wrap: word-wrap; }
            if Watch.detail-overview != "": Text { text: Watch.detail-overview; font-size: 17px; color: Theme.text-secondary; wrap: word-wrap; }
            ActionButton { text: "Close"; clicked => { Watch.close-detail(); } }
        }
    }
}

export component WatchPage inherits VerticalLayout {
    padding: 40px;
    spacing: Theme.gap;

    HorizontalLayout {
        spacing: 16px;
        PageHeader {
            title: "Where to watch";
            back => { Nav.page = "home"; }
        }
        Rectangle { width: 12px; }
        search := TextField {
            placeholder: "Search any movie or show";
            text <=> Watch.query;
            edited(q) => { Watch.edited(q); }
            accepted(q) => { Watch.search(q); }
        }
        CheckBox { text: "Only what I can watch now"; checked <=> Watch.only-now; }
    }

    HorizontalLayout {
        spacing: Theme.gap;
        vertical-stretch: 1;
        min-height: 0;
        preferred-height: 0;

        // Scrolls on its own so the credit line stays on screen.
        Flickable {
            horizontal-stretch: 1;
            min-height: 0;
            preferred-height: 0;
            content-height: groups.preferred-height;
            groups := VerticalLayout {
                width: parent.width;
                spacing: 28px;
                alignment: start;
                if Watch.message != "" || Watch.searching: Text {
                    text: Watch.searching ? "Searching…" : Watch.message;
                    font-size: Theme.body-size;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Group { title: "IN YOUR LIBRARY"; hint: "Plex and Jellyfin"; cards: Watch.library; }
                Group { title: "ON YOUR SERVICES"; hint: "Included with a site you have"; cards: Watch.included; }
                if !Watch.only-now: Group { title: "COSTS EXTRA"; hint: "Rent, buy, or a service you don't have"; cards: Watch.extra; }
                if !Watch.only-now: Group { title: "NOT STREAMING"; hint: "No US offers"; cards: Watch.none; }
                Group { title: "CHECKING"; hint: "Looking up where it streams…"; cards: Watch.checking; }
            }
        }

        if Watch.detail-open: WatchDetail { }
    }

    // Required by TMDB: JustWatch provides the availability data.
    HorizontalLayout {
        spacing: 10px;
        Text { text: "Availability in the US from JustWatch, via TMDB."; font-size: 16px; color: Theme.text-muted; }
        Text { text: "This product uses the TMDB API but is not endorsed or certified by TMDB."; font-size: 16px; color: Theme.text-muted; horizontal-stretch: 1; }
    }
}
