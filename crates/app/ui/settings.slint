import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { ActionButton, Card, CheckBox, PageHeader, SectionLabel, TextField } from "components.slint";
import { Accounts, AccountRow, Dash, Diagnostics, Display, HealthRow, Nav, Server, ServerActivityRow, ServerLibraryRow, SiteEditor, SiteRow, TvUi } from "state.slint";
import { Theme as T, UiTheme } from "theme.slint";

component AccountLine inherits VerticalLayout {
    in property <AccountRow> account;
    spacing: 12px;

    HorizontalLayout {
        spacing: 18px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.account.state == "ok" ? Theme.ok
                    : root.account.state == "warn" ? Theme.warn
                    : root.account.state == "busy" ? Theme.accent
                    : Theme.border;
            }
        }
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Text { text: root.account.name; font-size: Theme.body-size; font-weight: 600; color: Theme.text-primary; }
            Text {
                text: root.account.status;
                font-size: 18px;
                color: root.account.state == "warn" ? Theme.warn : Theme.text-secondary;
                overflow: elide;
            }
            if root.account.detail != "": Text {
                text: root.account.detail;
                font-size: 16px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        if root.account.secondary != "": VerticalLayout {
            alignment: center;
            ActionButton {
                text: root.account.secondary;
                clicked => { root.act(root.account.secondary-id); }
            }
        }
        if root.account.primary != "": VerticalLayout {
            alignment: center;
            ActionButton {
                text: root.account.primary;
                primary: true;
                clicked => { root.act(root.account.primary-id); }
            }
        }
    }

    if Accounts.editing == root.account.id: VerticalLayout {
        spacing: 8px;
        padding-left: 30px;
        HorizontalLayout {
            spacing: 12px;
            field := TextField {
                placeholder: root.account.input-hint;
                password: true;
                accepted(v) => { Accounts.submit(root.account.id, v); }
            }
            ActionButton { text: "Save"; primary: true; clicked => { Accounts.submit(root.account.id, field.text); } }
            ActionButton { text: "Cancel"; clicked => { Accounts.editing = ""; } }
        }
        if Accounts.edit-error != "": Text { text: Accounts.edit-error; font-size: 18px; color: Theme.warn; wrap: word-wrap; }
    }

    function act(id: string) {
        if id == "edit" {
            Accounts.edit-error = "";
            Accounts.editing = root.account.id;
        } else {
            Accounts.action(root.account.id, id);
        }
    }
}

component Tab inherits Rectangle {
    in property <string> id;
    in property <string> label;
    property <bool> on: Nav.settings-tab == root.id;
    min-height: Theme.hit-target;
    min-width: t.preferred-width + 44px;
    border-radius: 14px;
    background: root.on ? Theme.text-primary : touch.pressed ? Theme.surface-raised : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    t := Text { text: root.label; font-size: 20px; font-weight: 500; color: root.on ? Theme.bg : Theme.text-secondary; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Nav.settings-tab = root.id; }
    }
}

component IconAction inherits ActionButton {
    width: Theme.hit-target;
}

component StreamingLine inherits HorizontalLayout {
    in property <SiteRow> site;
    in property <bool> first;
    in property <bool> last;
    spacing: 14px;
    opacity: root.site.hidden ? 0.6 : 1;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: root.site.bg;
            Text { text: root.site.monogram; font-size: 24px; font-weight: 600; color: root.site.fg; }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        horizontal-stretch: 1;
        Text { text: root.site.name + (root.site.hidden ? " · hidden" : ""); font-size: Theme.body-size; font-weight: 600; color: Theme.text-primary; overflow: elide; }
        Text { text: root.site.url; font-size: 16px; color: Theme.text-muted; overflow: elide; }
    }
    Text {
        text: root.site.status;
        font-size: 18px;
        color: root.site.opened ? Theme.ok : Theme.text-secondary;
        vertical-alignment: center;
        width: 270px;
    }
    VerticalLayout { alignment: center; ActionButton { text: "Sign in on TV"; clicked => { Accounts.open-site(root.site.index); } } }
    VerticalLayout { alignment: center; ActionButton { text: "Edit"; icon: "edit"; clicked => { SiteEditor.edit(root.site.index); } } }
    VerticalLayout {
        alignment: center;
        ActionButton {
            text: root.site.hidden ? "Show" : "Hide";
            icon: root.site.hidden ? "eye" : "eye-off";
            width: 124px;
            clicked => { SiteEditor.set-hidden(root.site.index, !root.site.hidden); }
        }
    }
    VerticalLayout {
        alignment: center;
        IconAction {
            icon: "up";
            enabled: !root.first;
            accessible-label: "Move " + root.site.name + " up";
            clicked => { SiteEditor.move(root.site.index, root.site.index - 1); }
        }
    }
    VerticalLayout {
        alignment: center;
        IconAction {
            icon: "down";
            enabled: !root.last;
            accessible-label: "Move " + root.site.name + " down";
            clicked => { SiteEditor.move(root.site.index, root.site.index + 1); }
        }
    }
}

component AccountsTab inherits VerticalLayout {
    spacing: Theme.gap;
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 22px;
            SectionLabel { text: "SERVERS AND SERVICES"; }
            for row[i] in Accounts.accounts: VerticalLayout {
                spacing: 22px;
                if i > 0: Rectangle { height: 1px; background: Theme.border; }
                AccountLine { account: row; }
            }
        }
    }
    HorizontalLayout {
        spacing: 16px;
        ActionButton { text: "Run first-time setup again"; clicked => { Accounts.run-setup(); } }
        HorizontalLayout {
            spacing: 10px;
            horizontal-stretch: 1;
            padding-left: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Dash.keyring-dot; }
            }
            Text {
                text: Dash.keyring-status;
                font-size: Theme.label-size;
                color: Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component StreamingTab inherits VerticalLayout {
    spacing: Theme.gap;
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            HorizontalLayout {
                SectionLabel { text: "STREAMING SITES · TILE ORDER"; horizontal-stretch: 1; vertical-alignment: center; }
                ActionButton { text: "Add site"; icon: "plus"; primary: true; clicked => { SiteEditor.add(); } }
            }
            Text {
                text: "Each site opens full screen on the TV in tvdash's own browser profile; sign in there once with this laptop. Hidden sites leave the dashboard but still count as your services in Where to watch.";
                font-size: 18px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            for site[i] in Accounts.sites: VerticalLayout {
                spacing: 18px;
                if i > 0: Rectangle { height: 1px; background: Theme.border; }
                StreamingLine { site: site; first: i == 0; last: i == Accounts.sites.length - 1; }
            }
            if Accounts.sites.length == 0: Text { text: "No streaming sites yet. Add one to get a tile on the dashboard."; font-size: Theme.body-size; color: Theme.text-secondary; }
        }
    }
    Card {
        HorizontalLayout {
            padding: 28px;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;
                Text { text: "Browser profile"; font-size: Theme.body-size; font-weight: 600; color: Theme.text-primary; }
                Text {
                    text: Accounts.confirm-clear ? "Signs you out of every streaming site." : "Holds every streaming sign-in. Clearing it signs you out of all of them.";
                    font-size: 18px;
                    color: Accounts.confirm-clear ? Theme.warn : Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
            if !Accounts.confirm-clear: VerticalLayout {
                alignment: center;
                ActionButton { text: "Clear browser profile"; clicked => { Accounts.confirm-clear = true; } }
            }
            if Accounts.confirm-clear: VerticalLayout {
                alignment: center;
                ActionButton { text: "Cancel"; clicked => { Accounts.confirm-clear = false; } }
            }
            if Accounts.confirm-clear: VerticalLayout {
                alignment: center;
                ActionButton {
                    text: "Yes, clear it";
                    primary: true;
                    clicked => {
                        Accounts.confirm-clear = false;
                        Accounts.clear-profile();
                    }
                }
            }
        }
    }
}

// Two or three mutually exclusive choices.
component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    min-height: Theme.hit-target;
    min-width: t.preferred-width + 44px;
    border-radius: 14px;
    background: root.on ? Theme.text-primary : touch.pressed ? Theme.surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.label;
    t := Text { text: root.label; font-size: 20px; font-weight: 500; color: root.on ? Theme.bg : Theme.text-secondary; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingLine inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    spacing: 20px;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        horizontal-stretch: 1;
        Text { text: root.title; font-size: Theme.body-size; font-weight: 600; color: Theme.text-primary; }
        Text { text: root.detail; font-size: 17px; color: Theme.text-secondary; wrap: word-wrap; }
    }
    @children
}

component SegmentBox inherits Rectangle {
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius;
    HorizontalLayout {
        padding: 4px;
        @children
    }
}

component DisplayTab inherits VerticalLayout {
    spacing: Theme.gap;
    alignment: start;
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 24px;
            SectionLabel { text: "DISPLAY"; }
            VerticalLayout {
                spacing: 14px;
                SettingLine {
                    title: "Location";
                    detail: Display.location-name != "" ? Display.location-name + " · for the weather and the clock's time zone"
                        : "Not set: the weather stays off until you pick a place.";
                    HorizontalLayout {
                        spacing: 12px;
                        width: 560px;
                        place := TextField {
                            placeholder: "Search for a city";
                            text <=> Display.place-query;
                            accepted(q) => { Display.find-place(q); }
                        }
                        ActionButton { text: "Search"; icon: "search"; clicked => { Display.find-place(place.text); } }
                    }
                }
                if Display.place-searching: Text { text: "Looking it up…"; font-size: 18px; color: Theme.text-secondary; horizontal-alignment: right; }
                if Display.place-message != "": Text { text: Display.place-message; font-size: 18px; color: Theme.warn; horizontal-alignment: right; }
                if Display.places.length > 0: HorizontalLayout {
                    alignment: end;
                    VerticalLayout {
                        width: 560px;
                        spacing: 8px;
                        Text { text: "Pick your place:"; font-size: 17px; color: Theme.text-secondary; }
                        for p[i] in Display.places: ActionButton {
                            text: p;
                            clicked => { Display.pick-place(i); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            SettingLine {
                title: "Layout";
                detail: "Automatic: switches between two screens and TV only when the laptop lid or TV changes. Two screens: dashboard on the laptop, playback on the TV. TV only: everything full screen on the TV.";
                VerticalLayout {
                    alignment: center;
                    SegmentBox {
                        Segment { label: "Automatic"; on: Display.layout-setting == "auto"; clicked => { Display.set-layout-setting("auto"); } }
                        Segment { label: "Two screens"; on: Display.layout-setting == "dual"; clicked => { Display.set-layout-setting("dual"); } }
                        Segment { label: "TV only"; on: Display.layout-setting == "tv"; clicked => { Display.set-layout-setting("tv"); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            SettingLine {
                title: "Temperature";
                detail: "Weather in the header.";
                VerticalLayout {
                    alignment: center;
                    SegmentBox {
                        Segment { label: "°F"; on: !Display.celsius; clicked => { Display.celsius = false; Display.changed(); } }
                        Segment { label: "°C"; on: Display.celsius; clicked => { Display.celsius = true; Display.changed(); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            SettingLine {
                title: "Clock";
                detail: "On the laptop, the TV and in end times.";
                VerticalLayout {
                    alignment: center;
                    SegmentBox {
                        Segment { label: "24-hour"; on: !Display.h12; clicked => { Display.h12 = false; Display.changed(); } }
                        Segment { label: "12-hour"; on: Display.h12; clicked => { Display.h12 = true; Display.changed(); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            SettingLine {
                title: "Seconds";
                detail: "Show seconds on both clocks.";
                VerticalLayout {
                    alignment: center;
                    CheckBox { text: "Show seconds"; checked <=> Display.seconds; toggled => { Display.changed(); } }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            SettingLine {
                title: "Theme";
                detail: "The laptop only; the TV always stays dark. Also in the dashboard header.";
                VerticalLayout {
                    alignment: center;
                    SegmentBox {
                        Segment { label: "Follow system"; on: Display.follow-system; clicked => { Display.set-follow-system(); } }
                        Segment { label: "Dark"; on: !Display.follow-system && T.mode == UiTheme.dark; clicked => { Dash.set-theme(UiTheme.dark); } }
                        Segment { label: "Stone"; on: !Display.follow-system && T.mode == UiTheme.stone; clicked => { Dash.set-theme(UiTheme.stone); } }
                        Segment { label: "Mist"; on: !Display.follow-system && T.mode == UiTheme.mist; clicked => { Dash.set-theme(UiTheme.mist); } }
                    }
                }
            }
        }
    }
}

component HealthLine inherits HorizontalLayout {
    in property <HealthRow> health;
    spacing: 18px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.health.state == "ok" ? Theme.ok : root.health.state == "warn" ? Theme.warn : Theme.border;
        }
    }
    Text { text: root.health.name; font-size: Theme.body-size; font-weight: 600; color: Theme.text-primary; width: 280px; vertical-alignment: center; }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        horizontal-stretch: 1;
        Text { text: root.health.last-ok != "" ? "Last OK · " + root.health.last-ok : "No successful check yet"; font-size: 18px; color: Theme.text-secondary; overflow: elide; }
        if root.health.last-error != "": Text { text: "Last error · " + root.health.last-error; font-size: 18px; color: Theme.warn; wrap: word-wrap; }
    }
}

component DiagnosticsTab inherits VerticalLayout {
    spacing: Theme.gap;
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 20px;
            SectionLabel { text: "SERVICES"; }
            for row[i] in Diagnostics.rows: VerticalLayout {
                spacing: 20px;
                if i > 0: Rectangle { height: 1px; background: Theme.border; }
                HealthLine { health: row; }
            }
        }
    }
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 12px;
            SectionLabel { text: "FILES"; }
            for line in Diagnostics.paths: Text { text: line; font-size: 18px; color: Theme.text-secondary; wrap: word-wrap; }
        }
    }
}

component ServerGraph inherits Rectangle {
    in property <string> line-a;
    in property <string> line-b;
    in property <string> label;
    in property <string> scale;
    height: 150px;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    Text {
        x: 14px;
        y: 10px;
        text: root.label + (root.scale != "" ? " · " + root.scale : "");
        font-size: 16px;
        font-weight: 600;
        color: Theme.text-secondary;
    }
    Path {
        x: 10px;
        y: 38px;
        width: parent.width - 20px;
        height: parent.height - 48px;
        viewbox-width: 300;
        viewbox-height: 100;
        commands: root.line-a;
        stroke: Theme.accent;
        stroke-width: 3px;
    }
    Path {
        x: 10px;
        y: 38px;
        width: parent.width - 20px;
        height: parent.height - 48px;
        viewbox-width: 300;
        viewbox-height: 100;
        commands: root.line-b;
        stroke: Theme.text-secondary;
        stroke-width: 3px;
    }
}

component ServerTab inherits VerticalLayout {
    spacing: Theme.gap;
    Timer {
        interval: 100ms;
        running: true;
        triggered => {
            Server.open();
            self.running = false;
        }
    }
    Timer {
        interval: 5s;
        running: true;
        triggered => { Server.refresh(); }
    }
    Timer {
        interval: 3s;
        running: true;
        triggered => { Server.refresh-activities(); }
    }
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            HorizontalLayout {
                spacing: 12px;
                Text { text: Server.name; font-size: 24px; font-weight: 600; color: Theme.text-primary; }
                Text { text: Server.status; font-size: 18px; color: Theme.text-secondary; }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { text: "Refresh"; clicked => { Server.refresh(); } }
                ActionButton { text: "Scan all"; primary: true; clicked => { Server.scan-all(); } }
            }
            if !Server.plex-pass: Text {
                text: "Plex Pass is required for server graphs and stream controls.";
                font-size: 18px;
                color: Theme.text-secondary;
            }
            if Server.plex-pass: HorizontalLayout {
                spacing: 16px;
                ServerGraph { label: "CPU · Host / Plex"; line-a: Server.cpu-host-path; line-b: Server.cpu-process-path; horizontal-stretch: 1; }
                ServerGraph { label: "RAM · Host / Plex"; line-a: Server.ram-host-path; line-b: Server.ram-process-path; horizontal-stretch: 1; }
                ServerGraph { label: "Bandwidth · LAN / WAN"; line-a: Server.bandwidth-lan-path; line-b: Server.bandwidth-wan-path; scale: Server.bandwidth-scale + " Mb/s"; horizontal-stretch: 1; }
            }
            if Server.plex-pass: HorizontalLayout {
                spacing: 16px;
                Rectangle {
                    width: 180px; height: 86px; background: Theme.surface; border-radius: Theme.radius; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 16px; spacing: 6px; Text { text: "STREAMS"; font-size: 16px; color: Theme.text-secondary; } Text { text: Server.streams; font-size: 32px; font-weight: 600; color: Theme.text-primary; } }
                }
                Rectangle {
                    width: 180px; height: 86px; background: Theme.surface; border-radius: Theme.radius; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 16px; spacing: 6px; Text { text: "TRANSCODE"; font-size: 16px; color: Theme.text-secondary; } Text { text: Server.transcodes; font-size: 32px; font-weight: 600; color: Theme.text-primary; } }
                }
                Rectangle {
                    width: 180px; height: 86px; background: Theme.surface; border-radius: Theme.radius; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 16px; spacing: 6px; Text { text: "BANDWIDTH"; font-size: 16px; color: Theme.text-secondary; } Text { text: Server.bandwidth + " Mb/s"; font-size: 32px; font-weight: 600; color: Theme.text-primary; } }
                }
                Rectangle {
                    width: 180px; height: 86px; background: Theme.surface; border-radius: Theme.radius; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 16px; spacing: 6px; Text { text: "CPU"; font-size: 16px; color: Theme.text-secondary; } Text { text: Server.cpu + "%"; font-size: 32px; font-weight: 600; color: Theme.text-primary; } }
                }
                Rectangle {
                    width: 180px; height: 86px; background: Theme.surface; border-radius: Theme.radius; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 16px; spacing: 6px; Text { text: "RAM"; font-size: 16px; color: Theme.text-secondary; } Text { text: Server.ram + "%"; font-size: 32px; font-weight: 600; color: Theme.text-primary; } }
                }
            }
        }
    }
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            SectionLabel { text: "STREAMS"; }
            if Server.streams-detail.length == 0: Text {
                text: "Nothing is streaming from Plex right now.";
                font-size: 18px;
                color: Theme.text-secondary;
            }
            for row in Server.streams-detail: HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: row.title; font-size: 20px; color: Theme.text-primary; overflow: elide; }
                    Text { text: row.device + " · " + row.detail; font-size: 17px; color: Theme.text-secondary; overflow: elide; }
                }
                ActionButton {
                    text: "Stop";
                    enabled: Server.plex-pass && row.session-id != "";
                    clicked => {
                        Server.stop-session-id = row.session-id;
                        Server.stop-title = row.title;
                        Server.stop-device = row.device;
                        Server.confirm-stop = true;
                    }
                }
            }
        }
    }
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            SectionLabel { text: "ACTIVITY"; }
            if Server.activity.length == 0: Text {
                text: "Nothing running on the server.";
                font-size: 18px;
                color: Theme.text-secondary;
            }
            for row in Server.activity: VerticalLayout {
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        Text { text: row.title; font-size: 20px; color: Theme.text-primary; }
                        Text { text: row.subtitle; font-size: 17px; color: Theme.text-secondary; }
                        Rectangle {
                            height: 8px; background: Theme.border; border-radius: 999px;
                            Rectangle { width: min(row.progress, 100.0) * parent.width / 100; height: 100%; background: Theme.accent; border-radius: 999px; }
                        }
                    }
                    if row.cancellable: ActionButton { text: "Cancel"; clicked => { Server.cancel-activity(row.uuid); } }
                }
            }
        }
    }
    Card {
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            SectionLabel { text: "LIBRARIES"; }
            for row[index] in Server.libraries: HorizontalLayout {
                spacing: 16px;
                Text { text: row.title; font-size: 20px; color: Theme.text-primary; }
                Text { text: row.count + " items · scanned " + row.scanned; font-size: 18px; color: Theme.text-secondary; }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    text: row.loading ? "Scanning…" : "Scan";
                    enabled: !row.loading;
                    clicked => { Server.scan-section(index); }
                }
            }
        }
        if Server.confirm-stop: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #00000099;
            VerticalLayout {
                alignment: center;
                Card {
                    width: min(620px, parent.width - 64px);
                    VerticalLayout {
                        padding: 28px;
                        spacing: 18px;
                        Text {
                            text: "Stop " + Server.stop-title + " on " + Server.stop-device + "?";
                            font-size: 24px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        TextField {
                            placeholder: "Message shown on that device";
                            text <=> Server.stop-reason;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle { horizontal-stretch: 1; }
                            ActionButton { text: "Cancel"; clicked => { Server.confirm-stop = false; } }
                            ActionButton {
                                text: "Stop stream";
                                primary: true;
                                clicked => {
                                    Server.terminate(Server.stop-session-id, Server.stop-reason);
                                    Server.confirm-stop = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component ChangelogTab inherits VerticalLayout {
    spacing: Theme.gap;

    for entry in Dash.changelog: Card {
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                Text { text: entry.version; font-size: 22px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if entry.date != "": Text { text: entry.date; font-size: 16px; color: Theme.text-muted; vertical-alignment: center; }
            }
            Text {
                text: entry.notes;
                font-size: 17px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    padding: 40px;
    spacing: Theme.gap;

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 20px;
        PageHeader {
            title: "Settings";
            back => { Nav.page = "home"; }
        }
        if Dash.version != "": Text {
            text: "v" + Dash.version;
            font-size: 18px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius;
            HorizontalLayout {
                padding: 4px;
                Tab { id: "accounts"; label: "Accounts"; }
                Tab { id: "streaming"; label: "Streaming"; }
                Tab { id: "display"; label: "Display"; }
                Tab { id: "server"; label: "Server"; }
                Tab { id: "diagnostics"; label: "Diagnostics"; }
                Tab { id: "changelog"; label: "What's new"; }
            }
        }
        ActionButton { text: "Quit tvdash"; clicked => { Dash.quit(); } }
    }

    Flickable {
        vertical-stretch: 1;
        interactive: true;
        content-height: tab-body.preferred-height + 16px;
        tab-body := VerticalLayout {
            width: parent.width;
            if Nav.settings-tab == "accounts": AccountsTab { }
            if Nav.settings-tab == "streaming": StreamingTab { }
            if Nav.settings-tab == "display": DisplayTab { }
            if Nav.settings-tab == "server": ServerTab { }
            if Nav.settings-tab == "diagnostics": DiagnosticsTab { }
            if Nav.settings-tab == "changelog": ChangelogTab { }
        }
    }
}
