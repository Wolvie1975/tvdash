import { Theme } from "theme.slint";
import { ActionButton, Card, SectionLabel, TextField } from "components.slint";
import { Accounts, Dash, Nav, Setup } from "state.slint";

component StepDot inherits HorizontalLayout {
    in property <int> index;
    in property <string> label;
    // Connected (vs. merely passed/skipped).
    in property <bool> done;
    spacing: 10px;
    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: Setup.step == root.index ? Theme.accent : root.done ? Theme.ok : Theme.surface-raised;
        Text {
            text: root.done && Setup.step != root.index ? "✓" : root.index + 1;
            font-size: 18px;
            font-weight: 600;
            color: Setup.step == root.index || root.done ? Theme.on-accent : Theme.text-muted;
        }
    }
    Text {
        text: root.label;
        font-size: 20px;
        color: Setup.step == root.index ? Theme.text-primary : Theme.text-muted;
        vertical-alignment: center;
    }
}

// Code / progress / done block shared by the Plex and Jellyfin steps.
component SignInBlock inherits VerticalLayout {
    in property <string> state;
    in property <string> code;
    in property <string> message;
    in property <string> instructions;
    in property <string> start-label;
    callback begin();
    callback cancel();
    spacing: 16px;

    if root.state == "code": Text {
        text: root.code;
        font-size: 80px;
        font-weight: 600;
        letter-spacing: 14px;
        color: Theme.text-primary;
    }
    if root.state == "code": Text { text: root.instructions; font-size: Theme.body-size; color: Theme.text-secondary; wrap: word-wrap; }
    if root.state == "busy": Text { text: "Contacting the server…"; font-size: Theme.body-size; color: Theme.text-muted; }
    if root.state == "done": Text { text: "✓  " + root.message; font-size: Theme.body-size; color: Theme.ok; wrap: word-wrap; }
    if root.state == "error": Text { text: root.message; font-size: Theme.body-size; color: Theme.warn; wrap: word-wrap; }
    HorizontalLayout {
        alignment: start;
        spacing: 12px;
        if root.state == "idle" || root.state == "error": ActionButton {
            text: root.state == "error" ? "Try again" : root.start-label;
            primary: true;
            clicked => { root.begin(); }
        }
        if root.state == "code" || root.state == "busy": ActionButton { text: "Cancel"; clicked => { root.cancel(); } }
    }
}

export component SetupPage inherits VerticalLayout {
    padding: 48px;
    spacing: 32px;

    private property <bool> show-password: false;

    Text { text: "Welcome to tvdash"; font-size: 44px; font-weight: 600; color: Theme.text-primary; }
    Text {
        text: "Connect your accounts. Every step can be skipped and changed later in Settings.";
        font-size: Theme.body-size;
        color: Theme.text-secondary;
    }

    HorizontalLayout {
        spacing: 36px;
        alignment: start;
        StepDot { index: 0; label: "Plex"; done: Setup.plex-state == "done"; }
        StepDot { index: 1; label: "Jellyfin"; done: Setup.jellyfin-state == "done"; }
        StepDot { index: 2; label: "Streaming"; }
    }

    Card {
        vertical-stretch: 1;
        min-height: 420px;
        VerticalLayout {
            padding: 36px;
            spacing: 20px;
            alignment: start;

            // ── 1 · Plex ─────────────────────────────────────────
            if Setup.step == 0: VerticalLayout {
                spacing: 20px;
                SectionLabel { text: "STEP 1 · PLEX"; }
                Text { text: "Link tvdash to your Plex account with a short code."; font-size: 28px; color: Theme.text-primary; wrap: word-wrap; }
                SignInBlock {
                    state: Setup.plex-state;
                    code: Setup.plex-code;
                    message: Setup.plex-message;
                    instructions: "On any device, go to plex.tv/link and enter this code.";
                    start-label: "Get a code";
                    begin => { Setup.sign-in("plex"); }
                    cancel => { Setup.cancel("plex"); }
                }
            }

            // ── 2 · Jellyfin ─────────────────────────────────────
            if Setup.step == 1: VerticalLayout {
                spacing: 20px;
                SectionLabel { text: "STEP 2 · JELLYFIN"; }
                Text { text: "Sign in to your Jellyfin server."; font-size: 28px; color: Theme.text-primary; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Server"; font-size: Theme.body-size; color: Theme.text-secondary; vertical-alignment: center; width: 110px; }
                    TextField { placeholder: "http://jellyfin.local:8096"; text <=> Setup.jellyfin-url; }
                }
                if !root.show-password: SignInBlock {
                    state: Setup.jellyfin-state;
                    code: Setup.jellyfin-code;
                    message: Setup.jellyfin-message;
                    instructions: "On a signed-in Jellyfin app, open Settings › Quick Connect and enter this code.";
                    start-label: "Sign in with Quick Connect";
                    begin => { Setup.sign-in("jellyfin"); }
                    cancel => { Setup.cancel("jellyfin"); }
                }
                if root.show-password && Setup.jellyfin-state != "done": VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Username"; font-size: Theme.body-size; color: Theme.text-secondary; vertical-alignment: center; width: 110px; }
                        user := TextField { placeholder: "Username"; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Password"; font-size: Theme.body-size; color: Theme.text-secondary; vertical-alignment: center; width: 110px; }
                        pw := TextField {
                            placeholder: "Password";
                            password: true;
                            accepted => { Setup.jellyfin-password(user.text, pw.text); }
                        }
                    }
                    if Setup.jellyfin-state == "error": Text { text: Setup.jellyfin-message; font-size: Theme.body-size; color: Theme.warn; }
                    if Setup.jellyfin-state == "busy": Text { text: "Signing in…"; font-size: Theme.body-size; color: Theme.text-muted; }
                    HorizontalLayout {
                        alignment: start;
                        ActionButton { text: "Sign in"; primary: true; clicked => { Setup.jellyfin-password(user.text, pw.text); } }
                    }
                }
                if root.show-password && Setup.jellyfin-state == "done": Text {
                    text: "✓  " + Setup.jellyfin-message;
                    font-size: Theme.body-size;
                    color: Theme.ok;
                }
                if Setup.jellyfin-state != "done": Text {
                    text: root.show-password ? "Use Quick Connect instead" : "No Quick Connect? Use a username and password";
                    font-size: 18px;
                    color: toggle.has-hover ? Theme.text-primary : Theme.accent;
                    toggle := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-password = !root.show-password; }
                    }
                }
            }

            // ── 3 · Streaming ────────────────────────────────────
            if Setup.step == 2: VerticalLayout {
                spacing: 16px;
                SectionLabel { text: "STEP 3 · STREAMING"; }
                Text { text: "Sign in to each streaming site once, on the TV."; font-size: 28px; color: Theme.text-primary; }
                Text {
                    text: "Each opens full screen on the TV. Sign in there with this laptop's mouse and keyboard, then press Close browser here.";
                    font-size: 18px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                for site[i] in Accounts.sites: HorizontalLayout {
                    spacing: 18px;
                    Text { text: site.name; font-size: Theme.body-size; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; width: 200px; }
                    Text { text: site.status; font-size: 18px; color: site.opened ? Theme.ok : Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; }
                    ActionButton { text: "Sign in on TV"; clicked => { Accounts.open-site(i); } }
                }
                HorizontalLayout {
                    alignment: start;
                    ActionButton { text: "Close browser"; enabled: Dash.tv.mode == "streaming"; clicked => { Dash.transport("stop"); } }
                }
            }
        }
    }

    // ── Navigation ──────────────────────────────────────────────
    HorizontalLayout {
        spacing: 12px;
        if Setup.step > 0: ActionButton { text: "Back"; icon: "back-arrow"; clicked => { Setup.step -= 1; } }
        Rectangle { horizontal-stretch: 1; }
        if Setup.step < 2: ActionButton {
            text: "Skip";
            clicked => { Setup.step += 1; }
        }
        if Setup.step < 2: ActionButton {
            text: "Next";
            primary: true;
            clicked => { Setup.step += 1; }
        }
        if Setup.step == 2: ActionButton { text: "Finish"; primary: true; clicked => { Setup.finish(); } }
    }
}
